<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= role.seo.title %></title>
  <meta name="description" content="<%= role.seo.description %>">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="canonical" href="https://www.medhaiq.ai/explore/role-library/<%= role.slug %>">
  <meta property="og:title" content="<%= role.seo.title %>">
  <meta property="og:description" content="<%= role.seo.description %>">
  <meta property="og:type" content="article">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
  <link rel="stylesheet" href="/css/explore.css">
  <link rel="stylesheet" href="/css/company-library.css">
  <link rel="stylesheet" href="/css/role-library.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- Hero — dark, canonical Explore scale. No CTA here: the guide
       begins with learning; the practice invitation lives at the
       bottom, after the reader has actually gone through the role. -->
  <section class="mh-why-hero mh-explore-hero-compact reveal">
    <div class="mh-why-hero-inner mh-section-center">
      <div class="mh-eyebrow"><%= role.hero.subheadline %></div>
      <h1 class="mh-section-title mh-explore-hero-h1"><%= role.title %> Interview Guide</h1>
    </div>
  </section>

  <!-- ============ LIGHT EDITORIAL READING SURFACE ============ -->
  <div class="mh-editorial-surface">
    <div class="mh-editorial-inner">

      <%
        const _wordSource = [
          role.competencies.map(function(c) { return c.name + ' ' + c.desc; }).join(' '),
          role.questions.join(' '),
          role.tips.join(' '),
          role.practiceHelps.join(' '),
        ].join(' ');
        const _readingMinutes = Math.max(1, Math.round(_wordSource.split(/\s+/).filter(Boolean).length / 200));
      %>
      <nav class="mh-colib-breadcrumb-row" aria-label="Breadcrumb" style="padding: 0 0 32px;">
        <div>
          <a href="/explore" style="color: var(--ed-muted);">Explore MedhaIQ</a>
          <span aria-hidden="true" style="color: var(--ed-faint);">/</span>
          <a href="/explore/role-library" style="color: var(--ed-muted);">Role Library</a>
          <span aria-hidden="true" style="color: var(--ed-faint);">/</span>
          <span style="color: var(--ed-text); font-weight: 600;"><%= role.title %></span>
        </div>
        <span class="mh-colib-reading-time" style="background: rgba(15,23,42,0.05); color: var(--ed-faint);"><%= _readingMinutes %> min read</span>
      </nav>

      <!-- Role at a Glance -->
      <div class="mh-editorial-card">
        <h2 class="mh-colib-visually-hidden">Role at a Glance</h2>
        <div class="mh-colib-snapshot-grid">
          <div class="mh-colib-snapshot-card">
            <div class="mh-colib-snapshot-label">Role Focus</div>
            <div class="mh-colib-snapshot-value"><%= role.atAGlance.roleFocus %></div>
          </div>
          <div class="mh-colib-snapshot-card">
            <div class="mh-colib-snapshot-label">Interview Style</div>
            <div class="mh-colib-snapshot-value"><%= role.atAGlance.interviewStyle %></div>
          </div>
          <div class="mh-colib-snapshot-card">
            <div class="mh-colib-snapshot-label">Typical Experience</div>
            <div class="mh-colib-snapshot-value"><%= role.atAGlance.typicalExperience %></div>
          </div>
          <div class="mh-colib-snapshot-card">
            <div class="mh-colib-snapshot-label">Difficulty</div>
            <div class="mh-colib-snapshot-value mh-role-stars"><%- '★'.repeat(role.atAGlance.difficulty) + '☆'.repeat(5 - role.atAGlance.difficulty) %></div>
          </div>
        </div>
      </div>

      <!-- What Hiring Managers Evaluate -->
      <div class="mh-editorial-card">
        <div class="mh-section-center" style="margin-bottom: 8px;">
          <div class="mh-eyebrow" style="justify-content:center; display:flex;">What Hiring Managers Evaluate</div>
          <h2 class="mh-editorial-card-title">Core competencies</h2>
        </div>
        <div class="mh-explore-grid" role="list" style="margin-top: 24px;">
          <% role.competencies.forEach(function(comp) { %>
            <div class="mh-colib-competency-card" style="background:#FBFCFD; border:1px solid var(--ed-border,rgba(15,23,42,0.07)); border-radius:14px;" role="listitem">
              <div class="mh-colib-competency-name"><%= comp.name %></div>
              <div class="mh-colib-competency-desc"><%= comp.desc %></div>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- Typical Interview Flow -->
      <div class="mh-editorial-card">
        <div class="mh-section-center" style="margin-bottom: 8px;">
          <div class="mh-eyebrow" style="justify-content:center; display:flex;">Typical Interview Flow</div>
          <h2 class="mh-editorial-card-title">What to expect</h2>
        </div>
        <div class="mh-role-flow-row" style="margin-top: 24px;">
          <% role.interviewFlow.forEach(function(stage, i) { %>
            <div class="mh-role-flow-step" style="background:#FBFCFD; border:1px solid var(--ed-border,rgba(15,23,42,0.07)); color: var(--ed-text,#1A1F2B);"><%= stage %></div>
            <% if (i < role.interviewFlow.length - 1) { %><div class="mh-role-flow-arrow">→</div><% } %>
          <% }); %>
        </div>
      </div>

      <!-- Representative Questions -->
      <div class="mh-editorial-card">
        <div class="mh-section-center" style="margin-bottom: 8px;">
          <div class="mh-eyebrow" style="justify-content:center; display:flex;">Representative Questions</div>
          <h2 class="mh-editorial-card-title">What's commonly asked</h2>
        </div>
        <ol class="mh-colib-question-list" style="margin-top: 24px;">
          <% role.questions.forEach(function(q) { %>
            <li class="mh-colib-question-item" style="background:#FBFCFD; border:1px solid var(--ed-border,rgba(15,23,42,0.07)); color: var(--ed-text,#1A1F2B);"><%= q %></li>
          <% }); %>
        </ol>
      </div>

      <!-- Preparation Checklist -->
      <div class="mh-editorial-card">
        <div class="mh-section-center" style="margin-bottom: 8px;">
          <div class="mh-eyebrow" style="justify-content:center; display:flex;">Preparation Checklist</div>
          <h2 class="mh-editorial-card-title">How to prepare</h2>
        </div>
        <ul class="mh-role-checklist" style="margin-top: 16px;">
          <% role.tips.forEach(function(tip, i) { %>
            <li class="mh-role-checklist-item">
              <button type="button" class="mh-role-checklist-box" role="checkbox" aria-checked="false" aria-label="Mark done: <%= tip %>" data-checklist-item="<%= role.slug %>-<%= i %>">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </button>
              <span class="mh-role-checklist-text"><%= tip %></span>
            </li>
          <% }); %>
        </ul>
      </div>

      <!-- Official Resources -->
      <% if (role.resources && role.resources.length) { %>
      <div class="mh-editorial-card">
        <div class="mh-section-center" style="margin-bottom: 8px;">
          <div class="mh-eyebrow" style="justify-content:center; display:flex;">Official Resources</div>
          <h2 class="mh-editorial-card-title">Go deeper</h2>
        </div>
        <ul class="mh-role-resource-list" style="margin-top: 20px;">
          <% role.resources.forEach(function(res) { %>
            <li class="mh-role-resource-item">
              <a href="<%= res.url %>" target="_blank" rel="noopener noreferrer" class="mh-role-resource-link">
                <%= res.name %>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </li>
          <% }); %>
        </ul>
      </div>
      <% } %>

      <!-- Related Company Interviews -->
      <% if (role.relatedCompanies && role.relatedCompanies.length) { %>
      <div class="mh-editorial-card">
        <div class="mh-section-center" style="margin-bottom: 8px;">
          <div class="mh-eyebrow" style="justify-content:center; display:flex;">Related Company Interviews</div>
          <h2 class="mh-editorial-card-title">Practice this role at</h2>
        </div>
        <div class="mh-colib-role-chip-row" style="margin-top: 20px;">
          <% relatedCompanyObjects.forEach(function(company) { %>
            <a href="/explore/company-library/<%= company.slug %>" class="mh-colib-role-chip" style="background:rgba(37,99,235,0.08); color:#2563EB; cursor:pointer;"><%= company.name %></a>
          <% }); %>
        </div>
      </div>
      <% } %>

      <!-- Practice With MedhaIQ -->
      <div class="mh-editorial-card">
        <div class="mh-eyebrow">Ready To Practice?</div>
        <h2 class="mh-editorial-card-title">Put your preparation into practice</h2>
        <ul class="mh-colib-helps-list" style="margin-top: 16px;">
          <% role.practiceHelps.forEach(function(point) { %>
            <li><%= point %></li>
          <% }); %>
        </ul>
      </div>

    </div>
  </div>

  <!-- Final CTA — dark, per color system -->
  <section class="mh-colib-dark-cta reveal" id="sample-report">
    <div class="mh-explore-cta-inner">
      <h2 class="mh-section-title">Ready to practice?</h2>
      <p class="mh-explore-cta-sub">Start a personalized <%= role.title %> interview based on your resume and target level.</p>
      <div class="mh-explore-cta-actions">
        <a href="/login" class="mh-btn-primary">Practice <%= role.title %> Interview</a>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (reveals.length) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) { if (entry.isIntersecting) entry.target.classList.add('visible'); });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(function(el) { observer.observe(el); });
    }
  })();
  (function() {
    // Preparation checklist — visual-only toggle, no persistence.
    // Resets on reload by design; this is a working-through-it aid, not a tracker.
    document.querySelectorAll('.mh-role-checklist-box').forEach(function(box) {
      box.addEventListener('click', function() {
        var checked = box.getAttribute('aria-checked') === 'true';
        box.setAttribute('aria-checked', String(!checked));
        box.closest('.mh-role-checklist-item').classList.toggle('mh-role-checklist-item-done', !checked);
      });
    });
  })();
  </script>
</body>
</html>