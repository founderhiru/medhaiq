<script>
function switchTab(tab) {
    document.querySelectorAll('.role-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
    document.querySelectorAll('.role-panel').forEach(p => p.classList.toggle('visible', p.id === 'tab-' + tab));
    // Re-paint Step 1 selections from the single state source so toggling
    // tabs can never surface stale active classes.
    if (window.__miqRenderStep1) window.__miqRenderStep1();
}

(function () {
  // Same state machine and API payload as the previous version of this page —
  // { personaId, roleTitle, experienceLevel, vapiVoiceId } → POST /api/interview/sessions
  var IS_PREVIEW = <%- (typeof previewMode !== 'undefined' && previewMode) ? 'true' : 'false' %>;
  let state = { role: '', exp: null, persona: null, voice: null, org: null, jdText: '' };
  // Bridge for the Tailor-context script below (object shared by reference;
  // its writes to org/jdText are picked up by the POST payload above).
  window.__miqSetupState = state;
  // Bridge sync() too, so the tailor script can re-validate the CTA after
  // Apply Context (declaration below is hoisted — safe to reference here).
  window.__miqSync = function () { sync(); };

  const EXP_LABELS = { fresher: 'Fresher (0–2 yrs)', mid: 'Mid-Career (3–8 yrs)', senior: 'Senior (8–15 yrs)', executive: 'Executive (15+ yrs)' };
  const customInput = document.getElementById('roleCustom');

  document.querySelectorAll('.sel-card').forEach(el => {
    el.addEventListener('click', () => {
      if (el.classList.contains('persona-card')) {
        document.querySelectorAll('.persona-card').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        state.persona = el.dataset.persona;
        state.voice = el.dataset.voice;
        document.getElementById('ctxPersona').textContent = el.querySelector('.p-name').childNodes[0].textContent.trim();
        document.getElementById('ctxDiff').textContent = el.dataset.diff || '—';
      } else if (el.dataset.exp) {
        el.parentElement.querySelectorAll('.sel-card').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        state.exp = el.querySelector('.exp-name').textContent.trim();
        document.getElementById('ctxExp').textContent = EXP_LABELS[el.dataset.exp] || state.exp;
      } else {
        // role card (may live in either tab panel) — STRICT SINGLE-CHOICE:
        // selecting a role clears every other role card across BOTH tab
        // grids AND fully resets the "Tailor" context track.
        if (window.__miqTailorReset) window.__miqTailorReset();
        document.querySelectorAll('.role-panel .sel-card').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        if (el.dataset.custom) {
          customInput.classList.add('show');
          customInput.focus();
          state.role = customInput.value.trim();
        } else {
          customInput.classList.remove('show');
          state.role = el.dataset.role;
        }
        document.getElementById('ctxRole').textContent = state.role || 'Custom (type below)';
      }
      sync();
    });
  });

  // ── Single source of truth for Step 1 visuals. Called on every tab
  //    toggle so active states always re-render from state, never from
  //    stale DOM classes. (Tailor card visuals are owned by its own
  //    script and are reset at mutation time via __miqTailorReset.) ──
  function renderStep1() {
    document.querySelectorAll('.role-panel .sel-card').forEach(c => {
      c.classList.toggle('active', !!state.role && c.dataset.role === state.role);
    });
  }
  window.__miqRenderStep1 = renderStep1;

  customInput.addEventListener('input', () => {
    state.role = customInput.value.trim();
    document.getElementById('ctxRole').textContent = state.role || 'Custom (type below)';
    sync();
  });

  function sync() {
    // Step 1 is satisfied by EITHER a role card OR an applied "Tailor your
    // interview" context (state.tailorApplied set by the tailor script).
    const ready = !!((state.role || state.tailorApplied) && state.persona && state.exp);
    const btn = document.getElementById('beginBtn');
    btn.disabled = IS_PREVIEW ? false : !ready;
    document.getElementById('engTitle').textContent = ready ? 'Ready' : 'Waiting';
    document.getElementById('termStatus').textContent = ready ? 'Ready' : 'Waiting';
    document.getElementById('feedMsg').textContent = IS_PREVIEW
      ? 'AI systems ready. Explore the setup, then create your free account.'
      : (ready
        ? 'All systems ready. Click \u2018Initialize Session\u2019 to launch.'
        : 'AI systems ready. Complete steps 1\u20133 to begin.');
  }

  async function createSessionOnce() {
    const res = await fetch('/api/interview/sessions', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
          personaId: state.persona,
          roleTitle: state.role || state.tailorRole || 'General Professional',
          experienceLevel: state.exp,
          vapiVoiceId: state.voice,
          // Tailored-context pipeline: packaged ONLY when the tailor track
          // is the active Step 1 choice (strict single-selection model).
          orgPreset: state.tailorApplied ? (state.org || null) : null,
          jdText: state.tailorApplied ? (state.jdText || '') : ''
      })
    });
    const data = await res.json();
    return { status: res.status, data: data };
  }

  document.getElementById('beginBtn').addEventListener('click', async () => {
    const btn = document.getElementById('beginBtn');
    if (IS_PREVIEW) {
      window.location.href = '/auth/signup';
      return;
    }
    btn.textContent = 'Initializing...';

    // SIMPLIFIED (2026-07-24): stale-session recovery is now entirely
    // server-owned (middleware/guards.js's requireInterviewEntitlement
    // auto-abandons any ACTIVE session that's gone silent for longer than
    // SESSION_INACTIVITY_TIMEOUT_MINUTES before ever returning a
    // conflict) — see db/interview.js's abandonStaleActiveSession. The
    // frontend cleanup loop that used to live here (delete the reported
    // activeSessionId, retry, repeat) is gone: it's no longer this
    // layer's job, and it could only ever clear one stale session per
    // pass anyway, which is exactly what broke when several had
    // accumulated. A 409 ACTIVE_SESSION_EXISTS reaching this code now
    // means a GENUINELY recent session — most likely a second tab still
    // open — which is a real conflict, not something to silently clear.
    let result = await createSessionOnce().catch(function (e) { return { status: 0, data: { error: String(e) } }; });

    if (result.data && result.data.sessionId) {
      window.location.href = '/interview/session/' + result.data.sessionId;
      return;
    }
    if (result.status === 409 && result.data && result.data.reason === 'ACTIVE_SESSION_EXISTS') {
      console.log('[Launch] genuinely active session exists elsewhere (id=' + result.data.activeSessionId + ') — not stale, real conflict');
      alert('You already have an interview in progress in another tab or window. Please finish or end that session before starting a new one.');
      btn.textContent = 'Initialize Session →';
      return;
    }

    // Any OTHER failure (transient network/backend hiccup) still gets
    // the silent-retry treatment from before.
    const MAX_ATTEMPTS = 3;
    const RETRY_DELAY_MS = 800;
    let lastError = result.data && result.data.error;
    for (let attempt = 2; attempt <= MAX_ATTEMPTS; attempt++) {
      await new Promise(function (r) { setTimeout(r, RETRY_DELAY_MS); });
      try {
        const retryResult = await createSessionOnce();
        if (retryResult.data && retryResult.data.sessionId) {
          window.location.href = '/interview/session/' + retryResult.data.sessionId;
          return;
        }
        console.warn('[Launch] attempt ' + attempt + ' returned no sessionId:', retryResult.data);
        lastError = retryResult.data && retryResult.data.error;
      } catch (e) {
        console.warn('[Launch] attempt ' + attempt + ' threw:', e);
        lastError = e;
      }
    }
    // Only reached if ALL attempts failed.
    console.error('[Launch] all ' + MAX_ATTEMPTS + ' attempts failed:', lastError);
    alert('Failed to launch. Please check console.');
    btn.textContent = 'Initialize Session →';
  });
})();
</script>

<!-- ══════════════════════════════════════════════════════════════════
     TAILOR THIS INTERVIEW — modal + handler. Fully self-contained:
     its own IDs, its own IIFE, zero changes to existing handlers.
     Writes only two new fields onto the shared `state` object
     (state.org, state.jdText) which the session POST above sends.
════════════════════════════════════════════════════════════════════ -->
<div class="tc-overlay" id="tcOverlay" role="dialog" aria-modal="true" aria-labelledby="tcModalTitle">
  <div class="tc-modal">
    <div class="tc-m-head">
      <div class="tc-m-title" id="tcModalTitle">Tailor your interview</div>
      <button class="tc-m-close" type="button" id="tcClose" aria-label="Close">✕</button>
    </div>

    <div class="tc-field-label">Target Company</div>
    <input class="tc-input" id="tcCompanyIn" type="text" maxlength="80"
           placeholder="e.g. Microsoft, Flipkart, a Series B SaaS…" autocomplete="organization">

    <div class="tc-field-label">Target Level <span class="opt">(Optional)</span></div>
    <div class="tc-levels" id="tcLevels">
      <button class="tc-level" type="button" data-level="Senior PM">Senior PM</button>
      <button class="tc-level" type="button" data-level="Principal Engineer">Principal Engineer</button>
      <button class="tc-level" type="button" data-level="L6">L6</button>
      <button class="tc-level" type="button" data-level="Staff">Staff</button>
      <button class="tc-level" type="button" data-level="Director">Director</button>
    </div>

    <div class="tc-field-label">Paste Job Description <span class="opt">(Optional) — supports markdown</span></div>
    <textarea class="tc-textarea" id="tcJdIn" maxlength="5000"
              placeholder="Paste the JD here and MedhaIQ will detect the competencies to probe…"></textarea>
    <div class="tc-count"><span id="tcCount">0</span> / 5000</div>

    <div class="tc-field-label">AI Detected Focus Areas</div>
    <div class="tc-chips" id="tcChips"><span style="font-size:11px;color:var(--muted)">Paste a JD above to detect focus areas…</span></div>

    <div class="tc-field-label">Resume Intelligence</div>
    <div id="tcResumeStatus" style="font-size:12.5px; color:var(--muted); margin-bottom:14px;">Checking…</div>

    <button class="tc-apply" type="button" id="tcApply">✦ Apply Context</button>
    <div class="tc-privacy">🔒 Private &amp; secure — used only to personalize your interview.</div>
  </div>
</div>

<script>
// Resume Intelligence status — READ-ONLY. This fetch never parses or
// modifies anything; it only reports what's already on file (managed at
// /resume). Interview Setup must never trigger parsing itself.
(function () {
  const el = document.getElementById('tcResumeStatus');
  if (!el) return;
  if (window.__MIQ_PREVIEW_DEMO__) {
    el.innerHTML = window.__MIQ_PREVIEW_DEMO__.resumeStatusHtml;
    return;
  }
  fetch('/api/resume/status')
    .then(r => r.json())
    .then((data) => {
      if (data && data.hasResume) {
        el.innerHTML = `✓ Resume on file (${data.competencyCount || 0} competencies detected) — will personalize this interview automatically. <a href="/resume" style="color:var(--blue-hi);">Manage</a>`;
      } else {
        el.innerHTML = `No resume on file yet. <a href="/resume" style="color:var(--blue-hi);">Add one</a> to personalize your questions.`;
      }
    })
    .catch(() => { el.textContent = 'Resume status unavailable.'; });
})();
</script>

<script>
(function () {
  'use strict';
  // Shared setup state — bridged from the main wizard IIFE above. If the
  // bridge is ever missing, bail silently rather than break the page.
  var state = window.__miqSetupState;
  if (!state) { console.warn('[tailor] setup state bridge missing — feature disabled'); return; }
  // ── Element handles. Cards are instanced by class (one per tab) and all
  //    driven in sync; the modal is a single shared element by ID. ─────────
  var cards    = Array.prototype.slice.call(document.querySelectorAll('.tailor-card'));
  var overlay  = document.getElementById('tcOverlay');
  var companyIn= document.getElementById('tcCompanyIn');
  var jdIn     = document.getElementById('tcJdIn');
  var countEl  = document.getElementById('tcCount');
  var chipsEl  = document.getElementById('tcChips');
  var levelsEl = document.getElementById('tcLevels');
  var pickedLevel = '';

  // ── Client-side focus-area detection. Display-only preview: mirrors the
  //    authoritative parser in services/competency-matrix.js on the server. ──
  var TAXONOMY = [
    ['System Design',        /\b(system design|architecture|architect|distributed systems|microservices|scalab)/i],
    ['Cloud Architecture',   /\b(aws|azure|gcp|cloud|kubernetes|docker|devops|ci\/cd|terraform)\b/i],
    ['Scalability',          /\b(scale|scalab|performance|latency|throughput|reliab)/i],
    ['Leadership',           /\b(lead|mentor|coach|direct reports|people manage|grow(ing)? (the )?team|hire|hiring)\b/i],
    ['Mentorship',           /\b(mentor|coach|grow engineers|develop talent)\b/i],
    ['Performance',          /\b(performance|optimi[sz]|efficien)/i],
    ['Reliability',          /\b(reliab|uptime|sla|incident|on[- ]call|resilien)/i],
    ['Security',             /\b(security|compliance|gdpr|soc ?2|privacy)\b/i],
    ['Stakeholder Comms',    /\b(stakeholder|cross[- ]functional|alignment|executive|influenc)/i],
    ['Strategic Thinking',   /\b(strateg|roadmap|vision|prioriti[sz]|okr)/i],
    ['Data-Driven',          /\b(data[- ]driven|metrics|kpi|analytics|experiment)/i],
    ['Machine Learning',     /\b(machine learning|deep learning|llm|ai model|nlp|mlops)\b/i],
    ['Product Sense',        /\b(product (sense|thinking)|user (experience|research)|customer)\b/i],
    ['Delivery Execution',   /\b(deliver|execution|ship|deadline|agile|scrum|sprint)\b/i]
  ];

  function detectAreas(text) {
    var out = [];
    if (!text) return out;
    for (var i = 0; i < TAXONOMY.length && out.length < 8; i++) {
      if (TAXONOMY[i][1].test(text)) out.push(TAXONOMY[i][0]);
    }
    return out;
  }

  // Mirrors the server merge (5 role defaults + 2 org traits + JD detected,
  // deduped, capped at 8) so the count shown matches what the engine builds.
  function matrixCount(detected, hasCompany) {
    var base = 5 + (hasCompany ? 2 : 2); // role defaults + trait floor
    return Math.min(8, base + detected.length);
  }

  function renderChips() {
    var areas = detectAreas(jdIn.value);
    chipsEl.innerHTML = '';
    if (!areas.length) {
      chipsEl.innerHTML = '<span style="font-size:11px;color:var(--muted)">Paste a JD above to detect focus areas…</span>';
      return;
    }
    areas.forEach(function (a) {
      var s = document.createElement('span');
      s.className = 'tc-chip';
      s.textContent = a;
      chipsEl.appendChild(s);
    });
  }

  // ── Modal open/close ─────────────────────────────────────────────────────
  function openModal() {
    overlay.classList.add('open');
    companyIn.value = state.org || '';
    jdIn.value = state.jdText || '';
    countEl.textContent = jdIn.value.length;
    renderChips();
    setTimeout(function(){ companyIn.focus(); }, 50);
  }
  function closeModal() { overlay.classList.remove('open'); }

  cards.forEach(function (card) {
    card.addEventListener('click', function (e) {
      // The Edit link has its own handler — everything else opens the modal.
      if (e.target.classList && e.target.classList.contains('tc-edit-link')) return;
      openModal();
    });
    card.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(); }
    });
    var edit = card.querySelector('.tc-edit-link');
    if (edit) edit.addEventListener('click', function (e) { e.stopPropagation(); openModal(); });
  });
  document.getElementById('tcClose').addEventListener('click', closeModal);
  overlay.addEventListener('click', function (e) { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal(); });

  // ── Reset bridge: called by the role-card handler when the user chooses
  //    the standard track. Fully clears the tailor track — state hooks,
  //    both card instances' visuals, modal chip selection, sidebar row —
  //    so exactly ONE Step 1 selection ever exists. ──
  window.__miqTailorReset = function () {
    if (!state.tailorApplied && !state.org && !state.jdText && !pickedLevel) return;
    state.org = null;
    state.jdText = '';
    state.tailorApplied = false;
    state.tailorRole = '';
    pickedLevel = '';
    levelsEl.querySelectorAll('.tc-level').forEach(function (b) { b.classList.remove('active'); });
    cards.forEach(function (card) {
      card.classList.remove('tc-success');
      var e = card.querySelector('.tc-state-empty');
      var d = card.querySelector('.tc-state-done');
      if (e) e.style.display = '';
      if (d) d.style.display = 'none';
    });
    var wrap = document.getElementById('ctxCompanyWrap');
    if (wrap) wrap.style.display = 'none';
  };

  // ── Level chips (single-select toggle) ───────────────────────────────────
  levelsEl.addEventListener('click', function (e) {
    var btn = e.target.closest('.tc-level');
    if (!btn) return;
    var was = btn.classList.contains('active');
    levelsEl.querySelectorAll('.tc-level').forEach(function (b) { b.classList.remove('active'); });
    if (!was) btn.classList.add('active');
    pickedLevel = was ? '' : btn.dataset.level;
  });

  // ── Live JD character count + detection ─────────────────────────────────
  jdIn.addEventListener('input', function () {
    countEl.textContent = jdIn.value.length;
    renderChips();
  });

  // ── Apply Context: save into the shared state, flip the card, sync sidebar
  document.getElementById('tcApply').addEventListener('click', function () {
    var company = companyIn.value.trim();
    var jd = jdIn.value.trim();
    if (!company && !jd) { companyIn.focus(); return; }

    // The ONLY writes into shared state — read by the session POST payload.
    state.org = company || null;
    state.jdText = jd || '';
    // Validation gateway: an applied context is a first-class Step 1 choice.
    state.tailorApplied = true;
    state.tailorRole = pickedLevel || '';
    // STRICT SINGLE-CHOICE: choosing the tailor track clears any standard
    // role selection across both tab grids (state + visuals + sidebar).
    state.role = '';
    document.querySelectorAll('.role-panel .sel-card').forEach(function (c) { c.classList.remove('active'); });
    var customIn = document.getElementById('roleCustom');
    if (customIn) { customIn.classList.remove('show'); customIn.value = ''; }

    // ── Company logo resolution (favicon service, SVG building fallback) ──
    var KNOWN_DOMAINS = {
      google:'google.com', microsoft:'microsoft.com', amazon:'amazon.com', apple:'apple.com',
      meta:'meta.com', facebook:'meta.com', netflix:'netflix.com', nvidia:'nvidia.com',
      adobe:'adobe.com', salesforce:'salesforce.com', oracle:'oracle.com', ibm:'ibm.com',
      intel:'intel.com', walmart:'walmart.com', accenture:'accenture.com', deloitte:'deloitte.com',
      infosys:'infosys.com', tcs:'tcs.com', wipro:'wipro.com', flipkart:'flipkart.com',
      uber:'uber.com', airbnb:'airbnb.com', stripe:'stripe.com', 'jpmorgan':'jpmorganchase.com',
      'goldman sachs':'goldmansachs.com', 'mckinsey':'mckinsey.com', linkedin:'linkedin.com'
    };
    function companyDomain(name) {
      var key = name.toLowerCase().trim();
      if (KNOWN_DOMAINS[key]) return KNOWN_DOMAINS[key];
      var slug = key.replace(/[^a-z0-9]/g, '');
      return slug ? slug + '.com' : '';
    }
    var logoUrl = company ? 'https://www.google.com/s2/favicons?domain=' + encodeURIComponent(companyDomain(company)) + '&sz=64' : '';

    var detected = detectAreas(jd);
    var total = matrixCount(detected, !!company);

    // Flip EVERY card instance (both tabs) to the success state in sync
    cards.forEach(function (card) {
      // Logo: try the favicon; on failure (or no company) show the SVG fallback
      var img = card.querySelector('.tc-logo-img');
      var fb  = card.querySelector('.tc-logo-fallback');
      if (img && fb) {
        if (logoUrl) {
          img.onload  = function () { img.style.display = 'block'; fb.style.display = 'none'; };
          img.onerror = function () { img.style.display = 'none';  fb.style.display = 'block'; };
          img.src = logoUrl;
        } else {
          img.style.display = 'none'; fb.style.display = 'block';
        }
      }
      card.querySelector('.tc-company-out').textContent = company || 'Tailored Interview';
      card.querySelector('.tc-role-out').textContent =
        pickedLevel ? pickedLevel + (state.role ? ' · ' + state.role : '') : (state.role || 'Role: pick in Step 1');
      var jdBadge = card.querySelector('.tc-jd-badge');
      jdBadge.style.display = jd ? 'inline-block' : 'none';
      var lvlBadge = card.querySelector('.tc-level-badge');
      lvlBadge.style.display = pickedLevel ? 'inline-block' : 'none';
      lvlBadge.textContent = pickedLevel;
      card.querySelector('.tc-metrics-out').textContent = total + ' AI competencies detected';
      var stEmpty = card.querySelector('.tc-state-empty');
      var stDone  = card.querySelector('.tc-state-done');
      stEmpty.style.display = 'none';
      stDone.style.display = 'flex';
      stDone.style.flexDirection = 'column';
      stDone.style.gap = '8px';
      stDone.style.height = '100%';
      card.classList.add('tc-success');
    });

    // Sidebar live update (Company Name · JD Status · Competency Count)
    document.getElementById('ctxCompanyWrap').style.display = '';
    document.getElementById('ctxCompany').textContent = company || 'Tailored';
    document.getElementById('ctxCompanyMeta').textContent =
      (jd ? 'JD attached · ' : 'No JD · ') + total + ' competencies';

    // Reflect the tailored track in the sidebar Role row (the standard role
    // selection was just cleared — one track, one truth).
    var ctxRole = document.getElementById('ctxRole');
    if (ctxRole) ctxRole.textContent = pickedLevel ? pickedLevel + ' (tailored)' : 'Tailored to JD';

    // Re-run the master form validation so Initialize Session unlocks.
    if (window.__miqSync) window.__miqSync();

    closeModal();
  });
})();
</script>
</body>
</html>