<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Interview Setup — MedhaIQ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg:       #070b14;
      --surface:  #0d1424;
      --card:     #111a2e;
      --border:   rgba(255,255,255,0.07);
      --blue:     #1f59b4;
      --blue-hi:  #3b82f6;
      --blue-glow: rgba(59,130,246,0.15);
      --violet:   #8b5cf6;
      --muted:    #94a3b8;
      --dim:      #475569;
      --white:    #ffffff;
      --emerald:  #10b981;
      --gold:     #f59e0b;
      --orange:   #fb923c;
      --purple:   #a78bfa;
      --green:    #22c55e;
      --red:      #dc2626;
      /* Finalized 5-vector colors — same as live terminal & reports */
      --v-structure:  #3b82f6;
      --v-domain:     #a78bfa;
      --v-strategic:  #22c55e;
      --v-comm:       #fb923c;
      --v-leadership: #f59e0b;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--white);
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 14px;
      line-height: 1.5;
      min-height: 100vh;
    }
    h1,h2,h3 { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; font-weight: 700; }
    ul { list-style: none; }

    /* ── Nav ─────────────────────────────────────────── */
    .nav {
      position: sticky; top: 0; z-index: 20;
      background: rgba(7,11,20,0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      height: 52px;
      display: flex; align-items: center;
      padding: 0 24px;
      justify-content: space-between;
    }
    .nav-logo { display: flex; align-items: center; gap: 8px; text-decoration: none; }
    .nav-logo span { font-family:'Plus Jakarta Sans',system-ui,sans-serif; font-size:15px; font-weight:700; color:#fff; }
    .nav-logo span em { color: var(--blue-hi); font-style: normal; }
    .nav-actions { display: flex; align-items: center; gap: 10px; }
    .nav-link { color: var(--muted); text-decoration: none; font-size: 13px; font-weight: 500; padding: 5px 10px; border-radius: 6px; transition: color 0.15s; }
    .nav-link:hover { color: var(--white); }

    /* ── Master 3-column grid ────────────────────────── */
    .layout {
      display: grid;
      grid-template-columns: 250px minmax(0,1fr) 300px;
      gap: 18px;
      max-width: 1560px;
      margin: 0 auto;
      padding: 18px 20px 24px;
      align-items: start;
    }

    /* ── Shared card/panel styles ────────────────────── */
    .panel {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px;
    }
    .panel + .panel { margin-top: 14px; }
    .panel-label {
      font-size: 10px; font-weight: 700; letter-spacing: 1.4px;
      text-transform: uppercase; color: var(--blue-hi);
      margin-bottom: 12px;
    }

    /* ── LEFT: Session Context ───────────────────────── */
    .ctx-item { display: flex; align-items: flex-start; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border); }
    .ctx-item:last-child { border-bottom: none; }
    .ctx-icon { width: 28px; height: 28px; border-radius: 8px; background: var(--blue-glow); color: var(--blue-hi); display: flex; align-items: center; justify-content: center; font-size: 13px; flex-shrink: 0; }
    .ctx-k { font-size: 11px; color: var(--dim); }
    .ctx-v { font-size: 13px; font-weight: 600; color: var(--white); }

    /* ── LEFT: Session Breakdown donut ───────────────── */
    .donut-wrap { display: flex; align-items: center; gap: 14px; }
    .donut {
      width: 92px; height: 92px; border-radius: 50%;
      background: conic-gradient(
        var(--v-structure) 0deg 126deg,
        var(--v-domain) 126deg 216deg,
        var(--v-strategic) 216deg 288deg,
        var(--v-comm) 288deg 324deg,
        var(--v-leadership) 324deg 360deg
      );
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
    }
    .donut-hole {
      width: 62px; height: 62px; border-radius: 50%;
      background: var(--surface);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .donut-num { font-family:'Plus Jakarta Sans',sans-serif; font-size: 20px; font-weight: 800; line-height: 1; }
    .donut-sub { font-size: 9px; color: var(--muted); }
    .legend { display: flex; flex-direction: column; gap: 5px; flex: 1; min-width: 0; }
    .legend li { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--muted); }
    .legend .dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
    .legend .pct { margin-left: auto; color: var(--white); font-weight: 600; }

    /* ── LEFT: Live Terminal Preview ─────────────────── */
    .prev-row { display: flex; align-items: center; gap: 8px; padding: 6px 0; font-size: 12px; color: var(--muted); }
    .prev-row .p-ic { width: 22px; height: 22px; border-radius: 6px; background: rgba(139,92,246,0.15); color: var(--violet); display: flex; align-items: center; justify-content: center; font-size: 11px; flex-shrink: 0; }
    .prev-ready { margin-left: auto; font-size: 10px; font-weight: 700; color: var(--emerald); background: rgba(16,185,129,0.12); padding: 2px 8px; border-radius: 100px; }
    .prev-msg { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--emerald); margin-top: 8px; }
    .live-pill { display: inline-flex; align-items: center; gap: 5px; font-size: 10px; font-weight: 700; color: var(--emerald); }
    .live-pill::before { content:''; width: 6px; height: 6px; border-radius: 50%; background: var(--emerald); animation: pulse 1.6s ease-in-out infinite; }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1);} 50%{opacity:0.35;transform:scale(0.85);} }

    /* ── CENTER: wizard ──────────────────────────────── */
    .wizard-header { margin-bottom: 16px; }
    .wizard-header h1 { font-size: 22px; letter-spacing: -0.3px; display: flex; align-items: center; gap: 8px; }
    .wizard-header h1 .spark { color: var(--violet); }
    .wizard-header p { color: var(--muted); font-size: 13px; margin-top: 2px; }
    .step-label {
      font-family:'Plus Jakarta Sans',sans-serif;
      font-size: 14px; font-weight: 700; color: var(--white);
      margin: 20px 0 12px;
    }
    .step-label:first-of-type { margin-top: 0; }

    .role-tabs { display: flex; gap: 8px; margin-bottom: 14px; }
    .role-tab {
      padding: 7px 16px; border-radius: 8px;
      border: 1px solid var(--border); background: var(--card);
      color: var(--muted); font-size: 12px; font-weight: 600;
      cursor: pointer; font-family: inherit;
    }
    .role-tab.active { background: var(--blue); border-color: var(--blue); color: #fff; }
    .role-panel { display: none; }
    .role-panel.visible { display: block; }

    /* Role cards */
    .role-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    .sel-card {
      position: relative;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      cursor: pointer;
      transition: border-color 0.15s, transform 0.15s;
      user-select: none;
    }
    .sel-card:hover { border-color: var(--blue-hi); transform: translateY(-1px); }
    .sel-card.active {
      border-color: var(--blue-hi);
      box-shadow: 0 0 0 1px var(--blue-hi), 0 0 18px var(--blue-glow);
    }
    .sel-card .check {
      position: absolute; top: 10px; right: 10px;
      width: 20px; height: 20px; border-radius: 50%;
      background: var(--blue-hi); color: #fff;
      display: none; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 700;
    }
    .sel-card.active .check { display: flex; }
    .rc-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 15px; margin-bottom: 10px; background: var(--blue-glow); }
    .rc-title { font-size: 13px; font-weight: 700; margin-bottom: 3px; }
    .rc-desc { font-size: 11px; color: var(--muted); line-height: 1.45; }
    .custom-input {
      display: none; width: 100%; margin-top: 10px;
      background: var(--card); border: 1px solid var(--blue-hi);
      color: var(--white); border-radius: 8px; padding: 10px 14px;
      font-family: inherit; font-size: 13px; outline: none;
    }
    .custom-input.show { display: block; }

    /* Experience cards */
    .exp-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    .exp-card { text-align: left; display: flex; align-items: center; gap: 10px; }
    .exp-emoji { font-size: 18px; }
    .exp-name { font-size: 13px; font-weight: 700; }
    .exp-yrs { font-size: 11px; color: var(--muted); }

    /* Persona cards */
    .persona-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .persona-card { padding: 14px; }
    .p-head { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
    .p-avatar {
      width: 38px; height: 38px; border-radius: 50%;
      background: linear-gradient(135deg, var(--blue), var(--blue-hi));
      display: flex; align-items: center; justify-content: center;
      font-family:'Plus Jakarta Sans',sans-serif; font-size: 13px; font-weight: 700;
      flex-shrink: 0;
    }
    .p-avatar.emerald { background: linear-gradient(135deg, #047857, #10b981); }
    .p-avatar.gold    { background: linear-gradient(135deg, #b45309, #f59e0b); }
    .p-name { font-size: 13px; font-weight: 700; }
    .p-title { font-size: 11px; color: var(--muted); }
    .difficulty { font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 100px; white-space: nowrap; }
    .diff-hard   { background: rgba(220,38,38,0.15); color: #f87171; }
    .diff-elite  { background: rgba(139,92,246,0.15); color: #c4b5fd; }
    .diff-medium { background: rgba(245,158,11,0.15); color: #fcd34d; }
    .p-style { display: inline-block; font-size: 10px; font-weight: 700; padding: 3px 9px; border-radius: 6px; margin: 6px 0 8px; }
    .p-style.royal-blue { background: rgba(30,64,175,0.3); color: #93c5fd; }
    .p-style.emerald    { background: rgba(5,150,105,0.3);  color: #6ee7b7; }
    .p-style.gold       { background: rgba(217,119,6,0.3);  color: #fcd34d; }
    .p-traits { display: flex; flex-wrap: wrap; gap: 4px 10px; }
    .p-traits li { font-size: 10.5px; color: var(--muted); position: relative; padding-left: 9px; }
    .p-traits li::before { content:'•'; position: absolute; left: 0; color: var(--dim); }

    /* ── RIGHT: Live Terminal ────────────────────────── */
    .terminal { position: sticky; top: 66px; }
    .term-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    .term-title { font-family:'JetBrains Mono',monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; color: var(--muted); }
    .term-block { padding: 12px 0; border-bottom: 1px solid var(--border); }
    .term-block:first-of-type { padding-top: 0; }
    .term-block-last { border-bottom: none; }
    .term-label { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--dim); margin-bottom: 10px; }
    .engine-row { display: flex; align-items: center; gap: 12px; }
    .engine-ring-svg { flex-shrink: 0; filter: drop-shadow(0 0 8px rgba(139,92,246,0.45)); }
    .engine-title { font-family:'Plus Jakarta Sans',sans-serif; font-size: 14px; font-weight: 700; }
    .engine-sub { font-size: 11px; color: var(--muted); line-height: 1.5; }

    .star-row { display: flex; align-items: center; }
    .star-step { display: flex; flex-direction: column; align-items: center; gap: 5px; }
    .star-dot { width: 28px; height: 28px; border-radius: 50%; border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700; color: var(--muted); font-family:'Plus Jakarta Sans',sans-serif; }
    .star-step.on .star-dot { border-color: var(--blue-hi); color: var(--blue-hi); background: var(--blue-glow); }
    .star-name { font-size: 9px; color: var(--muted); }
    .star-step.on .star-name { color: var(--white); font-weight: 600; }
    .star-line { flex: 1; height: 1px; background: var(--border); margin: 0 3px 14px; }

    .score-row { display: flex; align-items: center; gap: 12px; }
    .score-ring { width: 52px; height: 52px; border-radius: 50%; border: 3px solid var(--border); display: flex; align-items: center; justify-content: center; font-family:'Plus Jakarta Sans',sans-serif; font-weight: 700; font-size: 13px; color: var(--dim); flex-shrink: 0; }
    .score-msg { font-size: 12px; font-weight: 600; color: var(--emerald); }
    .score-sub { font-size: 11px; color: var(--muted); }

    .vec-list { display: flex; flex-direction: column; gap: 10px; }
    .vec-list li { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); }
    .vec-ic { width: 20px; height: 20px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 10px; flex-shrink: 0; }
    .vec-bar { flex: 1; height: 4px; border-radius: 2px; background: var(--border); }
    .vec-val { font-family:'JetBrains Mono',monospace; font-size: 11px; color: var(--dim); }

    .feed-row { display: flex; align-items: flex-start; gap: 7px; font-size: 12px; color: var(--muted); }
    .feed-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue-hi); margin-top: 6px; flex-shrink: 0; }

    .begin-btn {
      width: 100%; margin-top: 14px;
      background: linear-gradient(135deg, var(--blue-hi), var(--violet));
      color: #fff; border: none; border-radius: 12px;
      padding: 14px; font-family:'Plus Jakarta Sans',sans-serif;
      font-size: 15px; font-weight: 700; cursor: pointer;
      transition: opacity 0.15s, transform 0.15s;
    }
    .begin-btn:hover:not(:disabled) { transform: translateY(-1px); }
    .begin-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .begin-sub { text-align: center; font-size: 10px; color: var(--muted); margin-top: 6px; }

    /* ── Bottom trust bar ────────────────────────────── */
    .trust {
      border-top: 1px solid var(--border);
      background: rgba(10,15,30,0.8);
      margin-top: 8px;
    }
    .trust-inner {
      max-width: 1560px; margin: 0 auto; padding: 18px 20px;
      display: grid; grid-template-columns: repeat(5, 1fr); gap: 18px;
    }
    .trust-item { display: flex; align-items: center; gap: 10px; }
    .trust-ic { width: 34px; height: 34px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 14px; }
    .trust-t { font-size: 12px; font-weight: 600; line-height: 1.3; }
    .trust-s { font-size: 10.5px; color: var(--muted); }

    /* ── Responsive ──────────────────────────────────── */
    @media (max-width: 1200px) {
      .layout { grid-template-columns: 1fr; }
      .terminal { position: static; }
      .role-grid { grid-template-columns: repeat(2, 1fr); }
      .exp-grid { grid-template-columns: repeat(2, 1fr); }
      .persona-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .role-grid, .exp-grid, .persona-grid { grid-template-columns: 1fr; }
      .trust-inner { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<nav class="nav">
  <a href="/" class="nav-logo">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M3 3 L10 3 L10 10 L17 10" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="10" r="1.5" fill="white"/><circle cx="3" cy="3" r="1.5" fill="white"/><circle cx="17" cy="10" r="1.5" fill="white"/><path d="M10 10 L17 3" stroke="white" stroke-width="1.5" stroke-linecap="round"/><path d="M7 14 L7 17 L10 17" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span>Medha<em>IQ</em>.ai</span>
  </a>
  <div class="nav-actions">
    <a href="/dashboard/history" class="nav-link">History</a>
  </div>
</nav>

<div class="layout">

  <!-- ══════════ LEFT SIDEBAR ══════════ -->
  <aside>
    <div class="panel">
      <div class="panel-label">Session Context</div>
      <div class="ctx-item"><div class="ctx-icon">💼</div><div><div class="ctx-k">Role</div><div class="ctx-v" id="ctxRole">Not selected</div></div></div>
      <div class="ctx-item"><div class="ctx-icon">⚡</div><div><div class="ctx-k">Experience</div><div class="ctx-v" id="ctxExp">Not selected</div></div></div>
      <div class="ctx-item"><div class="ctx-icon">👤</div><div><div class="ctx-k">Interviewer</div><div class="ctx-v" id="ctxPersona">Not selected</div></div></div>
      <div class="ctx-item"><div class="ctx-icon">🕐</div><div><div class="ctx-k">Duration</div><div class="ctx-v">~45 minutes</div></div></div>
      <div class="ctx-item"><div class="ctx-icon">✦</div><div><div class="ctx-k">Difficulty</div><div class="ctx-v" id="ctxDiff">—</div></div></div>
    </div>

    <div class="panel">
      <div class="panel-label">Session Breakdown</div>
      <div class="donut-wrap">
        <div class="donut"><div class="donut-hole"><div class="donut-num">5</div><div class="donut-sub">Vectors</div></div></div>
        <ul class="legend">
          <li><span class="dot" style="background:var(--v-structure)"></span>Structure<span class="pct">35%</span></li>
          <li><span class="dot" style="background:var(--v-domain)"></span>Domain Expertise<span class="pct">25%</span></li>
          <li><span class="dot" style="background:var(--v-strategic)"></span>Strategic Thinking<span class="pct">20%</span></li>
          <li><span class="dot" style="background:var(--v-comm)"></span>Communication<span class="pct">10%</span></li>
          <li><span class="dot" style="background:var(--v-leadership)"></span>Leadership &amp; Exec.<span class="pct">10%</span></li>
        </ul>
      </div>
    </div>

    <div class="panel">
      <div class="panel-label" style="display:flex;justify-content:space-between;align-items:center;">Live Terminal Preview <span class="live-pill">Live</span></div>
      <div class="prev-row"><span class="p-ic">◎</span>STAR Engine<span class="prev-ready">Ready</span></div>
      <div class="prev-row"><span class="p-ic">◎</span>Behavior Analyzer<span class="prev-ready">Ready</span></div>
      <div class="prev-row"><span class="p-ic">◎</span>Sentiment Engine<span class="prev-ready">Ready</span></div>
      <div class="prev-row"><span class="p-ic">◎</span>Response Predictor<span class="prev-ready">Ready</span></div>
      <div class="prev-msg">All systems ready. Let's begin!</div>
    </div>
  </aside>

  <!-- ══════════ CENTER: WIZARD ══════════ -->
  <main class="panel" style="padding:20px;">
    <div class="wizard-header">
      <h1><span class="spark">✦</span> AI Interview Setup</h1>
      <p>Configure your personalized interview experience</p>
    </div>

    <div class="step-label">1. Select Target Role</div>
    <div class="role-tabs">
      <button class="role-tab active" data-tab="core" onclick="switchTab('core')">Core Roles</button>
      <button class="role-tab" data-tab="ai" onclick="switchTab('ai')">AI &amp; Data Roles</button>
    </div>

    <div class="role-panel visible" id="tab-core">
      <div class="role-grid">
        <div class="sel-card chip" data-role="Product Manager"><div class="check">✓</div><div class="rc-icon">💼</div><div class="rc-title">Product Manager</div><div class="rc-desc">Drive product strategy and execution</div></div>
        <div class="sel-card chip" data-role="Software Engineer"><div class="check">✓</div><div class="rc-icon">&lt;/&gt;</div><div class="rc-title">Software Engineer</div><div class="rc-desc">Design, build and scale software systems</div></div>
        <div class="sel-card chip" data-role="Engineering Manager"><div class="check">✓</div><div class="rc-icon">👥</div><div class="rc-title">Engineering Manager</div><div class="rc-desc">Lead engineering teams and deliver impact</div></div>
        <div class="sel-card chip" data-role="Solutions Architect"><div class="check">✓</div><div class="rc-icon">🗂</div><div class="rc-title">Solutions Architect</div><div class="rc-desc">Design scalable architectural solutions</div></div>
        <div class="sel-card chip" data-role="Technical Program Manager"><div class="check">✓</div><div class="rc-icon">🗓</div><div class="rc-title">Technical Program Manager</div><div class="rc-desc">Plan and deliver complex technical programs</div></div>
        <div class="sel-card chip" data-role="Management Consultant"><div class="check">✓</div><div class="rc-icon">📊</div><div class="rc-title">Management Consultant</div><div class="rc-desc">Solve business problems and drive transformation</div></div>
        <div class="sel-card chip" data-role="Executive Leadership"><div class="check">✓</div><div class="rc-icon">👑</div><div class="rc-title">Executive Leadership</div><div class="rc-desc">Set vision and lead at the executive level</div></div>
        <div class="sel-card chip" data-role="Custom" data-custom="true"><div class="check">✓</div><div class="rc-icon">＋</div><div class="rc-title">Custom Role</div><div class="rc-desc">Define a custom role and expectations</div></div>
      </div>
    </div>

    <div class="role-panel" id="tab-ai">
      <div class="role-grid">
        <div class="sel-card chip" data-role="AI Engineer"><div class="check">✓</div><div class="rc-icon">🤖</div><div class="rc-title">AI Engineer</div><div class="rc-desc">Build and deploy AI-powered systems</div></div>
