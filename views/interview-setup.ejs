<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Start Your Session — MedhaIQ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg:       #0b1120;
      --surface:  #111827;
      --card:     #151f32;
      --border:   rgba(255,255,255,0.07);
      --blue:     #1f59b4;
      --blue-hi:  #3b82f6;
      --muted:    #94a3b8;
      --dim:      #475569;
      --white:    #ffffff;
      --emerald:  #059669;
      --gold:     #d97706;
      --red:      #dc2626;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--white);
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 14px;
      line-height: 1.5;
      min-height: 100vh;
    }
    h1,h2,h3 { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; font-weight: 700; }
    .nav {
      position: sticky; top: 0; z-index: 20;
      background: rgba(11,17,32,0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      height: 52px;
      display: flex; align-items: center;
      padding: 0 28px;
      justify-content: space-between;
    }
    .nav-logo { display: flex; align-items: center; gap: 8px; text-decoration: none; }
    .nav-logo span { font-family:'Plus Jakarta Sans',system-ui,sans-serif; font-size:15px; font-weight:700; color:#fff; }
    .nav-logo span em { color: var(--blue-hi); font-style: normal; }
    .nav-actions { display: flex; align-items: center; gap: 10px; }
    .nav-link { color: var(--muted); text-decoration: none; font-size: 13px; font-weight: 500; padding: 5px 10px; border-radius: 6px; transition: color 0.15s; }
    .nav-link:hover { color: var(--white); }
    .nav-cta { background: var(--blue); color: #fff; text-decoration: none; font-size: 12px; font-weight: 600; padding: 6px 14px; border-radius: 7px; transition: background 0.15s; }
    .nav-cta:hover { background: var(--blue-hi); }
    .page { max-width: 900px; margin: 0 auto; padding: 44px 24px 80px; }
    .page-header { margin-bottom: 36px; }
    .page-header h1 { font-size: 26px; letter-spacing: -0.4px; margin-bottom: 5px; }
    .page-header p { color: var(--muted); font-size: 13px; }
    .sec-label {
      font-size: 10px; font-weight: 600; letter-spacing: 1.4px;
      text-transform: uppercase; color: var(--blue-hi);
      margin-bottom: 10px;
    }
    .chips { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 28px; }
    .chip {
      padding: 5px 14px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--muted);
      font-size: 12px; font-weight: 500;
      cursor: pointer;
      transition: all 0.15s;
      white-space: nowrap;
      user-select: none;
    }
    .chip:hover { border-color: var(--blue-hi); color: var(--white); }
    .chip.active {
      background: rgba(31,89,180,0.25);
      border-color: var(--blue-hi);
      color: var(--white);
    }
    .role-tabs { display: flex; gap: 6px; margin-bottom: 12px; }
    .role-tab {
      padding: 5px 14px; border-radius: 999px;
      border: 1px solid var(--border);
      background: transparent; color: var(--muted);
      font-size: 12px; font-weight: 500;
      cursor: pointer; transition: all 0.15s;
    }
    .role-tab.active { background: var(--surface); border-color: var(--blue-hi); color: var(--white); }
    .role-panel { display: none; }
    .role-panel.visible { display: block; }
    .custom-input {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 14px;
      color: var(--white);
      font-size: 13px;
      font-family: 'Inter', system-ui, sans-serif;
      width: 100%; margin-top: 8px;
      display: none;
      transition: border-color 0.15s;
    }
    .custom-input:focus { outline: none; border-color: var(--blue-hi); }
    .divider { height: 1px; background: var(--border); margin: 28px 0; }
    .persona-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 36px;
    }
    @media (max-width: 640px) { .persona-grid { grid-template-columns: 1fr; } }
 .persona-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; margin-top: 20px; }
    .persona-card { background: var(--card); padding: 20px; border-radius: 12px; border: 1px solid var(--border); transition: 0.3s; cursor: pointer; }
    .persona-card:hover { border-color: var(--blue-hi); }
    .persona-card.selected { border-color: var(--blue-hi); background: rgba(59, 130, 246, 0.05); }
    .persona-card .p-avatar { width: 48px; height: 48px; border-radius: 50%; background: var(--surface); display: flex; align-items: center; justify-content: center; margin-bottom: 12px; font-size: 16px; font-weight: 700; color: #fff; }
    .persona-card .p-name { font-size: 16px; font-weight: 700; color: var(--white); margin-bottom: 2px; }
    .persona-card .p-title { font-size: 13px; color: var(--muted); opacity: 0.7; margin-bottom: 16px; display: block; }
    .persona-card .p-traits { list-style: none; padding: 0; margin: 0; }
    .persona-card .p-traits li { font-size: 13px; color: var(--muted); margin-bottom: 6px; padding-left: 18px; position: relative; line-height: 1.4; }
    .persona-card .p-traits li::before { content: "—"; position: absolute; left: 0; color: var(--blue-hi); }
  .persona-card:hover {
      border-color: var(--blue-hi);
      background: rgba(31,89,180,0.08);
      transform: translateY(-1px);
      box-shadow: 0 0 0 1px var(--blue-hi), 0 4px 20px rgba(31,89,180,0.15);
    }
    .persona-card.selected {
      border-color: var(--blue-hi);
      background: rgba(31,89,180,0.15);
      box-shadow: 0 0 0 1px var(--blue-hi);
    }
    .persona-card .check-dot {
      display: none;
      position: absolute; top: 10px; right: 10px;
      width: 20px; height: 20px;
      background: var(--blue);
      border-radius: 50%;
      align-items: center; justify-content: center;
      font-size: 11px; color: #fff;
    }
    .persona-card.selected .check-dot { display: flex; }
    .p-avatar {
      width: 46px; height: 46px;
      border-radius: 50%;
      flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 16px; font-weight: 700;
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      color: #fff;
      background: var(--blue);
    }
    .p-avatar.emerald { background: var(--emerald); }
    .p-avatar.gold    { background: var(--gold); }
    .p-body { flex: 1; min-width: 0; }
    .p-top { display: flex; align-items: center; gap: 8px; margin-bottom: 2px; flex-wrap: wrap; }
    .p-name { font-size: 14px; font-weight: 700; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
    .difficulty {
      font-size: 10px; font-weight: 600; padding: 2px 7px;
      border-radius: 999px; white-space: nowrap;
    }
    .diff-hard   { background: rgba(220,38,38,0.2);  color: #fca5a5; }
    .diff-medium { background: rgba(217,119,6,0.2);  color: #fcd34d; }
    .diff-elite  { background: rgba(109,40,217,0.2); color: #c4b5fd; }
    .p-title { font-size: 11px; color: var(--muted); margin-bottom: 8px; }
    .p-style {
      display: inline-block; font-size: 10px; font-weight: 600;
      padding: 2px 8px; border-radius: 999px; margin-bottom: 8px;
      letter-spacing: 0.2px;
    }
    .p-style.royal-blue { background: rgba(30,64,175,0.3); color: #93c5fd; }
    .p-style.emerald    { background: rgba(5,150,105,0.3);  color: #6ee7b7; }
    .p-style.gold       { background: rgba(217,119,6,0.3);  color: #fcd34d; }
    .p-traits { list-style: none; padding: 0; }
    .p-traits li {
      font-size: 11px; color: var(--muted);
      padding: 2px 0 2px 12px;
      position: relative; line-height: 1.4;
    }
    .p-traits li::before {
      content: '·'; position: absolute; left: 0;
      color: var(--blue-hi); font-size: 14px; line-height: 1.1;
    }
    .status-row { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; min-height: 22px; }
    .status-pill {
      font-size: 11px; font-weight: 500; padding: 3px 10px;
      border-radius: 999px;
      background: var(--surface); border: 1px solid var(--border); color: var(--muted);
    }
    .status-pill.filled { border-color: var(--blue-hi); color: var(--blue-hi); }
    .cta-bar { display: flex; align-items: center; gap: 16px; }
  .sticky-cta {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(17, 24, 39, 0.98);
  backdrop-filter: blur(10px);
  border-top: 1px solid var(--border);
  padding: 16px 24px;
  display: flex; align-items: center; justify-content: center;
  z-index: 100;
}
.sticky-inner { display: flex; align-items: center; gap: 24px; width: 100%; max-width: 900px; }
.cta-status { display: flex; gap: 12px; flex: 1; }
.cta-tag { font-size: 12px; color: var(--muted); padding: 4px 10px; border-radius: 6px; background: var(--surface); border: 1px solid var(--border); }
.cta-tag.filled { color: var(--blue-hi); border: 1px solid var(--blue-hi); }
.begin-btn {
  padding: 12px 24px; background: var(--blue); border: none; border-radius: 8px;
  color: white; font-weight: 600; cursor: pointer; transition: 0.2s;
}
.begin-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  </style>
</head>
<body>

<nav class="nav">
  <a href="/" class="nav-logo">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><path d="M3 3 L10 3 L10 10 L17 10" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="10" r="1.5" fill="white"/><circle cx="3" cy="3" r="1.5" fill="white"/><circle cx="17" cy="10" r="1.5" fill="white"/><path d="M10 10 L17 3" stroke="white" stroke-width="1.5" stroke-linecap="round"/><path d="M7 14 L7 17 L10 17" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <span>Medha<em>IQ</em></span>
  </a>
  <div class="nav-actions">
    <a href="/dashboard/history" class="nav-link">History</a>
    <a href="/interview" class="nav-cta">New Interview</a>
  </div>
</nav>

<div class="page">
  <div class="page-header">
    <h1>Build Your <span>Interview Experience</span></h1>
    <p>Choose your target role, experience level, and interview style that best matches your target opportunity</p>
  </div>

  <div class="sec-label">Target Role</div>
<div class="role-tabs" style="margin-bottom: 20px; display: flex; gap: 10px;">
  <button class="role-tab active" data-tab="core" onclick="switchTab('core')">Core Roles</button>
  <button class="role-tab" data-tab="ai" onclick="switchTab('ai')">AI & Data Roles</button>
</div>
<!-- Core Roles Section -->
 <div class="role-panel visible" id="tab-core">
    <div class="chips">
        <div class="chip" data-role="Software Engineer">Software Engineer</div>
        <div class="chip" data-role="Engineering Manager">Engineering Manager</div>
        <div class="chip" data-role="Product Manager">Product Manager</div>
        <div class="chip" data-role="Technical Program Manager">Technical Program Manager</div>
        <div class="chip" data-role="Solutions Architect">Solutions Architect</div>
        <div class="chip" data-role="Management Consultant">Management Consultant</div>
        <div class="chip" data-role="Executive Leadership">Executive Leadership</div>
        <div class="chip" data-role="Custom" data-custom="true">&#9998; Custom...</div>
    </div>
</div>
<!-- AI & Data Roles Section -->
  <div class="role-panel" id="tab-ai">
    <div class="chips">
        <div class="chip" data-role="AI Engineer">AI Engineer</div>
        <div class="chip" data-role="AI Product Manager">AI Product Manager</div>
        <div class="chip" data-role="Data Engineer">Data Engineer</div>
        <div class="chip" data-role="ML Engineer">ML Engineer</div>
        <div class="chip" data-role="MLOps Engineer">MLOps Engineer</div>
        <div class="chip" data-role="Research Scientist">Research Scientist</div>
        <div class="chip" data-role="LLM Engineer">LLM Engineer</div>
        <div class="chip" data-role="Custom" data-custom="true">&#9998; Custom...</div>
    </div>
  </div>
  <input type="text" class="custom-input" id="roleCustom" placeholder="Type your role and press Enter...">

  <div class="divider"></div>

  <div class="sec-label">Experience Level</div>
  <div class="chips" id="chips-exp">
    <div class="chip" data-exp="fresher">&#127807; Fresher (0&#8211;2 yrs)</div>
    <div class="chip" data-exp="mid">&#9889; Mid-Career (3&#8211;8 yrs)</div>
    <div class="chip" data-exp="senior">&#128293; Senior (8&#8211;15 yrs)</div>
    <div class="chip" data-exp="executive">&#128081; Executive (15+ yrs)</div>
  </div>

  <div class="divider"></div>

  <div class="sec-label">Choose Your Interviewer</div>

  <div class="persona-grid">

    <div class="persona-card" data-persona="alex_chen" data-voice="voice-alex">
      <div class="check-dot">&#10003;</div>
      <div class="p-avatar">AC</div>
      <div class="p-body">
        <div class="p-top">
          <span class="p-name">Alex Chen</span>
          <span class="difficulty diff-hard">&#128293; Hard</span>
        </div>
        <div class="p-title">Senior Principal Engineer &middot; AWS</div>
        <span class="p-style royal-blue">Structured Technical</span>
        <ul class="p-traits">
          <li>LP-driven, bar-raiser standard — no hand-holding</li>
          <li>Demands explicit trade-offs and measurable outcomes</li>
          <li>Deep dives into system design &amp; ownership moments</li>
        </ul>
      </div>
    </div>

    <div class="persona-card" data-persona="priya_ramesh" data-voice="voice-priya">
      <div class="check-dot">&#10003;</div>
      <div class="p-avatar emerald">PR</div>
      <div class="p-body">
        <div class="p-top">
          <span class="p-name">Priya Ramesh</span>
          <span class="difficulty diff-elite">&#128142; Elite</span>
        </div>
        <div class="p-title">Partner &middot; McKinsey Consulting</div>
        <span class="p-style emerald">Case-Led Communication</span>
        <ul class="p-traits">
          <li>MECE frameworks, fast-paced articulation under pressure</li>
          <li>Executive presence &amp; structured problem decomposition</li>
          <li>Punishes waffle — rewards clarity and synthesis</li>
        </ul>
      </div>
    </div>

    <div class="persona-card" data-persona="marcus_webb" data-voice="voice-marcus">
      <div class="check-dot">&#10003;</div>
      <div class="p-avatar gold">MW</div>
      <div class="p-body">
        <div class="p-top">
          <span class="p-name">Marcus Webb</span>
          <span class="difficulty diff-medium">&#9889; Medium</span>
        </div>
        <div class="p-title">VP Product &middot; Series B SaaS</div>
        <span class="p-style gold">Product Thinking</span>
        <ul class="p-traits">
          <li>Product sense, prioritisation frameworks, north-star metrics</li>
          <li>User empathy balanced with hard commercial judgement</li>
          <li>Cross-functional leadership &amp; go-to-market thinking</li>
        </ul>
      </div>
    </div>

    <div class="persona-card" data-persona="sanjeev_nair" data-voice="voice-sanjeev">
      <div class="check-dot">&#10003;</div>
      <div class="p-avatar">SN</div>
      <div class="p-body">
        <div class="p-top">
          <span class="p-name">Sanjeev Nair</span>
          <span class="difficulty diff-hard">&#128293; Hard</span>
        </div>
        <div class="p-title">Engineering Director &middot; Global Tech Firm</div>
        <span class="p-style royal-blue">Core Engineering + Team</span>
        <ul class="p-traits">
          <li>Architecture decisions at scale, agile delivery under pressure</li>
          <li>Team mentoring, org design, engineering culture</li>
          <li>Enterprise execution — timelines, stakeholders, delivery</li>
        </ul>
      </div>
    </div>

    <div class="persona-card" data-persona="sarah_kim" data-voice="voice-sarah">
      <div class="check-dot">&#10003;</div>
      <div class="p-avatar emerald">SK</div>
      <div class="p-body">
        <div class="p-top">
          <span class="p-name">Sarah Kim</span>
          <span class="difficulty diff-hard">&#128293; Hard</span>
        </div>
        <div class="p-title">CEO &middot; Pre-Series A Startup</div>
        <span class="p-style emerald">Generalist High-Bar</span>
        <ul class="p-traits">
          <li>First-principles thinking, resilience under extreme ambiguity</li>
          <li>Bias for action, growth mindset, founder-level hustle</li>
          <li>Tests resourcefulness — right answer matters less than how</li>
        </ul>
      </div>
    </div>

    <div class="persona-card" data-persona="raj_mehta" data-voice="voice-raj">
      <div class="check-dot">&#10003;</div>
      <div class="p-avatar gold">RM</div>
      <div class="p-body">
        <div class="p-top">
          <span class="p-name">Raj Mehta</span>
          <span class="difficulty diff-elite">&#128142; Elite</span>
        </div>
        <div class="p-title">Global Director &middot; GCC Enterprise Network</div>
        <span class="p-style gold">Executive Presence</span>
        <ul class="p-traits">
          <li>Stakeholder management across cultures and geographies</li>
          <li>Board-level communication, cross-border strategy</li>
          <li>Tests gravitas, composure, and enterprise political acuity</li>
        </ul>
      </div>
    </div>

  </div>

  <div class="sticky-cta">
  <div class="sticky-inner">
    <div class="cta-status">
      <span class="cta-tag" id="cta-role">Role: not selected</span>
      <span class="cta-tag set" id="cta-exp">Level: Mid-Career</span>
      <span class="cta-tag" id="cta-persona">Interviewer: not selected</span>
    </div>
    <button class="begin-btn" id="beginBtn" disabled>Initialize Session &#8594;</button>
  </div>
</div>

<script>
function switchTab(tab) {
    document.querySelectorAll('.role-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
    document.querySelectorAll('.role-panel').forEach(p => p.classList.toggle('visible', p.id === 'tab-' + tab));
}

(function () {
  let state = { role: '', exp: null, persona: null, voice: null };

  document.querySelectorAll('.chip, .persona-card').forEach(el => {
    el.addEventListener('click', () => {
      if(el.classList.contains('chip')) {
        el.parentElement.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        if(el.parentElement.id === 'chips-exp') state.exp = el.textContent.trim().split('(')[0];
        else state.role = el.dataset.role;
      } else {
        document.querySelectorAll('.persona-card').forEach(c => c.classList.remove('selected'));
        el.classList.add('selected');
        state.persona = el.dataset.persona; // Ensure persona ID is captured
        state.voice = el.dataset.voice;
      }
      sync();
    });
  });

  function sync() {
    const roleEl = document.getElementById('cta-role');
    const expEl = document.getElementById('cta-exp');
    const perEl = document.getElementById('cta-persona');
    const btn = document.getElementById('beginBtn');

    roleEl.textContent = state.role ? 'Role: ' + state.role : 'Role: not selected';
    roleEl.classList.toggle('filled', !!state.role);
    expEl.textContent = state.exp ? 'Level: ' + state.exp : 'Level: not selected';
    expEl.classList.toggle('filled', !!state.exp);
    perEl.textContent = state.persona ? 'Interviewer: ' + state.persona : 'Interviewer: not selected';
    perEl.classList.toggle('filled', !!state.persona);
    
    btn.disabled = !(state.role && state.persona && state.exp);
  }

  document.getElementById('beginBtn').addEventListener('click', async () => {
    const btn = document.getElementById('beginBtn');
    btn.textContent = 'Initializing...';
    try {
      const res = await fetch('/api/interview/sessions', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ 
            personaId: state.persona, 
            roleTitle: state.role, 
            experienceLevel: state.exp, 
            vapiVoiceId: state.voice 
        })
      });
      const data = await res.json();
      if (data.sessionId) {
        window.location.href = '/interview/session/' + data.sessionId;
      } else {
        alert('Failed to launch. Please check console.');
        btn.textContent = 'Initialize Session →';
      }
    } catch (e) {
      console.error(e);
      btn.textContent = 'Initialize Session →';
    }
  });
})();
</script>
</body>
</html>