<%
/* views/settings.ejs — Account Settings (Beta)
   Reuses partials/workspace-shell-top/bottom, .panel/.panel-header-row
   (career-workspace.css), and .cta-btn.primary — the exact same
   components dashboard-history.ejs and settings.ejs already use. No new
   page design, per spec.

   Tabs are client-side show/hide (no page reload between them), but the
   server picks the initially-active one from ?tab=, so a direct link like
   /settings?tab=subscription opens straight to that tab.
*/
const _activeTab = ['profile', 'subscription', 'preferences'].includes(activeTab) ? activeTab : 'profile';
const _signInMethod = hasPassword ? 'Email & Password' : 'Passwordless (Magic Link or Google)';
// Step 2 (Architecture v1.5, ADR-013): plan label now comes from the
// unified Capability Engine's resolved package, not from
// shellUser.subscription_plan (legacy, no longer read for this purpose).
// Falls back to 'Explorer' if capabilities wasn't attached for some
// reason -- matches the engine's own visitor/no-acquisition default,
// never silently shows something invented.
const _packageId = (typeof capabilities !== 'undefined' && capabilities && capabilities.package && capabilities.package.id) || 'explorer';
const _planLabel = _packageId.charAt(0).toUpperCase() + _packageId.slice(1);
// Founder display (Task 1, presentation-only) — a Founder account's
// resolved package is untouched and still shown below as "Current
// Package" (typically Explorer, since Founders don't purchase anything).
// "Role" is a SEPARATE fact shown alongside it, never a replacement for
// it — Founder is not a commercial package.
const _isFounderAccount = typeof capabilities !== 'undefined' && capabilities && capabilities.isFounderAccount;
%>
<%- include('partials/workspace-shell-top', { pageTitle: 'Account Settings — MedhaIQ', activeNav: 'settings', shellUser: shellUser, extraStylesheets: ['/css/career-workspace.css'], bodyClass: 'career-workspace' }) %>

<h1>Account Settings</h1>
<p class="subtitle">Manage your profile, subscription, and preferences.</p>

<div style="display:flex; gap:6px; margin-bottom:20px; border-bottom:1px solid var(--border);">
  <button type="button" class="acct-tab-btn" data-tab="profile" style="background:none;border:none;cursor:pointer;padding:10px 16px;font-size:14px;font-weight:600;color:var(--muted);border-bottom:2px solid transparent;">Personal Information</button>
  <button type="button" class="acct-tab-btn" data-tab="subscription" style="background:none;border:none;cursor:pointer;padding:10px 16px;font-size:14px;font-weight:600;color:var(--muted);border-bottom:2px solid transparent;">Subscription</button>
  <button type="button" class="acct-tab-btn" data-tab="preferences" style="background:none;border:none;cursor:pointer;padding:10px 16px;font-size:14px;font-weight:600;color:var(--muted);border-bottom:2px solid transparent;">Notifications &amp; Preferences</button>
</div>

<!-- ═══ Personal Information ═══ -->
<div class="acct-tab-panel" data-tab-panel="profile">
  <div class="panel" style="margin-bottom:16px;">
    <div class="panel-header-row">
      <h3>Personal Information</h3>
    </div>
    <div style="margin-bottom:14px;">
      <label style="display:block;font-size:12.5px;color:var(--dim);margin-bottom:5px;">Full Name</label>
      <input type="text" id="acct-name-input" value="<%= shellUser.name || '' %>" style="width:100%;max-width:360px;padding:9px 12px;border-radius:8px;border:1px solid var(--border);background:var(--card-hover,#1E2A45);color:#0B1020;font-size:14px;">
    </div>
    <div style="margin-bottom:14px;">
      <label style="display:block;font-size:12.5px;color:var(--dim);margin-bottom:5px;">Email Address</label>
      <p style="font-size:14px;color:var(--muted);margin:0;"><%= shellUser.email || '—' %></p>
    </div>
    <div style="margin-bottom:18px;">
      <label style="display:block;font-size:12.5px;color:var(--dim);margin-bottom:5px;">Sign-in Method</label>
      <p style="font-size:14px;color:var(--muted);margin:0;"><%= _signInMethod %></p>
    </div>
    <div style="margin-bottom:18px;">
      <label style="display:block;font-size:12.5px;color:var(--dim);margin-bottom:5px;">Member Since</label>
      <p style="font-size:14px;color:var(--muted);margin:0;"><%= shellUser.created_at ? new Date(shellUser.created_at).toLocaleDateString('en-US', {month:'long', day:'numeric', year:'numeric'}) : '—' %></p>
    </div>
    <button type="button" id="acct-save-profile" class="cta-btn primary" style="display:inline-block;">Save Changes</button>
    <span id="acct-profile-status" style="margin-left:10px;font-size:13px;color:var(--dim);"></span>
  </div>
</div>

<!-- ═══ Subscription ═══ -->
<div class="acct-tab-panel" data-tab-panel="subscription" style="display:none;">
  <div class="panel" style="margin-bottom:16px;">
    <div class="panel-header-row">
      <h3>Subscription</h3>
    </div>
    <% if (_isFounderAccount) { %>
    <p style="font-size:14px;margin-bottom:14px;"><strong style="display:inline-block;width:140px;color:var(--dim);font-weight:600;font-size:12.5px;text-transform:uppercase;letter-spacing:0.02em;">Role</strong> Founder</p>
    <% } %>
    <p style="font-size:14px;margin-bottom:14px;"><strong style="display:inline-block;width:140px;color:var(--dim);font-weight:600;font-size:12.5px;text-transform:uppercase;letter-spacing:0.02em;">Package</strong> <%= _planLabel %></p>
    <p style="font-size:14px;margin-bottom:14px;">
      <strong style="display:inline-block;width:140px;color:var(--dim);font-weight:600;font-size:12.5px;text-transform:uppercase;letter-spacing:0.02em;vertical-align:top;">Interview Credits</strong>
      <% if (interviewEntitlement.unlimited) { %>Unlimited<% } else { %><%= Math.round(interviewEntitlement.minutesRemaining) %> of <%= interviewEntitlement.minutesIncluded %> minutes remaining<% } %>
    </p>
    <%
    // Expires — sourced from the active package_acquisitions row's real
    // expires_at (lib/capability-engine.js). No acquisition at all
    // (Explorer, or a Founder whose package resolves to Explorer by
    // default) and an open-ended admin/Founder-granted acquisition both
    // correctly show "Never expires" — this isn't a placeholder, it's
    // the accurate current state for every account today, since no real
    // checkout with a fixed term exists yet (Architecture v1.5 §2.3).
    const _expiresAt = (typeof capabilities !== 'undefined' && capabilities && capabilities.package && capabilities.package.expiresAt) || null;
    const _expiresLabel = _expiresAt
      ? new Date(_expiresAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
      : 'Never expires';
    %>
    <p style="font-size:14px;margin-bottom:18px;"><strong style="display:inline-block;width:140px;color:var(--dim);font-weight:600;font-size:12.5px;text-transform:uppercase;letter-spacing:0.02em;">Expires</strong> <%= _expiresLabel %></p>
    <a href="/#pricing" class="cta-btn primary" style="display:inline-block;">Upgrade Plan</a>
  </div>
</div>

<!-- ═══ Notifications &amp; Preferences ═══ -->
<div class="acct-tab-panel" data-tab-panel="preferences" style="display:none;">
  <div class="panel">
    <div class="panel-header-row">
      <h3>Notifications &amp; Preferences</h3>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;max-width:420px;margin-bottom:14px;">
      <span style="font-size:14px;">Email Notifications</span>
      <input type="checkbox" id="acct-pref-email" <%= preferences.email_notifications ? 'checked' : '' %> style="width:18px;height:18px;">
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;max-width:420px;margin-bottom:18px;">
      <span style="font-size:14px;">Product Updates</span>
      <input type="checkbox" id="acct-pref-updates" <%= preferences.product_updates ? 'checked' : '' %> style="width:18px;height:18px;">
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;max-width:420px;margin-bottom:18px;">
      <span style="font-size:14px;">Theme</span>
      <select disabled title="Theme switching isn't available yet" style="padding:6px 10px;border-radius:6px;border:1px solid var(--border);background:var(--card-hover,#1E2A45);color:var(--dim);font-size:13px;">
        <option>Dark (default)</option>
      </select>
    </div>
    <button type="button" id="acct-save-preferences" class="cta-btn primary" style="display:inline-block;">Save Changes</button>
    <span id="acct-preferences-status" style="margin-left:10px;font-size:13px;color:var(--dim);"></span>
  </div>
</div>

<script>
(function() {
  var tabButtons = document.querySelectorAll('.acct-tab-btn');
  var panels = document.querySelectorAll('.acct-tab-panel');

  function activateTab(tab) {
    tabButtons.forEach(function(btn) {
      var isActive = btn.getAttribute('data-tab') === tab;
      btn.style.color = isActive ? '#0B1020' : 'var(--muted)'; /* was 'var(--white, #fff)' — --white is genuinely white at :root (unchanged), which is invisible against the new warm-light page; this only changes the highlight color, not the tab-switching logic itself */
      btn.style.borderBottomColor = isActive ? 'var(--bright, #3B82F6)' : 'transparent';
    });
    panels.forEach(function(panel) {
      panel.style.display = panel.getAttribute('data-tab-panel') === tab ? 'block' : 'none';
    });
    if (history.replaceState) {
      var url = new URL(window.location.href);
      url.searchParams.set('tab', tab);
      history.replaceState(null, '', url);
    }
  }

  tabButtons.forEach(function(btn) {
    btn.addEventListener('click', function() { activateTab(btn.getAttribute('data-tab')); });
  });

  activateTab('<%= _activeTab %>');

  // Profile save
  document.getElementById('acct-save-profile').addEventListener('click', async function() {
    var statusEl = document.getElementById('acct-profile-status');
    var name = document.getElementById('acct-name-input').value;
    statusEl.textContent = 'Saving...';
    try {
      const res = await fetch('/api/settings/profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: name })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to save');
      statusEl.textContent = 'Saved ✓';
      setTimeout(function() { statusEl.textContent = ''; }, 2500);
    } catch (err) {
      statusEl.textContent = err.message || 'Failed to save';
    }
  });

  // Preferences save
  document.getElementById('acct-save-preferences').addEventListener('click', async function() {
    var statusEl = document.getElementById('acct-preferences-status');
    var emailNotifications = document.getElementById('acct-pref-email').checked;
    var productUpdates = document.getElementById('acct-pref-updates').checked;
    statusEl.textContent = 'Saving...';
    try {
      const res = await fetch('/api/settings/preferences', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email_notifications: emailNotifications, product_updates: productUpdates })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to save');
      statusEl.textContent = 'Saved ✓';
      setTimeout(function() { statusEl.textContent = ''; }, 2500);
    } catch (err) {
      statusEl.textContent = err.message || 'Failed to save';
    }
  });
})();
</script>

<%- include('partials/workspace-shell-bottom') %>
