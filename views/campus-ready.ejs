<%- include('partials/workspace-shell-top', { pageTitle: 'Campus Ready — MedhaIQ', activeNav: 'campus', bodyClass: 'campus-ready-page', shellUser: shellUser, extraStylesheets: ['/css/campus-ready.css'], isCampusLearner: true, isFounder: typeof isFounder !== 'undefined' ? isFounder : false }) %>

<div class="campus-header-row">
  <div>
    <h1>Campus Ready</h1>
    <p class="campus-subtitle"><%= cohortLabel %> Placement Preparation</p>
  </div>
</div>

<div class="campus-root">

  <div class="campus-progress-block">
    <div class="campus-progress-row">
      <span>Overall Preparation Progress</span>
      <strong id="campusOverallPct">0%</strong>
    </div>
    <div class="campus-progress-track">
      <div id="campusOverallBar" class="campus-progress-fill" style="width:0%;"></div>
    </div>
    <div id="campusOverallCount" class="campus-progress-count">Loading your progress…</div>
  </div>

  <div id="campusNextAction" class="campus-next-action" style="display:none;">
    <div class="campus-next-action-eyebrow">Next Best Action</div>
    <div id="campusNextActionTitle" class="campus-next-action-title"></div>
    <div id="campusNextActionDesc" class="campus-next-action-desc"></div>
    <a id="campusNextActionCta" class="campus-cta" href="#"></a>
  </div>

  <div id="campusModuleList" class="campus-module-list"></div>

  <!-- Module detail — a lightweight inline panel, not a separate routed
       page, per the founder's "one screen" direction for V1. -->
  <div id="campusModulePanel" class="campus-module-panel" style="display:none;"></div>

  <!-- Handoff to the existing individual product — a PLAIN navigation
       link only. No pre-filled state, no shared session, no code path
       into routes/interview.js or the Interview Engine. Technically this
       is no different from any other <a href="/interview"> already
       elsewhere in the app (see views/dashboard-history.ejs). Locked
       until all 5 modules are complete; the lock is purely visual here
       since /interview has its own independent auth/entitlement gate. -->
  <div id="campusAiInterview" class="campus-ai-interview is-locked">
    <div class="campus-ai-interview-title">AI Interview</div>
    <div id="campusAiInterviewDesc" class="campus-ai-interview-desc">Complete Campus Ready to unlock.</div>
    <a id="campusAiInterviewCta" class="campus-cta is-disabled" href="#">Launch AI Interview →</a>
  </div>
</div>

<script>
(function () {
  const state = { modules: [], nextAction: null, activeModuleKey: null, activeModuleDbId: null, activeTopics: [] };

  function pct(n) { return Math.round(n) + '%'; }
  function statusLabel(status) {
    if (status === 'complete') return 'Complete';
    if (status === 'in_progress') return 'In Progress';
    return 'Not Started';
  }

  async function loadMe() {
    const res = await fetch('/api/campus/me');
    if (!res.ok) {
      document.getElementById('campusModuleList').innerHTML = '<p>Could not load your Campus Ready progress. Please refresh.</p>';
      return;
    }
    const data = await res.json();
    state.modules = data.modules;
    state.nextAction = data.nextAction;
    renderOverall();
    renderNextAction();
    renderModuleList();
    renderAiInterviewCard();
  }

  function renderOverall() {
    const avg = state.modules.length
      ? Math.round(state.modules.reduce((s, m) => s + Number(m.percent_complete), 0) / state.modules.length)
      : 0;
    const completeCount = state.modules.filter(m => m.status === 'complete').length;
    document.getElementById('campusOverallPct').textContent = pct(avg);
    document.getElementById('campusOverallBar').style.width = avg + '%';
    document.getElementById('campusOverallCount').textContent =
      completeCount + ' of ' + state.modules.length + ' Modules Completed';
  }

  function renderNextAction() {
    const card = document.getElementById('campusNextAction');
    const na = state.nextAction;
    if (!na) { card.style.display = 'none'; return; }
    card.style.display = 'block';
    document.getElementById('campusNextActionTitle').textContent = na.title;
    document.getElementById('campusNextActionDesc').textContent = na.description || '';
    const cta = document.getElementById('campusNextActionCta');
    cta.textContent = na.ctaLabel;
    if (na.type === 'LAUNCH_AI_INTERVIEW') {
      cta.href = na.href || '/interview';
      cta.onclick = null;
    } else {
      cta.href = '#';
      cta.onclick = (e) => { e.preventDefault(); openModule(na.moduleKey, na.topicKey); };
    }
  }

  function renderModuleList() {
    const el = document.getElementById('campusModuleList');
    el.innerHTML = state.modules.map((m, i) => `
      <button class="campus-module-row ${m.locked ? 'is-locked' : ''}" data-key="${m.key}" ${m.locked ? 'aria-disabled="true"' : ''}>
        <span class="campus-module-name"><span class="seq">${String(i + 1).padStart(2, '0')}</span>${m.name}</span>
        <span class="campus-status-pill ${m.locked ? 'locked' : m.status}">${m.locked ? 'Locked' : statusLabel(m.status) + (m.status === 'in_progress' ? ' · ' + pct(m.percent_complete) : '')}</span>
      </button>
    `).join('');
    el.querySelectorAll('.campus-module-row:not(.is-locked)').forEach(btn => {
      btn.addEventListener('click', () => openModule(btn.dataset.key));
    });
  }

  function renderAiInterviewCard() {
    const allComplete = state.modules.length > 0 && state.modules.every(m => m.status === 'complete');
    const wrap = document.getElementById('campusAiInterview');
    const cta = document.getElementById('campusAiInterviewCta');
    if (allComplete) {
      wrap.classList.remove('is-locked'); wrap.classList.add('is-unlocked');
      document.getElementById('campusAiInterviewDesc').textContent = 'Put your preparation into a realistic interview.';
      cta.classList.remove('is-disabled');
      cta.href = '/interview';
    } else {
      wrap.classList.add('is-locked'); wrap.classList.remove('is-unlocked');
      document.getElementById('campusAiInterviewDesc').textContent = 'Complete Campus Ready to unlock.';
      cta.classList.add('is-disabled');
      cta.href = '#';
    }
  }

  async function openModule(key, focusTopicKey) {
    state.activeModuleKey = key;
    const res = await fetch('/api/campus/modules/' + encodeURIComponent(key));
    if (res.status === 403) {
      // Server-side lock caught something the UI shouldn't have allowed
      // through in the first place — refresh state rather than fail silently.
      await loadMe();
      return;
    }
    if (!res.ok) return;
    const data = await res.json();
    state.activeTopics = data.topics;
    state.activeModuleDbId = data.module.id;
    renderModulePanel(data.module, focusTopicKey);

    // "Viewing the required Learn content is sufficient for V1" — mark
    // every visible, not-yet-viewed Learn item as viewed now that its
    // topic is actually rendered on screen, then refresh so the
    // checkmarks/Next Best Action reflect it immediately.
    const toMark = [];
    for (const topic of state.activeTopics) {
      for (const item of topic.items) {
        if (item.type === 'learn_example' && !item.viewed) toMark.push(item.id);
      }
    }
    if (toMark.length > 0) {
      await Promise.all(toMark.map(id => fetch('/api/campus/learn/view', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ contentItemId: id, moduleId: state.activeModuleDbId }),
      })));
      const res2 = await fetch('/api/campus/modules/' + encodeURIComponent(key));
      if (res2.ok) {
        const data2 = await res2.json();
        state.activeTopics = data2.topics;
        renderModulePanel(data2.module, focusTopicKey);
      }
      loadMe();
    }
  }

  function renderModulePanel(mod, focusTopicKey) {
    const panel = document.getElementById('campusModulePanel');
    panel.style.display = 'block';
    const currentTopic = state.activeTopics.find(t => !t.complete);
    panel.innerHTML = `<h3 style="margin-top:0;">${mod.name}</h3>` +
      `<div class="campus-topic-index">` +
      state.activeTopics.map(t => {
        const cls = t.complete ? 'complete' : (currentTopic && t.id === currentTopic.id ? 'current' : 'upcoming');
        const mark = t.complete ? '✓' : (cls === 'current' ? '→' : '○');
        return `<div class="campus-topic-index-row ${cls}"><span class="mark">${mark}</span>${t.name}</div>`;
      }).join('') +
      `</div>` +
      state.activeTopics.map(topic => renderTopic(topic)).join('') +
      `<button id="campusCloseModule" class="campus-close-panel">Close</button>`;
    document.getElementById('campusCloseModule').addEventListener('click', () => { panel.style.display = 'none'; });
    wireTopicInteractions(panel);
    panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (focusTopicKey) {
      const el = panel.querySelector(`[data-topic-key="${focusTopicKey}"]`);
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function renderTopic(topic) {
    const learn = topic.items.find(i => i.type === 'learn_example');
    const practice = topic.items.filter(i => i.type === 'practice_prompt');
    const quiz = topic.items.filter(i => i.type === 'quiz_question');
    const doneMark = (done) => done ? '<span class="done-mark">✓</span>' : '';
    return `
      <div class="campus-topic" data-topic-key="${topic.key}">
        <div class="campus-topic-title">${topic.name}${topic.complete ? '<span class="campus-topic-complete-badge">✓ Complete</span>' : ''}</div>
        ${learn ? `
          <div class="campus-section-label">Learn ${doneMark(topic.learnDone)}</div>
          <div class="campus-learn-block">
            <p><span class="label">${learn.prompt}</span></p>
            <p class="campus-learn-guidance">${learn.guidance || ''}</p>
            ${learn.mistakes ? `<p class="campus-learn-mistakes"><strong>Common mistakes:</strong> ${learn.mistakes}</p>` : ''}
          </div>` : ''}
        ${practice.length ? `<div class="campus-section-label">Practice ${doneMark(topic.practiceDone)}</div>` : ''}
        ${practice.map(p => `
          <div class="campus-practice-item" data-item-id="${p.id}">
            <p class="campus-item-prompt">${p.prompt}</p>
            <textarea class="campus-textarea" rows="3" placeholder="Write your answer here — this is self-reviewed, not graded.">${p.savedText ? p.savedText.replace(/</g, '&lt;') : ''}</textarea>
            <button class="campus-btn-secondary campus-submit-practice">${p.submitted ? 'Update Practice' : 'Save Practice'}</button>
            <span class="campus-saved-flag" style="${p.submitted ? 'display:inline;' : ''}">Saved ✓</span>
          </div>`).join('')}
        ${quiz.length ? `<div class="campus-section-label">Quiz ${doneMark(topic.quizDone)}</div>` : ''}
        ${quiz.map(q => `
          <div class="campus-quiz-item" data-item-id="${q.id}">
            <p class="campus-item-prompt">${q.prompt}</p>
            <div class="campus-quiz-options">
              ${(q.options || []).map(o => `
                <label>
                  <input type="radio" name="quiz-${q.id}" value="${o.id}" ${q.answered && q.selectedOptionId === o.id ? 'checked' : ''}> ${o.text}
                </label>`).join('')}
            </div>
            <button class="campus-btn-secondary campus-submit-quiz">${q.answered ? 'Retake Question' : 'Submit Answer'}</button>
            <p class="campus-quiz-feedback ${q.answered ? (q.isCorrect ? 'correct' : 'incorrect') : ''}" style="${q.answered ? 'display:block;' : ''}">${q.answered ? (q.isCorrect ? '✓ Correct. ' : '✗ Not quite. ') + (q.explanation || '') : ''}</p>
          </div>`).join('')}
      </div>`;
  }

  function wireTopicInteractions(panel) {
    panel.querySelectorAll('.campus-submit-practice').forEach(btn => {
      btn.addEventListener('click', async () => {
        const wrap = btn.closest('.campus-practice-item');
        const text = wrap.querySelector('textarea').value.trim();
        if (!text) return;
        const res = await fetch('/api/campus/practice', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contentItemId: Number(wrap.dataset.itemId), moduleId: state.activeModuleDbId, responseText: text }),
        });
        if (res.ok) {
          wrap.querySelector('.campus-saved-flag').style.display = 'inline';
          btn.textContent = 'Update Practice';
        }
        refreshAfterAction();
      });
    });
    panel.querySelectorAll('.campus-submit-quiz').forEach(btn => {
      btn.addEventListener('click', async () => {
        const wrap = btn.closest('.campus-quiz-item');
        const itemId = Number(wrap.dataset.itemId);
        const selected = wrap.querySelector(`input[name="quiz-${itemId}"]:checked`);
        if (!selected) return;
        const res = await fetch('/api/campus/quiz', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contentItemId: itemId, moduleId: state.activeModuleDbId, selectedOptionId: selected.value }),
        });
        if (!res.ok) return;
        const data = await res.json();
        const fb = wrap.querySelector('.campus-quiz-feedback');
        fb.style.display = 'block';
        fb.classList.remove('correct', 'incorrect');
        fb.classList.add(data.isCorrect ? 'correct' : 'incorrect');
        fb.textContent = (data.isCorrect ? '✓ Correct. ' : '✗ Not quite. ') + (data.explanation || '');
        btn.textContent = 'Retake Question';
        refreshAfterAction();
      });
    });
  }

  // After any Practice/Quiz submission, re-fetch this module's content
  // (so topic/section checkmarks + the topic index update) and refresh
  // the overall dashboard + Next Best Action — all derived from the same
  // persisted state, never guessed client-side.
  async function refreshAfterAction() {
    const res = await fetch('/api/campus/modules/' + encodeURIComponent(state.activeModuleKey));
    if (res.ok) {
      const data = await res.json();
      state.activeTopics = data.topics;
      renderModulePanel(data.module);
    }
    loadMe();
  }

  loadMe();
})();
</script>

<%- include('partials/workspace-shell-bottom') %>
