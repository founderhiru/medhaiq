<%
/* KPI cards are config-driven on purpose (Decision 3 — "pluggable, not
   hardcoded"): adding a future KPI is one array entry here, not a layout
   change. Any key missing from `stats` renders as '—' instead of erroring,
   so new/removed backend fields never break this view. */
const kpiConfig = [
  { key: 'totalUsers', title: 'Total Users', icon: 'users', accent: 'blue' },
  { key: 'activeUsersToday', title: 'Active Users Today', icon: 'person', accent: 'green' },
  { key: 'newBetaSignupsToday', title: 'New Beta Signups', icon: 'sparkle', accent: 'cyan' },
  { key: 'paidSubscribers', title: 'Paid Subscribers', icon: 'check', accent: 'gold' },
  { key: 'interviewsCompleted', title: 'Interviews Completed', icon: 'mic', accent: 'purple' },
  { key: 'reportsGenerated', title: 'Reports Generated', icon: 'document', accent: 'indigo' },
  // Anti-Abuse & Free-Offer Guardrail — lightweight visibility per spec
  // ("do not build a large fraud dashboard"): 3 more entries in this same
  // array, backed by db/founder-stats.js's getOverviewStats() merging in
  // db/free-offer-claims.js's getFreeOfferOverview(). No new fetch, no
  // new refresh logic, no new layout — this array is the whole change.
  { key: 'welcomeOffersGranted', title: 'Welcome Offers Granted', icon: 'sparkle', accent: 'green' },
  { key: 'restrictedClaims', title: 'Restricted Claims', icon: 'check', accent: 'gold' },
  { key: 'suspiciousDevices', title: 'Suspicious Devices', icon: 'person', accent: 'purple' },
];
const _stats = typeof stats !== 'undefined' && stats ? stats : {};
const _activity = typeof activity !== 'undefined' && activity ? activity : [];
const _users = typeof users !== 'undefined' && users ? users : [];
const _packageOptions = Array.isArray(packageOptions) && packageOptions.length ? packageOptions : ['explorer', 'growth', 'leadership'];
// Same emoji/label convention as the Dashboard sidebar pill and Settings
// page (Architecture v1.5) — kept consistent across every surface that
// displays a package, not a new convention invented for this table.
const _packageMeta = {
  explorer:   { label: 'Explorer',   dot: '⚪' },
  growth:     { label: 'Growth',     dot: '🔵' },
  leadership: { label: 'Leadership', dot: '🟣' },
};
function _pkgBadge(packageId) {
  const meta = _packageMeta[packageId] || _packageMeta.explorer;
  return meta.dot + ' ' + meta.label;
}
const _footer = typeof footerInfo !== 'undefined' && footerInfo ? footerInfo : {};
const _betaOverview = typeof betaOverview !== 'undefined' && betaOverview ? betaOverview : {};
const _beta = _betaOverview.beta || {};
const _plans = Array.isArray(_betaOverview.plans) ? _betaOverview.plans : [];
const _feedbackSummary = typeof feedbackSummary !== 'undefined' && feedbackSummary ? feedbackSummary : { total: 0, averageRating: null, newThisWeek: 0 };
const _recentFeedback = typeof recentFeedback !== 'undefined' && recentFeedback ? recentFeedback : [];
const _alerts = typeof alerts !== 'undefined' && alerts ? alerts : {};
// NOTE: dates are deliberately NOT formatted here. This template renders on
// the server (Render runs in UTC), but the person viewing this page is in
// their own local timezone — formatting server-side would silently show
// UTC times that don't match their clock. Instead we emit the raw ISO
// timestamp in a data-iso attribute and format it client-side (see the
// applyTimestamps() function in the <script> below), the same way the
// auto-refresh functions already format times using the browser's local
// timezone. This keeps initial load and refreshed data visually consistent.
const toISO = (d) => d ? new Date(d).toISOString() : '';
%>
<%- include('partials/workspace-shell-top', { pageTitle: 'Founder Dashboard — MedhaIQ', activeNav: 'founder', shellUser: shellUser, extraStylesheets: ['/css/career-workspace.css', '/css/founder-dashboard.css'] }) %>

<div class="fdash-header-row">
  <div>
    <h1>Founder Dashboard</h1>
    <p class="fdash-subtitle">How is MedhaIQ performing today?</p>
  </div>
  <span class="fdash-status-dot" id="fdash-live-dot">Live</span>
</div>

<!-- Section 1 — Executive Snapshot (config-driven, tolerates missing data) -->
<div class="fdash-kpi-grid" id="fdash-kpi-grid">
  <% kpiConfig.forEach(function(k) { %>
  <div class="fdash-kpi-card fdash-accent-<%= k.accent %>" data-kpi="<%= k.key %>">
    <div class="fdash-kpi-value"><%= (_stats[k.key] !== undefined && _stats[k.key] !== null) ? _stats[k.key] : '—' %></div>
    <div class="fdash-kpi-title"><%= k.title %></div>
    <div class="fdash-kpi-icon"><%- include('partials/icon', { name: k.icon, svgSize: 13 }) %></div>
  </div>
  <% }); %>
</div>

<!-- Quick Actions -->
<div class="fdash-section">
  <div class="fdash-section-header">
    <div class="fdash-section-title">Quick Actions</div>
  </div>
  <div class="fdash-quick-actions">
    <div class="fdash-qa-card">
      <div class="fdash-qa-label">Add to Beta Allowlist</div>
      <div class="fdash-qa-sub">Approves an email to sign up. Does not send anything — you'll need to tell them yourself.</div>
      <form id="fdash-invite-form" class="fdash-qa-invite-form">
        <input type="email" id="fdash-invite-email" placeholder="name@company.com" required>
        <button type="submit">Approve</button>
      </form>
      <div class="fdash-qa-invite-msg" id="fdash-invite-msg"></div>
    </div>
    <a href="#fdash-users-section" class="fdash-qa-card fdash-qa-link">
      <div class="fdash-qa-label">Manage Users</div>
      <div class="fdash-qa-sub">Jump to User Management ↓</div>
    </a>
    <a href="/admin/founder-dashboard.html" target="_blank" rel="noopener" class="fdash-qa-card fdash-qa-link">
      <div class="fdash-qa-label">Open Cost Analytics</div>
      <div class="fdash-qa-sub">Existing dashboard, opens separately</div>
    </a>
    <%
    /* Removed from the first screen per executive layout decision — "Coming
       soon" placeholders shouldn't compete for above-the-fold space. Restore
       these three blocks once each is actually built:

       Approve Beta Users  — disabled, title="Available with Alerts (Phase 5)"
       Platform Settings   — disabled, title="Not built yet"
       Send Announcement   — disabled, title="Not built yet"

       Original markup is preserved in version control history (the commit
       right before this UI pass) if needed verbatim. */
    %>
  </div>
</div>

<!-- Section 4 — Beta & Subscription Overview -->
<div class="fdash-section">
  <div class="fdash-section-header">
    <div class="fdash-section-title">Beta & Subscription Overview</div>
  </div>
  <p class="fdash-beta-note">These beta counts come from approvals via Quick Actions → "Add to Beta Allowlist" — separate from the "New Beta Signups" KPI above, which counts the public waitlist form on the marketing site. The two won't always match, and that's expected.</p>
  <div class="fdash-beta-grid">
    <div class="fdash-mini-card">
      <div class="fdash-mini-value"><%= _beta.pending || 0 %></div>
      <div class="fdash-mini-title">Beta Pending</div>
    </div>
    <div class="fdash-mini-card">
      <div class="fdash-mini-value"><%= _beta.accepted || 0 %></div>
      <div class="fdash-mini-title">Beta Accepted</div>
    </div>
    <% if (_plans.length === 0) { %>
    <div class="fdash-mini-card fdash-mini-empty">
      <div class="fdash-mini-value">—</div>
      <div class="fdash-mini-title">No paid subscribers yet</div>
    </div>
    <% } else { %>
    <% _plans.forEach(function(p) { %>
    <div class="fdash-mini-card">
      <div class="fdash-mini-value"><%= p.count %></div>
      <div class="fdash-mini-title"><%= p.plan.charAt(0).toUpperCase() + p.plan.slice(1) %></div>
    </div>
    <% }); %>
    <% } %>
  </div>
</div>

<!-- Section 2 — Recent User Activity (latest 5, scrollable box) -->
<div class="fdash-section">
  <div class="fdash-section-header">
    <div class="fdash-section-title">Recent Activity</div>
  </div>
  <div class="fdash-activity-card fdash-activity-scroll">
    <% if (_activity.length === 0) { %>
      <div class="fdash-activity-empty">No activity logged yet.</div>
    <% } else { %>
      <table class="fdash-activity-table">
        <thead><tr><th>Time</th><th>User</th><th>Activity</th></tr></thead>
        <tbody id="fdash-activity-body">
          <% _activity.forEach(function(a) { %>
          <tr>
            <td class="fdash-ts" data-iso="<%= toISO(a.created_at) %>"></td>
            <td class="fdash-user"><%= a.user_name || a.user_email || 'Unknown' %></td>
            <td><%= a.action || '—' %><%= a.feature ? (' · ' + a.feature) : '' %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
  <p class="fdash-refresh-note">Showing latest 5 · refreshes automatically every 45 seconds.</p>
</div>

<!-- Feedback & Alerts (replaces the originally planned Product Usage
     section per founder decision — beta-stage priority is sentiment +
     operational visibility, not feature-adoption analytics yet) -->
<div class="fdash-section">
  <div class="fdash-section-header">
    <div class="fdash-section-title">Feedback & Alerts</div>
  </div>
  <div class="fdash-fb-grid">
    <!-- Left column: Beta Feedback -->
    <div class="fdash-fb-col">
      <div class="fdash-fb-summary">
        <div class="fdash-fb-summary-item">
          <div class="fdash-fb-summary-value"><%= _feedbackSummary.averageRating !== null ? (_feedbackSummary.averageRating + ' / 5') : '—' %></div>
          <div class="fdash-fb-summary-label">Average Rating</div>
        </div>
        <div class="fdash-fb-summary-item">
          <div class="fdash-fb-summary-value"><%= _feedbackSummary.total || 0 %></div>
          <div class="fdash-fb-summary-label">Total Responses</div>
        </div>
        <div class="fdash-fb-summary-item">
          <div class="fdash-fb-summary-value"><%= _feedbackSummary.newThisWeek || 0 %></div>
          <div class="fdash-fb-summary-label">New This Week</div>
        </div>
      </div>
      <div class="fdash-fb-latest-title">Latest Feedback</div>
      <% if (_recentFeedback.length === 0) { %>
        <div class="fdash-activity-empty">No user feedback received yet.</div>
      <% } else { %>
        <div class="fdash-fb-list">
          <% _recentFeedback.forEach(function(f) { %>
          <div class="fdash-fb-item">
            <div class="fdash-fb-item-top">
              <span class="fdash-fb-stars"><%= f.rating ? '★'.repeat(f.rating) + '☆'.repeat(5 - f.rating) : 'No rating' %></span>
              <span class="fdash-fb-user"><%= f.userName %></span>
            </div>
            <% if (f.comment) { %><div class="fdash-fb-comment"><%= f.comment.slice(0, 100) %></div><% } %>
          </div>
          <% }); %>
        </div>
      <% } %>
      <button type="button" class="fdash-fb-view-all" disabled title="Coming soon">View All Feedback</button>
    </div>

    <!-- Right column: Founder Alerts -->
    <div class="fdash-fb-col">
      <div class="fdash-alerts-list">
        <div class="fdash-alert-item <%= (_alerts.pendingBetaCount || 0) > 0 ? 'fdash-alert-amber' : 'fdash-alert-green' %>">
          <span class="fdash-alert-dot"></span>
          <span class="fdash-alert-text"><%= _alerts.pendingBetaCount || 0 %> Beta Request<%= _alerts.pendingBetaCount === 1 ? '' : 's' %> Pending</span>
          <% if ((_alerts.pendingBetaCount || 0) > 0) { %><a href="#fdash-users-section" class="fdash-alert-action">Review</a><% } %>
        </div>
        <div class="fdash-alert-item <%= (_alerts.newFeedbackCount || 0) > 0 ? 'fdash-alert-amber' : 'fdash-alert-green' %>">
          <span class="fdash-alert-dot"></span>
          <span class="fdash-alert-text"><%= _alerts.newFeedbackCount || 0 %> New Feedback Response<%= _alerts.newFeedbackCount === 1 ? '' : 's' %></span>
        </div>
        <div class="fdash-alert-item fdash-alert-green">
          <span class="fdash-alert-dot"></span>
          <span class="fdash-alert-text">Database Connected</span>
        </div>
        <div class="fdash-alert-item fdash-alert-green">
          <span class="fdash-alert-dot"></span>
          <span class="fdash-alert-text">Founder Dashboard Healthy</span>
        </div>
        <div class="fdash-alert-item <%= _alerts.activityFeedHealthy ? 'fdash-alert-green' : 'fdash-alert-amber' %>">
          <span class="fdash-alert-dot"></span>
          <span class="fdash-alert-text">Activity Feed <%= _alerts.activityFeedHealthy ? 'Running' : 'Quiet (no activity in 24h)' %></span>
        </div>
        <div class="fdash-alert-item fdash-alert-disabled" title="Not built yet — no AI failure logging exists">
          <span class="fdash-alert-dot"></span>
          <span class="fdash-alert-text">AI Errors</span>
        </div>
        <div class="fdash-alert-item fdash-alert-disabled" title="Not built yet — billing isn't live">
          <span class="fdash-alert-dot"></span>
          <span class="fdash-alert-text">Payment Failures</span>
        </div>
        <div class="fdash-alert-item fdash-alert-disabled" title="Not built yet">
          <span class="fdash-alert-dot"></span>
          <span class="fdash-alert-text">Email Delivery Issues</span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Section 3 — User Management -->
<div class="fdash-section" id="fdash-users-section">
  <div class="fdash-section-header">
    <div class="fdash-section-title">User Management</div>
    <div class="fdash-section-header-actions">
      <input type="text" id="fdash-user-search" class="fdash-search-input" placeholder="Search name or email…">
      <button type="button" class="fdash-create-user-btn" id="fdash-create-user-open">+ Create User</button>
    </div>
  </div>
  <div class="fdash-activity-card">
    <table class="fdash-activity-table" id="fdash-users-table">
      <thead>
        <tr><th>Name</th><th>Email</th><th>Package</th><th>Status</th><th>Last Login</th><th>Actions</th></tr>
      </thead>
      <tbody id="fdash-users-body">
        <% if (_users.length === 0) { %>
        <tr><td colspan="6" class="fdash-activity-empty">No users found.</td></tr>
        <% } else { %>
        <% _users.forEach(function(u) { %>
        <tr>
          <td class="fdash-user"><%= u.name || '—' %></td>
          <td><%= u.email %></td>
          <td><span class="shell-package-pill pill-<%= u.package_id %>"><%= _pkgBadge(u.package_id) %></span></td>
          <!-- Status: package_acquisitions (via u.package_id, already
               resolved by db/founder-users.js's listUsers) is the source
               of truth — NOT u.subscription_status, a legacy field the
               real purchase flow (routes/stripe.js) never writes to.
               Explorer's 30-minute welcome grant is not a purchase, so
               'explorer' still reads as Free / Trial; growth/leadership
               read as Paid. -->
          <td><%= u.package_id !== 'explorer' ? 'Paid' : 'Free / Trial' %></td>
          <td class="fdash-ts" data-iso="<%= toISO(u.last_login) %>" data-empty-text="Never logged in"></td>
          <td class="fdash-actions-cell">
            <button type="button" class="fdash-action-btn fdash-manage-package-btn"
              data-user-id="<%= u.id %>"
              data-user-name="<%= (u.name || u.email).replace(/"/g, '&quot;') %>"
              data-current-package="<%= u.package_id %>">Manage Package</button>
            <span class="fdash-action-btn fdash-action-disabled" title="Coming soon">Suspend</span>
          </td>
        </tr>
        <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Manage Package modal — lightweight, Founder-only, MVP per spec.
     Persists through package_acquisitions only; never touches
     users.subscription_plan; never introduces a subscription_tier column. -->
<div id="fdash-package-modal" class="fdash-modal-overlay" style="display:none;">
  <div class="fdash-modal">
    <div class="fdash-modal-header">
      <div class="fdash-modal-title">User Package Management</div>
      <button type="button" class="fdash-modal-close" id="fdash-modal-close" aria-label="Close">&times;</button>
    </div>
    <div class="fdash-modal-sub">Assign or change a user's active package for testing, beta access, and customer support.</div>
    <div class="fdash-modal-field">
      <label class="fdash-modal-label">User</label>
      <div class="fdash-modal-user" id="fdash-modal-user-name">—</div>
    </div>
    <div class="fdash-modal-field">
      <label class="fdash-modal-label" for="fdash-package-select">Package</label>
      <select id="fdash-package-select" class="fdash-modal-select">
        <% _packageOptions.forEach(function(pkgId) { %>
        <option value="<%= pkgId %>"><%= _pkgBadge(pkgId) %></option>
        <% }); %>
      </select>
    </div>
    <div class="fdash-modal-msg" id="fdash-modal-msg"></div>
    <div class="fdash-modal-actions">
      <button type="button" class="fdash-action-btn" id="fdash-modal-cancel">Cancel</button>
      <button type="button" class="fdash-action-btn fdash-modal-save" id="fdash-modal-save">Save Package</button>
    </div>
  </div>
</div>

<!-- Create User modal — Founder-only. Supports both real and demo accounts
     through one form: Demo Account / Skip Email Verification / Seed Sample
     Data are independent toggles, not a "different mode." Reuses this
     page's existing modal pattern, RBAC (requireFounder), package
     acquisition flow, and profile bootstrap — see routes/founder.js
     POST /api/founder/users and db/founder-users.js::createUserAsFounder. -->
<div id="fdash-create-user-modal" class="fdash-modal-overlay" style="display:none;">
  <div class="fdash-modal">
    <div class="fdash-modal-header">
      <div class="fdash-modal-title">Create User</div>
      <button type="button" class="fdash-modal-close" id="fdash-create-user-close" aria-label="Close">&times;</button>
    </div>
    <div class="fdash-modal-sub">Creates a real, immediately-usable account — no invitation or email step required.</div>

    <div class="fdash-modal-field">
      <label class="fdash-modal-label" for="fdash-create-user-name">Name</label>
      <input type="text" id="fdash-create-user-name" class="fdash-modal-input" placeholder="Full name">
    </div>
    <div class="fdash-modal-field">
      <label class="fdash-modal-label" for="fdash-create-user-email">Email</label>
      <input type="email" id="fdash-create-user-email" class="fdash-modal-input" placeholder="name@company.com">
    </div>
    <div class="fdash-modal-field">
      <label class="fdash-modal-label" for="fdash-create-user-package">Package</label>
      <select id="fdash-create-user-package" class="fdash-modal-select">
        <% _packageOptions.forEach(function(pkgId) { %>
        <option value="<%= pkgId %>" <%= pkgId === 'explorer' ? 'selected' : '' %>><%= _pkgBadge(pkgId) %></option>
        <% }); %>
      </select>
    </div>
    <div class="fdash-modal-field">
      <label class="fdash-modal-label" for="fdash-create-user-minutes">AI Minutes</label>
      <input type="number" min="0" step="1" id="fdash-create-user-minutes" class="fdash-modal-input">
    </div>

    <div class="fdash-modal-checkbox-row">
      <label><input type="checkbox" id="fdash-create-user-demo" checked> Demo Account</label>
    </div>
    <div class="fdash-modal-checkbox-row">
      <label><input type="checkbox" id="fdash-create-user-skip-verify" checked> Skip Email Verification</label>
    </div>
    <div class="fdash-modal-checkbox-row">
      <label><input type="checkbox" id="fdash-create-user-seed" checked> Seed Sample Data</label>
    </div>

    <div class="fdash-modal-msg" id="fdash-create-user-msg"></div>
    <div class="fdash-modal-actions">
      <button type="button" class="fdash-action-btn" id="fdash-create-user-cancel">Cancel</button>
      <button type="button" class="fdash-action-btn fdash-modal-save" id="fdash-create-user-save">Create User</button>
    </div>
  </div>
</div>

<!-- Footer -->
<div class="fdash-footer">
  <div class="fdash-footer-title">MedhaIQ Founder Dashboard</div>
  <div class="fdash-footer-row">
    <span>Version <%= _footer.version || '1.0 Beta' %></span>
    <span>Last refreshed: <span id="fdash-last-refreshed" class="fdash-ts" data-iso="<%= toISO(_footer.lastRefreshed) %>" data-empty-text="—"></span></span>
    <span>Database: <span class="fdash-footer-ok">Connected</span></span>
    <span>Environment: <%= _footer.environment || 'Production' %></span>
  </div>
</div>

<script>
  (function () {
    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str == null ? '' : String(str);
      return div.innerHTML;
    }
    function fmtDT(iso) {
      if (!iso) return null;
      return new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    }
    // Same emoji/label convention as the Dashboard sidebar pill and
    // Settings page — kept consistent across every surface that displays
    // a package. Mirrors the EJS-side _pkgBadge() helper above; duplicated
    // because EJS and this client-side script are two different languages,
    // same pattern already used elsewhere in this file (e.g. the plan/
    // status logic was already duplicated between server-render and this
    // script before this change).
    const PKG_META = {
      explorer:   { label: 'Explorer',   dot: '⚪' },
      growth:     { label: 'Growth',     dot: '🔵' },
      leadership: { label: 'Leadership', dot: '🟣' },
    };
    function pkgBadge(packageId) {
      const meta = PKG_META[packageId] || PKG_META.explorer;
      return meta.dot + ' ' + meta.label;
    }
    // Same client-side duplication precedent as PKG_META above — mirrors
    // config/product-packages.js entitlements.includedMinutes. Only used
    // as the Create User modal's AI Minutes starting suggestion; the
    // founder can always override it before submitting.
    const PKG_MINUTES = { explorer: 30, growth: 120, leadership: 300 };

    // Formats every server-rendered timestamp using the browser's own local
    // timezone (the server renders in UTC, which would otherwise silently
    // mismatch the viewer's clock — see the comment at the top of this file).
    // Run once on initial load; the refresh functions below already format
    // their own injected rows the same way, so nothing further is needed
    // after this for consistency between initial load and refreshes.
    function applyTimestamps() {
      document.querySelectorAll('.fdash-ts').forEach(function (el) {
        const iso = el.getAttribute('data-iso');
        el.textContent = iso ? fmtDT(iso) : (el.getAttribute('data-empty-text') || '—');
      });
    }
    applyTimestamps();

    async function refreshOverview() {
      try {
        const res = await fetch('/api/founder/overview');
        if (!res.ok) return;
        const stats = await res.json();
        Object.keys(stats).forEach(function (key) {
          const card = document.querySelector('.fdash-kpi-card[data-kpi="' + key + '"] .fdash-kpi-value');
          if (card) card.textContent = stats[key];
        });
        const lastRefreshed = document.getElementById('fdash-last-refreshed');
        if (lastRefreshed) lastRefreshed.textContent = fmtDT(new Date().toISOString());
      } catch (e) { /* silent — next tick will retry */ }
    }

    async function refreshActivity() {
      try {
        const res = await fetch('/api/founder/activity');
        if (!res.ok) return;
        const data = await res.json();
        const tbody = document.getElementById('fdash-activity-body');
        if (!tbody || !data.activity) return;
        tbody.innerHTML = data.activity.map(function (a) {
          const time = escapeHtml(fmtDT(a.created_at));
          const user = escapeHtml(a.user_name || a.user_email || 'Unknown');
          const act = escapeHtml((a.action || '—') + (a.feature ? (' · ' + a.feature) : ''));
          return '<tr><td>' + time + '</td><td class="fdash-user">' + user + '</td><td>' + act + '</td></tr>';
        }).join('');
      } catch (e) { /* silent — next tick will retry */ }
    }

    async function searchUsers(term) {
      try {
        const res = await fetch('/api/founder/users?search=' + encodeURIComponent(term));
        if (!res.ok) return;
        const data = await res.json();
        const tbody = document.getElementById('fdash-users-body');
        if (!tbody || !data.users) return;
        if (data.users.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="fdash-activity-empty">No users found.</td></tr>';
          return;
        }
        tbody.innerHTML = data.users.map(function (u) {
          const name = escapeHtml(u.name || '—');
          const email = escapeHtml(u.email);
          const packageId = u.package_id || 'explorer';
          const packageBadge = escapeHtml(pkgBadge(packageId));
          // Same rule as the server-rendered row: package_acquisitions
          // (via packageId, already resolved server-side) is the source
          // of truth, not the legacy subscription_status field. Explorer
          // stays Free / Trial; growth/leadership read as Paid.
          const status = packageId !== 'explorer' ? 'Paid' : 'Free / Trial';
          const lastLogin = escapeHtml(fmtDT(u.last_login) || 'Never logged in');
          const userNameAttr = escapeHtml(u.name || u.email);
          return '<tr><td class="fdash-user">' + name + '</td><td>' + email + '</td>' +
            '<td><span class="shell-package-pill pill-' + packageId + '">' + packageBadge + '</span></td>' +
            '<td>' + status + '</td><td>' + lastLogin + '</td>' +
            '<td class="fdash-actions-cell"><button type="button" class="fdash-action-btn fdash-manage-package-btn" data-user-id="' + u.id + '" data-user-name="' + userNameAttr + '" data-current-package="' + packageId + '">Manage Package</button> <span class="fdash-action-btn fdash-action-disabled" title="Coming soon">Suspend</span></td></tr>';
        }).join('');
      } catch (e) { /* silent */ }
    }

    let searchDebounce;
    const searchInput = document.getElementById('fdash-user-search');
    if (searchInput) {
      searchInput.addEventListener('input', function () {
        clearTimeout(searchDebounce);
        const term = this.value;
        searchDebounce = setTimeout(function () { searchUsers(term); }, 300);
      });
    }

    const inviteForm = document.getElementById('fdash-invite-form');
    if (inviteForm) {
      inviteForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        const emailInput = document.getElementById('fdash-invite-email');
        const msg = document.getElementById('fdash-invite-msg');
        msg.textContent = 'Approving…';
        msg.className = 'fdash-qa-invite-msg';
        try {
          const res = await fetch('/api/founder/invitations', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: emailInput.value }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            msg.textContent = emailInput.value + ' can now sign up. Remember to tell them yourself — no email was sent automatically.';
            msg.className = 'fdash-qa-invite-msg success';
            emailInput.value = '';
          } else {
            msg.textContent = data.error || 'Failed to approve email';
            msg.className = 'fdash-qa-invite-msg error';
          }
        } catch (err) {
          msg.textContent = 'Failed to approve email';
          msg.className = 'fdash-qa-invite-msg error';
        }
      });
    }

    // ── Manage Package modal ──────────────────────────────────────────────
    // Event delegation on the table body (not the buttons directly) since
    // searchUsers() replaces tbody.innerHTML wholesale on every search —
    // a direct listener on a button would be destroyed along with it.
    const packageModal = document.getElementById('fdash-package-modal');
    const packageSelect = document.getElementById('fdash-package-select');
    const packageModalUserName = document.getElementById('fdash-modal-user-name');
    const packageModalMsg = document.getElementById('fdash-modal-msg');
    let packageModalUserId = null;
    let packageModalPreviousPackage = null;

    function openPackageModal(userId, userName, currentPackage) {
      packageModalUserId = userId;
      packageModalPreviousPackage = currentPackage;
      packageModalUserName.textContent = userName;
      packageSelect.value = currentPackage;
      packageModalMsg.textContent = '';
      packageModalMsg.className = 'fdash-modal-msg';
      packageModal.style.display = 'flex';
    }
    function closePackageModal() {
      packageModal.style.display = 'none';
      packageModalUserId = null;
    }

    const usersBody = document.getElementById('fdash-users-body');
    if (usersBody) {
      usersBody.addEventListener('click', function (e) {
        const btn = e.target.closest('.fdash-manage-package-btn');
        if (!btn) return;
        openPackageModal(btn.dataset.userId, btn.dataset.userName, btn.dataset.currentPackage);
      });
    }

    const modalCloseBtn = document.getElementById('fdash-modal-close');
    const modalCancelBtn = document.getElementById('fdash-modal-cancel');
    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closePackageModal);
    if (modalCancelBtn) modalCancelBtn.addEventListener('click', closePackageModal);
    if (packageModal) {
      packageModal.addEventListener('click', function (e) {
        if (e.target === packageModal) closePackageModal(); // click on the dimmed backdrop
      });
    }

    const modalSaveBtn = document.getElementById('fdash-modal-save');
    if (modalSaveBtn) {
      modalSaveBtn.addEventListener('click', async function () {
        const newPackage = packageSelect.value;
        if (!packageModalUserId) return;
        modalSaveBtn.disabled = true;
        packageModalMsg.textContent = 'Saving…';
        packageModalMsg.className = 'fdash-modal-msg';
        try {
          const res = await fetch('/api/founder/users/' + packageModalUserId + '/package', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ packageId: newPackage }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            const oldLabel = pkgBadge(packageModalPreviousPackage).replace(/^\S+\s/, '');
            const newLabel = pkgBadge(newPackage).replace(/^\S+\s/, '');
            packageModalMsg.textContent = '✅ Package updated successfully — ' + oldLabel + ' → ' + newLabel;
            packageModalMsg.className = 'fdash-modal-msg success';
            // Refresh the table — same function already used for search,
            // reused here rather than writing a second table-render path.
            await searchUsers(searchInput ? searchInput.value : '');
            setTimeout(closePackageModal, 1400);
          } else {
            packageModalMsg.textContent = data.error || 'Failed to update package';
            packageModalMsg.className = 'fdash-modal-msg error';
          }
        } catch (err) {
          packageModalMsg.textContent = 'Failed to update package';
          packageModalMsg.className = 'fdash-modal-msg error';
        } finally {
          modalSaveBtn.disabled = false;
        }
      });
    }

    // ── Create User modal ──────────────────────────────────────────────
    const createUserModal = document.getElementById('fdash-create-user-modal');
    const createUserOpenBtn = document.getElementById('fdash-create-user-open');
    const createUserNameInput = document.getElementById('fdash-create-user-name');
    const createUserEmailInput = document.getElementById('fdash-create-user-email');
    const createUserPackageSelect = document.getElementById('fdash-create-user-package');
    const createUserMinutesInput = document.getElementById('fdash-create-user-minutes');
    const createUserDemoCheckbox = document.getElementById('fdash-create-user-demo');
    const createUserSkipVerifyCheckbox = document.getElementById('fdash-create-user-skip-verify');
    const createUserSeedCheckbox = document.getElementById('fdash-create-user-seed');
    const createUserMsg = document.getElementById('fdash-create-user-msg');
    const createUserSaveBtn = document.getElementById('fdash-create-user-save');

    // AI Minutes auto-fills from the selected package, but only until the
    // founder manually edits it — a manual value is never silently
    // overwritten by a later package change.
    let minutesTouchedByUser = false;
    if (createUserMinutesInput) {
      createUserMinutesInput.addEventListener('input', function () { minutesTouchedByUser = true; });
    }
    function applyPackageMinutesDefault() {
      if (minutesTouchedByUser || !createUserPackageSelect || !createUserMinutesInput) return;
      const pkg = createUserPackageSelect.value;
      createUserMinutesInput.value = PKG_MINUTES[pkg] != null ? PKG_MINUTES[pkg] : '';
    }
    if (createUserPackageSelect) {
      createUserPackageSelect.addEventListener('change', applyPackageMinutesDefault);
    }

    function openCreateUserModal() {
      if (!createUserModal) return;
      createUserNameInput.value = '';
      createUserEmailInput.value = '';
      createUserPackageSelect.value = 'explorer';
      minutesTouchedByUser = false;
      applyPackageMinutesDefault();
      createUserDemoCheckbox.checked = true;
      createUserSkipVerifyCheckbox.checked = true;
      createUserSeedCheckbox.checked = true;
      createUserMsg.textContent = '';
      createUserMsg.className = 'fdash-modal-msg';
      createUserModal.style.display = 'flex';
    }
    function closeCreateUserModal() {
      if (createUserModal) createUserModal.style.display = 'none';
    }
    if (createUserOpenBtn) createUserOpenBtn.addEventListener('click', openCreateUserModal);

    const createUserCloseBtn = document.getElementById('fdash-create-user-close');
    const createUserCancelBtn = document.getElementById('fdash-create-user-cancel');
    if (createUserCloseBtn) createUserCloseBtn.addEventListener('click', closeCreateUserModal);
    if (createUserCancelBtn) createUserCancelBtn.addEventListener('click', closeCreateUserModal);
    if (createUserModal) {
      createUserModal.addEventListener('click', function (e) {
        if (e.target === createUserModal) closeCreateUserModal();
      });
    }

    if (createUserSaveBtn) {
      createUserSaveBtn.addEventListener('click', async function () {
        const seedWasRequested = createUserSeedCheckbox.checked;
        const payload = {
          fullName: createUserNameInput.value,
          email: createUserEmailInput.value,
          packageId: createUserPackageSelect.value,
          aiMinutes: createUserMinutesInput.value,
          isDemo: createUserDemoCheckbox.checked,
          skipEmailVerification: createUserSkipVerifyCheckbox.checked,
          seedSampleData: seedWasRequested,
        };
        if (!payload.fullName.trim() || !payload.email.trim()) {
          createUserMsg.textContent = 'Name and email are required';
          createUserMsg.className = 'fdash-modal-msg error';
          return;
        }
        createUserSaveBtn.disabled = true;
        createUserMsg.textContent = 'Creating…';
        createUserMsg.className = 'fdash-modal-msg';
        try {
          const res = await fetch('/api/founder/users', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            // Same refresh-in-place pattern as Manage Package — this page
            // doesn't do hard navigations for table updates anywhere else.
            await searchUsers(searchInput ? searchInput.value : '');
            if (seedWasRequested && !data.seeded) {
              createUserMsg.textContent = '✅ User created — sample data seeding did not complete; add a resume for this user separately.';
            } else if (!seedWasRequested) {
              createUserMsg.textContent = '✅ User created — no sample data added. Upload a resume for this user once they can sign in.';
            } else {
              createUserMsg.textContent = '✅ User created with sample resume data.';
            }
            createUserMsg.className = 'fdash-modal-msg success';
            setTimeout(closeCreateUserModal, 1800);
          } else {
            createUserMsg.textContent = data.error || 'Failed to create user';
            createUserMsg.className = 'fdash-modal-msg error';
          }
        } catch (err) {
          createUserMsg.textContent = 'Failed to create user';
          createUserMsg.className = 'fdash-modal-msg error';
        } finally {
          createUserSaveBtn.disabled = false;
        }
      });
    }

    setInterval(function () { refreshOverview(); refreshActivity(); }, 45000);
  })();
</script>

<%- include('partials/workspace-shell-bottom') %>
