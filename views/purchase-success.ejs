<%
/* views/purchase-success.ejs — Generic post-payment success page.
   Works for ANY package a Checkout Session's server-verified metadata
   names (Growth today; Leadership automatically once that checkout is
   separately approved and built — no changes needed here for that).

   This page is presentation only. It never grants anything itself — the
   Stripe webhook (routes/stripe.js) is the sole source of truth for the
   actual package_acquisitions/credit_ledger grant, and already ran (or
   will run) completely independently of whether this page is ever
   loaded (see the "browser closed" scenario in the approved design).

   Expected locals:
   - shellUser, capabilities: same as every other authenticated page
   - context: the object returned by routes/stripe.js's
     resolveCheckoutSuccessContext() — { status, packageName, minutes }
     for 'paid'; lighter shapes for 'processing' / 'invalid' / 'unavailable'
*/
%>
<%- include('partials/workspace-shell-top', { pageTitle: 'Payment Successful — MedhaIQ', activeNav: 'dashboard', shellUser: shellUser, extraStylesheets: ['/css/career-workspace.css'] }) %>

<div style="max-width:560px; margin:48px auto;">
  <% if (context.status === 'paid') { %>
    <div class="panel" style="align-items:center; text-align:center; padding:40px 32px; min-height:0;">
      <div style="width:56px; height:56px; border-radius:50%; background:rgba(16,185,129,0.15); display:flex; align-items:center; justify-content:center; margin-bottom:20px;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h1 style="font-size:22px; margin-bottom:6px;">Payment successful</h1>
      <p class="subtitle" style="margin-bottom:4px;"><strong><%= context.packageName %></strong> is now active.</p>
      <p class="subtitle" style="margin-bottom:24px;"><%= context.minutes %> AI Minutes added to your account.</p>
      <a href="/dashboard" class="cta-btn primary" style="display:inline-block;">Go to Workspace</a>
    </div>
  <% } else if (context.status === 'processing') { %>
    <div class="panel" style="align-items:center; text-align:center; padding:40px 32px; min-height:0;">
      <h1 style="font-size:22px; margin-bottom:6px;">Confirming your payment&hellip;</h1>
      <p class="subtitle" style="margin-bottom:24px;">
        <% if (context.packageName) { %>Your <strong><%= context.packageName %></strong> purchase is<% } else { %>Your purchase is<% } %>
        still being confirmed by Stripe. This is usually instant — your AI Minutes will appear on your dashboard as soon as it's done.
      </p>
      <a href="/dashboard" class="cta-btn primary" style="display:inline-block;">Go to Workspace</a>
    </div>
  <% } else { %>
    <div class="panel" style="align-items:center; text-align:center; padding:40px 32px; min-height:0;">
      <h1 style="font-size:22px; margin-bottom:6px;">We couldn't confirm that payment link</h1>
      <p class="subtitle" style="margin-bottom:24px;">It may have expired, already been used, or belongs to a different account. If you completed a payment, your AI Minutes will still be added automatically — check your dashboard.</p>
      <a href="/dashboard" class="cta-btn primary" style="display:inline-block;">Go to Workspace</a>
    </div>
  <% } %>
</div>

<%- include('partials/workspace-shell-bottom') %>
