<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Experience | MedhaIQ.ai</title>
  <meta name="description" content="What you'll unlock in your first evaluation — 3x AI mock interviews, communication scoring, and a full performance scorecard.">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
    <link rel="stylesheet" href="/css/value-footer.css">
  <style>
    /* Hide the entire Final CTA banner (partials/cta-banner.ejs's
       <section class="mh-cta-banner">) on this page only — headline,
       subheadline, button, and blue background area all removed, not
       just the button. Scoped via .experience-page on <body> so no
       other page (including Homepage, which must keep this banner) is
       affected. cta-banner.ejs itself is not modified. */
        .experience-page .mh-cta-banner { display: none; }
        
    .experience-page .mh-experience { background: #F7F6F2; }
    .experience-page .mh-experience-pre { color: var(--blue-bright); }
    .experience-page .mh-experience-heading { color: #0B1020; font-size: var(--h2-size); }
    .experience-page .mh-experience-sub { color: #5F6B82; }
  </style>
</head>
<body class="experience-page">
  <%- include('partials/header') %>

  <!-- No separate page hero here on purpose: partials/experience.ejs already
       carries its own eyebrow ("THE EXPERIENCE"), heading, and subtitle —
       adding another hero above it would duplicate that title verbatim.
       Reused exactly as it rendered on the homepage. -->
  <%- include('partials/experience') %>

  <%- include('partials/cta-banner') %>
  <%- include('partials/footer') %>
  <%- include('partials/contact-modal') %>

  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (!reveals.length) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          var items = entry.target.querySelectorAll('.reveal-item');
          items.forEach(function(item, i) {
            setTimeout(function() { item.classList.add('visible'); }, i * 100);
          });
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(function(el) { observer.observe(el); });
  })();
  </script>
</body>
</html>