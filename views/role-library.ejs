<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Role Library | MedhaIQ.ai</title>
  <meta name="description" content="Understand what hiring managers evaluate for the role you want — competencies, interview flow, representative questions, and preparation guidance.">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="canonical" href="https://www.medhaiq.ai/explore/role-library">
  <meta property="og:title" content="Role Library | MedhaIQ.ai">
  <meta property="og:description" content="Understand what hiring managers evaluate for the role you want.">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
  <link rel="stylesheet" href="/css/explore.css">
  <link rel="stylesheet" href="/css/company-library.css">
  <link rel="stylesheet" href="/css/role-library.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- Hero — dark -->
  <section class="mh-why-hero reveal">
    <div class="mh-why-hero-inner mh-section-center">
      <div class="mh-eyebrow">Role Library</div>
      <h1 class="mh-section-title mh-colib-hero-title">Master the interviews for the role you want.</h1>
      <p class="mh-section-sub">Understand what hiring managers evaluate, the competencies that matter most, and how to prepare with confidence before your interview.</p>
      <div class="mh-explore-cta-actions" style="margin-top: 28px;">
        <a href="#mh-role-browse-title" class="mh-btn-primary">Browse Roles</a>
      </div>
    </div>
  </section>

  <!--
    NOTE ON PERSONALIZATION: the spec calls for a "Recommended for You —
    94% Match" strip when MedhaIQ knows the user's profile. That match
    score would need a real algorithm against resume/interview history,
    which doesn't exist yet — so per the spec's own fallback rule ("if no
    profile exists, do not show this section"), nothing renders here.
  -->

  <!-- ============ LIGHT EDITORIAL READING SURFACE ============ -->
  <div class="mh-editorial-surface">
    <div class="mh-editorial-inner">

      <nav aria-label="Breadcrumb" style="padding-bottom: 32px; font-size: 13px;">
        <a href="/explore" style="color: var(--ed-muted);">Explore MedhaIQ</a>
        <span aria-hidden="true" style="color: var(--ed-faint);">/</span>
        <span aria-current="page" style="color: var(--ed-text); font-weight: 600;">Role Library</span>
      </nav>

      <!-- Browse by category -->
      <div class="mh-editorial-card" aria-labelledby="mh-role-browse-title">
        <div class="mh-section-center">
          <div class="mh-eyebrow">Browse By Category</div>
          <h2 id="mh-role-browse-title" class="mh-editorial-card-title">Find your role</h2>
        </div>
        <% roleCategories.forEach(function(cat) { %>
          <div class="mh-role-category-group">
            <div class="mh-role-category-heading"><%= cat.name %></div>
            <div class="mh-explore-grid" role="list">
              <% cat.roles.forEach(function(role) { %>
                <%- include('partials/role-browse-card', { role: role }) %>
              <% }); %>
            </div>
          </div>
        <% }); %>
      </div>

    </div>
  </div>

  <!-- CTA — restored per the unified structure (dark, #0E1322) -->
  <section class="mh-colib-dark-cta reveal">
    <div class="mh-explore-cta-inner">
      <h2 class="mh-section-title">Ready to practice?</h2>
      <p class="mh-explore-cta-sub">Start a personalized AI interview built around the role you're targeting.</p>
      <div class="mh-explore-cta-actions">
        <a href="/login" class="mh-btn-primary">Get Started</a>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <!-- Coming-soon modal -->
  <div class="mh-modal-overlay" id="mh-role-comingsoon-modal" style="display:none">
    <div class="mh-modal" role="dialog" aria-modal="true" aria-labelledby="mh-role-comingsoon-title">
      <button class="mh-modal-close" id="mh-role-comingsoon-close" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="mh-modal-title" id="mh-role-comingsoon-title">This one's being prepared</div>
      <div class="mh-modal-sub">This role guide is currently being prepared. More roles are being added every week.</div>
    </div>
  </div>

  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (reveals.length) {
      var observer = new IntersectionObserver(function(entries) { entries.forEach(function(entry) { if (entry.isIntersecting) entry.target.classList.add('visible'); }); }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(function(el) { observer.observe(el); });
    }
  })();
  (function() {
    var modal = document.getElementById('mh-role-comingsoon-modal');
    var closeBtn = document.getElementById('mh-role-comingsoon-close');
    if (!modal) return;
    document.querySelectorAll('.mh-role-comingsoon-trigger').forEach(function(trigger) {
      trigger.addEventListener('click', function(e) { e.preventDefault(); modal.style.display = 'flex'; });
    });
    if (closeBtn) closeBtn.addEventListener('click', function() { modal.style.display = 'none'; });
    modal.addEventListener('click', function(e) { if (e.target === modal) modal.style.display = 'none'; });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') modal.style.display = 'none'; });
  })();
  </script>
</body>
</html>
