<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Role Library | MedhaIQ.ai</title>
  <meta name="description" content="Understand what hiring managers evaluate for the role you want — competencies, interview flow, representative questions, and preparation guidance.">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="canonical" href="https://www.medhaiq.ai/explore/role-library">
  <meta property="og:title" content="Role Library | MedhaIQ.ai">
  <meta property="og:description" content="Understand what hiring managers evaluate for the role you want.">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
  <link rel="stylesheet" href="/css/explore.css">
  <link rel="stylesheet" href="/css/company-library.css">
  <link rel="stylesheet" href="/css/role-library.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- Hero — dark. Same base container (.mh-why-hero) as Company Library
       and every other dark hero on the site, so spacing/proportions match
       automatically. Title uses Explore's own .mh-explore-hero-h1 scale
       (clamp(28px,3.6vw,40px)) rather than Company Library's larger
       .mh-colib-hero-title — this was the actual typography mismatch the
       spec called out. No orbit illustration: that stays unique to the
       Explore landing page per instruction; role cards are the focal
       point here instead. -->
  <section class="mh-why-hero reveal">
    <div class="mh-why-hero-inner mh-section-center">
      <div class="mh-eyebrow">Explore</div>
      <h1 class="mh-section-title mh-explore-hero-h1">Role Intelligence</h1>
      <p class="mh-section-sub">Understand what top companies expect from each role and prepare with confidence.</p>

      <div class="mh-explore-search-wrap">
        <svg class="mh-explore-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input id="mh-role-search" class="mh-form-input" type="search" placeholder="Search roles..." aria-label="Search roles">
      </div>
      <div id="mh-role-search-meta" class="mh-explore-search-meta" aria-live="polite"></div>
    </div>
  </section>

  <!-- ============ LIGHT EDITORIAL READING SURFACE ============ -->
  <div class="mh-editorial-surface">
    <div class="mh-editorial-inner">

      <nav aria-label="Breadcrumb" style="padding-bottom: 32px; font-size: 13px;">
        <a href="/explore" style="color: var(--ed-muted);">Explore MedhaIQ</a>
        <span aria-hidden="true" style="color: var(--ed-faint);">/</span>
        <span aria-current="page" style="color: var(--ed-text); font-weight: 600;">Role Library</span>
      </nav>

      <!-- Flat, curated grid — the 6 launch-ready roles only. No
           categories, no coming-soon cards: everything shown is real. -->
      <div class="mh-editorial-card" aria-labelledby="mh-role-browse-title">
        <div class="mh-section-center">
          <div class="mh-eyebrow">Featured Roles</div>
          <h2 id="mh-role-browse-title" class="mh-editorial-card-title">Find your role</h2>
        </div>
        <div class="mh-explore-grid" role="list" id="mh-role-grid">
          <% roles.forEach(function(role) { %>
            <%- include('partials/role-browse-card', { role: role }) %>
          <% }); %>
        </div>
        <p id="mh-role-search-empty" class="mh-section-sub" style="display:none; text-align:center; margin-top: 24px;">No roles match your search.</p>
      </div>

    </div>
  </div>

  <!-- CTA — restored per the unified structure (dark, #0E1322) -->
  <section class="mh-colib-dark-cta reveal">
    <div class="mh-explore-cta-inner">
      <h2 class="mh-section-title">Ready to practice?</h2>
      <p class="mh-explore-cta-sub">Start a personalized AI interview built around the role you're targeting.</p>
      <div class="mh-explore-cta-actions">
        <a href="/login" class="mh-btn-primary">Get Started</a>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (reveals.length) {
      var observer = new IntersectionObserver(function(entries) { entries.forEach(function(entry) { if (entry.isIntersecting) entry.target.classList.add('visible'); }); }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(function(el) { observer.observe(el); });
    }
  })();
  (function() {
    // Live search over the 6 role cards — matches on role name or
    // competency tags. Only 6 items, so a simple client-side filter is
    // plenty; no server round-trip needed.
    var input = document.getElementById('mh-role-search');
    var meta = document.getElementById('mh-role-search-meta');
    var empty = document.getElementById('mh-role-search-empty');
    if (!input) return;
    var cards = Array.prototype.slice.call(document.querySelectorAll('[data-role-card]'));
    input.addEventListener('input', function() {
      var q = input.value.trim().toLowerCase();
      var visible = 0;
      cards.forEach(function(card) {
        var match = !q || card.getAttribute('data-role-name').indexOf(q) !== -1 || card.getAttribute('data-role-tags').indexOf(q) !== -1;
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      meta.textContent = q ? (visible + (visible === 1 ? ' role found' : ' roles found')) : '';
      empty.style.display = (q && visible === 0) ? 'block' : 'none';
    });
  })();
  </script>
</body>
</html>