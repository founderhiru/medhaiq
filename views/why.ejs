<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Why MedhaIQ | MedhaIQ.ai</title>
  <meta name="description" content="Why MedhaIQ — the engineering, research, and philosophy behind the platform.">
  <meta name="robots" content="index, follow">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- Minimal page intro — the only new copy on this page. Everything below
       it reuses existing partials verbatim: no new product claims, no new
       features, nothing invented. -->
  <section style="padding: 140px 40px 60px; max-width: var(--max-w); margin: 0 auto; text-align: center;">
    <div class="mh-eyebrow">Why MedhaIQ</div>
    <h1 style="font-family: var(--font-display); font-weight: 800; font-size: 36px; color: var(--white); margin: 12px 0;">
      The engineering and research behind the platform
    </h1>
    <p style="color: var(--text-muted); font-size: 15px; max-width: 600px; margin: 0 auto;">
      A closer look at how MedhaIQ is built, and the people and research behind it.
    </p>
  </section>

  <%- include('partials/matrix') %>
  <%- include('partials/proof') %>
  <%- include('partials/founder') %>
  <%- include('partials/cta-banner') %>
  <%- include('partials/footer') %>

  <!-- Same scroll-reveal script as the homepage, so .reveal sections here behave identically -->
  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (!reveals.length) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          var items = entry.target.querySelectorAll('.reveal-item');
          items.forEach(function(item, i) {
            setTimeout(function() { item.classList.add('visible'); }, i * 100);
          });
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(function(el) { observer.observe(el); });
  })();
  </script>
</body>
</html>
