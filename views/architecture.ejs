<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Architecture | MedhaIQ.ai</title>
  <meta name="description" content="The engineering behind MedhaIQ — platform architecture and the AI engine.">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
  <link rel="stylesheet" href="/css/trust-architecture.css">
  <link rel="stylesheet" href="/css/architecture-light.css">
</head>
<body class="architecture-page">
  <%- include('partials/header') %>

  <!-- Hero — shared PageHero partial (was hand-duplicated from Why MedhaIQ's
       markup; now both pages actually consume the same component). -->
  <%- include('partials/page-hero', {
    eyebrow: 'Architecture',
    title: 'How MedhaIQ Is Built',
    sub: 'Explore the technical foundation powering MedhaIQ—from AI orchestration and career intelligence to enterprise-grade trust, governance, and security.'
  }) %>

  <!-- Sticky left-nav + right-content hub. Per your latest correction:
       - "Career Architecture" → #journey (partials/timeline.ejs — real
         eyebrow literally reads "Career Architecture")
       - "Core Architecture" → #framework (partials/framework.ejs — real
         eyebrow literally reads "Core Architecture")
       - "Live Terminal" → #proof (partials/proof.ejs — real eyebrow reads
         "Live Engine"); now a normal in-page anchor, not an external link
       - "Core Infrastructure", "AI Engine Core", and "Career OS & Enterprise
         Sync" nav entries are removed per your instruction. Their content
         (Layer 2, Layer 3, Multi-Model panel) is NOT deleted — it's part of
         partials/architecture.ejs, which stays intact under "Technical
         Blueprint" — just without its own dedicated sidebar entry anymore.
       - "Trust Architecture" (partials/trust-architecture.ejs) merged in as
         the 5th and final section, reusing the same mh-framework /
         mh-frame-card component as "Core Architecture" (framework.ejs). -->
  <section class="mh-hub reveal">
    <div class="mh-hub-inner">
      <nav class="mh-hub-nav" aria-label="Architecture sections">
        <a href="#technical-blueprint" class="mh-hub-nav-link">Technical Blueprint</a>
        <a href="#journey" class="mh-hub-nav-link">Career Architecture</a>
        <a href="#framework" class="mh-hub-nav-link">Core Architecture</a>
        <a href="#proof" class="mh-hub-nav-link">Live Terminal</a>
        <a href="#trust-architecture" class="mh-hub-nav-link">Trust Architecture</a>
      </nav>
      <div class="mh-hub-content">
        <%- include('partials/architecture') %>
        <%- include('partials/timeline') %>
        <%- include('partials/framework') %>
        <%- include('partials/proof') %>
        <%- include('partials/trust-architecture') %>
      </div>
    </div>
  </section>

  <%- include('partials/cta-banner') %>
  <%- include('partials/footer') %>
  <%- include('partials/contact-modal') %>

  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (!reveals.length) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          var items = entry.target.querySelectorAll('.reveal-item');
          items.forEach(function(item, i) {
            setTimeout(function() { item.classList.add('visible'); }, i * 100);
          });
        }
      });
       }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(function(el) { observer.observe(el); });

    function settleAndReveal() {
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          reveals.forEach(function(el) {
            if (el.classList.contains('visible')) return;
            var rect = el.getBoundingClientRect();
            var inViewport = rect.top < (window.innerHeight || document.documentElement.clientHeight) && rect.bottom > 0;
            if (inViewport) {
              el.classList.add('visible');
              var items = el.querySelectorAll('.reveal-item');
              items.forEach(function(item, i) {
                setTimeout(function() { item.classList.add('visible'); }, i * 100);
              });
            }
          });
        });
      });
    }
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(settleAndReveal);
    } else {
      settleAndReveal();
    }
  })();

  // Sticky nav: highlight active section, smooth-scroll on click, no route change
  (function() {
    var navLinks = document.querySelectorAll('.mh-hub-nav-link');
    if (!navLinks.length) return;
    navLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var target = document.querySelector(link.getAttribute('href'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    var targets = Array.from(navLinks).map(function(l) {
      return document.querySelector(l.getAttribute('href'));
    }).filter(Boolean);

    // Root cause of the earlier bug: with a single-entry threshold
    // observer, multiple adjacent sections can simultaneously satisfy
    // isIntersecting near their shared boundary, and the previous logic
    // reacted to whichever entry's callback happened to fire last in
    // that batch — not necessarily the section actually at the top of
    // the viewport. Fix: track ALL currently-intersecting sections in
    // a Set, and on every observer callback, explicitly pick whichever
    // one has the smallest boundingClientRect.top (i.e. the section
    // actually nearest the top of the viewport) as active. This is
    // tied to the real section elements/IDs, not a hardcoded scroll
    // range, so it keeps working correctly if section heights change.
    var currentlyVisible = new Set();
    function updateActiveTab() {
      var topMost = null;
      var topMostTop = Infinity;
      currentlyVisible.forEach(function(el) {
        var top = el.getBoundingClientRect().top;
        if (top < topMostTop) {
          topMostTop = top;
          topMost = el;
        }
      });
      if (!topMost) return;
      var idx = targets.indexOf(topMost);
      if (idx === -1) return;
      navLinks.forEach(function(l) { l.classList.remove('active'); });
      navLinks[idx].classList.add('active');
    }
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          currentlyVisible.add(entry.target);
        } else {
          currentlyVisible.delete(entry.target);
        }
      });
      updateActiveTab();
    }, { threshold: 0.15, rootMargin: '-100px 0px -55% 0px' });
    targets.forEach(function(t) { observer.observe(t); });

    // Handle direct anchor landing / page refresh at a section: the
    // observer fires once sections start crossing the threshold during
    // scroll, but a hard load at #proof, for example, needs an initial
    // check since no scroll event necessarily occurs first.
    if (window.location.hash) {
      var initial = document.querySelector(window.location.hash);
      if (initial && targets.indexOf(initial) > -1) {
        currentlyVisible.add(initial);
        updateActiveTab();
      }
    }
  })();
  </script>
</body>
</html>