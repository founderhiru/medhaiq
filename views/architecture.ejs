<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Architecture | MedhaIQ.ai</title>
  <meta name="description" content="The engineering behind MedhaIQ — platform architecture and the AI engine.">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
</head>
<body>
  <%- include('partials/header') %>

  <section style="padding: 104px var(--section-pad-x) 53px; max-width: var(--max-w); margin: 0 auto; text-align: center;">
    <div class="mh-eyebrow">Architecture</div>
    <h1 style="font-family: var(--font-display); font-weight: 800; font-size: var(--hero-h1-size); color: var(--white); letter-spacing: var(--hero-h1-tracking); margin-bottom: 16px;">;">
      How MedhaIQ Is Built
    </h1>
  </section>

  <!-- Sticky left-nav + right-content hub. Per your latest correction:
       - "Career Architecture" → #journey (partials/timeline.ejs — real
         eyebrow literally reads "Career Architecture")
       - "Core Architecture" → #framework (partials/framework.ejs — real
         eyebrow literally reads "Core Architecture")
       - "Live Terminal" → #proof (partials/proof.ejs — real eyebrow reads
         "Live Engine"); now a normal in-page anchor, not an external link
       - "Core Infrastructure", "AI Engine Core", and "Career OS & Enterprise
         Sync" nav entries are removed per your instruction. Their content
         (Layer 2, Layer 3, Multi-Model panel) is NOT deleted — it's part of
         partials/architecture.ejs, which stays intact under "Technical
         Blueprint" — just without its own dedicated sidebar entry anymore.

       FLAG: timeline.ejs, framework.ejs, and proof.ejs are currently also
       live on the homepage (confirmed in layout.ejs). Including them here
       too means this content now exists in two places — see chat. -->
  <section class="mh-hub reveal">
    <div class="mh-hub-inner">
      <nav class="mh-hub-nav" aria-label="Architecture sections">
        <a href="#technical-blueprint" class="mh-hub-nav-link">Technical Blueprint</a>
        <a href="#journey" class="mh-hub-nav-link">Career Architecture</a>
        <a href="#framework" class="mh-hub-nav-link">Core Architecture</a>
        <a href="#proof" class="mh-hub-nav-link">Live Terminal</a>
      </nav>
      <div class="mh-hub-content">
        <%- include('partials/architecture') %>
        <%- include('partials/timeline') %>
        <%- include('partials/framework') %>
        <%- include('partials/proof') %>
      </div>
    </div>
  </section>

  <%- include('partials/cta-banner') %>
  <%- include('partials/footer') %>

  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (!reveals.length) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          var items = entry.target.querySelectorAll('.reveal-item');
          items.forEach(function(item, i) {
            setTimeout(function() { item.classList.add('visible'); }, i * 100);
          });
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(function(el) { observer.observe(el); });
  })();

  // Sticky nav: highlight active section, smooth-scroll on click, no route change
  (function() {
    var navLinks = document.querySelectorAll('.mh-hub-nav-link');
    if (!navLinks.length) return;
    navLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var target = document.querySelector(link.getAttribute('href'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    var targets = Array.from(navLinks).map(function(l) {
      return document.querySelector(l.getAttribute('href'));
    }).filter(Boolean);
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var idx = targets.indexOf(entry.target);
          navLinks.forEach(function(l) { l.classList.remove('active'); });
          if (idx > -1) navLinks[idx].classList.add('active');
        }
      });
    }, { threshold: 0.3, rootMargin: '-100px 0px -60% 0px' });
    targets.forEach(function(t) { observer.observe(t); });
  })();
  </script>
</body>
</html>
