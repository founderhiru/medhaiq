<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Architecture | MedhaIQ.ai</title>
  <meta name="description" content="The engineering behind MedhaIQ — platform architecture and the AI engine.">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
</head>
<body>
  <%- include('partials/header') %>

  <section style="padding: 148px var(--section-pad-x) 0; max-width: var(--max-w); margin: 0 auto; text-align: center;">
    <div class="mh-eyebrow">Architecture</div>
    <h1 style="font-family: var(--font-display); font-weight: 800; font-size: var(--hero-h1-size); color: var(--white); letter-spacing: var(--hero-h1-tracking); margin: 12px 0;">
      How MedhaIQ Is Built
    </h1>
  </section>

  <!-- Sticky left-nav + right-content hub. The right panel is architecture.ejs
       verbatim (from partials/architecture.ejs) — only 4 id attributes were
       added to its existing Layer 1/2/3 and Multi-Model divs so the left nav
       has something real to scroll to. No text, section, or layout changed.
       There are only 4 real subsections here — Layer 1, Layer 2, Layer 3, and
       Multi-Model Architecture — because that's genuinely all that exists in
       the source content. No 5th "AI Engine" or "Live Terminal" section was
       invented to fill out the nav; see chat for why. -->
  <section class="mh-hub reveal">
    <div class="mh-hub-inner">
      <nav class="mh-hub-nav" aria-label="Architecture sections">
        <a href="#arch-layer-1" class="mh-hub-nav-link">Career Intelligence Engine</a>
        <a href="#arch-layer-2" class="mh-hub-nav-link">Performance Analytics Layer</a>
        <a href="#arch-layer-3" class="mh-hub-nav-link">Career OS &amp; Enterprise Sync</a>
        <a href="#arch-multimodel" class="mh-hub-nav-link">Multi-Model Architecture</a>
      </nav>
      <div class="mh-hub-content">
        <%- include('partials/architecture') %>
      </div>
    </div>
  </section>

  <%- include('partials/cta-banner') %>
  <%- include('partials/footer') %>

  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (!reveals.length) return;
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          var items = entry.target.querySelectorAll('.reveal-item');
          items.forEach(function(item, i) {
            setTimeout(function() { item.classList.add('visible'); }, i * 100);
          });
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(function(el) { observer.observe(el); });
  })();

  // Sticky nav: highlight active section, smooth-scroll on click, no route change
  (function() {
    var navLinks = document.querySelectorAll('.mh-hub-nav-link');
    if (!navLinks.length) return;
    navLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var target = document.querySelector(link.getAttribute('href'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
    var targets = Array.from(navLinks).map(function(l) {
      return document.querySelector(l.getAttribute('href'));
    }).filter(Boolean);
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var idx = targets.indexOf(entry.target);
          navLinks.forEach(function(l) { l.classList.remove('active'); });
          if (idx > -1) navLinks[idx].classList.add('active');
        }
      });
    }, { threshold: 0.3, rootMargin: '-100px 0px -60% 0px' });
    targets.forEach(function(t) { observer.observe(t); });
  })();
  </script>
</body>
</html>
