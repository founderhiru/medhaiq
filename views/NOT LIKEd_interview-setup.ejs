      </div>
    </div>

    <!-- Sarah Kim -->
    <div class="persona-card" data-persona="sarah_kim">
      <div class="card-check">&#10003;</div>
      <div class="card-headshot">
        <div class="card-initials" style="background:linear-gradient(135deg,#064e3b,#10b981);">SK</div>
      </div>
      <div class="card-body">
        <div class="card-name-row">
          <span class="card-name">Sarah Kim</span>
          <span class="card-diff diff-hard">&#128293; Hard</span>
        </div>
        <div class="card-role">CEO &bull; Pre-Series A Startup</div>
        <span class="card-style style-green">Grit &amp; Vision</span>
