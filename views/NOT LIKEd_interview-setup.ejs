    <div class="chip" data-exp="senior">&#128293; Senior &nbsp;8&#8211;15 yrs</div>
    <div class="chip" data-exp="executive">&#128081; Executive &nbsp;15+ yrs</div>
  </div>

  <div class="divider"></div>

  <!-- SECTION 3: PERSONA -->
  <div class="sec"><div class="sec-num">3</div><div class="sec-label">Choose Your Interviewer</div><div class="sec-line"></div></div>

  <div class="persona-grid">

    <!-- Alex Chen -->
    <div class="persona-card" data-persona="alex_chen">
      <div class="card-check">&#10003;</div>
      <div class="card-headshot">
        <div class="card-initials" style="background:linear-gradient(135deg,#1e3a8a,#2563eb);">AC</div>
      </div>
      <div class="card-body">
        <div class="card-name-row">
          <span class="card-name">Alex Chen</span>
          <span class="card-diff diff-hard">&#128293; Hard</span>
        </div>
        <div class="card-role">Senior Principal Engineer &bull; AWS</div>
        <span class="card-style style-blue">Structured Technical</span>
        <div class="card-quote">"System design, scalability focus, and deep-dive technical reasoning. Expect thorough probing of your architectural choices."</div>
      </div>
    </div>

    <!-- Priya Ramesh -->
    <div class="persona-card" data-persona="priya_ramesh">
      <div class="card-check">&#10003;</div>
      <div class="card-headshot">
        <div class="card-initials" style="background:linear-gradient(135deg,#065f46,#059669);">PR</div>
      </div>
      <div class="card-body">
        <div class="card-name-row">
          <span class="card-name">Priya Ramesh</span>
          <span class="card-diff diff-elite">&#128142; Elite</span>
        </div>
        <div class="card-role">Partner &bull; McKinsey Consulting</div>
        <span class="card-style style-green">Case-Led Communication</span>
        <div class="card-quote">"Highly structured, top-down communication style. Focused on business impact, market sizing, and strategic clarity."</div>
      </div>
    </div>

    <!-- Marcus Webb -->
    <div class="persona-card" data-persona="marcus_webb">
      <div class="card-check">&#10003;</div>
      <div class="card-headshot">
        <div class="card-initials" style="background:linear-gradient(135deg,#78350f,#d97706);">MW</div>
      </div>
      <div class="card-body">
        <div class="card-name-row">
          <span class="card-name">Marcus Webb</span>
          <span class="card-diff diff-medium">&#9889; Medium</span>
        </div>
        <div class="card-role">VP Product &bull; Series B SaaS</div>
        <span class="card-style style-amber">User-Centric Growth</span>
        <div class="card-quote">"Focuses on user empathy, prioritization frameworks, and cross-functional leadership metrics."</div>
      </div>
    </div>

    <!-- Sanjeev Nair -->
    <div class="persona-card" data-persona="sanjeev_nair">
      <div class="card-check">&#10003;</div>
      <div class="card-headshot">
        <div class="card-initials" style="background:linear-gradient(135deg,#3730a3,#6366f1);">SN</div>
      </div>
      <div class="card-body">
        <div class="card-name-row">
          <span class="card-name">Sanjeev Nair</span>
          <span class="card-diff diff-hard">&#128293; Hard</span>
        </div>
