<!-- STICKY FOOTER -->
<div class="sticky-cta">
  <div class="sticky-inner">
    <div class="cta-tags">
      <span class="cta-tag" id="cta-role">Role: not selected</span>
      <span class="cta-tag set" id="cta-exp">Level: Mid-Career</span>
      <span class="cta-tag" id="cta-persona">Interviewer: not selected</span>
    </div>
    <button class="begin-btn" id="beginBtn" disabled>Initialize Session &#8594;</button>
  </div>
</div>

<script>
/* ── Tab switch ── */
function switchTab(tab) {
  document.querySelectorAll('.role-tab').forEach(function(t) { t.classList.toggle('active', t.dataset.tab === tab); });
  document.querySelectorAll('.role-panel').forEach(function(p) { p.classList.toggle('visible', p.id === 'tab-' + tab); });
}

(function() {
  var state = { role: '', exp: 'mid', persona: null };
  var expLabels = { fresher:'Fresher', mid:'Mid-Career', senior:'Senior', executive:'Executive' };

  /* Role chips */
  document.querySelectorAll('.chip[data-role]').forEach(function(chip) {
    chip.addEventListener('click', function() {
      if (chip.dataset.custom === 'true') {
        document.querySelectorAll('.chip[data-role]').forEach(function(c) { c.classList.remove('active'); });
        chip.classList.add('active');
        var inp = document.getElementById('roleCustom');
        inp.classList.add('show'); inp.focus();
        state.role = ''; sync(); return;
      }
      document.querySelectorAll('.chip[data-role]').forEach(function(c) { c.classList.remove('active'); });
      document.getElementById('roleCustom').classList.remove('show');
      chip.classList.add('active');
      state.role = chip.dataset.role;
      sync();
    });
  });
  document.getElementById('roleCustom').addEventListener('input', function() { state.role = this.value.trim(); sync(); });

  /* Exp chips */
  document.querySelectorAll('#chips-exp .chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      document.querySelectorAll('#chips-exp .chip').forEach(function(c) { c.classList.remove('active'); });
      chip.classList.add('active');
      state.exp = chip.dataset.exp;
      sync();
    });
  });

  /* Persona cards */
  document.querySelectorAll('.persona-card').forEach(function(card) {
    card.addEventListener('click', function() {
      document.querySelectorAll('.persona-card').forEach(function(c) { c.classList.remove('selected'); });
      card.classList.add('selected');
      state.persona = card.dataset.persona;
      sync();
    });
  });

  function sync() {
    var roleTag    = document.getElementById('cta-role');
    var expTag     = document.getElementById('cta-exp');
    var personaTag = document.getElementById('cta-persona');
    var btn        = document.getElementById('beginBtn');

    roleTag.textContent    = state.role    ? '\u2713 ' + state.role    : 'Role: not selected';
    expTag.textContent     = 'Level: ' + (expLabels[state.exp] || 'Mid-Career');
    personaTag.textContent = state.persona ? '\u2713 ' + state.persona.replace(/_/g,' ').replace(/\b\w/g,function(c){return c.toUpperCase();}) : 'Interviewer: not selected';

    roleTag.classList.toggle('set', !!state.role);
    expTag.classList.add('set');
    personaTag.classList.toggle('set', !!state.persona);

    var ready = !!(state.role && state.persona);
    btn.disabled = !ready;
    btn.classList.toggle('ready', ready);
  }

  /* Begin */
  document.getElementById('beginBtn').addEventListener('click', async function() {
    var btn = this;
    btn.disabled = true; btn.textContent = 'Initializing...';
    try {
      var resp = await fetch('/api/interview/sessions', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          personaId:       state.persona,
          roleTitle:       state.role,
          experienceLevel: state.exp,
          orgPreset:       '',
        }),
      });
      var data = await resp.json();
      if (!resp.ok) throw new Error(data.error || 'Server error ' + resp.status);
      if (!data.sessionId) throw new Error('No session ID returned');
      window.location.href = '/interview/session/' + data.sessionId;
    } catch (err) {
      btn.disabled = false;
      btn.textContent = 'Initialize Session \u2192';
      btn.classList.add('ready');
      alert('Failed to start: ' + (err.message || 'Unknown error'));
    }
  });

  sync();
})();
</script>
</body>
</html>
