<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Company Interview Library | MedhaIQ.ai</title>
  <meta name="description" content="How leading companies interview. Find the company you're preparing for — Amazon, Microsoft, Google, Meta, Apple, Stripe and more.">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="canonical" href="https://www.medhaiq.ai/explore/company-library">
  <meta property="og:title" content="Company Interview Library | MedhaIQ.ai">
  <meta property="og:description" content="How leading companies interview. Find the company you're preparing for.">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
  <link rel="stylesheet" href="/css/explore.css">
  <link rel="stylesheet" href="/css/company-library.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- Hero — dark, per color system. Simplified to one job: let the
       person find the company they're preparing for. Search is the
       primary action; no CTA button competing with it. -->
  <section class="mh-why-hero reveal">
    <div class="mh-why-hero-inner mh-section-center">
      <div class="mh-eyebrow">Company Interview Library</div>
      <h1 class="mh-section-title mh-colib-hero-title mh-colib-hero-title-compact">How companies interview.</h1>
      <p class="mh-section-sub">Discover how leading companies evaluate candidates, what they value, and how to prepare with confidence.</p>

      <div class="mh-explore-search-wrap" style="margin-top: 32px;">
        <svg class="mh-explore-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input class="mh-form-input" type="search" placeholder="Search companies..." aria-label="Search companies">
      </div>
    </div>
  </section>

  <!-- ============ LIGHT EDITORIAL READING SURFACE ============ -->
  <div class="mh-editorial-surface">
    <div class="mh-editorial-inner">

      <nav aria-label="Breadcrumb" style="padding-bottom: 32px; font-size: 13px;">
        <a href="/explore" style="color: var(--ed-muted);">Explore MedhaIQ</a>
        <span aria-hidden="true" style="color: var(--ed-faint);">/</span>
        <span aria-current="page" style="color: var(--ed-text); font-weight: 600;">Company Interview Library</span>
      </nav>

      <!-- Curated grid — recognition + selection only. No descriptions,
           no category pills, no metadata. -->
      <div class="mh-editorial-card">
        <div class="mh-section-center">
          <div class="mh-eyebrow">Popular Companies</div>
          <h2 class="mh-editorial-card-title">Choose a company</h2>
        </div>
        <div class="mh-explore-grid mh-colib-curated-grid" role="list" style="margin-top: 24px;">
          <% curatedCompanies.forEach(function(company) { %>
            <%- include('partials/company-curated-card', { company: company }) %>
          <% }); %>
        </div>
        <p class="mh-colib-viewall-row">
          <a href="/explore/company-library/all" class="mh-explore-card-link">View all companies <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg></a>
        </p>
      </div>

      <p class="mh-colib-trademark-disclaimer">Company names and logos are the property of their respective owners. No affiliation or endorsement is implied.</p>

    </div>
  </div>

  <!-- CTA — dark, per color system (#0E1322). Single, understated. -->
  <section class="mh-colib-dark-cta reveal">
    <div class="mh-explore-cta-inner">
      <h2 class="mh-section-title">Ready to practice?</h2>
      <p class="mh-explore-cta-sub">Experience a personalized interview based on the company you're preparing for.</p>
      <div class="mh-explore-cta-actions">
        <a href="/login" class="mh-btn-primary">Start Practice Interview</a>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (reveals.length) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(function(el) { observer.observe(el); });
    }
  })();
  </script>
</body>
</html>
