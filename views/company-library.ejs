<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Company Interview Library | MedhaIQ.ai</title>
  <meta name="description" content="Explore interview expectations, hiring processes, core competencies, and preparation strategies for leading employers — Amazon, Microsoft, Google, Salesforce, Deloitte and more.">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="canonical" href="https://www.medhaiq.ai/explore/company-library">
  <meta property="og:title" content="Company Interview Library | MedhaIQ.ai">
  <meta property="og:description" content="Interview expectations, hiring processes, and preparation strategies for leading employers.">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
  <link rel="stylesheet" href="/css/explore.css">
  <link rel="stylesheet" href="/css/company-library.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- Breadcrumb -->
  <nav class="mh-colib-breadcrumb" aria-label="Breadcrumb">
    <div class="mh-explore-section-inner">
      <a href="/explore">Explore MedhaIQ</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Company Interview Library</span>
    </div>
  </nav>

  <!-- Hero + Search -->
  <section class="mh-why-hero reveal">
    <div class="mh-why-hero-inner mh-section-center">
      <div class="mh-eyebrow">Company Interview Library</div>
      <h1 class="mh-section-title">Company Interview Library</h1>
      <p class="mh-section-sub">Prepare for interviews at the world's leading employers. Explore hiring philosophies, interview styles, competencies, representative questions, and preparation guidance — then practice with a personalized AI interview.</p>
      <div class="mh-explore-cta-actions" style="margin-top: 28px;">
        <a href="#mh-colib-featured-title" class="mh-btn-primary">Browse Companies</a>
      </div>

      <div class="mh-explore-search-wrap" style="margin-top: 40px;">
        <svg class="mh-explore-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input class="mh-form-input" type="search" placeholder="Search companies..." aria-label="Search companies" disabled>
      </div>
      <p class="mh-explore-trust-line">Search is coming soon — five featured guides are ready below.</p>
    </div>
  </section>

  <!-- Featured Companies — fixed order per launch spec, NOT alphabetical -->
  <section class="mh-explore-section reveal" aria-labelledby="mh-colib-featured-title">
    <div class="mh-explore-section-inner">
      <div class="mh-section-center">
        <div class="mh-eyebrow">Featured Companies</div>
        <h2 id="mh-colib-featured-title" class="mh-section-title">Five guides, ready now</h2>
      </div>
      <div class="mh-explore-grid" role="list">
        <% companyLibrary.forEach(function(company) { %>
          <%- include('partials/company-featured-card', { company: company }) %>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- How to use this library -->
  <section class="mh-explore-section reveal" aria-labelledby="mh-colib-howto-title">
    <div class="mh-explore-section-inner">
      <div class="mh-section-center">
        <div class="mh-eyebrow">How To Use This Library</div>
        <h2 id="mh-colib-howto-title" class="mh-section-title">Three steps to a confident interview</h2>
      </div>
      <div class="mh-colib-howto-row">
        <div class="mh-colib-howto-step">
          <div class="mh-colib-howto-num">1</div>
          <div class="mh-colib-howto-title">Choose a Company</div>
          <div class="mh-colib-howto-desc">Pick the employer you're preparing for from the featured guides above.</div>
        </div>
        <div class="mh-colib-howto-step">
          <div class="mh-colib-howto-num">2</div>
          <div class="mh-colib-howto-title">Learn What Interviewers Evaluate</div>
          <div class="mh-colib-howto-desc">Read the hiring philosophy, competencies, and representative questions specific to that company.</div>
        </div>
        <div class="mh-colib-howto-step">
          <div class="mh-colib-howto-num">3</div>
          <div class="mh-colib-howto-title">Practice with MedhaIQ</div>
          <div class="mh-colib-howto-desc">Run a personalized AI interview calibrated to that company's actual interview style.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why company-specific preparation matters -->
  <section class="mh-explore-section mh-explore-section-alt reveal" aria-labelledby="mh-colib-why-title">
    <div class="mh-explore-section-inner">
      <div class="mh-section-center">
        <div class="mh-eyebrow">Why It Matters</div>
        <h2 id="mh-colib-why-title" class="mh-section-title">Why company-specific preparation matters</h2>
        <p class="mh-section-sub mh-colib-why-body">
          Generic interview advice tells you how to answer a question. It doesn't tell you what a specific
          company is actually listening for. Amazon evaluates candidates against a published set of
          Leadership Principles. Google weighs reasoning process as heavily as the final answer. Deloitte
          expects you to structure a case out loud, client-facing, from the first minute. The same story,
          told the same way, can land completely differently depending on which of these you're sitting in
          front of. Preparing for the company, not just the role, is what turns a good candidate into a
          confident one.
        </p>
      </div>
    </div>
  </section>

  <!-- What you'll find in each guide -->
  <section class="mh-explore-section reveal" aria-labelledby="mh-colib-whatfind-title">
    <div class="mh-explore-section-inner">
      <div class="mh-section-center">
        <div class="mh-eyebrow">Inside Every Guide</div>
        <h2 id="mh-colib-whatfind-title" class="mh-section-title">What you'll find in each guide</h2>
      </div>
      <div class="mh-explore-discover-grid" role="list">
        <div class="mh-explore-card mh-explore-discover-card" role="listitem">
          <div class="mh-explore-discover-icon" aria-hidden="true">🏢</div>
          <div class="mh-explore-discover-title">Company Overview & Hiring Philosophy</div>
          <div class="mh-explore-discover-desc">What the company values and what candidates should genuinely expect.</div>
        </div>
        <div class="mh-explore-card mh-explore-discover-card" role="listitem">
          <div class="mh-explore-discover-icon" aria-hidden="true">🧭</div>
          <div class="mh-explore-discover-title">Interview Journey</div>
          <div class="mh-explore-discover-desc">A stage-by-stage walk through the process, from application to offer.</div>
        </div>
        <div class="mh-explore-card mh-explore-discover-card" role="listitem">
          <div class="mh-explore-discover-icon" aria-hidden="true">⭐</div>
          <div class="mh-explore-discover-title">Core Competencies</div>
          <div class="mh-explore-discover-desc">The specific qualities interviewers are trained to evaluate — and why each matters.</div>
        </div>
        <div class="mh-explore-card mh-explore-discover-card" role="listitem">
          <div class="mh-explore-discover-icon" aria-hidden="true">💬</div>
          <div class="mh-explore-discover-title">Representative Questions</div>
          <div class="mh-explore-discover-desc">A curated, realistic set — not an exhaustive dump of hundreds of questions.</div>
        </div>
        <div class="mh-explore-card mh-explore-discover-card" role="listitem">
          <div class="mh-explore-discover-icon" aria-hidden="true">📚</div>
          <div class="mh-explore-discover-title">Preparation Tips</div>
          <div class="mh-explore-discover-desc">Practical, company-specific advice on structure, tone, and common mistakes.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Browse by category — grouped from each company's existing `category`
       field (no new data added; Big Tech / Enterprise SaaS / Consulting
       derived from the same strings already shown on the featured cards) -->
  <%
    const _categoryGroups = [];
    companyLibrary.forEach(function(company) {
      let label = company.category;
      if (company.category.indexOf('Big Tech') !== -1) label = 'Big Tech';
      else if (company.category.indexOf('Enterprise SaaS') !== -1) label = 'Enterprise SaaS';
      else if (company.category.indexOf('Consulting') !== -1) label = 'Consulting';
      let group = _categoryGroups.find(function(g) { return g.label === label; });
      if (!group) { group = { label: label, companies: [] }; _categoryGroups.push(group); }
      group.companies.push(company);
    });
  %>
  <section class="mh-explore-section reveal" aria-labelledby="mh-colib-category-title">
    <div class="mh-explore-section-inner">
      <div class="mh-section-center">
        <div class="mh-eyebrow">Browse By Category</div>
        <h2 id="mh-colib-category-title" class="mh-section-title">Find your industry</h2>
      </div>
      <div class="mh-colib-category-list">
        <% _categoryGroups.forEach(function(group) { %>
          <div class="mh-colib-category-group">
            <div class="mh-colib-category-label"><%= group.label %></div>
            <div class="mh-colib-category-companies">
              <% group.companies.forEach(function(company) { %>
                <a href="/explore/company-library/<%= company.slug %>" class="mh-explore-pill mh-explore-pill-blue mh-colib-category-pill"><%= company.name %></a>
              <% }); %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Coming Soon strip -->
  <section class="mh-explore-section mh-explore-section-alt reveal" aria-labelledby="mh-colib-comingsoon-title">
    <div class="mh-explore-section-inner mh-section-center">
      <div class="mh-eyebrow">Always Expanding</div>
      <h2 id="mh-colib-comingsoon-title" class="mh-section-title">More companies, coming soon</h2>
      <div class="mh-colib-comingsoon-strip">
        <% comingSoonCompanies.forEach(function(name) { %>
          <span class="mh-explore-pill mh-explore-pill-gold"><%= name %></span>
        <% }); %>
      </div>
    </div>
</section>

  <%- include('partials/footer') %>

  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (reveals.length) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(function(el) { observer.observe(el); });
    }
  })();
  </script>
</body>
</html>
