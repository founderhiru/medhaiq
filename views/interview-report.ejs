<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interview Report — MedhaIQ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/interview.css">
  <link rel="stylesheet" href="/css/feedback-widget.css">
</head>
<body class="report-page-body">

<!--
  Web Report — restructured across three approved checkpoints (all
  2026-08-12): Step 2 (information architecture — section consolidation),
  Step 3 (visual redesign — white executive system, matching
  public/sample-report/index.html), Step 4 (executive 2-column grid
  layout, this pass). Every class used in this file's markup either
  already existed in public/css/interview.css before Step 2, or was
  added in Step 3/4 — see that file's two dedicated comment blocks near
  the end for the full scoping rationale (this stylesheet is shared with
  other pages; every report-specific rule is scoped under .report-page).

  Journey: Hero (Score + Five-Vector Profile) → Your Career Intelligence
  Overview → Your Strongest Signal / Your Development Focus → STAR
  Intelligence → What Your Answers Showed → How to Improve / Your
  Development Path → (Leadership only) Executive Interpretation / Role
  Readiness → Next-Level Direction.

  Every value rendered below comes from the SAME buildCareerIntelligenceReport()
  call server.js already made before Step 2 — no new AI call, no new
  scoring, no new calculation. See server.js's /interview/report/:id route
  for exactly which cir.* field backs each variable used here.

  Decision 1 (recommendation): report.recommendation is not deleted or
  recalculated — it's folded into a small subtitle line
  (recommendationContext) instead of a standalone colored Hire/No-Hire
  badge. The old .recommendation-badge markup and rec/recClass logic are
  removed from this file; the CSS rules for them are simply unused now,
  not deleted.
-->

<div class="report-page">
  <div style="margin-bottom: 32px;">
    <%- include('partials/brand-logo', { size: 'md', eager: true }) %>
  </div>

  <!-- ═══ HERO — Score + Five-Vector Profile, combined (Step 4) ═══
       Previously two separate blocks (.report-header stacked above
       .scoreboard-section). Merged into one full-width hero with the
       score ring and vectors side by side, per §4/§5's explicit
       requirement that "the five vectors should have enough horizontal
       width to make the bars and labels readable." Same data, same
       markup for each half — only the wrapping structure changed.

       hasSubstantiveEvidence branch (2026-08-13, response-intent
       formalization): when a session has zero real interview_scores
       rows — every question was SKIP/DONT_KNOW, or Discovery-only —
       report.overall_score and every vector average are literally 0,
       which is not "the candidate scored zero," it's "there is nothing
       to score." Shows "—" / "Not assessed" instead per the approved
       plan. hasSubstantiveEvidence is computed once in
       lib/career-intelligence-report.js and is TRUE for every legacy
       (pre-migration) session by construction — see that file's
       comment — so this branch never changes what a historical report
       already looked like. -->
  <div class="report-hero">
    <div class="report-hero-identity">
      <div class="report-date"><%= formattedDate %></div>
      <div class="report-hero-name"><%= candidateName %> · <%= roleTitle %></div>
      <div class="persona-info">Interviewed by <%= personaName %></div>
    </div>
    <div class="report-hero-row">
      <div class="report-hero-score">
        <div class="score-ring">
          <svg width="140" height="140" viewBox="0 0 140 140">
            <circle class="bg" cx="70" cy="70" r="60" />
            <% if (hasSubstantiveEvidence) { %>
            <circle class="fill" cx="70" cy="70" r="60"
              stroke-dasharray="<%= circumference %>"
              stroke-dashoffset="<%= circumferenceOffset %>" />
            <% } %>
          </svg>
          <% if (hasSubstantiveEvidence) { %>
          <div class="score-num"><%= Math.round(report.overall_score) %><span class="score-num-sub">out of 100</span></div>
          <% } else { %>
          <div class="score-num">—<span class="score-num-sub">Not assessed</span></div>
          <% } %>
        </div>
        <div class="score-label">Overall Career Intelligence Score</div>
        <% if (hasPdfAccess) { %>
        <a href="/interview/report/<%= report.session_id %>/pdf" class="report-hero-pdf" style="display:inline-block; padding:10px 20px; background:#3B82F6; color:#fff; border-radius:999px; font-weight:700; font-size:13px; text-decoration:none;" download>
          ↓ Download PDF Report
        </a>
        <% } %>
      </div>
      <div class="report-hero-vectors">
        <h3 class="scoreboard-title">YOUR 5-VECTOR PROFILE</h3>
        <div class="scoreboard-grid">
           <% const scoreboardRows = [
            { label: 'Structure', score: starAvg },
            { label: 'Domain Expertise', score: technicalAvg },
            { label: 'Strategic Thinking', score: executiveAvg },
            { label: 'Communication', score: frictionAvg },
            { label: 'Leadership & Execution', score: gccAvg },
          ]; %>
          <% scoreboardRows.forEach(function(row) { %>
            <% if (hasSubstantiveEvidence) { %>
            <% const cls = row.score >= 80 ? 'high' : row.score >= 60 ? 'mid' : 'low'; %>
            <div class="scoreboard-row">
              <span class="scoreboard-label"><%= row.label %></span>
              <div class="scoreboard-track">
                <div class="scoreboard-fill <%= cls %>" style="width: <%= row.score %>%"></div>
              </div>
              <span class="scoreboard-val <%= cls %>"><%= Math.round(row.score) %>/100</span>
            </div>
            <% } else { %>
            <div class="scoreboard-row">
              <span class="scoreboard-label"><%= row.label %></span>
              <div class="scoreboard-track"></div>
              <span class="scoreboard-val" style="color:#94A3B8; font-weight:600;">Not assessed</span>
            </div>
            <% } %>
          <% }); %>
        </div>
      </div>
    </div>
  </div>

  <!-- ═══ RESPONSE SUMMARY ═══ Deterministic counts from real per-answer
       response_intent values — never guessed. Null (and therefore
       nothing rendered here) for any legacy session with no classified
       intents, so historical reports are unaffected. Uses the existing
       .score-attribution caption style — no new CSS. -->
  <% if (responsePattern) { %>
  <div class="response-summary">
    <span class="eyebrow">RESPONSE SUMMARY</span>
    <div class="score-attribution" style="margin-top:4px;"><%= responsePattern.answered %> answered · <%= responsePattern.skipped %> skipped · <%= responsePattern.dontKnow %> don't know</div>
  </div>
  <% } %>

  <!-- ═══ SECTION 1 — YOUR CAREER INTELLIGENCE OVERVIEW ═══
       Kept full-width — see the CSS block's header comment for why this
       deliberately deviates from the prompt's "half-width" list. -->

  <% if (hasFullReport && hasSubstantiveEvidence && report.executive_summary) { %>
  <div class="report-section">
    <h3>Your Career Intelligence Overview</h3>
    <p class="exec-summary"><%= report.executive_summary %></p>
    <% if (report.persona_verdict) { %>
    <p class="persona-verdict" style="margin-top:14px;"><%= report.persona_verdict %></p>
    <% } %>
    <% if (recommendationContext) { %>
    <div class="score-attribution"><%= recommendationContext %></div>
    <% } %>
  </div>
  <% } %>

  <div class="report-divider"></div>

  <% if (!hasSubstantiveEvidence) { %>
  <!-- ═══ INTERVIEW NOT COMPLETED ═══ (2026-08-13, response-intent
       formalization). Shown for BOTH Explorer and Growth/Leadership when
       there is zero substantive evidence — exact copy, not AI-generated,
       so "no performance criticism from nonexistent evidence" and "no
       candidate/employer-style conclusions" are guaranteed every time
       rather than relying on the AI to consistently avoid them. Replaces
       the entire Strengths/Development/STAR/Evidence/Improve/Roadmap/
       Leadership content below for this session — none of that content
       is meaningful when there is nothing to assess. -->
  <div class="report-section">
    <h3>Interview Not Completed</h3>
    <p class="exec-summary">There isn't enough response evidence to assess your interview performance. Complete an interview with substantive responses to generate your Career Intelligence assessment.</p>
  </div>

  <div class="report-section">
    <h3>How to Get a Meaningful Assessment</h3>
    <p class="exec-summary">Answer the interview questions with specific examples, decisions, reasoning, and outcomes. A completed interview will generate your 5-Vector Intelligence assessment and personalized development insights.</p>
  </div>

  <% if (!hasFullReport) { %>
  <div class="report-section" style="text-align:center; background:#F7F8FA; border-radius:12px; padding:24px;">
    <h3 style="margin-bottom:8px;">Want the full picture?</h3>
    <p class="exec-summary" style="margin-bottom:16px;">Unlock your complete interview analysis, evidence, and personalized improvement guidance with Growth.</p>
    <a href="/dashboard" class="cta-btn primary">Upgrade to Growth</a>
  </div>
  <% } %>

  <% } else if (hasFullReport) { %>

  <div class="report-grid">
  <!-- ═══ SECTION 2 — YOUR STRONGEST SIGNAL ═══
       cir.strengths[0] prominent; cir.strengths[1] (if present) noted as
       a secondary line rather than a second full section — avoids a
       second "list of strengths" section per the consolidation
       instruction. -->
  <div class="report-section">
    <h3>Your Strongest Signal</h3>
    <div class="evidence-block evidence-strong">
      <div class="evidence-label"><%= strengths[0].label %> — <%= strengths[0].score %>/100</div>
    </div>
    <% if (strengths[1]) { %>
    <div class="score-attribution">Also a strength this session: <%= strengths[1].label %> — <%= strengths[1].score %>/100</div>
    <% } %>
  </div>

  <!-- ═══ SECTION 3 — YOUR DEVELOPMENT FOCUS ═══
       Top development priority prominent (with its existing narrative
       sentence, if the canonical builder attached one); remaining
       priorities as a compact list rather than a separate "Top 3"
       section — same underlying report.improvements_json data as
       before, now read via cir.developmentPriorities instead of the
       raw field directly (see server.js's STEP 4 note). -->
  <div class="report-section">
    <h3>Your Development Focus</h3>
    <div class="evidence-block evidence-weak">
      <div class="evidence-label"><%= developmentPriorities[0].label %> — <%= developmentPriorities[0].score %>/100</div>
      <% if (developmentPriorities[0].narrative) { %>
      <div class="evidence-quote" style="font-style:normal; margin-top:8px;"><%= developmentPriorities[0].narrative %></div>
      <% } %>
    </div>
    <% if (developmentPriorities.length > 1) { %>
    <ul class="improve-list" style="margin-top:16px;">
      <% developmentPriorities.slice(1).forEach(function(d) { %>
      <li><%= d.label %> — <%= d.score %>/100</li>
      <% }); %>
    </ul>
    <% } %>
  </div>
  </div>

  <!-- ═══ SECTION 4 — STAR INTELLIGENCE ═══
       Kept full-width — see the CSS block's header comment for why this
       deliberately deviates from the prompt's "half-width" list.
       Full cir.starIntelligence — same computeStarProgress() output the
       Explorer sentence and the PDF both already use. Low-evidence
       sessions (totalAnswered === 0) get an honest explanation instead
       of a percentages grid that would otherwise show all-zero without
       context. -->
  <div class="report-section">
    <h3>STAR Intelligence</h3>
    <% if (starIntelligence.totalAnswered > 0) { %>
    <div class="diagnostics-grid">
      <% ['situation','task','action','result'].forEach(function(letter) {
           var s = starIntelligence[letter];
           var label = letter.charAt(0).toUpperCase() + letter.slice(1);
      %>
      <div class="diag-item">
        <div class="diag-label"><%= label %></div>
        <div class="diag-value"><%= s.pct %>% — identified in <%= s.detected %> of <%= s.of %> answered questions</div>
      </div>
      <% }); %>
    </div>
    <div class="score-attribution" style="margin-top:16px;">Overall STAR Score: <%= starIntelligence.overallStarScore %> — the number of answers with Situation, Task, Action, and Result all present.</div>
    <% } else { %>
    <p class="exec-summary">This session did not provide enough substantive answers to assess STAR quality — situation, task, action, and result could not be reliably identified.</p>
    <% } %>
  </div>

  <!-- ═══ SECTION 5 — WHAT YOUR ANSWERS SHOWED (Representative Evidence) ═══
       Full-width outer section, per §9, with a 2-column .evidence-pair
       grid inside it for the strongest/development evidence — matches
       the prompt's explicit example exactly. Pure evidence — the
       strongest and weakest captured responses, same
       report.strongest_response / .weakest_response fields as before,
       now read via cir.coachingInsights. -->
  <% if ((coachingInsights.strongestResponse) || (coachingInsights.weakestResponse)) { %>
  <div class="report-section">
    <h3>What Your Answers Showed</h3>
    <div class="evidence-pair">
    <% if (coachingInsights.strongestResponse) { %>
    <div class="evidence-block evidence-strong">
      <div class="evidence-label">Strongest Evidence</div>
      <div class="evidence-meta">Context: <%= coachingInsights.strongestResponse.context %></div>
      <div class="evidence-quote">"<%= coachingInsights.strongestResponse.evidence %>"</div>
    </div>
    <% } %>
    <% if (coachingInsights.weakestResponse) { %>
    <div class="evidence-block evidence-weak">
      <div class="evidence-label">Development Signal</div>
      <div class="evidence-meta">Context: <%= coachingInsights.weakestResponse.context %></div>
      <div class="evidence-quote">"<%= coachingInsights.weakestResponse.evidence %>"</div>
    </div>
    <% } %>
    </div>
  </div>
  <% } %>

  <div class="report-grid">
  <!-- ═══ SECTION 6 — HOW TO IMPROVE ═══
       Paired with the Development Path, per §10's explicit example.
       Communication/delivery diagnostics (same structural_flow /
       linguistic_nuances fields as before, via cir.coachingInsights) plus
       a single Next Practice Focus callout (cir.nextPracticeFocus,
       previously computed but never rendered anywhere on the Web
       Report). One consolidated section, not three separate ones. -->
  <div class="report-section">
    <h3>How to Improve</h3>
    <div class="diagnostics-grid">
      <div class="diag-item">
        <div class="diag-label">Structural Layout &amp; Flow</div>
        <div class="diag-value"><%= coachingInsights.structuralFlow || 'Moderate — logical structure present but could be tightened.' %></div>
      </div>
      <div class="diag-item">
        <div class="diag-label">Linguistic Nuances &amp; Fillers</div>
        <div class="diag-value"><%= coachingInsights.linguisticNuances || 'Developing executive vocabulary and filler frequency.' %></div>
      </div>
    </div>
    <% if (nextPracticeFocus) { %>
    <div class="evidence-block evidence-strong" style="margin-top:20px;">
      <div class="evidence-label">Next Practice Focus</div>
      <div class="evidence-quote" style="font-style:normal;"><%= nextPracticeFocus.label %> — the lowest-scoring vector this session (<%= nextPracticeFocus.score %>/100), and the highest-leverage place to focus before your next interview.</div>
    </div>
    <% } %>
  </div>

  <!-- ═══ SECTION 7 — YOUR DEVELOPMENT PATH ═══
       cir.careerRoadmap (report.next_steps_json) — previously computed
       by the canonical builder but never added to this route's payload
       at all. Same 0–30/30–60/60–90-day framing already used on the
       PDF, using the existing .next-steps counter-badge list style. -->
  <% if (careerRoadmap && careerRoadmap.length) { %>
  <div class="report-section">
    <h3>Your Development Path</h3>
    <ol class="next-steps">
      <% var roadmapWindows = ['0–30 Days', '30–60 Days', '60–90 Days']; %>
      <% careerRoadmap.forEach(function(step, i) { %>
      <li><strong><%= roadmapWindows[i] || ('Step ' + (i + 1)) %>:</strong> <%= step %></li>
      <% }); %>
    </ol>
  </div>
  <% } %>
  </div>

  <% if (hasLeadershipInsights && leadershipInsights) { %>
  <!-- Leadership-only narrative layer — content UNCHANGED from the prior
       checkpoint, only the wrapping grid is new. Executive Interpretation
       + Role Readiness paired per §11's explicit example; Next-Level
       Direction stays full-width standalone, also per §11. Sourced
       exclusively from cir.leadershipInsights (lib/career-intelligence-report.js),
       itself a pass-through of the SAME generateReport() AI call that
       produces executive_summary above — no second AI call, no new
       calculation. Each field is rendered only if non-null. Growth never
       reaches this block — hasLeadershipInsights requires the
       'leadership.insights' permission, which Growth's package does not
       grant. -->
  <div class="report-divider"></div>

  <% if (leadershipInsights.executiveInterpretation || leadershipInsights.roleReadiness) { %>
  <div class="report-grid">
  <% if (leadershipInsights.executiveInterpretation) { %>
  <div class="report-section">
    <h3>Executive Interpretation</h3>
    <p class="exec-summary"><%= leadershipInsights.executiveInterpretation %></p>
  </div>
  <% } %>

  <% if (leadershipInsights.roleReadiness) { %>
  <div class="report-section">
    <h3>Role Readiness</h3>
    <p class="exec-summary"><%= leadershipInsights.roleReadiness %></p>
  </div>
  <% } %>
  </div>
  <% } %>

  <% if (leadershipInsights.nextLevelDirection) { %>
  <div class="report-section">
    <h3>Next-Level Direction</h3>
    <p class="exec-summary"><%= leadershipInsights.nextLevelDirection %></p>
  </div>
  <% } %>
  <% } %>

  <% } else { %>
  <!-- Explorer snapshot — same ranked canonical data as Growth/Leadership,
       just the top-1 slice (server.js passes topStrength/topPriority/
       starIntelligence from the same cir object). Headings renamed to
       match the new section names exactly (content and gating
       completely unchanged from before this checkpoint). -->
  <div class="report-section">
    <h3>Your Strongest Signal</h3>
    <div class="evidence-block evidence-strong">
      <div class="evidence-label"><%= topStrength.label %> — <%= topStrength.score %>/100</div>
    </div>
  </div>

  <div class="report-section">
    <h3>Your Development Focus</h3>
    <div class="evidence-block evidence-weak">
      <div class="evidence-label"><%= topPriority.label %> — <%= topPriority.score %>/100</div>
    </div>
  </div>

  <% if (starIntelligence.totalAnswered > 0) { %>
  <div class="report-section">
    <h3>STAR Signal</h3>
    <p class="exec-summary">Across <%= starIntelligence.totalAnswered %> answered question<%= starIntelligence.totalAnswered === 1 ? '' : 's' %>, Situation was identified in <%= starIntelligence.situation.pct %>%, Task in <%= starIntelligence.task.pct %>%, Action in <%= starIntelligence.action.pct %>%, and Result in <%= starIntelligence.result.pct %>%.</p>
  </div>
  <% } %>

  <div class="report-section" style="text-align:center; background:#F7F8FA; border-radius:12px; padding:24px;">
    <h3 style="margin-bottom:8px;">Want the full picture?</h3>
    <p class="exec-summary" style="margin-bottom:16px;">Unlock your complete interview analysis, evidence, and personalized improvement guidance with Growth.</p>
    <a href="/dashboard" class="cta-btn primary">Upgrade to Growth</a>
  </div>
  <% } %>


  <!-- CTAs — unchanged -->
  <div class="report-ctas">
    <a href="/interview" class="cta-btn primary">Practice Again</a>
    <a href="/interview" class="cta-btn outline">Try a Different Persona</a>
  <a href="/dashboard/history" class="cta-btn emerald">Return to Workspace</a>
    <a href="/" class="cta-btn text-link">Return Home</a>
  </div>

  <% if (typeof showFeedbackPrompt !== 'undefined' && showFeedbackPrompt) { %>
  <!-- Lightweight feedback widget — unchanged from before. Reuses
       user_activity_logs, no new table. -->
  <div class="fbw-card" id="fbw-card">
    <div id="fbw-form-state">
      <div class="fbw-title">How was your MedhaIQ experience?</div>
      <div class="fbw-stars" id="fbw-stars">
        <% for (let i = 1; i <= 5; i++) { %><span class="fbw-star" data-value="<%= i %>">★</span><% } %>
      </div>
      <div class="fbw-sub">(Optional)</div>
      <input type="text" id="fbw-comment" class="fbw-comment" placeholder="What could we improve?" maxlength="500">
      <div class="fbw-actions">
        <button type="button" id="fbw-submit" class="fbw-submit-btn" disabled>Submit</button>
        <button type="button" id="fbw-dismiss" class="fbw-dismiss-btn">Not Now</button>
      </div>
      <div class="fbw-msg" id="fbw-msg"></div>
    </div>
  </div>
  <script>
    (function () {
      const card = document.getElementById('fbw-card');
      const stars = document.querySelectorAll('#fbw-stars .fbw-star');
      const submitBtn = document.getElementById('fbw-submit');
      const dismissBtn = document.getElementById('fbw-dismiss');
      const commentInput = document.getElementById('fbw-comment');
      const msg = document.getElementById('fbw-msg');
      let selectedRating = 0;

      stars.forEach(function (star) {
        star.addEventListener('click', function () {
          selectedRating = parseInt(this.getAttribute('data-value'), 10);
          stars.forEach(function (s) {
            s.classList.toggle('fbw-star-filled', parseInt(s.getAttribute('data-value'), 10) <= selectedRating);
          });
          submitBtn.disabled = false;
        });
      });

      async function postFeedback(path, body) {
        const res = await fetch(path, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body || {}),
        });
        return res.ok;
      }

      submitBtn.addEventListener('click', async function () {
        if (!selectedRating) return;
        submitBtn.disabled = true;
        const ok = await postFeedback('/api/feedback', { rating: selectedRating, comment: commentInput.value, feature: 'interview_report' });
        if (ok) {
          card.innerHTML = '<div class="fbw-thanks">Thanks for the feedback — it genuinely helps.</div>';
        } else {
          msg.textContent = 'Something went wrong — feel free to try again later.';
          submitBtn.disabled = false;
        }
      });

      dismissBtn.addEventListener('click', async function () {
        card.style.display = 'none';
        await postFeedback('/api/feedback/dismiss', {});
      });
    })();
  </script>
  <% } %>
</div>

</body>
</html>
