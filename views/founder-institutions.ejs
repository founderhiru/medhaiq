<%- include('partials/workspace-shell-top', { pageTitle: 'Campus Ready Institutions — MedhaIQ', activeNav: 'founder', bodyClass: 'founder-institutions-page', shellUser: shellUser, isFounder: true }) %>

<div class="page-header-row">
  <div>
    <h1>Campus Ready — Institutions</h1>
    <p class="subtitle">Manage pilot colleges, cohorts, and learner invites.</p>
  </div>
  <div class="page-header-actions">
    <a href="/founder" class="new-interview-btn" style="background:none;border:1px solid rgba(255,255,255,0.15);">← Founder Dashboard</a>
  </div>
</div>

<div style="max-width:960px;margin:0 auto;padding:0 16px;">

  <section style="margin-bottom:32px;">
    <h3>Add Institution</h3>
    <form id="newInstitutionForm" style="display:flex;gap:8px;flex-wrap:wrap;">
      <input name="name" placeholder="Institution name" required style="flex:1;min-width:200px;padding:8px 10px;border-radius:6px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.12);color:inherit;">
      <input name="contactName" placeholder="TPO / contact name" style="flex:1;min-width:160px;padding:8px 10px;border-radius:6px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.12);color:inherit;">
      <input name="contactEmail" placeholder="Contact email" type="email" style="flex:1;min-width:160px;padding:8px 10px;border-radius:6px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.12);color:inherit;">
      <button type="submit" style="padding:8px 16px;border-radius:6px;background:var(--blue-bright,#3b82f6);border:none;color:#fff;cursor:pointer;">Add</button>
    </form>
  </section>

  <section>
    <h3>Institutions</h3>
    <div id="institutionList"></div>
  </section>

  <!-- Institution detail: cohorts + invites, rendered inline rather than
       as a separate page — keeps this to one net-new admin screen. -->
  <div id="institutionDetail" style="display:none;margin-top:28px;padding:20px;border-radius:12px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);"></div>
</div>

<script>
(function () {
  const API = '/api/founder/campus';
  let activeInstitutionId = null;

  async function loadInstitutions() {
    const res = await fetch(API + '/institutions');
    const data = await res.json();
    const el = document.getElementById('institutionList');
    if (!data.institutions.length) { el.innerHTML = '<p style="opacity:0.6;">No institutions yet.</p>'; return; }
    el.innerHTML = data.institutions.map(i => `
      <button class="inst-row" data-id="${i.id}" style="all:unset;cursor:pointer;display:flex;justify-content:space-between;width:100%;padding:12px 16px;border-radius:8px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);margin-bottom:8px;">
        <span>${i.name}</span>
        <span style="opacity:0.6;font-size:13px;">${i.cohort_count} cohort(s)</span>
      </button>
    `).join('');
    el.querySelectorAll('.inst-row').forEach(btn => btn.addEventListener('click', () => openInstitution(btn.dataset.id)));
  }

  document.getElementById('newInstitutionForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = new FormData(e.target);
    await fetch(API + '/institutions', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: form.get('name'), contactName: form.get('contactName'), contactEmail: form.get('contactEmail') }),
    });
    e.target.reset();
    loadInstitutions();
  });

  async function openInstitution(id) {
    activeInstitutionId = id;
    const res = await fetch(API + '/institutions/' + id);
    const data = await res.json();
    const el = document.getElementById('institutionDetail');
    el.style.display = 'block';
    el.innerHTML = `
      <h3>${data.institution.name}</h3>
      <form id="newCohortForm" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
        <input name="name" placeholder="Cohort name (e.g. 2027 CSE)" required style="flex:1;min-width:180px;padding:8px 10px;border-radius:6px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.12);color:inherit;">
        <input name="learnerLimit" placeholder="Learner limit" type="number" style="width:120px;padding:8px 10px;border-radius:6px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.12);color:inherit;">
        <button type="submit" style="padding:8px 16px;border-radius:6px;background:var(--blue-bright,#3b82f6);border:none;color:#fff;cursor:pointer;">Add Cohort</button>
      </form>
      <div id="cohortList"></div>
    `;
    renderCohorts(data.cohorts);
    document.getElementById('newCohortForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = new FormData(e.target);
      await fetch(`${API}/institutions/${activeInstitutionId}/cohorts`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: form.get('name'), learnerLimit: form.get('learnerLimit') || null }),
      });
      openInstitution(activeInstitutionId);
    });
  }

  function renderCohorts(cohorts) {
    const el = document.getElementById('cohortList');
    if (!cohorts.length) { el.innerHTML = '<p style="opacity:0.6;">No cohorts yet.</p>'; return; }
    el.innerHTML = cohorts.map(c => `
      <div style="padding:14px 16px;border-radius:8px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);margin-bottom:10px;">
        <div style="display:flex;justify-content:space-between;">
          <strong>${c.name}</strong>
          <span style="opacity:0.6;font-size:13px;">${c.learner_count} learner(s)</span>
        </div>
        <div style="margin-top:8px;display:flex;gap:8px;">
          <input class="invite-email" placeholder="learner@email.com" style="flex:1;padding:6px 8px;border-radius:6px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.12);color:inherit;font-size:13px;">
          <button class="invite-btn" data-cohort="${c.id}" style="padding:6px 12px;border-radius:6px;background:none;border:1px solid rgba(255,255,255,0.15);color:inherit;cursor:pointer;font-size:13px;">Generate Invite Link</button>
        </div>
        <p class="invite-result" style="font-size:12px;opacity:0.7;margin-top:6px;word-break:break-all;"></p>
        <a href="#" class="view-analytics" data-cohort="${c.id}" style="font-size:12px;">View cohort progress →</a>
        <div class="cohort-analytics" style="display:none;margin-top:10px;font-size:13px;"></div>
      </div>
    `).join('');
    el.querySelectorAll('.invite-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const wrap = btn.closest('div').parentElement;
        const emailInput = wrap.querySelector('.invite-email');
        const resultEl = wrap.querySelector('.invite-result');
        if (!emailInput.value.trim()) return;
        const res = await fetch(`${API}/cohorts/${btn.dataset.cohort}/invites`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value.trim() }),
        });
        const data = await res.json();
        resultEl.textContent = 'Share this link: ' + window.location.origin + data.joinUrl;
      });
    });
    el.querySelectorAll('.view-analytics').forEach(link => {
      link.addEventListener('click', async (e) => {
        e.preventDefault();
        const res = await fetch(`${API}/cohorts/${link.dataset.cohort}`);
        const data = await res.json();
        const box = link.nextElementSibling;
        box.style.display = 'block';
        box.innerHTML = `
          <p>${data.analytics.totals.started} of ${data.analytics.totals.total_learners} learners started.</p>
          ${data.analytics.moduleBreakdown.map(m => `<p>${m.name}: avg ${m.avg_percent || 0}%, ${m.complete_count} complete</p>`).join('')}
        `;
      });
    });
  }

  loadInstitutions();
})();
</script>

<%- include('partials/workspace-shell-bottom') %>
