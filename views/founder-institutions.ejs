<%- include('partials/workspace-shell-top', { pageTitle: 'Campus Ready Institutions — MedhaIQ', activeNav: 'founder', bodyClass: 'founder-institutions-page', shellUser: shellUser, extraStylesheets: ['/css/founder-institutions.css', '/css/campus-ready.css'], isFounder: true }) %>

<div class="page-header-row">
  <div>
    <h1>Campus Ready — Institutions</h1>
    <p class="subtitle">Manage colleges, cohorts, and TPO access.</p>
  </div>
  <div class="fi-admin-tools">
    <button id="fiAdminToolsTrigger" class="fi-admin-tools-trigger">Admin Tools ▾</button>
    <div id="fiAdminToolsMenu" class="fi-admin-tools-menu">
      <a href="/campus/tpo">TPO Preview</a>
      <a href="/founder/campus/e2e">E2E Test Lab</a>
      <a href="/founder">Founder Dashboard</a>
    </div>
  </div>
</div>

<div class="fi-root">

  <section class="fi-section">
    <div class="fi-section-title">Add Institution</div>
    <form id="newInstitutionForm" class="fi-form">
      <input name="name" placeholder="Institution name" required style="flex:1;min-width:200px;">
      <input name="contactName" placeholder="TPO / contact name" style="flex:1;min-width:160px;">
      <input name="contactEmail" placeholder="Contact email" type="email" style="flex:1;min-width:160px;">
      <button type="submit" class="fi-btn-primary">Add</button>
    </form>
  </section>

  <section class="fi-section">
    <div class="fi-section-title">Institutions</div>
    <div id="institutionList"></div>
  </section>

  <!-- Institution detail: cohorts + invites, rendered inline rather than
       as a separate page — keeps this to one net-new admin screen. -->
  <div id="institutionDetail" class="fi-detail-panel" style="display:none;"></div>
</div>

<script>
(function () {
  const API = '/api/founder/campus';
  let activeInstitutionId = null;

  const toolsBtn = document.getElementById('fiAdminToolsTrigger');
  const toolsMenu = document.getElementById('fiAdminToolsMenu');
  toolsBtn.addEventListener('click', (e) => { e.stopPropagation(); toolsMenu.classList.toggle('open'); });
  document.addEventListener('click', () => toolsMenu.classList.remove('open'));

  async function loadInstitutions() {
    const res = await fetch(API + '/institutions');
    const data = await res.json();
    const el = document.getElementById('institutionList');
    if (!data.institutions.length) { el.innerHTML = '<p class="fi-empty">No institutions yet.</p>'; return; }
    el.innerHTML = data.institutions.map(i => `
      <button class="fi-row inst-row" data-id="${i.id}">
        <span>${i.name}</span>
        <span class="fi-row-meta">${i.cohort_count} cohort(s)</span>
      </button>
    `).join('');
    el.querySelectorAll('.inst-row').forEach(btn => btn.addEventListener('click', () => openInstitution(btn.dataset.id)));
  }

  document.getElementById('newInstitutionForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = new FormData(e.target);
    await fetch(API + '/institutions', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: form.get('name'), contactName: form.get('contactName'), contactEmail: form.get('contactEmail') }),
    });
    e.target.reset();
    loadInstitutions();
  });

  async function openInstitution(id) {
    activeInstitutionId = id;
    const [res, adminsRes] = await Promise.all([
      fetch(API + '/institutions/' + id),
      fetch(API + '/institutions/' + id + '/admins'),
    ]);
    const data = await res.json();
    const adminsData = await adminsRes.json();
    const el = document.getElementById('institutionDetail');
    el.style.display = 'block';
    el.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <h3 style="margin:0;">${data.institution.name}</h3>
        <a href="/campus/tpo/${id}" class="fi-view-analytics">View as TPO →</a>
      </div>
      <form id="newCohortForm" class="fi-form" style="margin:16px 0;">
        <input name="name" placeholder="Cohort name (e.g. 2027 CSE)" required style="flex:1;min-width:180px;">
        <input name="learnerLimit" placeholder="Learner limit" type="number" style="width:120px;">
        <button type="submit" class="fi-btn-primary">Add Cohort</button>
      </form>
      <div id="cohortList"></div>

      <div class="fi-tpo-section">
        <div class="fi-section-title">TPO Access</div>
        <div id="tpoAdminList" class="fi-tpo-list"></div>
        <form id="grantTpoForm" class="fi-form">
          <input name="email" type="email" placeholder="tpo@institution.edu" required style="flex:1;min-width:200px;">
          <button type="submit" class="fi-btn-secondary">Grant TPO Access</button>
        </form>
        <p class="fi-tpo-hint">Grants instant access — the TPO still logs in through the normal MedhaIQ sign-in with this email. No invite link is sent. Once granted, the TPO can invite their own candidates from their TPO Dashboard.</p>
      </div>
    `;
    renderCohorts(data.cohorts);
    renderTpoAdmins(adminsData.admins);
    document.getElementById('newCohortForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = new FormData(e.target);
      await fetch(`${API}/institutions/${activeInstitutionId}/cohorts`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: form.get('name'), learnerLimit: form.get('learnerLimit') || null }),
      });
      openInstitution(activeInstitutionId);
    });
    document.getElementById('grantTpoForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = new FormData(e.target);
      await fetch(`${API}/institutions/${activeInstitutionId}/admins`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: form.get('email') }),
      });
      openInstitution(activeInstitutionId);
    });
  }

  function renderTpoAdmins(admins) {
    const el = document.getElementById('tpoAdminList');
    el.innerHTML = admins.length
      ? admins.map(a => `<div>${a.name || a.email} (${a.email})</div>`).join('')
      : '<div class="fi-empty">No TPOs granted yet.</div>';
  }

  function renderCohorts(cohorts) {
    const el = document.getElementById('cohortList');
    if (!cohorts.length) { el.innerHTML = '<p class="fi-empty">No cohorts yet.</p>'; return; }
    el.innerHTML = cohorts.map(c => `
      <div class="fi-cohort-card">
        <div style="display:flex;justify-content:space-between;">
          <strong>${c.name}</strong>
          <span class="fi-row-meta">${c.learner_count} learner(s)</span>
        </div>
        <div class="fi-cohort-invite-row">
          <input class="invite-email" placeholder="learner@email.com">
          <button class="invite-btn fi-btn-secondary" data-cohort="${c.id}">Generate Invite Link</button>
        </div>
        <p class="invite-result fi-invite-result"></p>
        <a href="#" class="view-analytics fi-view-analytics" data-cohort="${c.id}">View cohort progress →</a>
        <div class="cohort-analytics fi-analytics-box" style="display:none;"></div>
      </div>
    `).join('');
    el.querySelectorAll('.invite-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const wrap = btn.closest('div').parentElement;
        const emailInput = wrap.querySelector('.invite-email');
        const resultEl = wrap.querySelector('.invite-result');
        if (!emailInput.value.trim()) return;
        const res = await fetch(`${API}/cohorts/${btn.dataset.cohort}/invites`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value.trim() }),
        });
        const data = await res.json();
        resultEl.textContent = 'Share this link: ' + window.location.origin + data.joinUrl;
      });
    });
    el.querySelectorAll('.view-analytics').forEach(link => {
      link.addEventListener('click', async (e) => {
        e.preventDefault();
        const res = await fetch(`${API}/cohorts/${link.dataset.cohort}`);
        const data = await res.json();
        const box = link.nextElementSibling;
        box.style.display = 'block';
        box.innerHTML = `
          <p>${data.analytics.totals.started} of ${data.analytics.totals.total_learners} learners started.</p>
          ${data.analytics.moduleBreakdown.map(m => `<p>${m.name}: avg ${m.avg_percent || 0}%, ${m.complete_count} complete</p>`).join('')}
        `;
      });
    });
  }

  loadInstitutions();
})();
</script>

<%- include('partials/workspace-shell-bottom') %>
