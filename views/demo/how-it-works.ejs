<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>See How It Works — MedhaIQ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/demo-walkthrough.css">
</head>
<body id="mh-demo-page" style="background:#0A0F1E; min-height:100vh;">
  <%- include('../partials/header') %>

  <div class="mh-demo-video-wrap">
    <h1 style="color:#F8FAFC; font-family:'Plus Jakarta Sans',sans-serif; font-size:28px; margin-bottom:20px;">See how MedhaIQ works</h1>
    <div class="mh-demo-video-frame">
      <video autoplay muted playsinline controls preload="metadata" poster="" id="mhDemoVideo">
        <source src="/videos/how-it-works.mp4" type="video/mp4">
      </video>
      <button type="button" id="mhSoundOnBtn" class="mh-demo-sound-btn" aria-label="Turn sound on">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>
        Sound On
      </button>
    </div>
    <div class="mh-demo-video-fallback" id="mhDemoFallback" style="display:none;">
      The walkthrough video isn't available yet — check back shortly.
    </div>
  </div>

  <script>
    document.getElementById('mhDemoVideo').addEventListener('error', function () {
      document.getElementById('mhDemoVideo').style.display = 'none';
      document.getElementById('mhDemoFallback').style.display = 'block';
      var soundBtnOnError = document.getElementById('mhSoundOnBtn');
      if (soundBtnOnError) soundBtnOnError.style.display = 'none';
    }, true);

    (function () {
      var video = document.getElementById('mhDemoVideo');
      var soundBtn = document.getElementById('mhSoundOnBtn');
      if (!video || !soundBtn) return;

      function syncSoundButton() {
        soundBtn.style.display = video.muted ? 'inline-flex' : 'none';
      }
      syncSoundButton();

      soundBtn.addEventListener('click', function () {
        video.muted = false;
        soundBtn.style.display = 'none';
      });
    })();
  </script>
</body>
</html>
