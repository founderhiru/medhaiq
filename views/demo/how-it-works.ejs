<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>See How It Works — MedhaIQ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <!-- Reuses the REAL production stylesheets — the interactive chapters
       are built entirely from the same CSS classes/visual language as
       the real interview session, real report, and real brand system.
       No new visual language is introduced. This single page replaces
       the previous MP4-based /demo/how-it-works landing page: all 5
       chapters are pre-rendered server-side into this one document and
       switched client-side by public/js/demo-chapters.js — no page
       reloads, no second Play screen, no Vapi/Stripe/DB calls anywhere
       on this route. -->
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/interview-session.css?v=20260805b">
  <link rel="stylesheet" href="/css/interview.css">
  <link rel="stylesheet" href="/css/brand-logo.css">
  <link rel="stylesheet" href="/css/demo-walkthrough.css">
</head>
<body id="mh-demo-page" style="background:#0A0F1E; min-height:100vh;">
  <%- include('../partials/header') %>

  <div class="mh-demo-shell">

    <!-- Persistent chapter navigation -->
    <nav class="mh-chapter-nav" id="mhChapterNav" aria-label="Walkthrough chapters">
      <% chapters.forEach(function(ch, i) { %>
      <button type="button" class="mh-chapter-nav-item" data-chapter-index="<%= i %>" aria-current="<%= i === 0 ? 'true' : 'false' %>">
        <span class="mh-chapter-nav-number"><%= ch.number %></span>
        <span class="mh-chapter-nav-label"><%= ch.navLabel %></span>
      </button>
      <% }); %>
    </nav>

    <!-- Voice control — subtle, not a conventional video-player button.
         Hidden entirely unless a chapter actually has a playable audio
         source (set by JS at runtime; absent by default until real
         voiceover files are added). -->
    <button type="button" id="mhEnableVoiceBtn" class="mh-enable-voice-btn" style="display:none;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.5 8.5a5 5 0 0 1 0 7"></path></svg>
      Enable Voice
    </button>

    <!-- Chapter stage: all chapters pre-rendered, shown/hidden by JS -->
    <div class="mh-chapter-stage" id="mhChapterStage">
      <section class="mh-chapter-panel is-active" data-chapter-index="0" data-chapter-id="discover">
        <%- include('partials/chapter-discover', { discover: discover }) %>
      </section>
      <section class="mh-chapter-panel" data-chapter-index="1" data-chapter-id="prepare">
        <%- include('partials/chapter-prepare', { prepare: prepare }) %>
      </section>
      <section class="mh-chapter-panel" data-chapter-index="2" data-chapter-id="interview">
        <%- include('partials/chapter-interview', { roleTitle: roleTitle, personaName: personaName, personaStyleLabel: personaStyleLabel, snapshot: snapshot }) %>
      </section>
      <section class="mh-chapter-panel" data-chapter-index="3" data-chapter-id="intelligence">
        <%- include('partials/chapter-intelligence', { fixture: fixture }) %>
      </section>
      <section class="mh-chapter-panel" data-chapter-index="4" data-chapter-id="progress">
        <%- include('partials/chapter-progress', { progress: progress }) %>
      </section>
      <section class="mh-chapter-panel" data-chapter-index="5" data-chapter-id="closing">
        <%- include('partials/chapter-closing') %>
      </section>
    </div>

  </div>

  <!-- Hidden audio element shared across chapters. No <source> files are
       guaranteed to exist yet — public/js/demo-chapters.js handles a
       missing/erroring source gracefully and falls back to a pure
       visual-timer autoplay pace, so the walkthrough works perfectly
       with zero audio files present. -->
  <audio id="mhChapterAudio" preload="none" muted playsinline></audio>

  <script>
    window.__MH_CHAPTERS__ = <%- JSON.stringify(chapters) %>;
    window.__MH_CLOSING__ = <%- JSON.stringify(closing) %>;
  </script>
  <script src="/js/demo-chapters.js"></script>
</body>
</html>
