<div class="mh-chapter-inner mh-prepare">
  <p class="mh-chapter-eyebrow">02 · PREPARE</p>
  <h2 class="mh-chapter-title">Experience → Role → Opportunity → Alignment</h2>

  <div class="mh-prepare-flow">
    <div class="mh-prepare-sources">
      <% prepare.sources.forEach(function(source) { %>
      <div class="mh-prepare-source-card">
        <span class="mh-prepare-source-icon"><%= source.icon %></span>
        <div>
          <p class="mh-prepare-source-label"><%= source.label %></p>
          <p class="mh-prepare-source-detail"><%= source.detail %></p>
        </div>
      </div>
      <% }); %>
    </div>

    <div class="mh-prepare-arrow" aria-hidden="true">→</div>

    <div class="mh-prepare-alignment">
      <p class="mh-prepare-alignment-heading"><%= prepare.alignment.heading %></p>
      <p class="mh-prepare-alignment-detail"><%= prepare.alignment.detail %></p>
      <ul class="mh-prepare-alignment-points">
        <% prepare.alignment.matchPoints.forEach(function(point) { %>
        <li><%= point %></li>
        <% }); %>
      </ul>
    </div>
  </div>
</div>
