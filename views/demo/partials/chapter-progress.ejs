<div class="mh-chapter-inner mh-progress">
  <p class="mh-chapter-eyebrow">05 · PROGRESS</p>
  <h2 class="mh-chapter-title"><%= progress.headline %></h2>
  <p class="mh-progress-detail"><%= progress.detail %></p>

  <div class="mh-progress-flow-labels">
    <span>Session</span>
    <span>→</span>
    <span>Insight</span>
    <span>→</span>
    <span>Improvement</span>
    <span>→</span>
    <span>Progress</span>
  </div>

  <div class="mh-progress-trend">
    <% var maxScore = Math.max.apply(null, progress.sessions.map(function(s){ return s.score; })); %>
    <% progress.sessions.forEach(function(s, i) { %>
    <div class="mh-progress-bar-col">
      <div class="mh-progress-bar" style="height: <%= Math.round((s.score / maxScore) * 100) %>%;">
        <span class="mh-progress-bar-score"><%= s.score %></span>
      </div>
      <span class="mh-progress-bar-label">Session <%= s.session %></span>
    </div>
    <% }); %>
  </div>
</div>
