<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interview Frameworks | MedhaIQ.ai</title>
  <meta name="description" content="Master practical frameworks that improve performance across behavioural, technical and leadership interviews.">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="canonical" href="https://www.medhaiq.ai/explore/interview-frameworks">
  <meta property="og:title" content="Interview Frameworks | MedhaIQ.ai">
  <meta property="og:description" content="Master practical frameworks that improve performance across behavioural, technical and leadership interviews.">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
  <link rel="stylesheet" href="/css/explore.css">
  <link rel="stylesheet" href="/css/company-library.css">
  <link rel="stylesheet" href="/css/role-library.css">
  <link rel="stylesheet" href="/css/interview-frameworks.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- Hero — dark. Same base (.mh-why-hero) + Explore's own
       .mh-explore-hero-h1 typography scale as Role Library's rebuilt
       hero, for consistency across the ecosystem. No illustration —
       framework cards are the focal point. -->
  <section class="mh-why-hero mh-explore-hero-compact reveal">
    <div class="mh-why-hero-inner mh-section-center">
      <div class="mh-eyebrow">Explore</div>
      <h1 class="mh-section-title mh-explore-hero-h1">Interview Frameworks</h1>
      <p class="mh-section-sub">Master practical frameworks that improve performance across behavioural, technical and leadership interviews.</p>

      <div class="mh-explore-search-wrap">
        <svg class="mh-explore-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input id="mh-fw-search" class="mh-form-input" type="search" placeholder="Search frameworks..." aria-label="Search frameworks">
      </div>
      <div id="mh-fw-search-meta" class="mh-explore-search-meta" aria-live="polite"></div>
    </div>
  </section>

  <!-- ============ LIGHT EDITORIAL READING SURFACE ============ -->
  <div class="mh-editorial-surface">
    <div class="mh-editorial-inner">

      <nav aria-label="Breadcrumb" style="padding-bottom: 32px; font-size: 13px;">
        <a href="/explore" style="color: var(--ed-muted);">Explore MedhaIQ</a>
        <span aria-hidden="true" style="color: var(--ed-faint);">/</span>
        <span aria-current="page" style="color: var(--ed-text); font-weight: 600;">Interview Frameworks</span>
      </nav>

      <!-- Flat, curated grid — the 6 launch frameworks only. No
           categories, no "Most Popular," no blog layout. -->
      <div class="mh-editorial-card" aria-labelledby="mh-fw-browse-title">
        <div class="mh-section-center">
          <div class="mh-eyebrow">Frameworks</div>
          <h2 id="mh-fw-browse-title" class="mh-editorial-card-title">Find your framework</h2>
        </div>
        <div class="mh-explore-grid" role="list" id="mh-fw-grid">
          <% frameworks.forEach(function(fw) { %>
            <%- include('partials/framework-browse-card', { fw: fw }) %>
          <% }); %>
        </div>
        <p id="mh-fw-search-empty" class="mh-section-sub" style="display:none; text-align:center; margin-top: 24px;">No frameworks match your search.</p>
      </div>

    </div>
  </div>

  <%- include('partials/footer') %>

  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (reveals.length) {
      var observer = new IntersectionObserver(function(entries) { entries.forEach(function(entry) { if (entry.isIntersecting) entry.target.classList.add('visible'); }); }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(function(el) { observer.observe(el); });
    }
  })();
  (function() {
    // Live search over the 6 framework cards — matches on name only
    // (frameworks don't carry competency tags the way roles do).
    var input = document.getElementById('mh-fw-search');
    var meta = document.getElementById('mh-fw-search-meta');
    var empty = document.getElementById('mh-fw-search-empty');
    if (!input) return;
    var cards = Array.prototype.slice.call(document.querySelectorAll('[data-fw-card]'));
    input.addEventListener('input', function() {
      var q = input.value.trim().toLowerCase();
      var visible = 0;
      cards.forEach(function(card) {
        var match = !q || card.getAttribute('data-fw-name').indexOf(q) !== -1;
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      meta.textContent = q ? (visible + (visible === 1 ? ' framework found' : ' frameworks found')) : '';
      empty.style.display = (q && visible === 0) ? 'block' : 'none';
    });
  })();
  </script>
</body>
</html>
