<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= guide.seo.title %></title>
  <meta name="description" content="<%= guide.seo.description %>">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="canonical" href="https://www.medhaiq.ai/interview-questions/<%= guide.slug %>">
  <meta property="og:title" content="<%= guide.seo.title %>">
  <meta property="og:description" content="<%= guide.seo.description %>">
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://www.medhaiq.ai/interview-questions/<%= guide.slug %>">
  <meta property="og:site_name" content="MedhaIQ">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= guide.seo.title %>">
  <meta name="twitter:description" content="<%= guide.seo.description %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
  <link rel="stylesheet" href="/css/explore.css">
  <link rel="stylesheet" href="/css/company-library.css">
  <link rel="stylesheet" href="/css/role-library.css">
  <link rel="stylesheet" href="/css/interview-frameworks.css">
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Explore MedhaIQ", "item": "https://www.medhaiq.ai/explore" },
      { "@type": "ListItem", "position": 2, "name": "Interview Questions", "item": "https://www.medhaiq.ai/interview-questions" },
      { "@type": "ListItem", "position": 3, "name": guide.title, "item": "https://www.medhaiq.ai/interview-questions/" + guide.slug }
    ]
  }) %>
  </script>
</head>
<body>
  <%- include('partials/header') %>

  <section class="mh-why-hero mh-explore-hero-compact reveal">
    <div class="mh-why-hero-inner mh-section-center">
      <div class="mh-eyebrow"><%= guide.eyebrow %></div>
      <h1 class="mh-section-title mh-explore-guide-hero-h1"><%= guide.title %></h1>
    </div>
  </section>

  <div class="mh-editorial-surface">
    <div class="mh-editorial-inner">

      <%
        const _wordSource = [
          guide.intro,
          guide.questions.map(function(x) { return x.q + ' ' + x.tests + ' ' + x.tip; }).join(' '),
          guide.mistakes.join(' '),
        ].join(' ');
        const _readingMinutes = Math.max(1, Math.round(_wordSource.split(/\s+/).filter(Boolean).length / 200));
      %>
      <nav class="mh-colib-breadcrumb-row" aria-label="Breadcrumb" style="padding: 0 0 32px;">
        <div>
          <a href="/explore" style="color: var(--ed-muted);">Explore MedhaIQ</a>
          <span aria-hidden="true" style="color: var(--ed-faint);">/</span>
          <a href="/interview-questions" style="color: var(--ed-muted);">Interview Questions</a>
          <span aria-hidden="true" style="color: var(--ed-faint);">/</span>
          <span style="color: var(--ed-text); font-weight: 600;"><%= guide.title %></span>
        </div>
        <span class="mh-colib-reading-time" style="background: rgba(15,23,42,0.05); color: var(--ed-faint);"><%= _readingMinutes %> min read</span>
      </nav>

      <div class="mh-editorial-card">
        <div class="mh-section-center" style="margin-bottom: 8px;">
          <div class="mh-eyebrow" style="justify-content:center; display:flex;">Overview</div>
          <h2 class="mh-editorial-card-title">How to use this guide</h2>
        </div>
        <p style="margin-top: 16px; font-size: 15px; line-height: 1.65; color: var(--ed-text, #1A1F2B); text-align: center; max-width: 720px; margin-left: auto; margin-right: auto;"><%= guide.intro %></p>
      </div>

      <div class="mh-editorial-card">
        <div class="mh-section-center" style="margin-bottom: 8px;">
          <div class="mh-eyebrow" style="justify-content:center; display:flex;">What Interviewers Look For</div>
          <h2 class="mh-editorial-card-title">Skills these questions test</h2>
        </div>
        <div class="mh-explore-chip-row" style="justify-content:center; margin-top: 20px;">
          <% guide.focus.forEach(function(item) { %>
            <span class="mh-explore-chip"><%= item %></span>
          <% }); %>
        </div>
      </div>

      <div class="mh-editorial-card">
        <div class="mh-section-center" style="margin-bottom: 8px;">
          <div class="mh-eyebrow" style="justify-content:center; display:flex;">Practice Questions</div>
          <h2 class="mh-editorial-card-title"><%= guide.questions.length %> questions and how to answer them</h2>
        </div>
        <div class="mh-fw-breakdown">
          <% guide.questions.forEach(function(item, i) { %>
            <div class="mh-fw-breakdown-step">
              <div class="mh-fw-breakdown-index"><%= i + 1 %></div>
              <div class="mh-fw-breakdown-body">
                <h3 class="mh-fw-breakdown-stage" style="margin-top:0;"><%= item.q %></h3>
                <div class="mh-fw-breakdown-desc"><strong>What it tests:</strong> <%= item.tests %></div>
                <div class="mh-fw-breakdown-desc"><strong>How to answer:</strong> <%= item.tip %></div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <div class="mh-editorial-card">
        <div class="mh-section-center" style="margin-bottom: 8px;">
          <div class="mh-eyebrow" style="justify-content:center; display:flex;">Common Mistakes</div>
          <h2 class="mh-editorial-card-title">What to avoid</h2>
        </div>
        <ul class="mh-fw-mistakes">
          <% guide.mistakes.forEach(function(mistake) { %>
            <li class="mh-fw-mistake-item"><span class="mh-fw-mistake-icon" aria-hidden="true">✕</span><span><%= mistake %></span></li>
          <% }); %>
        </ul>
      </div>

      <div class="mh-editorial-card">
        <div class="mh-section-center" style="margin-bottom: 8px;">
          <div class="mh-eyebrow" style="justify-content:center; display:flex;">Related Guides</div>
          <h2 class="mh-editorial-card-title">Keep preparing</h2>
        </div>
        <ul class="mh-role-resource-list" style="margin-top: 20px;">
          <% guide.related.forEach(function(res) { %>
            <li class="mh-role-resource-item">
              <a href="<%= res.href %>" class="mh-role-resource-link"><%= res.label %></a>
            </li>
          <% }); %>
        </ul>
      </div>

    </div>
  </div>

  <section class="mh-colib-dark-cta reveal">
    <div class="mh-explore-cta-inner">
      <h2 class="mh-section-title">Ready to practice?</h2>
      <p class="mh-explore-cta-sub"><%= guide.ctaCopy %></p>
      <div class="mh-explore-cta-actions">
        <a href="/login" class="mh-btn-primary">Start Practice Interview</a>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <%- include('partials/contact-modal') %>

  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (reveals.length) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) { if (entry.isIntersecting) entry.target.classList.add('visible'); });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(function(el) { observer.observe(el); });
    }
  })();
  </script>
</body>
</html>
