<script>
(function () {
  // ── Deterministic demo data only. This section NEVER calls fetch(),
  // never touches /api/public-preview or any AI provider. Everything
  // below is either static markup already in the DOM or pure scroll-
  // position math driving CSS class/style changes.

  var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var isMobile = window.innerWidth < 760;

  var spacer = document.getElementById('mh-sd-spacer');
  var staticVersion = document.getElementById('mh-sd-static');
  var rightPanel = document.getElementById('mh-sd-right');

  if (!spacer || !rightPanel) return;

  if (prefersReducedMotion || isMobile) {
    // Static, non-animated presentation — same content, no scroll-jacking.
    spacer.style.display = 'none';
    if (staticVersion) staticVersion.hidden = false;
    return;
  }

  // ── Scroll-progress state machine ───────────────────────────────────
  // 7 states, weighted ranges (processing + intelligence generation get
  // more "dwell" scroll distance than the shorter states).
  var RANGES = [
    { state: 1, from: 0.00, to: 0.08 },
    { state: 2, from: 0.08, to: 0.28 },
    { state: 3, from: 0.28, to: 0.48 },
    { state: 4, from: 0.48, to: 0.64 },
    { state: 5, from: 0.64, to: 0.76 },
    { state: 6, from: 0.76, to: 0.88 },
    { state: 7, from: 0.88, to: 1.00 },
  ];

  var progressFill = document.getElementById('mh-sd-progress-fill');
  var processLines = rightPanel.querySelectorAll('.mh-sd-process-line');
  var barFills = rightPanel.querySelectorAll('.mh-sd-bar-fill');
  var barNums = rightPanel.querySelectorAll('.mh-sd-bar-num');
  var signalItems = rightPanel.querySelectorAll('.mh-sd-signals li');

  var ticking = false;

  function clamp01(n) { return Math.max(0, Math.min(1, n)); }

  function update() {
    ticking = false;
    var rect = spacer.getBoundingClientRect();
    var spacerHeight = spacer.offsetHeight;
    var viewportH = window.innerHeight;
    var scrolled = -rect.top; // how far we've scrolled INTO the spacer
    var scrollableDistance = spacerHeight - viewportH;
    if (scrollableDistance <= 0) return;

    var progress = clamp01(scrolled / scrollableDistance);

    var activeRange = RANGES[0];
    for (var i = 0; i < RANGES.length; i++) {
      if (progress >= RANGES[i].from) activeRange = RANGES[i];
    }
    var activeState = activeRange.state;
    var subProgress = clamp01((progress - activeRange.from) / (activeRange.to - activeRange.from));

    rightPanel.setAttribute('data-active-state', String(activeState));

    // State 2: sequential process lines + progress bar, driven by subProgress
    if (activeState === 2 || activeState > 2) {
      var p2 = activeState > 2 ? 1 : subProgress;
      processLines.forEach(function (line) {
        var idx = parseInt(line.getAttribute('data-idx'), 10);
        line.classList.toggle('is-visible', p2 > idx / processLines.length);
      });
      if (progressFill) progressFill.style.width = (p2 * 100) + '%';
    } else {
      processLines.forEach(function (line) { line.classList.remove('is-visible'); });
      if (progressFill) progressFill.style.width = '0%';
    }

    // State 3: bars count up + fill, driven by subProgress (reversible —
    // scrolling back up smoothly un-counts, since this is pure scroll math,
    // not a one-shot timer-based animation).
    var p3 = activeState > 3 ? 1 : (activeState === 3 ? subProgress : 0);
    barFills.forEach(function (fill) {
      var target = parseFloat(fill.getAttribute('data-target'));
      fill.style.width = (p3 * target) + '%';
    });
    barNums.forEach(function (num) {
      var target = parseFloat(num.getAttribute('data-target'));
      num.textContent = Math.round(p3 * target);
    });

    // State 4: sequential signal reveal
    var p4 = activeState > 4 ? 1 : (activeState === 4 ? subProgress : 0);
    signalItems.forEach(function (item) {
      var idx = parseInt(item.getAttribute('data-idx'), 10);
      item.classList.toggle('is-visible', p4 > idx / signalItems.length);
    });
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(update);
      ticking = true;
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  update(); // initial paint
})();
</script>
