  <div class="mh-modal">
    <button class="mh-modal-close" id="mh-modal-close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="mh-modal-title">You're early — and that's a good thing.</div>
    <div class="mh-modal-sub">MedhaIQ is in beta. Enter your email to secure priority access when we launch.</div>

    <div class="mh-modal-success" id="mh-modal-success" style="display:none">
      <div class="mh-modal-success-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <div class="mh-modal-success-title">You're on the list.</div>
      <p class="mh-modal-success-msg">We'll reach out to <span id="mh-modal-email-confirm"></span> the moment access opens.</p>
    </div>

    <form class="mh-modal-form" id="mh-modal-form">
      <div class="mh-modal-field">
        <label>Email Address <span>*</span></label>
        <input type="email" id="mh-modal-email" placeholder="you@company.com" required autocomplete="email">
      </div>
      <div class="mh-modal-field">
        <label>Name <span style="color:var(--text-faint)">(optional)</span></label>
        <input type="text" id="mh-modal-name" placeholder="Your name" autocomplete="name">
      </div>
      <div class="mh-modal-field">
        <label>I am a:</label>
        <select id="mh-modal-role" required>
          <option value="" disabled selected>Select your role</option>
          <option value="student">Student</option>
          <option value="professional">Working Professional</option>
          <option value="hr_manager">HR Manager</option>
          <option value="recruiter">Recruiter</option>
          <option value="founder">Founder</option>
          <option value="other">Other</option>
        </select>
      </div>
      <input type="hidden" id="mh-modal-plan" value="">
      <button type="submit" class="mh-modal-submit" id="mh-modal-submit">Claim My Priority Spot</button>
    </form>
  </div>
</div>

<script>
(function() {
  // ── State ─────────────────────────────────────────────
  var currency = 'INR';

  // Base prices (INR)
  var BASE_PRICES = { free: 0, growth: 999, leadership: 2999 };

  // USD equivalents
  var USD_PRICES = { free: 0, growth: 12, leadership: 39 };

  // EUR equivalents (~0.92x USD mapping)
  var EUR_PRICES = { free: 0, growth: 11, leadership: 36 };

  // Currency symbols
  var CURRENCY_SYMBOLS = { INR: '\u20B9', USD: '$', EUR: '\u20AC' };

  // ── Helpers ─────────────────────────────────────────────
  function fmt(n) {
    if (currency === 'INR') {
      return n.toLocaleString('en-IN');
    }
    return n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function getPrice(tier) {
    if (currency === 'USD') return USD_PRICES[tier] || 0;
    if (currency === 'EUR') return EUR_PRICES[tier] || 0;
    return BASE_PRICES[tier] || 0;
  }

  // ── Update Prices ──────────────────────────────
  function updatePrices() {
    var sym = CURRENCY_SYMBOLS[currency];

    ['free', 'growth', 'leadership'].forEach(function(tier) {
      // Find element by data-base matching our constants
      var priceEl = document.querySelector('[data-base="' + BASE_PRICES[tier] + '"]');
      if (!priceEl) return;
      
      var price = getPrice(tier);
      priceEl.textContent = fmt(price);

      // Update currency symbol
      var symEl = priceEl.parentElement.querySelector('.mh-price-sym');
      if (symEl) symEl.innerHTML = sym;
    });
  }

  // ── Currency Selector ────────────────────────────────────
  var currencySelect = document.getElementById('currency-select');
  if (currencySelect) {
    currencySelect.addEventListener('change', function() {
      currency = currencySelect.value;
      updatePrices();
    });
  }

  // ── Modal logic (Preserved) ───────────────────────────────
  var ctas = document.querySelectorAll('[data-plan]');
  var modal = document.getElementById('mh-email-modal');
  var form = document.getElementById('mh-modal-form');
  var successDiv = document.getElementById('mh-modal-success');
  var planField = document.getElementById('mh-modal-plan');
  var submitBtn = document.getElementById('mh-modal-submit');
  var closeBtn = document.getElementById('mh-modal-close');
  var emailConfirm = document.getElementById('mh-modal-email-confirm');

  function openModal(plan) {
    if(!modal) return;
    modal.style.display = 'flex';
    if(planField) planField.value = plan || '';
    if(form) form.style.display = 'flex';
    if(successDiv) successDiv.style.display = 'none';
  }

  ctas.forEach(function(cta) {
    cta.addEventListener('click', function(e) {
      // Allow default link navigation if no data-plan exists (e.g. going to /login)
      var plan = cta.getAttribute('data-plan');
      if(plan) {
        e.preventDefault();
        openModal(plan);
      }
    });
  });

  if (closeBtn) {
    closeBtn.addEventListener('click', function() { modal.style.display = 'none'; });
  }
  if (modal) {
    modal.addEventListener('click', function(e) { if (e.target === modal) modal.style.display = 'none'; });
  }

  if (form) {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';
      var email = document.getElementById('mh-modal-email').value.trim();
      var name  = document.getElementById('mh-modal-name').value.trim();
      var role  = document.getElementById('mh-modal-role').value;
      var plan  = planField.value;
      if (!email || !/^[^\u0040@\u002E]+@[^\u0040@\u002E]+\u002E[^\u0040@\u002E]+$/.test(email)) {
        alert('Please enter a valid email address.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Claim My Priority Spot';
        return;
      }
      var data = { email: email, name: name || null, role: role || null, user_type: role || 'other', plan_interest: plan };
      try {
        var res  = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        var json = await res.json();
        if (json.success) {
          form.style.display = 'none';
          successDiv.style.display = 'block';
          if (emailConfirm) emailConfirm.textContent = email;
        } else {
          alert(json.error || 'Something went wrong. Please try again.');
        }
      } catch(err) {
        alert('Network error. Please try again.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Claim My Priority Spot';
      }
    });
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal && modal.style.display === 'flex') {
      modal.style.display = 'none';
    }
  });

  // Initial render
  updatePrices();
})();
</script>