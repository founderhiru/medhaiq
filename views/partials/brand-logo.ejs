<%
const _sizeMap = { xs: 24, sm: 32, md: 48, lg: 64, xl: 80 }; 
const _size    = _sizeMap[typeof size !== 'undefined' ? size : 'md'] || 48;
const _variant = typeof variant !== 'undefined' ? variant : 'full';
const _href    = typeof href !== 'undefined' ? href : '/';
const _suffix  = typeof suffix !== 'undefined' ? suffix : '';
const _eager   = typeof eager !== 'undefined' ? eager : false;

const _iconH   = Math.round(_size * 0.60); 
const _iconW   = Math.round(_iconH * 1.467); // Locks the design asset's native aspect ratio
const _textS   = Math.round(_size * 0.56);
%>
<a href="<%= _href %>" class="brand-logo brand-logo-<%= _variant %>" style="display: inline-flex; align-items: center; gap: 11px; text-decoration: none; vertical-align: middle;" aria-label="MedhaIQ<%= _suffix %> home">
  <img
    src="/assets/branding/medhaiq-icon.png"
    alt="MedhaIQ"
    class="brand-logo__icon"
    width="<%= _iconW %>"
    height="<%= _iconH %>"
    style="height: <%= _iconH %>px; width: <%= _iconW %>px; object-fit: contain; flex-shrink: 0;"
    loading="<%= _eager ? 'eager' : 'lazy' %>"
    decoding="async"
  />
  <% if (_variant === 'full') { %>
    <span class="brand-logo__wordmark" style="font-size: <%= _textS %>px; font-weight: 600; letter-spacing: -0.035em; display: inline-flex; align-items: center; line-height: 1;">
      <span style="color: #ffffff;">Medha</span>
      <span style="background: linear-gradient(135deg, #3B82F6 0%, #4F6CF8 35%, #6C5CF5 70%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">IQ</span>
    </span>
  <% } %>
</a>