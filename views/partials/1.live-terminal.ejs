<!-- ══════════════════════════════════════════════════════════════
     live-terminal.ejs — RIGHT COLUMN (320px fixed)
     Visibility logic: the ENTIRE terminal container — both the
     Tactical (STAR checklist) and Strategic (Intelligence Score)
     views — is governed by a single header switch. Off by default;
     switching it "On" reveals both views together. The switch only
     animates this panel's own content height, so the fixed 3-column
     grid never reflows.
════════════════════════════════════════════════════════════════ -->
<div class="terminal-panel">

  <div class="term-header-static">
    <span class="term-toggle-title">Live Terminal</span>
  </div>

  <div class="term-content expanded" id="terminalContent">

    <!-- ══ TACTICAL VIEW ══ -->
    <div class="term-card">
      <div class="term-card-hdr">
        <span class="term-card-title">Live Terminal (Tactical View)</span>
      </div>

      <div class="ai-status-block">
        <div class="ai-status-ring-wrap">
          <svg viewBox="0 0 78 78">
            <circle class="ai-status-ring-bg" cx="39" cy="39" r="35"/>
            <circle class="ai-status-ring-fill" id="aiStatusRing" cx="39" cy="39" r="35"/>
          </svg>
        </div>
        <div class="ai-status-title" id="aiStatusTitle">Calibrating…</div>
        <div class="ai-status-sub" id="aiStatusSub">Setting up your session</div>
      </div>

      <div class="star-progress-lbl">STAR Progress <span>(Real-time Detection)</span></div>
      <div class="star-rail" id="starRail">
        <div class="star-node" id="starNode-situation"><div class="star-node-dot">S</div><div class="star-node-lbl">Situation</div></div>
        <div class="star-connector" id="starConn-1"></div>
        <div class="star-node" id="starNode-task"><div class="star-node-dot">T</div><div class="star-node-lbl">Task</div></div>
        <div class="star-connector" id="starConn-2"></div>
        <div class="star-node" id="starNode-action"><div class="star-node-dot">A</div><div class="star-node-lbl">Action</div></div>
        <div class="star-connector" id="starConn-3"></div>
        <div class="star-node" id="starNode-result"><div class="star-node-dot">R</div><div class="star-node-lbl">Result</div></div>
      </div>

      <div class="status-checklist" id="statusChecklist">
        <div class="status-item" data-step="captured"><span class="si-dot"></span>Answer captured</div>
        <div class="status-item" data-step="analyzing"><span class="si-dot"></span>Analyzing response</div>
        <div class="status-item" data-step="preparing"><span class="si-dot"></span>Preparing next question</div>
      </div>
    </div>

    <!-- ══ STRATEGIC VIEW — gauge is the focal point, 5-vector bars sit
         directly underneath it ══ -->
    <div class="term-card">
      <div class="term-card-hdr">
        <span class="term-card-title">Overall Intelligence Score (Strategic View)</span>
        <span class="term-card-live"><span class="dot"></span>LIVE</span>
      </div>

      <div class="lt-score-block">
        <div class="score-ring-wrap">
          <svg width="96" height="96" viewBox="0 0 78 78">
            <circle class="ring-bg" cx="39" cy="39" r="34"/>
            <circle class="ring-fill" id="ringFill" cx="39" cy="39" r="34"/>
          </svg>
          <div class="ring-label" id="ringLabel">—</div>
        </div>
        <div class="ring-out-of" id="ringOutOf">/ 100</div>
        <div class="ring-status" id="ringStatus"></div>
        <div class="ring-status-sub" id="ringStatusSub"></div>
      </div>

                 <div class="lt-vec-lbl">5-Vector Intelligence</div>
      <div class="metric-row">
        <span class="metric-icon">‚ö°</span>
        <div class="metric-body"><div class="metric-lbl">Structure</div>
          <div class="metric-track"><div class="metric-fill" id="mStar" style="background:#3b82f6;"></div></div></div>
        <span class="metric-val" id="mStarV" style="color:#3b82f6;">‚Äî</span>
      </div>
      <div class="metric-row">
        <span class="metric-icon">üß†</span>
        <div class="metric-body"><div class="metric-lbl">Domain Expertise</div>
          <div class="metric-track"><div class="metric-fill" id="mTech" style="background:#a78bfa;"></div></div></div>
        <span class="metric-val" id="mTechV" style="color:#a78bfa;">‚Äî</span>
      </div>
      <div class="metric-row">
        <span class="metric-icon">üëî</span>
        <div class="metric-body"><div class="metric-lbl">Strategic Thinking</div>
          <div class="metric-track"><div class="metric-fill" id="mExec" style="background:#22c55e;"></div></div></div>
        <span class="metric-val" id="mExecV" style="color:#22c55e;">‚Äî</span>
      </div>
      <div class="metric-row">
        <span class="metric-icon">üí¨</span>
        <div class="metric-body"><div class="metric-lbl">Communication</div>
          <div class="metric-track"><div class="metric-fill" id="mFric" style="background:#fb923c;"></div></div></div>
        <span class="metric-val" id="mFricV" style="color:#fb923c;">‚Äî</span>
      </div>
      <div class="metric-row">
        <span class="metric-icon">üåê</span>
        <div class="metric-body"><div class="metric-lbl">Leadership & Execution</div>
          <div class="metric-track"><div class="metric-fill" id="mGcc" style="background:#f59e0b;"></div></div></div>
        <span class="metric-val" id="mGccV" style="color:#f59e0b;">‚Äî</span>
      </div>

      <div class="lt-footer pulsing" id="ltFooter">‚ö° Analyzing in real-time</div>
    </div>

  </div><!-- /term-content -->
</div><!-- /terminal-panel -->
