<%
/* Featured Company Card — expects `company` in locals (one item from
   companyLibrary). Same card-link pattern as explore-company-card.ejs,
   reused here rather than duplicated: .mh-explore-card / .mh-explore-card-btn
   / .mh-explore-card-link. */
%>
<a href="/explore/company-library/<%= company.slug %>" class="mh-explore-card-btn" role="listitem" aria-label="<%= company.name %> interview guide">
  <div class="mh-explore-card mh-colib-featured-card">
    <div class="mh-colib-featured-top">
      <div class="mh-explore-company-logo" aria-hidden="true"><%= company.logo %></div>
      <span class="mh-explore-pill mh-explore-pill-blue"><%= company.category %></span>
    </div>
    <div>
      <div class="mh-explore-company-name"><%= company.name %></div>
      <div class="mh-explore-company-sub"><%= company.tagline %></div>
    </div>
    <span class="mh-explore-card-link">
      Explore
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg>
    </span>
  </div>
</a>
