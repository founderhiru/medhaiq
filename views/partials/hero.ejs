    display: flex;
    align-items: center;
    gap: 6px;
  }

  .mh-vector-line {
    flex: 1;
    height: 2px;
    background: rgba(148, 163, 184, 0.12);
    margin: 0 6px;
    border-radius: 1px;
  }

  /* Responsive Fallbacks */
