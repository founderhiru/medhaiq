    padding: 20px;
    box-shadow: -18px 24px 40px rgba(0, 0, 0, 0.75);
    transform: translateZ(0px);
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-sizing: border-box;
  }

  /* FRONT CARD: Live Interview Terminal */
  .mh-card-terminal {
    position: absolute;
    right: 10px; /* Anchored inset to guarantee zero truncation */
    top: -10px;
    width: 56%;
    height: 530px;
    background: #050a15;
    border: 1.5px solid #3b82f6;
    border-radius: 18px;
