  .mh-hero-chip-icon-magenta svg { filter: drop-shadow(0 0 6px rgba(251, 113, 133, 0.9)) brightness(1.4); }

  /* Fix 3: See How It Works Arrow & Text Highlight */
  .mh-hero-tertiary {
    transition: all 0.3s ease;
  }
  .mh-hero-tertiary:hover {
    color: #3B82F6 !important;
  }
