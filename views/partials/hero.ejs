    stroke: #3B82F6 !important;
    filter: drop-shadow(0 0 6px rgba(59, 130, 246, 0.8));
  }

  /* Responsive Fallback */
  @media (max-width: 1024px) {
    .mh-hero-product-stack {
      height: auto;
      flex-direction: column;
      align-items: center;
      margin-top: 0;
    }
    .mh-career-mock,
