    .mh-hero-signature { font-size: 18px; }
    .mh-hero-actions { flex-direction: column; align-items: stretch; }
    .mh-btn-primary, .mh-btn-outline { justify-content: center; }
    .mh-ii { padding: 0 0 22px; }
    .mh-ii-win { padding: 12px 12px 12px; }
    .mh-ii-body { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .mh-ii-a { min-height: 150px; }
    .mh-ii-chip { right: 6px; bottom: 0; }
  }
</style>

