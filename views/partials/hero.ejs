  .mh-ii-box { padding-top: 10px; border-top: 1px solid rgba(150,180,255,.12); }
  .mh-ii-rail { display: flex; align-items: flex-start; }
  .mh-ii-step { display: flex; flex-direction: column; align-items: center; gap: 3px; min-width: 40px; }
  .mh-ii-node { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11.5px; font-weight: 700; border: 1px solid #2A3450; color: #8A94A8; transition: all .3s; }
