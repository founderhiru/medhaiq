  }

  /* Right Column 4D Stage (Adjusted offset & perspectives to eliminate right clipping) */
  .mh-stage-4d {
    flex: 1.2;
    position: relative;
    height: 560px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    perspective: 1200px;
    perspective-origin: 50% 50%;
    padding-right: 40px; /* Essential inner padding to protect border glow */
    box-sizing: border-box;
  }

  .mh-card-group {
    position: relative;
    width: 100%;
    max-width: 680px;
    height: 520px;
    transform-style: preserve-3d;
    transform: rotateY(-9deg) rotateX(3deg);
  }

  .mh-card-group::before {
    content: '';
    position: absolute;
    inset: -15px;
    background: radial-gradient(circle at 75% 50%, rgba(59, 130, 246, 0.35), rgba(139, 92, 246, 0.15), transparent 70%);
    filter: blur(40px);
    z-index: 0;
    pointer-events: none;
  }

