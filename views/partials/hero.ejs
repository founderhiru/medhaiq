<style>
  /* 1. Pulsing Green Indicator Animation */
  @keyframes mh-live-pulse {
    0% {
      opacity: 1;
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.85);
      box-shadow: 0 0 8px 2px rgba(16, 185, 129, 0.9);
    }
    100% {
      opacity: 1;
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    }
  }

  .mh-live-dot {
    width: 7px;
    height: 7px;
    background-color: #10B981;
    border-radius: 50%;
    display: inline-block;
    animation: mh-live-pulse 1.8s infinite ease-in-out;
  }

  /* 2. Hero Stage (10% Wider & Enhanced 3D Perspective) */
  .mh-hero-product-stack {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    max-width: 900px;
    height: 540px;
    margin-top: -10px;
    perspective: 1600px;
    perspective-origin: 55% 45%;
  }

  /* REAR CARD: CAREER WORKSPACE (Jointed & 4D Embedded Shadow) */
  .mh-career-mock {
    position: absolute;
    right: 250px;
    top: 15px;
    width: 530px;
    height: 495px;
    background: #0B1226;
    border: 1.5px solid rgba(59, 130, 246, 0.45);
    border-radius: 18px;
    padding: 22px;
    z-index: 1;
    transform-style: preserve-3d;
    transform: rotateY(-18deg) rotateX(7deg) rotateZ(2deg);
    box-shadow: 
      0 0 25px rgba(59, 130, 246, 0.35),
      -25px 35px 70px rgba(0, 0, 0, 0.85),
      inset 0 0 15px rgba(59, 130, 246, 0.15);
    overflow: hidden;
  }

  .mh-career-mock-card {
    background: #0F172A;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 12px;
    padding: 12px 14px;
  }

  /* FRONT CARD: LIVE INTERVIEW TERMINAL (10% Wider + Intense 4D Neon Edge Glow) */
  .mh-hero-mockup-wrap {
    position: absolute;
    right: 0px;
    top: 0px;
    width: 340px;
    height: 525px;
    z-index: 2;
    transform-style: preserve-3d;
    transform: rotateY(-18deg) rotateX(7deg) rotateZ(2deg);
  }

  .mh-terminal-v2 {
    height: 100%;
    background: #060B17;
    border: 1.5px solid #3B82F6;
    border-radius: 18px;
    padding: 14px 16px;
    /* Elevated 4D/3D Neon Blue Highlight applied here */
    box-shadow: 
      0 0 40px rgba(59, 130, 246, 0.75),
      -20px 30px 60px rgba(0, 0, 0, 0.95),
      inset 0 0 20px rgba(59, 130, 246, 0.5),
      inset 0 0 5px rgba(255, 255, 255, 0.3);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  .mh-terminal-v2-body {
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
    height: calc(100% - 28px);
    justify-content: space-between;
  }

  .mh-terminal-v2-block {
    padding: 6px 10px !important;
    margin-bottom: 0 !important;
    background: rgba(15, 23, 42, 0.75);
    border-radius: 8px;
    border: 1px solid rgba(148, 163, 184, 0.1);
  }

  .mh-terminal-v2-header {
    padding-bottom: 4px;
    margin-bottom: 4px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.15);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mh-terminal-v2-engine {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mh-terminal-v2-ring-svg {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
  }

  /* 5-Vector List Styles matching Live Engine */
  .mh-terminal-v2-vectors {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .mh-terminal-v2-vectors li {
    font-size: 10px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: #CBD5E1;
  }

  .mh-vector-bar {
    flex: 1;
    height: 3px;
    background: rgba(148, 163, 184, 0.15);
    border-radius: 2px;
    margin: 0 4px;
  }

