<style>
  /* Base Container Staging */
  .mh-hero-container {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .mh-hero-content {
    flex: 1;
    max-width: 500px;
  }

  /* 4D Perspective Stage */
  .mh-stage-4d {
    flex: 1.25;
    position: relative;
    height: 600px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    perspective: 1500px;
    perspective-origin: 65% 45%;
  }

  .mh-card-group {
    position: relative;
    width: 100%;
    max-width: 860px;
    height: 580px;
    transform-style: preserve-3d;
    transform: rotateY(-18deg) rotateX(8deg) rotateZ(2deg);
  }

  /* Ambient Glow Effect Behind Cards */
  .mh-card-group::before {
    content: '';
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle at 75% 50%, rgba(59, 130, 246, 0.35), rgba(139, 92, 246, 0.18), transparent 70%);
    filter: blur(45px);
    z-index: 0;
    pointer-events: none;
  }

  /* REAR CARD: Career Workspace */
  .mh-card-workspace {
    position: absolute;
    left: 0;
    top: 40px;
    width: 52%;
    height: 520px;
    background: linear-gradient(145deg, #0b1226 0%, #070d19 100%);
    border: 1px solid rgba(59, 130, 246, 0.35);
    border-radius: 18px;
    padding: 22px;
    box-shadow: 
      -18px 24px 40px rgba(0, 0, 0, 0.75),
      inset 0 1px 1px rgba(255, 255, 255, 0.12);
    transform: translateZ(0px);
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* FRONT CARD: Live Interview Terminal (10%+ Taller, Wider) */
  .mh-card-terminal {
    position: absolute;
    right: -8%;
    top: -10px;
    width: 58%;
    height: 580px;
    background: #050a15;
    border: 1.5px solid #3b82f6;
    border-radius: 18px;
    padding: 20px 18px;
    box-shadow: 
      0 0 35px rgba(59, 130, 246, 0.5),
      -22px 28px 50px rgba(0, 0, 0, 0.85),
      inset 0 0 18px rgba(59, 130, 246, 0.22);
    transform: translateZ(45px);
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Live Dot Pulse Animation */
  .mh-live-pulse {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10b981;
    display: inline-block;
    animation: mhPulse 2s infinite;
  }

  @keyframes mhPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* Structural UI Widgets */
  .mh-badge {
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: #60a5fa;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .mh-metric-box {
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(148, 163, 184, 0.12);
    border-radius: 10px;
    padding: 10px 12px;
  }

  .mh-vector-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 10.5px;
    color: #94a3b8;
    margin-bottom: 6px;
  }

  .mh-vector-row-left {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .mh-vector-line {
    flex: 1;
    height: 2px;
    background: rgba(148, 163, 184, 0.12);
    margin: 0 8px;
    border-radius: 1px;
  }

  /* Sparkline Graph Styling */
  .mh-sparkline-svg {
    width: 100%;
    height: 22px;
    overflow: visible;
  }

  /* Mobile Responsive Stacking */
  @media (max-width: 968px) {
    .mh-hero-container { flex-direction: column; }
    .mh-stage-4d { height: auto; width: 100%; perspective: none; }
    .mh-card-group { transform: none; height: auto; display: flex; flex-direction: column; gap: 16px; }
    .mh-card-workspace, .mh-card-terminal { position: relative; width: 100%; height: auto; transform: none; top: 0; right: 0; }
  }
</style>

