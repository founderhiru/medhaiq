  .mh-live-dot {
    width: 7px;
    height: 7px;
    background-color: #10B981;
    border-radius: 50%;
    display: inline-block;
    animation: mh-live-pulse 1.8s infinite ease-in-out;
  }
  .mh-hero-tagline {
    font-size: 17px; font-weight: 600; letter-spacing: -0.005em; line-height: 1.4;
    color: #1D4ED8; margin: -6px 0 16px 0;
  }

  /* ── Live interview + intelligence showcase (illustrative; no API calls, no audio, no photos) ── */
  .mh-ii { position: relative; width: 100%; max-width: 640px; margin-left: auto; padding: 18px 0 26px; }
  .mh-ii-orb { position: absolute; border-radius: 50%; filter: blur(46px); pointer-events: none; z-index: 0; animation: mh-ii-drift 14s ease-in-out infinite alternate; }
  .mh-ii-orb.o1 { width: 300px; height: 300px; right: -60px; top: -10px; background: radial-gradient(circle, rgba(91,155,255,.55), transparent 70%); }
  .mh-ii-orb.o2 { width: 260px; height: 260px; left: -40px; bottom: 10px; background: radial-gradient(circle, rgba(139,92,246,.38), transparent 70%); animation-delay: -6s; }
  .mh-ii-card { position: relative; z-index: 1; border-radius: 22px; padding: 1px; background: linear-gradient(160deg, rgba(111,166,255,.9), rgba(139,92,246,.35) 45%, rgba(150,180,255,.14)); box-shadow: 0 40px 90px -26px rgba(8,15,40,.65); animation: mh-ii-in .7s ease-out both; }
  .mh-ii-win { border-radius: 21px; background: linear-gradient(180deg, #0E1A3C 0%, #0A1330 100%); color: #EAF0FF; padding: 14px 16px 12px; }
  .mh-ii-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding-bottom: 12px; border-bottom: 1px solid rgba(150,180,255,.12); font: 600 10.5px ui-monospace, Menlo, Consolas, monospace; letter-spacing: .08em; color: #93A3C4; }
  .mh-ii-top b { color: #EAF0FF; font-weight: 700; }
