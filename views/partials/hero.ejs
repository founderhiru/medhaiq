    50% {
      opacity: 0.4;
      transform: scale(0.85);
      box-shadow: 0 0 8px 2px rgba(16, 185, 129, 0.9);
    }
    100% {
      opacity: 1;
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    }
