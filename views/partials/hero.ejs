  .mh-ii-node.done { border-color: rgba(34,197,94,.55); color: #22C55E; background: rgba(34,197,94,.12); }
  .mh-ii-node.missed { border-color: #EF4444; color: #EF4444; box-shadow: 0 0 0 2px rgba(239,68,68,.35); }
  .mh-ii-conn { flex: 1; min-width: 6px; height: 1px; background: #2A3450; margin-top: 14px; transition: background .3s; }
