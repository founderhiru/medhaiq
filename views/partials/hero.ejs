        <a href="#how-it-works" class="mh-hero-tertiary">
          <span class="mh-hero-tertiary-icon">
            <svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 4.2v11.6a1 1 0 0 0 1.53.85l9.2-5.8a1 1 0 0 0 0-1.7l-9.2-5.8A1 1 0 0 0 6 4.2Z" stroke-linejoin="round"/></svg>
          </span>
          See How It Works
        </a>
      </div>
    </div>


    <!-- Right Column: live interview + intelligence showcase. Illustrative sample only:
         no network calls, no audio, no photos. -->
    <div class="mh-ii" id="mh-ii" data-spk="none" role="region" aria-label="Illustrative sample of a MedhaIQ live interview and its intelligence results">
      <p class="mh-sr-only">Illustrative sample, not a real assessment. An AI interviewer asks a question, a sample answer appears, STAR evidence is detected, a follow-up is asked, and the overall score and five vectors improve.</p>
      <span class="mh-ii-orb o1" aria-hidden="true"></span><span class="mh-ii-orb o2" aria-hidden="true"></span>
      <div class="mh-ii-card"><div class="mh-ii-win">
        <div class="mh-ii-top">
          <span class="lv"><i></i><b>LIVE INTERVIEW</b> &middot; sample</span>
          <button type="button" class="mh-ii-pause" id="mh-ii-pause" aria-pressed="false">PAUSE</button>
        </div>
        <div class="mh-ii-body" aria-hidden="true">
          <div class="mh-ii-col">
            <div>
              <div class="mh-ii-h"><span>AI INTERVIEWER</span><em><span class="mh-ii-wave a" id="mh-ii-wa"></span><span id="mh-ii-stat">READY</span></em></div>
              <div class="mh-ii-q" id="mh-ii-q"></div>
            </div>
            <div>
              <div class="mh-ii-h"><span>YOUR ANSWER (SAMPLE)</span><em class="you"><span class="mh-ii-wave y" id="mh-ii-wy"></span></em></div>
              <div class="mh-ii-a"><span id="mh-ii-at"></span><span class="mh-ii-caret" id="mh-ii-caret" style="display:none"></span></div>
            </div>
            <div class="mh-ii-ins"><b>&#9728;</b><p id="mh-ii-ins"><small>AI INSIGHT</small><span id="mh-ii-it">&nbsp;</span></p></div>
          </div>
          <div class="mh-ii-col">
            <div class="mh-ii-score">
              <div class="mh-ii-ring">
                <svg viewBox="0 0 84 84"><defs><linearGradient id="mh-ii-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5B9BFF"/><stop offset="1" stop-color="#A78BFA"/></linearGradient></defs><circle class="bg" cx="42" cy="42" r="35"/><circle class="fg" id="mh-ii-fg" cx="42" cy="42" r="35"/></svg>
                <b><span id="mh-ii-num">--</span><small>/100</small></b>
              </div>
              <div class="mh-ii-st"><div class="mh-ii-h" style="margin-bottom:4px"><span>OVERALL SCORE</span></div><strong id="mh-ii-ttl">Listening&hellip;</strong><span id="mh-ii-sub">Scored as you speak.</span></div>
            </div>
            <div class="mh-ii-box">
              <div class="mh-ii-h"><span>STAR PROGRESS</span></div>
              <div class="mh-ii-rail" id="mh-ii-rail">
                <div class="mh-ii-step"><span class="mh-ii-node">S</span><small>Situation</small></div><span class="mh-ii-conn"></span>
                <div class="mh-ii-step"><span class="mh-ii-node">T</span><small>Task</small></div><span class="mh-ii-conn"></span>
                <div class="mh-ii-step"><span class="mh-ii-node">A</span><small>Action</small></div><span class="mh-ii-conn"></span>
                <div class="mh-ii-step"><span class="mh-ii-node">R</span><small>Result</small></div>
              </div>
              <div class="mh-ii-snote" id="mh-ii-snote"></div>
            </div>
            <div class="mh-ii-box"><div class="mh-ii-h"><span>5-VECTOR INTELLIGENCE</span></div><div id="mh-ii-vecs"></div></div>
          </div>
        </div>
        <div class="mh-ii-foot" aria-hidden="true">Sample session &middot; illustrative content, not a real assessment</div>
      </div></div>
      <div class="mh-ii-chip" id="mh-ii-b" aria-hidden="true"><i>&#8593;</i><span>Structure +11 with a measurable result</span></div>
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('mh-ii');
  if (!root) return;
  var $ = function (id) { return document.getElementById(id); };
  var Q1 = 'Tell me about a time you influenced a difficult decision.';
  var Q2 = 'What was the measurable result of that decision?';
  // Sample answer, split by STAR part so each part is highlighted when the engine "detects" it.
  var SEG = [
    ['s', 'We had two weeks and three regions with uneven data, '],
    ['t', 'so my task was to recommend where to focus first. '],
    ['a', 'I ranked regions by revenue at risk and aligned the team on one trade-off. '],
    ['r', 'Escalations fell 18% in six weeks.']
  ];
  var NAMES = ['Structure', 'Domain Expertise', 'Strategic Thinking', 'Communication', 'Leadership & Execution'];
  var COL = ['#3B82F6', '#A78BFA', '#22C55E', '#FB923C', '#F59E0B'];
  var V1 = [74, 72, 70, 62, 76], V2 = [85, 80, 78, 66, 82];
  var LOOP = 21000, t = 0, paused = false, visible = true, reduced = false, C = 220, lastKey = '';
  try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
  ['mh-ii-wa', 'mh-ii-wy'].forEach(function (id) { var w = $(id); for (var i = 0; i < 7; i++) w.appendChild(document.createElement('i')); });
  var vecs = $('mh-ii-vecs');
  NAMES.forEach(function (n, i) { var r = document.createElement('div'); r.className = 'mh-ii-vec'; r.style.setProperty('--c', COL[i]); r.innerHTML = '<i></i><span>' + n.replace('&', '&amp;') + '</span><em>--</em><div class="mh-ii-bar"><i></i></div>'; vecs.appendChild(r); });
  var bars = vecs.querySelectorAll('.mh-ii-bar i'), nums = vecs.querySelectorAll('em');
  var nodes = $('mh-ii-rail').querySelectorAll('.mh-ii-node'), conns = $('mh-ii-rail').querySelectorAll('.mh-ii-conn');
  var at = $('mh-ii-at'), bEl = $('mh-ii-b');
  function setText(el, v) { if (el.textContent !== v) el.textContent = v; }
  function slice(s, from, to) { var p = Math.max(0, Math.min(1, (t - from) / (to - from))); return s.slice(0, Math.round(s.length * p)); }
  // Typed answer: each segment is typed within its own window, so highlights line up with the STAR detection.
  var WIN = [[3200, 5000], [5200, 6600], [6800, 8800], [13200, 14800]];
  function answerHTML() {
    var h = '', i;
    for (i = 0; i < SEG.length; i++) {
      var typed = slice(SEG[i][1], WIN[i][0], WIN[i][1]);
      if (!typed) continue;
      var on = (i === 0 && t >= 5000) || (i === 1 && t >= 6600) || (i === 2 && t >= 8800) || (i === 3 && t >= 14800);
      h += '<mark class="' + SEG[i][0] + (on ? ' on' : '') + '">' + typed + '</mark>';
    }
    return h;
  }
  // Timeline (ms): 400 asks | 3200 you answer S | 5200 T | 6800 A | 9600 scored (R missing) | 10600 follow-up | 13200 you add the result | 14800 full STAR | 19000 hold | 21000 loop
  function render() {
    var spk = 'none', stat = 'READY', q = '';
    if (t >= 400 && t < 3200) { spk = 'ai'; stat = 'SPEAKING'; q = slice(Q1, 400, 2800); }
    else if (t >= 3200 && t < 10600) { spk = 'you'; stat = 'LISTENING'; q = Q1; }
    else if (t >= 10600 && t < 13200) { spk = 'ai'; stat = 'FOLLOW-UP'; q = slice(Q2, 10600, 12800); }
    else if (t >= 13200) { spk = 'you'; stat = 'LISTENING'; q = Q2; }
    root.setAttribute('data-spk', spk); setText($('mh-ii-stat'), stat); setText($('mh-ii-q'), q);
    var live = (t >= 3200 && t < 9600) || (t >= 13200 && t < 14800);
    $('mh-ii-caret').style.display = live ? 'inline-block' : 'none';
    if (t < 3200) at.innerHTML = ''; else at.innerHTML = answerHTML();
    var det = [t >= 5000, t >= 6600, t >= 8800, t >= 14800], fin1 = t >= 9600, fin2 = t >= 15600, k;
    for (k = 0; k < 4; k++) nodes[k].className = 'mh-ii-node' + (det[k] ? ((k < 3 ? fin1 : fin2) ? ' done' : ' active') : (fin1 && k === 3 ? ' missed' : ''));
    for (k = 0; k < 3; k++) conns[k].className = 'mh-ii-conn' + (det[k] && det[k + 1] && (k < 2 ? fin1 : fin2) ? ' done' : '');
    var sn = $('mh-ii-snote');
    sn.className = 'mh-ii-snote' + (fin2 ? ' ok' : (fin1 ? ' miss' : ''));
    setText(sn, fin2 ? '\u2713 Full STAR structure \u2014 all four components covered' : (fin1 ? '\u2715 This answer missed: Result' : ''));
    var V = fin2 ? V2 : (fin1 ? V1 : null), sc = fin2 ? 78 : (fin1 ? 71 : 0);
    for (k = 0; k < 5; k++) { bars[k].style.width = V ? V[k] + '%' : '0'; setText(nums[k], V ? String(V[k]) : '--'); }
    $('mh-ii-fg').style.strokeDashoffset = C * (1 - sc / 100); setText($('mh-ii-num'), sc ? String(sc) : '--');
    setText($('mh-ii-ttl'), fin2 ? 'Strong, complete answer' : (fin1 ? 'Good start' : 'Listening\u2026'));
    setText($('mh-ii-sub'), fin2 ? 'Structure and impact are clear.' : (fin1 ? 'Result missing, so a follow-up was asked.' : 'Scored as you speak.'));
    var ins = fin2 ? 'Complete STAR answer. Quantified results lift Structure and Strategic Thinking.' : (fin1 ? 'Clear situation and action. Add a measurable result to strengthen Structure.' : '');
    setText($('mh-ii-it'), ins || '\u00a0');
    bEl.className = 'mh-ii-chip' + (t >= 16000 && t < 20000 ? ' on' : '');
  }
  var pb = $('mh-ii-pause');
  if (reduced) { pb.style.display = 'none'; t = 18000; render(); return; }
  pb.addEventListener('click', function () { paused = !paused; pb.setAttribute('aria-pressed', paused ? 'true' : 'false'); pb.textContent = paused ? 'PLAY' : 'PAUSE'; });
  try { new IntersectionObserver(function (e) { visible = e[0].isIntersecting; }, { threshold: 0.15 }).observe(root); } catch (e) {}
  render();
  var last = Date.now();
  setInterval(function () {
    var now = Date.now(), dt = now - last; last = now;
    if (paused || !visible || document.hidden) return;
    t += Math.min(dt, 250); if (t >= LOOP) t = 0;
    render();
  }, 100);
})();
</script>
