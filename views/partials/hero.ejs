         no network calls, no audio. Images are static files with graceful fallback:
         /images/home/hero-interviewer.jpg and /images/home/hero-you.jpg -->
    <div class="mh-ws" id="mh-ws" data-speaker="none" role="region" aria-label="Illustrative sample interview">
      <p class="mh-sr-only">Illustrative sample, not a live interview. An AI interviewer asks a question, a sample answer appears, and STAR evidence and five assessment vectors fill in.</p>
      <div class="mh-ws-frame"><div class="mh-ws-win">
        <div class="mh-ws-bar">
          <span class="mh-ws-live"><i></i><b>SAMPLE INTERVIEW</b> &middot; illustrative</span>
          <span style="display:inline-flex;align-items:center;gap:10px"><span class="mh-ws-qn">QUESTION 4 OF 8</span><button type="button" class="mh-ws-pause" id="mh-ws-pause" aria-pressed="false">PAUSE</button></span>
        </div>
        <div class="mh-ws-body" aria-hidden="true">
          <div class="mh-ws-main">
            <div class="mh-ws-video" id="mh-ws-video">
              <img class="mh-ws-photo" src="/images/home/hero-interviewer.jpg" alt="" width="1200" height="945" decoding="async" fetchpriority="high" onerror="this.parentNode.classList.add('noimg')">
              <div class="mh-ws-fallback"><svg viewBox="0 0 200 240"><defs><linearGradient id="mh-ws-g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5B9BFF" stop-opacity=".9"/><stop offset="1" stop-color="#5B9BFF" stop-opacity=".2"/></linearGradient></defs><path d="M22 240C22 176 62 150 100 150S178 176 178 240Z" fill="url(#mh-ws-g)"/><circle cx="100" cy="92" r="35" fill="url(#mh-ws-g)"/></svg></div>
              <div class="mh-ws-tags"><span class="mh-ws-tag"><i></i><span id="mh-ws-status">READY</span></span><span class="mh-ws-tag lvl">Elite</span></div>
              <div class="mh-ws-plate"><b>Priya Ramesh</b><span>Partner &middot; McKinsey Consulting</span></div>
              <div class="mh-ws-you" id="mh-ws-you"><img src="/images/home/hero-you.jpg" alt="" width="400" height="320" decoding="async" onerror="this.parentNode.classList.add('noimg')"><em>YOU</em><span class="mh-ws-mic"><i></i><i></i><i></i></span></div>
              <div class="mh-ws-cap"><span class="mh-ws-wave" id="mh-ws-wave"></span><p id="mh-ws-qtext"></p></div>
            </div>
            <div class="mh-ws-ctl"><span id="mh-ws-clock">00:00 / 01:00</span><span class="mh-ws-btns"><span>&#127908;</span><span>&#127909;</span><span class="end">END</span></span></div>
            <div class="mh-ws-tr"><h5>YOUR RESPONSE (SAMPLE)</h5><p><span id="mh-ws-atext"></span><span class="mh-ws-caret" id="mh-ws-caret" style="display:none"></span></p></div>
          </div>
          <div class="mh-ws-side">
            <div class="mh-ws-box"><h4>STAR EVIDENCE</h4>
              <div class="mh-ws-starwrap">
                <div class="mh-ws-ring"><svg viewBox="0 0 64 64"><circle class="bg" cx="32" cy="32" r="24"/><circle class="fg" id="mh-ws-fg" cx="32" cy="32" r="24"/></svg><b id="mh-ws-cnt">0/4</b></div>
                <div class="mh-ws-star" id="mh-ws-star"><div><i></i>Situation</div><div><i></i>Task</div><div><i></i>Action</div><div class="miss"><i></i>Result</div></div>
              </div>
            </div>
            <div class="mh-ws-box"><h4>SAMPLE INSIGHT</h4><div class="mh-ws-ins" id="mh-ws-ins">Clear situation and action. No measurable result yet, so a follow-up is likely.</div></div>
            <div class="mh-ws-box"><h4>5-VECTOR ASSESSMENT</h4><div id="mh-ws-vecs"></div></div>
          </div>
        </div>
        <div class="mh-ws-note">Sample session &middot; illustrative content, not a real assessment</div>
      </div></div>
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('mh-ws');
  if (!root) return;
  var $ = function (id) { return document.getElementById(id); };
  var Q = 'Tell me about a time you influenced a difficult decision.';
  var A = 'We had two weeks and three regions with uneven data, so I ranked regions by revenue at risk, aligned the team on one trade-off, and started where a wrong call would cost the most.';
  var F = 'What was the measurable result of that decision?';
  var VEC = [['Structure', 85, '#3DDBA9'], ['Domain', 80, '#5B9BFF'], ['Strategy', 78, '#A78BFA'], ['Communication', 66, '#F0B94B'], ['Leadership', 82, '#F472B6']];
  var LOOP = 19000, t = 0, paused = false, visible = true, reduced = false;
  try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
  var wave = $('mh-ws-wave'); for (var i = 0; i < 18; i++) wave.appendChild(document.createElement('i'));
  var vecs = $('mh-ws-vecs');
  VEC.forEach(function (v) { var r = document.createElement('div'); r.className = 'mh-ws-vec'; r.innerHTML = '<span>' + v[0] + '</span><div class="mh-ws-bar2"><i style="--c:' + v[2] + '"></i></div><em>' + v[1] + '</em>'; vecs.appendChild(r); });
  var bars = vecs.querySelectorAll('.mh-ws-bar2 i'), nums = vecs.querySelectorAll('em'), star = $('mh-ws-star').children;
  var C = 150.8;
  function slice(s, from, to) { var p = Math.max(0, Math.min(1, (t - from) / (to - from))); return s.slice(0, Math.round(s.length * p)); }
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  // Timeline (ms): 0 ready | 900 asks | 4200 you answer | 9600 STAR | 11200 insight | 12000 vectors | 13600 follow-up | 17000 hold | 19000 loop
  function render() {
    var speaker = 'none', status = 'READY', q = '';
    if (t >= 900 && t < 4200) { speaker = 'ai'; status = 'SPEAKING'; q = slice(Q, 900, 3600); }
    else if (t >= 4200 && t < 13600) { speaker = 'you'; status = 'LISTENING'; q = Q; }
    else if (t >= 13600 && t < 17000) { speaker = 'ai'; status = 'FOLLOW-UP'; q = slice(F, 13600, 15600); }
    else if (t >= 17000) { status = 'LISTENING'; q = F; }
    root.setAttribute('data-speaker', speaker);
    $('mh-ws-status').textContent = status; $('mh-ws-qtext').textContent = q;
    $('mh-ws-atext').textContent = t >= 4200 ? slice(A, 4500, 9400) : '';
    $('mh-ws-caret').style.display = (t >= 4200 && t < 13600) ? 'inline-block' : 'none';
    var on = [t >= 9600, t >= 9600, t >= 10000, t >= 10400], n = 0;
    for (var s = 0; s < 4; s++) { star[s].className = (on[s] ? 'on' : '') + (s === 3 ? ' miss' : ''); if (on[s] && s < 3) n++; }
    $('mh-ws-fg').style.strokeDashoffset = C * (1 - n / 4); $('mh-ws-cnt').textContent = n + '/4';
    $('mh-ws-ins').className = 'mh-ws-ins' + (t >= 11200 ? ' on' : '');
    for (var k = 0; k < bars.length; k++) { var o = t >= 12000 + k * 150; bars[k].style.width = o ? VEC[k][1] + '%' : '0'; nums[k].style.opacity = o ? 1 : 0; }
    $('mh-ws-clock').textContent = '00:' + pad(Math.min(59, Math.floor(t / 1000 * 3))) + ' / 01:00';
  }
  var pb = $('mh-ws-pause');
  if (reduced) { pb.style.display = 'none'; t = 18000; render(); return; }
  pb.addEventListener('click', function () { paused = !paused; pb.setAttribute('aria-pressed', paused ? 'true' : 'false'); pb.textContent = paused ? 'PLAY' : 'PAUSE'; });
  try { new IntersectionObserver(function (e) { visible = e[0].isIntersecting; }, { threshold: 0.15 }).observe(root); } catch (e) {}
  render();
  var last = Date.now();
  setInterval(function () {
    var now = Date.now(), dt = now - last; last = now;
    if (paused || !visible || document.hidden) return;
    t += Math.min(dt, 250); if (t >= LOOP) t = 0;
    render();
  }, 100);
})();
</script>
