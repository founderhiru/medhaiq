  .mh-ii-top .lv i { width: 7px; height: 7px; border-radius: 50%; background: #3DDBA9; animation: mh-live-pulse 1.8s infinite ease-in-out; }
  .mh-ii-pause { appearance: none; border: 1px solid rgba(150,180,255,.25); background: rgba(255,255,255,.05); color: #D6E4FF; border-radius: 999px; font: 600 10px ui-monospace, Menlo, monospace; letter-spacing: .06em; padding: 4px 10px; cursor: pointer; }
  .mh-ii-pause:hover { background: rgba(255,255,255,.1); } .mh-ii-pause:focus-visible { outline: 2px solid #5B9BFF; outline-offset: 2px; }
  .mh-ii-body { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); gap: 16px; padding-top: 14px; }
  .mh-ii-col { display: grid; gap: 10px; align-content: start; min-width: 0; }
  /* conversation */
  .mh-ii-h { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 0 0 6px; font: 600 9.5px ui-monospace, Menlo, monospace; letter-spacing: .1em; color: #93A3C4; }
  .mh-ii-h em { font-style: normal; display: inline-flex; align-items: center; gap: 6px; color: #5B9BFF; }
  .mh-ii-h em.you { color: #3DDBA9; }
  .mh-ii-wave { display: inline-flex; gap: 2px; align-items: center; height: 12px; }
  .mh-ii-wave i { width: 2.5px; height: 100%; border-radius: 2px; background: currentColor; transform: scaleY(.2); }
  .mh-ii[data-spk="ai"] .mh-ii-wave.a i, .mh-ii[data-spk="you"] .mh-ii-wave.y i { animation: mh-ii-eq .9s ease-in-out infinite; }
  .mh-ii-wave i:nth-child(2n) { animation-delay: -.3s; } .mh-ii-wave i:nth-child(3n) { animation-delay: -.6s; }
  .mh-ii-q { padding: 11px 13px; border-radius: 14px 14px 14px 4px; background: linear-gradient(135deg, rgba(47,107,255,.28), rgba(139,92,246,.2)); border: 1px solid rgba(111,166,255,.35); font-size: 14px; line-height: 1.45; font-weight: 600; color: #fff; min-height: 66px; }
  .mh-ii-a { padding: 11px 13px; border-radius: 14px; background: rgba(255,255,255,.04); border: 1px solid rgba(150,180,255,.16); font-size: 12.5px; line-height: 1.6; color: #C5D2EE; min-height: 142px; }
  .mh-ii-a mark { background: none; color: inherit; border-radius: 4px; padding: 1px 0; box-shadow: inset 0 -2px 0 transparent; transition: background .4s, box-shadow .4s, color .4s; }
  .mh-ii-a mark.s.on { background: rgba(59,130,246,.2); box-shadow: inset 0 -2px 0 #3B82F6; color: #EAF0FF; }
  .mh-ii-a mark.t.on { background: rgba(167,139,250,.2); box-shadow: inset 0 -2px 0 #A78BFA; color: #EAF0FF; }
  .mh-ii-a mark.a.on { background: rgba(34,197,94,.18); box-shadow: inset 0 -2px 0 #22C55E; color: #EAF0FF; }
  .mh-ii-a mark.r.on { background: rgba(245,158,11,.2); box-shadow: inset 0 -2px 0 #F59E0B; color: #EAF0FF; }
  .mh-ii-caret { display: inline-block; width: 6px; height: 12px; background: #5B9BFF; vertical-align: -2px; margin-left: 1px; animation: mh-ii-blink 1s steps(1) infinite; }
  .mh-ii-ins { display: flex; gap: 10px; align-items: flex-start; padding: 8px 12px; border-radius: 12px; background: rgba(91,155,255,.09); border: 1px solid rgba(91,155,255,.22); }
  .mh-ii-ins > b { flex: none; width: 22px; height: 22px; border-radius: 7px; background: rgba(240,185,75,.16); color: #F0B94B; display: flex; align-items: center; justify-content: center; font-size: 12px; }
  .mh-ii-ins p { margin: 0; font-size: 11.5px; line-height: 1.5; color: #D6E4FF; min-height: 34px; }
  .mh-ii-ins p small { display: block; margin-bottom: 2px; font: 600 9px ui-monospace, Menlo, monospace; letter-spacing: .1em; color: #93A3C4; }
  /* results */
  .mh-ii-score { display: grid; grid-template-columns: 84px minmax(0,1fr); gap: 12px; align-items: center; }
  .mh-ii-ring { position: relative; width: 84px; height: 84px; }
  .mh-ii-ring svg { width: 84px; height: 84px; transform: rotate(-90deg); display: block; }
  .mh-ii-ring circle { fill: none; stroke-width: 8; }
  .mh-ii-ring .bg { stroke: #1B2740; }
  .mh-ii-ring .fg { stroke: url(#mh-ii-grad); stroke-linecap: round; stroke-dasharray: 220; stroke-dashoffset: 220; transition: stroke-dashoffset 1s cubic-bezier(.2,.7,.2,1); }
  .mh-ii-ring b { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 25px; font-weight: 800; line-height: 1; letter-spacing: -.02em; }
  .mh-ii-ring b small { font-size: 9px; font-weight: 600; color: #6F7FA6; margin-top: 3px; letter-spacing: .04em; }
  .mh-ii-st strong { display: block; font-size: 14px; line-height: 1.25; font-weight: 700; color: #fff; }
