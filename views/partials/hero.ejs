<style>
  /* Hero Container Setup */
  .mh-hero-product-stack {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    max-width: 820px;
    height: 520px;
    margin-top: -10px;
    perspective: 1400px;
    perspective-origin: 60% 40%;
  }

  /* REAR CARD: CAREER WORKSPACE (3D Incline) */
  .mh-career-mock {
    position: absolute;
    left: 10px;
    top: 15px;
    width: 66%;
    height: 480px;
    background: #0B132B;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 18px;
    padding: 22px;
    z-index: 1;
    transform-style: preserve-3d;
    transform: rotateY(-16deg) rotateX(6deg) rotateZ(2deg);
    box-shadow: 
      -15px 30px 60px rgba(0, 0, 0, 0.7),
      0 0 30px rgba(15, 23, 42, 0.8),
      inset 0 1px 1px rgba(255, 255, 255, 0.15);
    overflow: hidden;
  }

  .mh-career-mock-card {
    background: #0F172A;
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 12px;
    padding: 12px 14px;
  }

  /* FRONT CARD: LIVE INTERVIEW TERMINAL (3D Overlay & Perimeter Neon Glow) */
  .mh-hero-mockup-wrap {
    position: absolute;
    right: -10px;
    top: 0px;
    width: 42%;
    height: 510px;
    z-index: 2;
    transform-style: preserve-3d;
    transform: rotateY(-16deg) rotateX(6deg) rotateZ(2deg);
  }

  .mh-terminal-v2 {
    height: 100%;
    background: #070C18;
    border: 1.5px solid #3B82F6;
    border-radius: 18px;
    padding: 14px 16px;
    box-shadow: 
      0 0 25px rgba(59, 130, 246, 0.5),
      -10px 20px 40px rgba(0, 0, 0, 0.8),
      inset 0 0 12px rgba(59, 130, 246, 0.2);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  /* Internal Compact Layout Strategy */
  .mh-terminal-v2-body {
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
    height: calc(100% - 28px);
    justify-content: space-between;
  }

  .mh-terminal-v2-block {
    padding: 6px 10px !important;
    margin-bottom: 0 !important;
    background: rgba(15, 23, 42, 0.75);
    border-radius: 8px;
    border: 1px solid rgba(148, 163, 184, 0.1);
  }

  .mh-terminal-v2-header {
    padding-bottom: 4px;
    margin-bottom: 4px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.15);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mh-terminal-v2-engine {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mh-terminal-v2-ring-svg {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
  }

  .mh-terminal-v2-vectors li {
    padding: 1px 0;
    font-size: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #94A3B8;
  }

  /* Responsive Fallback */
  @media (max-width: 1024px) {
    .mh-hero-product-stack {
      height: auto;
      flex-direction: column;
      align-items: center;
      margin-top: 0;
    }
    .mh-career-mock,
    .mh-hero-mockup-wrap {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      width: 100%;
      height: auto;
      transform: none;
    }
    .mh-hero-mockup-wrap {
      margin-top: -20px;
    }
  }
</style>

