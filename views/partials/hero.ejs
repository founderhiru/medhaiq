  .mh-ii-snote.miss { color: #F87171; } .mh-ii-snote.ok { color: #4ADE80; }
  .mh-ii-vec { display: grid; grid-template-columns: 14px minmax(0,1fr) 22px; gap: 3px 7px; align-items: center; font-size: 10.5px; color: #B4C3E2; margin-bottom: 6px; }
  .mh-ii-vec:last-child { margin-bottom: 0; }
  .mh-ii-vec > i { width: 14px; height: 14px; border-radius: 5px; background: color-mix(in srgb, var(--c) 20%, transparent); position: relative; }
  .mh-ii-vec > i::after { content: ''; position: absolute; inset: 4px; border-radius: 50%; background: var(--c); }
  .mh-ii-vec > span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mh-ii-bar { grid-column: 2 / 4; height: 4px; border-radius: 3px; background: rgba(255,255,255,.07); overflow: hidden; }
  .mh-ii-bar i { display: block; height: 100%; width: 0; border-radius: 3px; background: var(--c); transition: width .9s cubic-bezier(.2,.7,.2,1); }
  .mh-ii-vec em { font: 500 10px ui-monospace, Menlo, monospace; font-style: normal; color: #D6E4FF; text-align: right; }
  .mh-ii-foot { margin-top: 12px; font-size: 10.5px; color: #7D8DB3; }
  .mh-ii-chip { position: absolute; z-index: 3; right: -10px; bottom: 6px; background: #fff; color: #0F172A; border-radius: 14px; padding: 9px 14px; display: flex; align-items: center; gap: 9px; font-size: 12.5px; font-weight: 700; box-shadow: 0 18px 44px -10px rgba(15,23,42,.35), 0 0 0 1px rgba(15,23,42,.05); opacity: 0; transform: translateY(8px); transition: opacity .45s, transform .45s; }
  .mh-ii-chip.on { opacity: 1; transform: none; }
  .mh-ii-chip i { width: 20px; height: 20px; border-radius: 50%; background: #DCFCE7; color: #16A34A; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; font-style: normal; }
  .mh-sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .mh-hero-proof { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; }
  .mh-hero-proof li { display: inline-flex; align-items: center; gap: 7px; font-size: 13.5px; font-weight: 500; color: #475569; }
  .mh-hero-proof + .mh-hero-tertiary-row { margin-top: 18px; }
  .mh-hero-proof svg { width: 16px; height: 16px; flex: none; }
  @keyframes mh-ii-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes mh-ii-drift { from { transform: translate(0,0) scale(1); } to { transform: translate(26px,-18px) scale(1.12); } }
  @keyframes mh-ii-pulse { 0%,100% { opacity: 1; } 50% { opacity: .6; } }
  @keyframes mh-ii-eq { 0%,100% { transform: scaleY(.2); } 50% { transform: scaleY(1); } }
  @keyframes mh-ii-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .mh-ii *, .mh-ii-card { animation: none !important; transition: none !important; } }
  @media (max-width: 1024px) {
    .mh-hero-inner { grid-template-columns: minmax(0, 1fr) !important; gap: 44px; }
