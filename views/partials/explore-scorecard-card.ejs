<!-- Sample Scorecard — illustrative values only, animated on load via explore.ejs's script -->
<div class="mh-explore-preview-card">
  <div class="mh-explore-preview-head">
    <h3>Sample Scorecard</h3>
    <span class="mh-explore-pill mh-explore-pill-blue">Sample</span>
  </div>

  <div class="mh-explore-score-overall">
    <div class="mh-explore-score-ring">
      <div class="mh-explore-score-ring-inner">82</div>
    </div>
    <div class="mh-explore-score-overall-label">Overall Score</div>
  </div>

  <div class="mh-explore-score-bar-row">
    <div class="mh-explore-score-bar-labels"><span>Communication</span><span>88%</span></div>
    <div class="mh-explore-score-bar-track"><div class="mh-explore-score-bar-fill" data-target="88"></div></div>
  </div>
  <div class="mh-explore-score-bar-row">
    <div class="mh-explore-score-bar-labels"><span>Technical</span><span>79%</span></div>
    <div class="mh-explore-score-bar-track"><div class="mh-explore-score-bar-fill" data-target="79"></div></div>
  </div>
  <div class="mh-explore-score-bar-row">
    <div class="mh-explore-score-bar-labels"><span>Leadership</span><span>74%</span></div>
    <div class="mh-explore-score-bar-track"><div class="mh-explore-score-bar-fill" data-target="74"></div></div>
  </div>

  <button type="button" class="mh-btn-outline mh-explore-btn-sm" style="margin-top: 22px;">View Sample</button>
</div>
