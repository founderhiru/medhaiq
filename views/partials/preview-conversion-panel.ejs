<!-- ══════════════════════════════════════════════════════════════════════
     partials/preview-conversion-panel.ejs
     Shared bottom conversion panel for every /preview/* route. One file,
     included identically everywhere so the message never drifts between
     preview pages. Carries no styles beyond layout — it inherits whichever
     page's --bg/--card/--blue tokens it's dropped into.
════════════════════════════════════════════════════════════════════════ -->
<section class="mh-preview-conversion" style="margin-top:32px;padding:32px 24px;text-align:center;border-top:1px solid var(--border,rgba(255,255,255,0.07));">
  <h2 style="font-size:22px;margin-bottom:8px;">Experience MedhaIQ with Your Own Career Data</h2>
  <p style="color:var(--muted,#94a3b8);max-width:520px;margin:0 auto 20px;font-size:14px;line-height:1.6;">
    Upload your resume, complete adaptive AI interviews, and receive personalized executive insights.
  </p>
  <a href="/auth/signup" style="display:inline-block;background:var(--blue-hi,#3b82f6);color:#fff;text-decoration:none;font-weight:600;font-size:14px;padding:12px 28px;border-radius:10px;">
    Create Your Free Account →
  </a>
  <p style="color:var(--dim,#475569);font-size:12px;margin-top:14px;">
    No credit card required. Start your AI-powered career journey in minutes.
  </p>
</section>
