              <g class="pt"><circle cx="20" cy="112" r="4"/><circle cx="85" cy="96" r="4"/><circle cx="150" cy="74" r="4"/><circle cx="215" cy="52" r="4"/><circle cx="262" cy="32" r="4"/></g>
