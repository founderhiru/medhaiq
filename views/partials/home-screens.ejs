          <div class="mh-sc-body">
            <div><div class="mh-sc-lbl">RESUME</div><div class="mh-sc-input"><span>resume.pdf</span><i>&#10003;</i></div></div>
            <div><div class="mh-sc-lbl">TARGET ROLE</div><div class="mh-sc-input"><span>Senior Product Manager &middot; Fintech</span></div></div>
            <div><div class="mh-sc-lbl">JOB DESCRIPTION</div><div class="mh-sc-input"><span>Pasted</span><i>&#10003;</i></div></div>
