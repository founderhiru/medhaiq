            <div class="mh-sc-rail2">
              <div class="mh-sc-st"><span class="mh-sc-nd done">S</span>Situation</div><span class="mh-sc-cn"></span>
              <div class="mh-sc-st"><span class="mh-sc-nd done">T</span>Task</div><span class="mh-sc-cn"></span>
              <div class="mh-sc-st"><span class="mh-sc-nd done">A</span>Action</div><span class="mh-sc-cn off"></span>
              <div class="mh-sc-st"><span class="mh-sc-nd miss">R</span>Result</div>
            </div>
            <div class="mh-sc-note">&#10005; This answer missed: Result</div>
          </div>
        </div>
        <span class="mh-sc-tag">SAMPLE DATA</span>
        <h3>An interview that adapts</h3><p>Vague answers get a follow-up, with STAR tracked live.</p>
      </figure>

      <figure class="mh-sc-item">
        <div class="mh-sc-win" role="img" aria-label="Scorecard with an overall score of 78 and five vectors (sample data)">
          <div class="mh-sc-bar"><i></i><i></i><i></i><span>SCORECARD</span></div>
          <div class="mh-sc-body">
