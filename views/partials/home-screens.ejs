              <div class="mh-sc-vec"><span>Strategic Thinking</span><div class="mh-sc-trk"><i style="--w:78%;--c:#22C55E"></i></div><em>78</em></div>
              <div class="mh-sc-vec"><span>Communication</span><div class="mh-sc-trk"><i style="--w:66%;--c:#FB923C"></i></div><em>66</em></div>
