</section>

<script>
(function () {
  var sec = document.getElementById('the-product');
  if (!sec) return;
  var reduced = false;
  try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
  if (reduced || !('IntersectionObserver' in window)) return;
  sec.classList.add('mh-armed');
  var io = new IntersectionObserver(function (e) { if (e[0].isIntersecting) { sec.classList.add('is-in'); io.disconnect(); } }, { threshold: 0.18 });
  io.observe(sec);
})();
</script>
