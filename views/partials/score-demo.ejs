<!-- Section 5: AI Career Score Demo — Career Intelligence Preview -->
<section class="mh-score reveal" id="score">
  <div class="mh-score-inner">

    <div class="mh-section-center">
      <div class="mh-eyebrow">Career Intelligence Preview</div>
      <h2 class="mh-section-title">See Your Profile Through an Executive Recruiter's Eyes</h2>
      <p class="mh-section-sub">Upload your resume to generate an evidence-based preview before validating your capabilities through a Live AI Interview.</p>
      <div class="mh-cip-stats">
        <span>100% Free</span><span class="sep">·</span>
        <span>Takes 60 Seconds</span><span class="sep">·</span>
        <span>No Sign Up</span>
      </div>
    </div>

    <div class="mh-cip-shell">
      <!-- LEFT -->
      <div class="mh-cip-left">
        <div class="mh-cip-step">
          <span class="mh-cip-step-num">1</span>
          <span class="mh-cip-step-label">Upload Your Resume</span>
        </div>

        <!-- CV upload drop zone — IDs/classes below are unchanged from the
             existing implementation; medhaiq.css's .extracting/.uploaded
             state toggling (already defined there) keeps working as-is. -->
        <div class="mh-drop-zone mh-upload-zone" id="mh-upload-zone">
          <div class="mh-drop-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
          </div>
          <div style="width:100%">
            <div class="mh-drop-label">Drag &amp; drop your resume here</div>
            <div class="mh-drop-hint mh-upload-hint">PDF or DOCX (Max 5MB)</div>
            <div class="mh-upload-extracting" id="mh-upload-extracting">AI Extracting Skills&hellip;</div>
            <div class="mh-upload-filename" id="mh-upload-filename"></div>
          </div>
          <input type="file" id="mh-cv-file" accept=".pdf,.doc,.docx" style="display:none">
        </div>

        <div class="mh-cip-step">
          <span class="mh-cip-step-num">2</span>
          <span class="mh-cip-step-label">Choose Target Role &amp; Level</span>
        </div>
        <div class="mh-drop-zone" style="cursor:default">
          <div class="mh-drop-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div style="width:100%">
            <select class="mh-drop-select" id="mh-role-select">
              <option value="">Select a role...</option>
              <option>Software Engineer</option>
              <option>Product Manager</option>
              <option>Management Consultant</option>
              <option>Director</option>
              <option>VP</option>
              <option>C-Suite</option>
              <option>Custom</option>
            </select>
            <input type="text" id="mh-custom-role" class="mh-drop-select" placeholder="Describe your target role…" style="display:none">
          </div>
        </div>

        <div class="mh-cip-step">
          <span class="mh-cip-step-num">3</span>
          <span class="mh-cip-step-label">Target Organisation Scale</span>
        </div>
        <div class="mh-drop-zone" style="cursor:default">
          <div class="mh-drop-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <div style="width:100%">
            <select class="mh-drop-select" id="mh-scale-select">
              <option value="">Select org type...</option>
              <option>Startup (1–50)</option>
              <option>SME (51–500)</option>
              <option>Enterprise (500–5,000)</option>
              <option>Fortune 500 / Global MNC</option>
            </select>
          </div>
        </div>

        <div class="mh-score-cta-wrap">
          <button id="mh-run-btn" type="button" class="mh-score-run-btn">Run Free Analysis</button>
        </div>
        <div class="mh-cip-trust">&#128274; Your resume is processed securely and is not stored after analysis.</div>
      </div>

      <!-- RIGHT: Career Intelligence Preview -->
      <div class="mh-preview-output">
        <div class="mh-score-loading" id="mh-score-loading">
          <div class="mh-shimmer" style="width:60%"></div>
          <div class="mh-shimmer" style="width:80%"></div>
          <div class="mh-shimmer" style="width:40%"></div>
          <div class="mh-shimmer" style="width:70%"></div>
          <div class="mh-shimmer" style="width:55%"></div>
        </div>

        <div class="mh-preview-error" id="mh-preview-error"></div>

        <div class="mh-preview-card" id="mh-score-card">

          <div class="mh-preview-section">
            <div class="mh-cip-right-top">
              <div>
                <div class="mh-preview-eyebrow">Career Intelligence Preview</div>
                <div class="mh-preview-band" id="mh-preview-band"></div>
                <div class="mh-preview-caption">Estimated from Resume · Confidence: <span id="mh-preview-confidence"></span></div>
                <div class="mh-preview-helper">Your Verified Career Intelligence is generated after a Live AI Interview.</div>
              </div>
              <div class="mh-cip-gauge">
                <svg width="88" height="52" viewBox="0 0 88 52">
                  <path d="M6 46 A38 38 0 0 1 82 46" fill="none" stroke="var(--navy-border)" stroke-width="7" stroke-linecap="round"/>
                  <path d="M6 46 A38 38 0 0 1 82 46" fill="none" stroke="var(--emerald)" stroke-width="7" stroke-linecap="round"
                    stroke-dasharray="119" stroke-dashoffset="119" id="mh-preview-gauge-arc" style="transition: stroke-dashoffset 1s ease"/>
                </svg>
                <div class="mh-cip-gauge-label" id="mh-preview-gauge-label"></div>
                <div class="mh-cip-gauge-sub">Confidence</div>
              </div>
            </div>
          </div>

          <div class="mh-preview-section mh-preview-section--divided">
            <div class="mh-preview-section-title">Intelligence Snapshot</div>
            <div class="mh-score-bars" id="mh-preview-bars"></div>
          </div>

          <div class="mh-preview-section">
            <div class="mh-cip-split">
              <div>
                <div class="mh-preview-section-title">Executive Signals Detected</div>
                <ul class="mh-preview-signal-list" id="mh-preview-signals"></ul>
                <div class="mh-preview-note"></div>
              </div>
              <div>
                <div class="mh-preview-section-title">AI Recruiter First Impression</div>
                <p class="mh-preview-recruiter-text" id="mh-preview-recruiter-text"></p>
              </div>
            </div>
          </div>

          <div class="mh-preview-section mh-preview-section--divided">
            <div class="mh-preview-section-title">Opportunities to Strengthen</div>
            <ul class="mh-preview-opportunity-list" id="mh-preview-opportunities"></ul>
          </div>

          <div class="mh-preview-section mh-preview-section--last">
            <div class="mh-preview-cta">
              <div class="mh-preview-cta-icon">&#9733;</div>
              <p class="mh-preview-cta-text"><b>A resume can't reveal your Executive Presence, Strategic Thinking, Decision Making, or Leadership Judgement.</b> Validate your true potential in a live, AI-powered interview.</p>
              <button type="button" class="mh-score-run-btn mh-preview-cta-btn">Start Free Trial</button>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  // ── Renders directly off the real API response shape from
  // POST /api/public-preview. No adapter layer, no mock data — every value
  // below is read straight off what the backend returns. Only presentation
  // (chip rendering, gauge fill, button success/reset state) changed in
  // this pass; the fetch/response-handling logic itself is unchanged.

  var CONFIDENCE_GAUGE_OFFSET = { High: 18, Medium: 48, Low: 89 }; // out of dasharray=119 (semicircle length)

  function renderPreview(preview) {
    document.getElementById('mh-preview-band').textContent = preview.metrics.overall.band;
    document.getElementById('mh-preview-confidence').textContent = preview.metrics.overall.confidence;

    var arc = document.getElementById('mh-preview-gauge-arc');
    var offset = CONFIDENCE_GAUGE_OFFSET[preview.metrics.overall.confidence];
    arc.style.strokeDashoffset = (offset !== undefined ? offset : 89);
    document.getElementById('mh-preview-gauge-label').textContent = preview.metrics.overall.confidence;

    // Snapshot bars — visual-only, no numeric label (direction, not false
    // precision). A bucket that didn't clear the reliability threshold
    // (numeric: false) renders as a "Limited Signal" chip instead of a bar.
    var barsEl = document.getElementById('mh-preview-bars');
    barsEl.innerHTML = preview.buckets.map(function (b) {
      if (!b.numeric) {
        return '<div class="mh-score-bar-row mh-preview-limited-row">' +
          '<span class="mh-score-bar-label">' + b.label + '</span>' +
          '<span class="mh-preview-limited-chip">Limited Signal</span>' +
          '</div>';
      }
      var fillClass = b.score >= 70 ? '' : 'gold-fill';
      return '<div class="mh-score-bar-row">' +
        '<span class="mh-score-bar-label">' + b.label + '</span>' +
        '<div class="mh-score-bar-track"><div class="mh-score-bar-fill ' + fillClass + '" style="width:' + b.score + '%"></div></div>' +
        '</div>';
    }).join('');

    // Executive Signals — now rendered as chips (was a plain checklist).
    var signalsEl = document.getElementById('mh-preview-signals');
    var signals = preview.executiveSignals.signals || [];
    signalsEl.innerHTML = signals.length
      ? signals.map(function (s) { return '<li>' + s + '</li>'; }).join('')
      : '<li class="mh-preview-muted-item">No strong signals detected yet</li>';
    document.querySelector('#mh-score-card .mh-preview-note').textContent = preview.executiveSignals.note;

    document.getElementById('mh-preview-recruiter-text').textContent = preview.recruiterFirstImpression;

    var oppEl = document.getElementById('mh-preview-opportunities');
    var opportunities = preview.opportunities || [];
    oppEl.innerHTML = opportunities.length
      ? opportunities.map(function (o) { return '<li>' + o + '</li>'; }).join('')
      : '<li class="mh-preview-muted-item">No notable gaps detected — resume evidence is strong across the board.</li>';
  }

  function renderError(message) {
    var errorEl = document.getElementById('mh-preview-error');
    errorEl.textContent = message;
    errorEl.classList.add('mh-preview-error-visible');
    document.getElementById('mh-score-card').classList.remove('mh-score-visible');
  }

  function clearError() {
    var errorEl = document.getElementById('mh-preview-error');
    errorEl.classList.remove('mh-preview-error-visible');
    errorEl.textContent = '';
  }

  // Button success/reset presentation state — purely cosmetic, no change
  // to the underlying click/fetch behavior.
  var BTN_DEFAULT_HTML = 'Run Free Analysis';
  function setButtonComplete(btn) {
    btn.classList.add('is-complete');
    btn.innerHTML = '&#10003; Analysis Complete<span class="mh-cip-btn-sub">You can re-run the analysis</span>';
  }
  function resetButton(btn) {
    btn.classList.remove('is-complete');
    btn.innerHTML = BTN_DEFAULT_HTML;
  }

  var btn = document.getElementById('mh-run-btn');
  var loading = document.getElementById('mh-score-loading');
  var card = document.getElementById('mh-score-card');
  var cvFileInput = document.getElementById('mh-cv-file');
  var roleSelect = document.getElementById('mh-role-select');
  var scaleSelect = document.getElementById('mh-scale-select');

  if (btn && loading && card) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      clearError();

      var targetRole = roleSelect ? roleSelect.value : '';
      var orgScale = scaleSelect ? scaleSelect.value : '';
      if (!cvFileInput || !cvFileInput.files.length) {
        renderError('Upload your resume first.');
        return;
      }
      if (!targetRole || !orgScale) {
        renderError('Choose a target role and organisation scale first.');
        return;
      }

      var formData = new FormData();
      formData.append('resumeFile', cvFileInput.files[0]);
      formData.append('targetRole', targetRole);
      formData.append('orgScale', orgScale);

      loading.classList.add('mh-score-loading-visible');
      btn.disabled = true;

      fetch('/api/public-preview', { method: 'POST', body: formData })
        .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
        .then(function (result) {
          loading.classList.remove('mh-score-loading-visible');
          btn.disabled = false;

          if (!result.ok || result.data.status === 'error') {
            resetButton(btn);
            renderError((result.data && result.data.message) || 'Something went wrong. Please try again.');
            return;
          }
          if (result.data.status === 'insufficient_signal') {
            resetButton(btn);
            renderError(result.data.message);
            return;
          }
          renderPreview(result.data.preview);
          card.classList.add('mh-score-visible');
          setButtonComplete(btn);
        })
        .catch(function () {
          loading.classList.remove('mh-score-loading-visible');
          btn.disabled = false;
          resetButton(btn);
          renderError('Something went wrong reaching the server. Please try again.');
        });
    });
  }

  // ── Upload zone / role-select interaction — UNCHANGED from the original
  // implementation. ─────────────────────────────────────────────────────
  var uploadZone = document.getElementById('mh-upload-zone');
  var cvFile = document.getElementById('mh-cv-file');
  var extracting = document.getElementById('mh-upload-extracting');
  var fileNameEl = document.getElementById('mh-upload-filename');
  if (uploadZone && extracting) {
    function showExtracting(filename) {
      uploadZone.classList.remove('uploaded');
      uploadZone.classList.add('extracting');
      setTimeout(function () {
        uploadZone.classList.remove('extracting');
        uploadZone.classList.add('uploaded');
        if (fileNameEl) fileNameEl.textContent = '📄 ' + filename + ' ✓';
      }, 2200);
    }
    uploadZone.addEventListener('click', function () {
      if (cvFile) cvFile.click();
    });
    if (cvFile) {
      cvFile.addEventListener('change', function () {
        if (cvFile.files && cvFile.files.length) showExtracting(cvFile.files[0].name);
      });
    }
    uploadZone.addEventListener('dragover', function (e) { e.preventDefault(); });
    uploadZone.addEventListener('drop', function (e) {
      e.preventDefault();
      var file = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
      if (file) showExtracting(file.name);
    });
  }

  if (roleSelect) {
    var customRoleInput = document.getElementById('mh-custom-role');
    if (customRoleInput) {
      roleSelect.addEventListener('change', function () {
        if (roleSelect.value === 'Custom') {
          roleSelect.style.display = 'none';
          customRoleInput.style.display = 'block';
          customRoleInput.value = '';
          customRoleInput.focus();
        } else {
          customRoleInput.style.display = 'none';
        }
      });
      function commitCustomRole() {
        var val = customRoleInput.value.trim();
        customRoleInput.style.display = 'none';
        roleSelect.style.display = '';
        if (val) {
          var opt = document.getElementById('mh-custom-role-opt');
          if (!opt) {
            opt = document.createElement('option');
            opt.id = 'mh-custom-role-opt';
            roleSelect.appendChild(opt);
          }
          opt.value = val;
          opt.textContent = val;
          roleSelect.value = val;
        } else {
          roleSelect.value = '';
        }
      }
      customRoleInput.addEventListener('blur', commitCustomRole);
      customRoleInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); commitCustomRole(); }
      });
    }
  }
})();
</script>
