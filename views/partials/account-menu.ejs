<%
/* partials/account-menu.ejs — reusable account dropdown menu CONTENT.
   Renders a list of { label, href } rows, then a divider, then Logout
   (always last, always present). This is deliberately just the row
   list — the trigger button, avatar, chevron, and open/close positioning
   live in header.ejs since they're tied to that specific avatar markup.

   To add a menu item later (Settings sub-sections, a dedicated Billing
   page, etc.), add one more { label, href } object to the menuItems
   array wherever this partial is included — no changes needed here or
   to the surrounding dropdown structure.
*/
const _menuItems = typeof menuItems !== 'undefined' && Array.isArray(menuItems) ? menuItems : [];
const _rowStyle = 'display:block;padding:11px 14px;color:#e2e8f0;text-decoration:none;font-size:13px;font-weight:500;';
%><% _menuItems.forEach(function(item) { %><a href="<%= item.href %>" role="menuitem" style="<%= _rowStyle %>"><%= item.label %></a><% }); %><div style="height:1px;background:rgba(255,255,255,0.08);margin:2px 0;"></div><a href="/auth/logout" role="menuitem" style="<%= _rowStyle %>">Logout</a>
