<!-- Sidebar Scroll-Spy Fix Script -->
<script>
(function() {
  // 1. Tab Switching Logic
  var TRUSTARCH_DATA = {
    privacy: {
      title: 'Privacy & Protection',
      intro: 'We protect professional data through privacy-by-design architecture. Every interaction is encrypted, isolated by tenant, and access-controlled by role.',
      bullets: ['Secure AI Processing', 'Encrypted Communications', 'Privacy-first Data Handling', 'Tenant-aware Data Isolation'],
      centerLabel: 'Privacy &<br>Protection',
      centerIcon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
      nodes: [
        { label: 'Secure AI Processing', sub: 'Isolated AI workloads', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>' },
        { label: 'Encryption', sub: 'End-to-end security', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><circle cx="12" cy="16" r="1"/></svg>' },
        { label: 'Data Isolation', sub: 'Tenant-level separation', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/></svg>' },
        { label: 'Role-based Access', sub: 'Granular permissions', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>' }
      ]
    },
    evaluation: {
      title: 'Evaluation Integrity',
      intro: 'Every interview evaluation is built on structured competencies and standardized scoring. Assessments stay consistent, evidence-based, and free from bias.',
      bullets: ['Multi-layer Competency Mapping', 'Standardized Scoring Vectors', 'Explainable Evaluation Logic', 'Evidence-based Feedback'],
      centerLabel: 'Evaluation<br>Integrity',
      centerIcon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>',
      nodes: [
        { label: 'Competency Engine', sub: 'Structured frameworks', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/></svg>' },
        { label: 'STAR Mapping', sub: 'Behavioral detection', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>' },
        { label: 'Multi-vector Scoring', sub: 'Objective benchmarks', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>' },
        { label: 'Explainability', sub: 'Traceable feedback', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>' }
      ]
    },
    explainable: {
      title: 'Explainable AI',
      intro: 'Our AI shows its work. Every assessment includes traceable reasoning and transparent scoring so professionals understand exactly how conclusions are reached.',
      bullets: ['Transparent Scoring Methodology', 'Structured Competency Maps', 'Actionable Career Insights', 'Traceable AI Decisions'],
      centerLabel: 'Explainable<br>AI Node',
      centerIcon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>',
      nodes: [
        { label: 'Transparent Scoring', sub: 'Clear metric pathways', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>' },
        { label: 'Structured Competencies', sub: 'Mapped skill domains', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="20" y1="21" x2="20" y2="16"/></svg>' },
        { label: 'Actionable Insights', sub: 'Targeted growth steps', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>' },
        { label: 'Traceable Decisions', sub: 'Auditable logic trails', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>' }
      ]
    },
    governance: {
      title: 'Secure Platform & Governance',
      intro: 'MedhaIQ runs on modern cloud infrastructure with strong operational controls. Security and responsible AI governance are built into the platform, not bolted on.',
      bullets: ['Industry Authentication Standards', 'Cloud Security Architecture', 'Audit Logging & Verification', 'Operational Access Controls'],
      centerLabel: 'Platform &<br>Governance',
      centerIcon: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>',
      nodes: [
        { label: 'Authentication', sub: 'OAuth & Zero Trust', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><circle cx="12" cy="16" r="1"/></svg>' },
        { label: 'Cloud Security', sub: 'Isolated infrastructure', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="8" rx="2"/><rect x="2" y="13" width="20" height="8" rx="2"/></svg>' },
        { label: 'Audit Logging', sub: 'Continuous verification', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>' },
        { label: 'Operational Controls', sub: 'Strict policy enforcement', icon: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>' }
      ]
    }
  };

  var root = document.getElementById('trustarch-root');
  if (!root) return;

  var tabs = root.querySelectorAll('.mh-trustarch-tab');
  var centerIconEl = root.querySelector('[data-role="center-icon"]');
  var centerLabelEl = root.querySelector('[data-role="center-label"]');
  var titleEl = root.querySelector('[data-role="panel-title"]');
  var introEl = root.querySelector('[data-role="panel-intro"]');
  var listEl = root.querySelector('[data-role="panel-list"]');

  function updateTab(key) {
    var data = TRUSTARCH_DATA[key];
    if (!data) return;

    tabs.forEach(function(t) {
      var isActive = t.getAttribute('data-tab') === key;
      t.classList.toggle('is-active', isActive);
      t.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    // Lets the four diagram callout icons inherit the current tab's accent
    // color via CSS (see trust-architecture.css). Purely presentational —
    // does not affect tab-switching or animation behavior.
    root.setAttribute('data-active-tab', key);

    var checkIcon = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>';

    if (titleEl) titleEl.textContent = data.title;
    if (introEl) introEl.textContent = data.intro;
    if (centerLabelEl) centerLabelEl.innerHTML = data.centerLabel;
    if (centerIconEl) centerIconEl.innerHTML = data.centerIcon;

    if (listEl) {
      listEl.innerHTML = data.bullets.map(function(b) {
        return '<li>' + checkIcon + b + '</li>';
      }).join('');
    }

    data.nodes.forEach(function(node, i) {
      var iconEl = root.querySelector('[data-role="node-icon-' + i + '"]');
      var labelEl = root.querySelector('[data-role="node-label-' + i + '"]');
      var subEl = root.querySelector('[data-role="node-sub-' + i + '"]');

      if (iconEl) iconEl.innerHTML = node.icon;
      if (labelEl) labelEl.textContent = node.label;
      if (subEl) subEl.textContent = node.sub;
    });
  }

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      var key = tab.getAttribute('data-tab');
      var fadeTargets = root.querySelectorAll('.mh-trustarch-fade');

      fadeTargets.forEach(function(el) { el.classList.add('is-fading'); });
      setTimeout(function() {
        updateTab(key);
        fadeTargets.forEach(function(el) { el.classList.remove('is-fading'); });
      }, 150);
    });
  });

  // 2. BUG 2 Observer Sync: Ensures sidebar pill switches correctly on scroll
  var observerOptions = { root: null, rootMargin: '-20% 0px -50% 0px', threshold: 0.1 };
  var sectionTarget = document.getElementById('trust-architecture');
  if (sectionTarget && 'IntersectionObserver' in window) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var sidebarPills = document.querySelectorAll('.mh-sidebar-link, [data-sidebar-pill]');
          sidebarPills.forEach(function(pill) {
            var href = pill.getAttribute('href') || pill.getAttribute('data-target');
            if (href === '#trust-architecture' || href === 'trust-architecture') {
              sidebarPills.forEach(function(p) { p.classList.remove('active', 'is-active'); });
              pill.classList.add('active', 'is-active');
            }
          });
        }
      });
    }, observerOptions);
    observer.observe(sectionTarget);
  }
})();
</script>