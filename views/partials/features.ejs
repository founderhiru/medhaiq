<!-- Section 2c: What Makes It Adaptive (replaces the old "Three Steps to
     Career Transformation" treatment). Warm-light island section by
     design -- see the .mh-adaptive block in medhaiq.css for why. -->
<section class="mh-adaptive reveal" id="how-it-works">
  <div class="mh-adaptive-inner">
    <div class="mh-section-center">
      <div class="mh-eyebrow">What makes it adaptive</div>
      <h2 class="mh-adaptive-headline">Three inputs go in. The interview<br>rewrites itself around them.</h2>
    </div>

    <div class="mh-adaptive-cards">

      <div class="mh-adaptive-card">
        <div class="mh-adaptive-num">01 / Configure</div>
        <h3 class="mh-adaptive-title">Resume, role, JD</h3>
        <p class="mh-adaptive-desc">Drop the actual posting. The question set is drawn from your evidence, not a generic bank.</p>
        <div class="mh-adaptive-chips">
          <span class="mh-adaptive-chip">resume.pdf</span>
          <span class="mh-adaptive-chip">Sr. PM · Fintech</span>
          <span class="mh-adaptive-chip">JD pasted</span>
        </div>
      </div>

      <div class="mh-adaptive-card">
        <div class="mh-adaptive-num">02 / Simulate</div>
        <h3 class="mh-adaptive-title">It probes, you defend</h3>
        <p class="mh-adaptive-desc">Vague answers get a follow-up. Strong ones get a harder one. Pick the persona: friendly, skeptical, executive.</p>
        <div class="mh-adaptive-followups">
          <div class="mh-adaptive-followup">Why that tradeoff?</div>
          <div class="mh-adaptive-followup">What did you own vs. the team?</div>
          <div class="mh-adaptive-followup is-emphasis">Give me the number.</div>
        </div>
      </div>

      <div class="mh-adaptive-card">
        <div class="mh-adaptive-num">03 / Grow</div>
        <h3 class="mh-adaptive-title">Scored on five vectors</h3>
        <p class="mh-adaptive-desc">Not a vibe check. Structure, domain, strategy, communication, leadership — tracked across sessions.</p>
        <div class="mh-adaptive-scores">
          <div class="mh-adaptive-score-row">
            <span class="mh-adaptive-score-label">Structure</span>
            <div class="mh-adaptive-score-track"><div class="mh-adaptive-score-fill" style="width:72%"></div></div>
          </div>
          <div class="mh-adaptive-score-row">
            <span class="mh-adaptive-score-label">Domain</span>
            <div class="mh-adaptive-score-track"><div class="mh-adaptive-score-fill" style="width:55%"></div></div>
          </div>
          <div class="mh-adaptive-score-row">
            <span class="mh-adaptive-score-label">Strategy</span>
            <div class="mh-adaptive-score-track"><div class="mh-adaptive-score-fill is-accent" style="width:40%"></div></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
