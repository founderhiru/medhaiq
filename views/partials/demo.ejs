<script>
(function () {
  var box = document.getElementById('mh-demo-player');
  var v = document.getElementById('mh-demo-vid');
  var grid = document.getElementById('mh-demo-grid');
  if (!box || !v) return;
  var wrap = document.getElementById('mh-demo-pwrap');
  var big = document.getElementById('mh-demo-bigplay'), pp = document.getElementById('mh-demo-pp');
  var seek = document.getElementById('mh-demo-seek'), vol = document.getElementById('mh-demo-vol');
  var mute = document.getElementById('mh-demo-mute'), fs = document.getElementById('mh-demo-fs'), tm = document.getElementById('mh-demo-time');
  var steps = [].slice.call(document.querySelectorAll('.mh-demo-step'));
  var END = [].concat(steps.map(function (b) { return +b.getAttribute('data-t'); }));
  v.volume = 0.8;
  function fmt(x) { x = Math.max(0, Math.floor(x || 0)); return Math.floor(x / 60) + ':' + ('0' + (x % 60)).slice(-2); }
  function dur() { return isFinite(v.duration) && v.duration > 0 ? v.duration : 90; }
  function state(st) { box.setAttribute('data-state', st); wrap.setAttribute('data-state', st); if (grid) grid.classList.toggle('is-playing', st === 'playing' || st === 'paused'); }
  function toggle() {
    if (v.paused || v.ended) { var pr = v.play(); if (pr && pr.catch) pr.catch(function () { state('error'); }); }
    else v.pause();
  }
  function syncPP() { var playing = !v.paused && !v.ended; pp.setAttribute('aria-label', playing ? 'Pause' : (v.ended ? 'Replay' : 'Play')); }
  function syncMute() { var m = v.muted || v.volume === 0; mute.setAttribute('aria-pressed', m ? 'true' : 'false'); mute.setAttribute('aria-label', m ? 'Unmute' : 'Mute'); box.classList.toggle('is-muted', m); wrap.classList.toggle('is-muted', m); }
  function syncSteps() {
    var t = v.currentTime, d = dur(), cur = -1;
    steps.forEach(function (b, i) { if (t >= END[i] - 0.05) cur = i; });
    steps.forEach(function (b, i) {
      var start = END[i], stop = i + 1 < END.length ? END[i + 1] : Math.min(d, 84.5);
      var on = i === cur && t > 0 && !v.ended;
      b.classList.toggle('is-on', on);
      b.classList.toggle('is-done', t > 0 && (i < cur || (i === cur && v.ended)) );
      if (on) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current');
      var p = i < cur ? 100 : (i === cur ? Math.max(0, Math.min(100, (t - start) / (stop - start) * 100)) : 0);
      b.style.setProperty('--p', p + '%');
    });
  }
  function tick() { var d = dur(); seek.value = Math.round((v.currentTime / d) * 1000); seek.style.setProperty('--p', (v.currentTime / d * 100) + '%'); tm.textContent = fmt(v.currentTime) + ' / ' + fmt(d); syncSteps(); }
  big.addEventListener('click', toggle);
  pp.addEventListener('click', toggle);
  v.addEventListener('click', toggle);
  v.addEventListener('play', function () { state('playing'); syncPP(); });
  v.addEventListener('pause', function () { if (!v.ended) state('paused'); syncPP(); });
  v.addEventListener('ended', function () { state('ended'); syncPP(); syncSteps(); });
  v.addEventListener('timeupdate', tick);
  v.addEventListener('seeked', tick);
  v.addEventListener('loadedmetadata', tick);
  v.addEventListener('error', function () { state('error'); });
  seek.addEventListener('input', function () { v.currentTime = (seek.value / 1000) * dur(); tick(); });
  vol.addEventListener('input', function () { v.volume = vol.value / 100; v.muted = v.volume === 0; syncMute(); });
  mute.addEventListener('click', function () { v.muted = !v.muted; if (!v.muted && v.volume === 0) { v.volume = 0.5; vol.value = 50; } syncMute(); });
  fs.addEventListener('click', function () {
    var d = document;
    if (d.fullscreenElement || d.webkitFullscreenElement) { (d.exitFullscreen || d.webkitExitFullscreen).call(d); }
    else if (wrap.requestFullscreen) wrap.requestFullscreen();
    else if (wrap.webkitRequestFullscreen) wrap.webkitRequestFullscreen();
    else if (v.webkitEnterFullscreen) v.webkitEnterFullscreen();
  });
  wrap.addEventListener('keydown', function (e) {
    var t = e.target && e.target.tagName;
    if (t === 'INPUT' || t === 'BUTTON') { if (e.key !== 'm' && e.key !== 'f') return; }
    if (e.key === ' ' || e.key === 'k') { e.preventDefault(); toggle(); }
    else if (e.key === 'm') { mute.click(); }
    else if (e.key === 'f') { fs.click(); }
  });
  steps.forEach(function (b) {
    b.addEventListener('click', function () {
      var go = function () { v.currentTime = +b.getAttribute('data-t'); var pr = v.play(); if (pr && pr.catch) pr.catch(function () {}); };
      if (v.readyState >= 1) go(); else { v.addEventListener('loadedmetadata', go, { once: true }); v.load(); }
    });
  });
  syncPP(); syncMute(); tick();
})();
</script>
