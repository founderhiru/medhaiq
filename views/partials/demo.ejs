    if (e.key === ' ' || e.key === 'k') { e.preventDefault(); toggle(); }
    else if (e.key === 'm') { mute.click(); }
    else if (e.key === 'c') { cc.click(); }
    else if (e.key === 'f') { fs.click(); }
  });
  steps.forEach(function (b) {
    b.addEventListener('click', function () {
      var go = function () { v.currentTime = +b.getAttribute('data-t'); var pr = v.play(); if (pr && pr.catch) pr.catch(function () {}); };
      if (v.readyState >= 1) go(); else { v.addEventListener('loadedmetadata', go, { once: true }); v.load(); }
    });
  });
  /* See Demo: bring the player into view and start it straight away (the click is the user gesture, so sound is allowed) */
  [].slice.call(document.querySelectorAll('a[href="#demo"]')).forEach(function (a) {
    a.addEventListener('click', function (e) {
      var media = document.querySelector('.mh-demo-media');
      if (!media) return;
      e.preventDefault();
      try { history.replaceState(null, '', '#demo'); } catch (x) {}
      var r = media.getBoundingClientRect(), y = window.pageYOffset + r.top - Math.max(16, (window.innerHeight - r.height) / 2);
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: Math.max(0, y), behavior: reduce ? 'auto' : 'smooth' });
      if (v.paused || v.ended) { if (v.ended || v.currentTime > 0.5) v.currentTime = 0; toggle(); }
      try { box.focus({ preventScroll: true }); } catch (x2) {}
    });
  });
  syncPP(); syncMute(); tick();
})();
</script>
