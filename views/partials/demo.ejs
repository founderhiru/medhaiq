  .mh-demo-pts li.is-hit { color: #0B1020; } .mh-demo-pts li.is-hit span { background-size: 100% 62%; } .mh-demo-pts li.is-hit::before { background: var(--ac); }
  .mh-demo-pts li.is-now { font-weight: 800; } .mh-demo-pts li.is-now::before { transform: scale(1.35); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ac) 28%, transparent); }
  .mh-demo-card.is-on { background: #FBF9F4; border-color: var(--ac); box-shadow: 0 16px 44px -12px rgba(2,6,23,.55), 0 0 0 3px color-mix(in srgb, var(--ac) 30%, transparent); }
