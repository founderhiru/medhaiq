  .mh-demo-media .mh-scr-transcript li { color: #B4C3E2; border-top-color: rgba(150,180,255,.16); }
  .mh-demo-media .mh-scr-transcript li span { color: #7FB2FF; }
  @media (max-width: 960px) {
    .mh-demo { padding: 64px 16px; }
    .mh-demo-grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "head" "media" "steps" "cta"; }
    .mh-demo-media { margin-bottom: 22px; }
    .mh-demo-lede { margin-bottom: 22px; }
    .mh-demo-steps { max-width: none; }
  }
  @media (max-width: 480px) { .mh-demo-t { display: none; } .mh-demo-step { padding: 12px 12px; gap: 12px; } }
  @media (prefers-reduced-motion: reduce) { .mh-demo-step, .mh-demo-no { transition: none; } }
</style>

