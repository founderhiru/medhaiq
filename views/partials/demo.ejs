      var last = -1;
      PTS[i].forEach(function (li, k) { if (t > 0 && t >= +li.getAttribute('data-t') - 0.05 && (i <= cur)) last = k; });
      PTS[i].forEach(function (li, k) {
        li.classList.toggle('is-hit', k <= last && t > 0);
        li.classList.toggle('is-now', on && k === last && !v.paused);
