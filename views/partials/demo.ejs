  }
  var ccOn = false; try { ccOn = localStorage.getItem('mh-demo-cc') === '1'; } catch (e) {}
  v.addEventListener('loadedmetadata', function () { setCC(ccOn); });
  setCC(ccOn);
  cc.addEventListener('click', function () { setCC(cc.getAttribute('aria-pressed') !== 'true'); });
