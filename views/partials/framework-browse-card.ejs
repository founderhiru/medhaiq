<%
/* Framework Browse Card — expects `fw` in locals: { slug, title, oneLiner }.
   All 6 launch frameworks are real guides — plain link straight to the guide,
   no coming-soon branch needed. */
%>
<a href="/explore/interview-frameworks/<%= fw.slug %>" class="mh-explore-card-btn" role="listitem" aria-label="<%= fw.title %>" data-fw-card data-fw-name="<%= fw.title.toLowerCase() %>">
  <div class="mh-explore-card mh-fw-browse-card">
    <div class="mh-explore-company-name"><%= fw.title %></div>
    <% if (fw.oneLiner) { %>
      <div class="mh-explore-company-sub"><%= fw.oneLiner %></div>
    <% } %>
    <span class="mh-explore-card-link" style="margin-top: 16px;">
      Read Framework
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg>
    </span>
  </div>
</a>
