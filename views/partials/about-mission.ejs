<!-- ============================================
     ABOUT — 01. OUR MISSION
     Visual: an orbital "intelligence core" composition — no approved
     illustration asset exists in the repo, so this is built in
     HTML/SVG using only existing brand colors and the real MedhaIQ
     mark (medhaiq-icon.png, already used in the header/footer — not a
     new or generated logo). Reuses the same outline-icon language as
     the Principles cards further down the page.
     ============================================ -->
<section class="mh-about-section mh-about-mission" id="mission">
  <div class="mh-about-inner mh-about-mission-grid">
    <div class="mh-about-mission-copy">
      <div class="mh-eyebrow">Our Mission</div>
      <h2 class="mh-about-mission-statement">Building Continuous Career Intelligence for the AI Era.</h2>
      <p>MedhaIQ gives professionals the intelligence, preparation, and structured feedback needed to navigate high-stakes career moments with confidence.</p>
      <p>We believe career progression should be driven by capability, preparation, and deliberate practice—not chance. From early-career transitions to executive leadership, MedhaIQ is building a more intelligent way to navigate the moments that shape a career.</p>
    </div>

    <div class="mh-about-mission-visual" aria-hidden="true">
      <div class="mh-about-mv-stage">
        <svg class="mh-about-mv-svg" viewBox="0 0 1274 876" fill="none" preserveAspectRatio="none">
          <ellipse class="mh-about-mv-orbit" cx="592" cy="395" rx="535" ry="368"/>
          <ellipse class="mh-about-mv-orbit" cx="592" cy="395" rx="382" ry="262"/>
          <circle class="mh-about-mv-dot" cx="305" cy="130" r="4"/>
          <circle class="mh-about-mv-dot" cx="1030" cy="260" r="4"/>
          <circle class="mh-about-mv-dot" cx="80" cy="447" r="3.5"/>
          <circle class="mh-about-mv-dot" cx="1120" cy="540" r="3.5"/>
          <circle class="mh-about-mv-dot" cx="152" cy="697" r="4"/>

          <!-- layered "platform" beneath the core, suggesting elevation.
               Grouped separately so a perspective skew can be applied to
               it alone, without touching the orbit rings/dots above. -->
          <g class="mh-about-mv-platform-group">
            <rect class="mh-about-mv-platform" x="486" y="562" width="212" height="20" rx="10" opacity="0.9"/>
            <rect class="mh-about-mv-platform" x="466" y="586" width="252" height="22" rx="11" opacity="0.6"/>
            <rect class="mh-about-mv-platform" x="446" y="610" width="292" height="24" rx="12" opacity="0.35"/>
          </g>
        </svg>

        <div class="mh-about-mv-core">
