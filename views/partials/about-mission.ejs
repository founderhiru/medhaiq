        <div class="mh-about-mv-card" style="left:21.4%; top:44.2%; width:14.9%; height:25.8%;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V13"/><path d="M11 20V9"/><path d="M18 20v-6"/><path d="M15 5l3-1.5L21 6"/></svg>
