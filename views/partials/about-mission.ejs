        <defs>
          <radialGradient id="mvGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#7C3AED" stop-opacity="0.14"/>
            <stop offset="100%" stop-color="#7C3AED" stop-opacity="0"/>
          </radialGradient>
          <linearGradient id="mvCoreRing" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#3B82F6"/>
            <stop offset="100%" stop-color="#7C3AED"/>
          </linearGradient>
        </defs>

        <circle cx="170" cy="150" r="70" fill="url(#mvGlow)"/>
        <circle class="mh-about-mv-orbit" cx="170" cy="150" r="114" fill="none"/>

        <line class="mh-about-mv-line" x1="170" y1="150" x2="262" y2="82"/>
        <line class="mh-about-mv-line" x1="170" y1="150" x2="262" y2="218"/>
        <line class="mh-about-mv-line" x1="170" y1="150" x2="78" y2="218"/>
