<!-- Section — Professional Perspectives
     Staging-only. NOT a testimonial section — these are representative
     professional perspectives, not verified customer statements.
     No avatars/imagery (removed per review — illustrated headshots read
     as low-quality/cartoonish at this size); quote-first compact cards
     with role + location as a muted footer line. Rendered as a
     continuous horizontal marquee: two identical passes of the same
     6 cards, translated by exactly -50% of the track width, so the
     loop point is invisible. Pauses on hover; falls back to a static
     wrapped layout for prefers-reduced-motion. Sits between #pricing
     and the CTA banner. -->
<%
  const mhPerspectives = [
    {
      role: 'Engineer Leader', geo: 'India',
      quote: 'I want realistic interview practice that reflects how strong companies actually evaluate.'
    },
    {
      role: 'Product Manager', geo: 'USA',
      quote: 'I want clear feedback on where I stand and what I need to improve next.'
    },
    {
      role: 'Data Analyst', geo: 'Singapore',
      quote: 'I want to communicate my experience clearly and demonstrate my strengths with confidence.'
    },
    {
      role: 'Management Consultant', geo: 'UK',
      quote: 'I want to know whether my thinking is as strong as the experience on my resume.'
    },
    {
      role: 'Technical Program Manager', geo: 'USA',
      quote: 'I want practice that challenges my judgment, not just my ability to answer questions.'
    },
    {
      role: 'Senior Business Leader', geo: 'India',
      quote: 'I want a clear view of my leadership readiness before the next opportunity arrives.'
    }
  ];
%>
<section class="mh-perspectives">
  <div class="mh-perspectives-inner mh-section-center">
    <div class="mh-eyebrow">Professional Perspectives</div>
    <h2 class="mh-section-title">What professionals are looking for</h2>

    <div class="mh-perspectives-viewport">
      <div class="mh-perspective-track">
        <% [0, 1].forEach(function (pass) { %>
          <% mhPerspectives.forEach(function (p) { %>
            <div class="mh-perspective-card<% if (pass === 1) { %> mh-perspective-dup<% } %>"<% if (pass === 1) { %> aria-hidden="true"<% } %>>
              <p class="mh-perspective-quote">“<%= p.quote %>”</p>
              <p class="mh-perspective-meta"><span class="mh-perspective-role"><%= p.role %></span> · <span class="mh-perspective-location"><%= p.geo %></span></p>
            </div>
          <% }); %>
        <% }); %>
      </div>
    </div>
  </div>
</section>
