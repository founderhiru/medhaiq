<%
/* Curated Company Card — expects `company` in locals (one item from
   curatedCompanies): { slug, name, identifier, icon, accentColor, hasGuide }.

   V1 VISUAL IDENTITY: no real company logos, no simplified brand
   redraws. Microsoft's and Amazon's own trademark guidelines prohibit
   reproducing their marks in any form, in any size, without a written
   license — a small monochrome version is still "the mark." Instead,
   every company gets a MedhaIQ-designed abstract icon + accent color,
   acting as a navigation cue, not company branding. Icons are simple,
   generic geometric shapes (bars, rings, arches, hexagons) chosen to
   NOT evoke each company's actual logo silhouette. Real, licensed
   logos are a separate future enhancement, not a V1 concern — this
   card's structure (icon key + accentColor per company) doesn't need
   to change if that happens later. */
const ICONS = {
  ascend:  '<rect x="4" y="13" width="4" height="7" rx="1"/><rect x="10" y="8" width="4" height="12" rx="1"/><rect x="16" y="4" width="4" height="16" rx="1"/>',
  pennant: '<path d="M6 3v18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M6 4l13 5.5L6 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>',
  orbit:   '<circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="2"/>',
  arch:    '<path d="M5 20v-6a7 7 0 0 1 14 0v6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  stack:   '<path d="M12 4l7 4-7 4-7-4 7-4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M5 13l7 4 7-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  hex:     '<path d="M12 3.5l7.5 4.25v8.5L12 20.5l-7.5-4.25v-8.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>',
  diamond: '<rect x="7.5" y="7.5" width="9" height="9" rx="1.5" transform="rotate(45 12 12)" fill="none" stroke="currentColor" stroke-width="2"/>',
  wave:    '<path d="M3 13c1.8-3.5 3.6-3.5 5.4 0s3.6 3.5 5.4 0 3.6-3.5 5.4 0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
};
const iconSvg = ICONS[company.icon] || ICONS.orbit;
%>
<% if (company.hasGuide) { %>
<a href="/explore/company-library/<%= company.slug %>" class="mh-explore-card-btn" role="listitem" aria-label="<%= company.name %> interview guide">
  <div class="mh-explore-card mh-colib-curated-card">
    <div class="mh-colib-curated-icon" style="background: <%= company.accentColor %>1A; color: <%= company.accentColor %>;" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24"><%- iconSvg %></svg>
    </div>
    <div class="mh-explore-company-name"><%= company.name %></div>
    <div class="mh-colib-curated-identifier"><%= company.identifier %></div>
  </div>
</a>
<% } else { %>
<div class="mh-explore-card mh-colib-curated-card mh-colib-curated-card-soon" role="listitem" aria-label="<%= company.name %> — guide coming soon">
  <div class="mh-colib-curated-icon" style="background: <%= company.accentColor %>1A; color: <%= company.accentColor %>;" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24"><%- iconSvg %></svg>
  </div>
  <div class="mh-explore-company-name"><%= company.name %></div>
  <div class="mh-colib-curated-identifier"><%= company.identifier %></div>
  <span class="mh-colib-curated-soon-tag">Guide coming soon</span>
</div>
<% } %>