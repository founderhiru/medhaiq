<%
/* Curated Company Card — expects `company` in locals (one item from
   curatedCompanies). Deliberately minimal per the landing-page redesign:
   small logo + name + one short identifier line, nothing else (no
   description, no category pill, no competency chips).

   LOGOS: real monochrome brand marks are used only where a properly
   licensed, purpose-built source exists — Google, Meta, Apple, and
   Stripe icons below are sourced verbatim from Simple Icons (CC0 1.0,
   simpleicons.org), a project built specifically for brand
   identification use like this. Amazon, Microsoft, and Salesforce are
   NOT in that library — both Amazon and Microsoft are documented as
   having been removed from Simple Icons after their legal teams
   objected to trademark reproduction there, and Salesforce was never
   included. Deloitte also isn't available. Rather than hand-reconstruct
   those four trademarks from memory without a licensed source, they
   keep the two-letter monogram tile. If a licensed monochrome SVG for
   any of them becomes available later, add its `d`/viewBox to
   BRAND_ICONS below and it will automatically replace that company's
   monogram — no other change needed.

   If hasGuide is false, the card renders in a muted, non-clickable
   "Guide coming soon" state instead of linking to a page that doesn't
   exist yet. */
const BRAND_ICONS = {
  google: { viewBox: '0 0 24 24', d: 'M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z' },
  meta:   { viewBox: '0 0 24 24', d: 'M6.915 4.03c-1.968 0-3.683 1.28-4.871 3.113C.704 9.208 0 11.883 0 14.449c0 .706.07 1.369.21 1.973a6.624 6.624 0 0 0 .265.86 5.297 5.297 0 0 0 .371.761c.696 1.159 1.818 1.927 3.593 1.927 1.497 0 2.633-.671 3.965-2.444.76-1.012 1.144-1.626 2.663-4.32l.756-1.339.186-.325c.061.1.121.196.183.3l2.152 3.595c.724 1.21 1.665 2.556 2.47 3.314 1.046.987 1.992 1.22 3.06 1.22 1.075 0 1.876-.355 2.455-.843a3.743 3.743 0 0 0 .81-.973c.542-.939.861-2.127.861-3.745 0-2.72-.681-5.357-2.084-7.45-1.282-1.912-2.957-2.93-4.716-2.93-1.047 0-2.088.467-3.053 1.308-.652.57-1.257 1.29-1.82 2.05-.69-.875-1.335-1.547-1.958-2.056-1.182-.966-2.315-1.303-3.454-1.303zm10.16 2.053c1.147 0 2.188.758 2.992 1.999 1.132 1.748 1.647 4.195 1.647 6.4 0 1.548-.368 2.9-1.839 2.9-.58 0-1.027-.23-1.664-1.004-.496-.601-1.343-1.878-2.832-4.358l-.617-1.028a44.908 44.908 0 0 0-1.255-1.98c.07-.109.141-.224.211-.327 1.12-1.667 2.118-2.602 3.358-2.602zm-10.201.553c1.265 0 2.058.791 2.675 1.446.307.327.737.871 1.234 1.579l-1.02 1.566c-.757 1.163-1.882 3.017-2.837 4.338-1.191 1.649-1.81 1.817-2.486 1.817-.524 0-1.038-.237-1.383-.794-.263-.426-.464-1.13-.464-2.046 0-2.221.63-4.535 1.66-6.088.454-.687.964-1.226 1.533-1.533a2.264 2.264 0 0 1 1.088-.285z' },
  apple:  { viewBox: '0 0 24 24', d: 'M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701' },
  stripe: { viewBox: '0 0 24 24', d: 'M13.976 9.15c-2.172-.806-3.356-1.426-3.356-2.409 0-.831.683-1.305 1.901-1.305 2.227 0 4.515.858 6.09 1.631l.89-5.494C18.252.975 15.697 0 12.165 0 9.667 0 7.589.654 6.104 1.872 4.56 3.147 3.757 4.992 3.757 7.218c0 4.039 2.467 5.76 6.476 7.219 2.585.92 3.445 1.574 3.445 2.583 0 .98-.84 1.545-2.354 1.545-1.875 0-4.965-.921-6.99-2.109l-.9 5.555C5.175 22.99 8.385 24 11.714 24c2.641 0 4.843-.624 6.328-1.813 1.664-1.305 2.525-3.236 2.525-5.732 0-4.128-2.524-5.851-6.594-7.305h.003z' },
};
const brandIcon = BRAND_ICONS[company.slug];
%>
<%
  const logoInner = brandIcon
    ? `<svg width="18" height="18" viewBox="${brandIcon.viewBox}" fill="currentColor" aria-hidden="true"><path d="${brandIcon.d}"/></svg>`
    : company.name.slice(0, 2).toUpperCase();
%>
<% if (company.hasGuide) { %>
<a href="/explore/company-library/<%= company.slug %>" class="mh-explore-card-btn" role="listitem" aria-label="<%= company.name %> interview guide">
  <div class="mh-explore-card mh-colib-curated-card">
    <div class="mh-explore-company-logo<%= brandIcon ? ' mh-colib-brand-logo' : '' %>" aria-hidden="true"><%- logoInner %></div>
    <div class="mh-explore-company-name"><%= company.name %></div>
    <div class="mh-colib-curated-identifier"><%= company.identifier %></div>
  </div>
</a>
<% } else { %>
<div class="mh-explore-card mh-colib-curated-card mh-colib-curated-card-soon" role="listitem" aria-label="<%= company.name %> — guide coming soon">
  <div class="mh-explore-company-logo<%= brandIcon ? ' mh-colib-brand-logo' : '' %>" aria-hidden="true"><%- logoInner %></div>
  <div class="mh-explore-company-name"><%= company.name %></div>
  <div class="mh-colib-curated-identifier"><%= company.identifier %></div>
  <span class="mh-colib-curated-soon-tag">Guide coming soon</span>
</div>
<% } %>
