<%
/* Role Browse Card — expects `role` in locals: { slug, title, oneLiner, tags }.
   All 6 launch roles are real guides now — no coming-soon branch needed;
   every card is a plain link straight to its guide. */
%>
<a href="/explore/role-library/<%= role.slug %>" class="mh-explore-card-btn" role="listitem" aria-label="<%= role.title %>" data-role-card data-role-name="<%= role.title.toLowerCase() %>" data-role-tags="<%= (role.tags || []).join(' ').toLowerCase() %>">
  <div class="mh-explore-card mh-role-browse-card">
    <div class="mh-explore-company-name"><%= role.title %></div>
    <% if (role.oneLiner) { %>
      <div class="mh-explore-company-sub"><%= role.oneLiner %></div>
    <% } %>
    <% if (role.tags && role.tags.length) { %>
      <div class="mh-explore-chip-row" style="margin: 12px 0 auto;">
        <% role.tags.forEach(function(tag) { %>
          <span class="mh-explore-chip"><%= tag %></span>
        <% }); %>
      </div>
    <% } %>
    <span class="mh-explore-card-link" style="margin-top: 16px;">
      Browse Role
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg>
    </span>
  </div>
</a>