<%
// Navigation Resolver consumption: middleware/capabilities.js already
// computes res.locals.megaMenuItems on every request (visitor -> preview
// routes where they exist, /explore fallback where they don't;
// authenticated -> real production routes) — this file just needs to
// actually read it, which it wasn't doing before. Fallback second
// argument below is only a safety net (matches this codebase's existing
// `typeof x !== 'undefined'` defensive style) in case this partial is
// ever rendered without that middleware having run — normal requests
// always have real, resolved data here.
const _megaMenuItems = typeof megaMenuItems !== 'undefined' && Array.isArray(megaMenuItems) ? megaMenuItems : [];
const _menuHref = (key, fallback) => {
  const item = _megaMenuItems.find(i => i.key === key);
  return item ? item.href : fallback;
};
// Site-wide session-awareness: middleware/capabilities.js (server.js:70)
// runs on EVERY request and already attaches this exact same object as
// res.locals.capabilities — automatically available in every res.render()
// call, no per-route wiring needed. homeCapabilities is kept as a fallback
// only: the '/' route in server.js additionally passes req.capabilities
// under that name explicitly (homeCapabilities = req.capabilities, an
// identical, untransformed copy), which is what this partial originally
// keyed off. Routes like /why and /architecture never passed
// homeCapabilities, so they always fell back to the guest header even for
// a logged-in visitor — capabilities was there the whole time, just under
// a different name. Preferring capabilities first (with homeCapabilities
// as a safety net) fixes every page that includes this partial at once,
// with no new auth mechanism and no change to session/login behavior.
const _homeCaps = (typeof capabilities !== 'undefined' && capabilities)
  ? capabilities
  : (typeof homeCapabilities !== 'undefined' && homeCapabilities ? homeCapabilities : null);
const _isHomeAuthed = !!(_homeCaps && _homeCaps.isAuthenticated);
%>
<header class="mh-nav" id="mh-nav">
  <div class="mh-nav-inner">
    <!-- Logo — unchanged -->

<%- include('brand-logo', { size: 'md', eager: true }) %>

    <!-- Desktop nav -->
    <nav class="mh-nav-links" aria-label="Main navigation">

      <!-- "Platform" is now a mega-menu trigger, not a direct link.
           Previously <a href="#platform">, which pointed to the Advanced
           Platform Architecture section (architecture.ejs). That section
           is unchanged and still reachable by scrolling — it's just no
           longer the nav word's direct destination. -->
      <div class="mh-nav-item mh-nav-item-mega" id="mh-platform-wrap">
        <button type="button"
                class="mh-nav-link mh-nav-trigger"
                id="mh-platform-trigger"
                aria-haspopup="true"
                aria-expanded="false">
          Platform
          <svg class="mh-nav-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>

        <div class="mh-megamenu" id="mh-megamenu" aria-label="Platform capabilities">
          <div class="mh-megamenu-inner">
            <nav aria-label="Platform capabilities">
              <ul class="mh-megamenu-list" role="menu">

                <li role="none"><a href="<%= _menuHref('interview', '/interview') %>" class="mh-megamenu-item dropdown-item" role="menuitem">
                  <span class="mh-megamenu-icon">🎤</span>
                  <span class="mh-megamenu-text">
                    <span class="mh-megamenu-title">Adaptive Interview</span>
                    <span class="mh-megamenu-desc">Personalize with Resume, Target Role & JD</span>
                  </span>
                </a></li>
                <li role="none"><a href="<%= _menuHref('insights', '/dashboard/history?focus=insights') %>" class="mh-megamenu-item dropdown-item" role="menuitem">
                  <span class="mh-megamenu-icon">⭐</span>
                  <span class="mh-megamenu-text">
                    <span class="mh-megamenu-title">Interview Insights</span>
                    <span class="mh-megamenu-desc">Understand how you think, communicate and perform</span>
                  </span>
                </a></li>
                <li role="none"><a href="<%= _menuHref('progress', '/dashboard/history') %>" class="mh-megamenu-item dropdown-item" role="menuitem">
                  <span class="mh-megamenu-icon">📈</span>
                  <span class="mh-megamenu-text">
                    <span class="mh-megamenu-title">Career Progress</span>
                    <span class="mh-megamenu-desc">Track your capability growth over time</span>
                  </span>
                </a></li>
                <li role="none"><a href="/experience" class="mh-megamenu-item dropdown-item" role="menuitem">
                  <span class="mh-megamenu-icon">⚡</span>
                  <span class="mh-megamenu-text">
                    <span class="mh-megamenu-title">The Experience</span>
                    <span class="mh-megamenu-desc">See MedhaIQ in action</span>
                  </span>
                </a></li>

                <li class="mh-megamenu-divider-row" role="none"><hr class="mh-megamenu-divider"></li>

                <li role="none"><a href="/professional-horizons" class="mh-megamenu-item dropdown-item mh-megamenu-item-link" role="menuitem">
                  Who it's for
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a></li>

              </ul>
            </nav>
          </div>
        </div>
      </div>

      <a href="/why" class="mh-nav-link">Why MedhaIQ</a>
      <!-- NEW route — see conflict note in chat: no "Architecture" page existed
           to consolidate; this reuses architecture.ejs's real content. -->
      <a href="/architecture" class="mh-nav-link">Architecture</a>
      <a href="/#pricing" class="mh-nav-link">Pricing</a>
      <!-- NEW route — see conflict note in chat: reuses founder.ejs's real
           "Vision" content; no "Mission" copy exists anywhere in the repo,
           so none was invented here. -->
      <a href="/about" class="mh-nav-link">About</a>
    </nav>

    <!-- CTA + hamburger — Sign In restored (was present in an earlier
         header version, along with its CSS in medhaiq.css, but the link
         itself was dropped during later nav refactoring rounds) -->
    <div class="mh-nav-actions">
      <% if (_isHomeAuthed) { %>
        <a href="<%= _homeCaps.primaryNavigation.href %>" class="mh-nav-cta" style="margin-right: 8px;"><%= _homeCaps.primaryNavigation.label %></a>
        <!-- Avatar: Account Menu (Account Settings, Subscription, Logout).
             Menu rows are data-driven via partials/account-menu — add a
             future item (e.g. once a dedicated Billing page exists) by
             adding one more { label, href } object where it's included
             below, no markup changes needed. Follows the same
             open/close-on-click/Escape/outside-click pattern as the
             Platform mega menu below, for consistency. Avatar content
             (initials/icon) comes from partials/user-avatar — the single
             shared identity component also used in the Workspace sidebar,
             so both surfaces render identically. -->
        <div class="mh-profile-wrap" id="mh-profile-wrap" style="position:relative;margin-right:8px;">
          <button type="button" id="mh-profile-trigger" aria-haspopup="true" aria-expanded="false" aria-label="Account menu for <%= (_homeCaps.user && _homeCaps.user.name) || 'your account' %>" style="display:inline-flex;align-items:center;gap:5px;background:none;border:none;cursor:pointer;padding:0;">
            <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:#1E2A45;font-weight:700;font-size:13px;flex-shrink:0;"><%- include('user-avatar', { user: _homeCaps.user, glyphSize: 17 }) %></span>
            <svg id="mh-profile-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.6;flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div id="mh-profile-menu" role="menu" style="display:none;position:absolute;top:calc(100% + 10px);right:0;min-width:180px;background:#12172a;border:1px solid rgba(255,255,255,0.08);border-radius:10px;box-shadow:0 10px 30px rgba(0,0,0,0.45);overflow:hidden;z-index:60;">
            <%- include('account-menu', { menuItems: [
              { label: 'Account Settings', href: '/settings' },
              { label: 'Subscription', href: '/settings?tab=subscription' },
            ] }) %>
          </div>
        </div>
      <% } else { %>
        <a href="/auth/login" class="mh-nav-signin">Sign In</a>
       <a href="/login" class="mh-nav-cta" style="margin-right: 8px;">Get Started</a>
      <% } %>
      <button class="mh-hamburger" id="mh-hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="mh-mobile-menu" id="mh-mobile-menu">
    <nav class="mh-mobile-nav">

      <!-- Platform becomes an accordion item on mobile, not a menu link.
           Two columns collapse into two labeled groups, same content/order. -->
      <div class="mh-mobile-accordion">
        <button type="button" class="mh-mobile-link mh-mobile-accordion-trigger" id="mh-mobile-platform-trigger" aria-expanded="false">
          Platform
          <svg class="mh-mobile-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="mh-mobile-accordion-panel" id="mh-mobile-platform-panel">
          <a href="<%= _menuHref('interview', '/interview') %>" class="mh-mobile-sublink">🎤 Adaptive Interview</a>
          <a href="<%= _menuHref('insights', '/dashboard/history?focus=insights') %>" class="mh-mobile-sublink">⭐ Interview Insights</a>
          <a href="<%= _menuHref('progress', '/dashboard/history') %>" class="mh-mobile-sublink">📈 Career Progress</a>
          <a href="/experience" class="mh-mobile-sublink">⚡ The Experience</a>
          <hr class="mh-mobile-sublink-divider">
          <a href="/professional-horizons" class="mh-mobile-sublink">Who it's for →</a>
        </div>
      </div>

      <a href="/why" class="mh-mobile-link">Why MedhaIQ</a>
      <a href="/architecture" class="mh-mobile-link">Architecture</a>
      <a href="/#pricing" class="mh-mobile-link">Pricing</a>
      <a href="/about" class="mh-mobile-link">About</a>
      <% if (_isHomeAuthed) { %>
        <a href="<%= _homeCaps.primaryNavigation.href %>" class="mh-mobile-cta"><%= _homeCaps.primaryNavigation.label %></a>
        <!-- Same as desktop: static for now, foundation for a future Profile menu. -->
        <!-- Same as desktop: static for now, foundation for a future Profile menu. -->
        <div class="mh-mobile-link" aria-label="Your account" style="display:flex;align-items:center;"><span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:#1E2A45;font-weight:700;font-size:12px;margin-right:8px;flex-shrink:0;"><%- include('user-avatar', { user: _homeCaps.user, glyphSize: 14 }) %></span><%= (_homeCaps.user && _homeCaps.user.name) || 'Your account' %></div>
        <a href="/settings" class="mh-mobile-link">Account Settings</a>
        <a href="/settings?tab=subscription" class="mh-mobile-link">Subscription</a>
        <a href="/auth/logout" class="mh-mobile-link">Logout</a>
      <% } else { %>
        <a href="/auth/login" class="mh-mobile-link mh-mobile-signin">Sign In</a>
         <a href="/login" class="mh-mobile-cta">Get Started</a>
      <% } %>
    </nav>
  </div>
</header>

<script>
(function() {
  var nav = document.getElementById('mh-nav');
  var hamburger = document.getElementById('mh-hamburger');
  var mobileMenu = document.getElementById('mh-mobile-menu');

  /* ---- existing scroll behavior — unchanged ---- */
  window.addEventListener('scroll', function() {
    if (window.scrollY > 60) {
      nav.classList.add('mh-nav-scrolled');
    } else {
      nav.classList.remove('mh-nav-scrolled');
    }
  });

  /* ---- existing hamburger toggle — unchanged ---- */
  hamburger.addEventListener('click', function() {
    var isOpen = mobileMenu.classList.toggle('mh-mobile-menu-open');
    hamburger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    hamburger.classList.toggle('mh-hamburger-open', isOpen);
  });

  /* ---- existing "close mobile menu on link click" — unchanged.
     Note: the mobile Platform trigger is a <button>, not an <a>, so this
     querySelectorAll('a') correctly skips it — tapping it opens the
     accordion instead of closing the whole mobile menu. ---- */
  mobileMenu.querySelectorAll('a').forEach(function(link) {
    link.addEventListener('click', function() {
      mobileMenu.classList.remove('mh-mobile-menu-open');
      hamburger.classList.remove('mh-hamburger-open');
      hamburger.setAttribute('aria-expanded', 'false');
    });
  });

  /* ---- NEW: desktop mega menu (hover + focus + click + Escape) ---- */
  var megaWrap = document.getElementById('mh-platform-wrap');
  var megaTrigger = document.getElementById('mh-platform-trigger');

  function openMega() {
    megaWrap.classList.add('mh-mega-open');
    megaTrigger.setAttribute('aria-expanded', 'true');
  }
  function closeMega() {
    megaWrap.classList.remove('mh-mega-open');
    megaTrigger.setAttribute('aria-expanded', 'false');
  }

  // Hover-bridge delay: closing is deferred 150ms so the cursor can travel
  // from the trigger into the panel without the menu closing mid-transit.
  // A new mouseenter anywhere in megaWrap (trigger OR panel) cancels the
  // pending close. This replaces a hard mouseleave-closes-instantly model.
  var closeTimer = null;

  function scheduleClose() {
    clearTimeout(closeTimer);
    closeTimer = setTimeout(closeMega, 150);
  }
  function cancelScheduledClose() {
    clearTimeout(closeTimer);
  }

  megaWrap.addEventListener('mouseenter', function() {
    cancelScheduledClose();
    openMega();
  });
  megaWrap.addEventListener('mouseleave', scheduleClose);

  // Click/tap toggles — covers touch devices where hover doesn't fire
  megaTrigger.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation(); // prevent the document click-outside listener below from immediately re-closing what this click just opened
    cancelScheduledClose();
    if (megaWrap.classList.contains('mh-mega-open')) { closeMega(); }
    else { openMega(); }
  });

  // Keyboard: Tab into the menu opens it, Tab out closes it immediately
  // (no delay needed for keyboard — there's no "transit" to bridge)
  megaWrap.addEventListener('focusin', function() {
    cancelScheduledClose();
    openMega();
  });
  megaWrap.addEventListener('focusout', function(e) {
    if (!megaWrap.contains(e.relatedTarget)) { closeMega(); }
  });

  // Escape closes immediately (no delay) and returns focus to the trigger
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && megaWrap.classList.contains('mh-mega-open')) {
      cancelScheduledClose();
      closeMega();
      megaTrigger.focus();
    }
  });

  // Click anywhere outside the menu closes it immediately
  document.addEventListener('click', function(e) {
    if (megaWrap.classList.contains('mh-mega-open') && !megaWrap.contains(e.target)) {
      cancelScheduledClose();
      closeMega();
    }
  });

  // Clicking/activating any menu item closes the panel immediately
  megaWrap.querySelectorAll('.mh-megamenu-item').forEach(function(item) {
    item.addEventListener('click', function() {
      cancelScheduledClose();
      closeMega();
    });
  });

  /* ---- NEW: mobile Platform accordion ---- */
  var mobTrigger = document.getElementById('mh-mobile-platform-trigger');
  var mobPanel = document.getElementById('mh-mobile-platform-panel');

  mobTrigger.addEventListener('click', function() {
    var isOpen = mobPanel.classList.toggle('mh-mobile-accordion-panel-open');
    mobTrigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  /* ---- NEW: avatar profile menu (Logout only, for launch) — same
     click/Escape/outside-click pattern as the Platform mega menu above.
     Guarded with an if-check: this markup only renders for authenticated
     users, so these elements are null on the visitor-facing homepage and
     this whole block must safely no-op there rather than throw. ---- */
  var profileWrap = document.getElementById('mh-profile-wrap');
  if (profileWrap) {
    var profileTrigger = document.getElementById('mh-profile-trigger');
    var profileMenu = document.getElementById('mh-profile-menu');

    function openProfileMenu() {
      profileMenu.style.display = 'block';
      profileTrigger.setAttribute('aria-expanded', 'true');
    }
    function closeProfileMenu() {
      profileMenu.style.display = 'none';
      profileTrigger.setAttribute('aria-expanded', 'false');
    }

    profileTrigger.addEventListener('click', function(e) {
      e.stopPropagation(); // don't let this click immediately trigger the document click-outside listener below
      if (profileMenu.style.display === 'block') { closeProfileMenu(); }
      else { openProfileMenu(); }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && profileMenu.style.display === 'block') {
        closeProfileMenu();
        profileTrigger.focus();
      }
    });

    document.addEventListener('click', function(e) {
      if (profileMenu.style.display === 'block' && !profileWrap.contains(e.target)) {
        closeProfileMenu();
      }
    });
  }
})();
</script>
