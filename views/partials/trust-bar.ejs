<%
  // Exact same company roster and order as before — nothing added or
  // removed. Previously each name/separator repeated ~30 inline style
  // attributes by hand (same values every time); refactored into two
  // shared classes below so responsive font-size scaling is actually
  // possible — inline styles can't respond to a media query.
  const trustCompanies = [
    'McKinsey', 'BCG', 'EY', 'KPMG', 'Deloitte', 'Accenture', 'PwC',
    'Goldman Sachs', 'J.P. Morgan', 'Citi', 'BofA', 'Microsoft', 'Apple',
    'Google', 'Amazon', 'Nvidia', 'OpenAI', 'Meta', 'IBM', 'Salesforce',
    'Coca-Cola', 'Nestlé', 'J&J', 'P&G', 'Novartis', 'Pfizer', 'Infosys',
    'TCS', 'Cognizant'
  ];
%>
<section class="mh-trust-bar">
  <div class="mh-trust-inner">
    <p class="mh-trust-label">INTERVIEW PREPARATION ACROSS LEADING COMPANIES</p>
  </div>
  <div class="logo-marquee-track">
    <% trustCompanies.forEach(function(name) { %><span class="mh-trust-name"><%= name %></span><span class="mh-trust-sep">·</span><% }); %>
    <% trustCompanies.forEach(function(name) { %><span class="mh-trust-name" aria-hidden="true"><%= name %></span><span class="mh-trust-sep" aria-hidden="true">·</span><% }); %>
  </div>
</section>
