<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Interview OS — MedhaIQ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <script>
  (function(d,t){
    var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
    g.src='https://cdn.jsdelivr.net/gh/VapiAI/html-script-tag@latest/dist/assets/index.js';
    g.defer=true; g.async=true; s.parentNode.insertBefore(g,s);
  })(document,'script');
  </script>
  <style>
    /* ═══════════════════════════════════════════════════════════════
       DESIGN TOKENS
       These are the ONLY place colors/spacing should be edited. Every
       component below references these variables — change a value
       here and it updates everywhere, without touching component code.
    ═══════════════════════════════════════════════════════════════ */
    :root {
      --bg:         #070d1a;
      --panel:      #0d1829;
      --card:       #111e33;
      --border:     rgba(59,130,246,0.1);
      --border-hi:  rgba(59,130,246,0.42);
      --blue:       #1d4ed8;
      --blue-hi:    #3b82f6;
      --blue-glow:  rgba(59,130,246,0.2);
      --green:      #22c55e;
      --purple:     #a78bfa;
      --amber:      #f59e0b;
      --red:        #ef4444;
      --muted:      #3d5068;
      --soft:       #94a3b8;
      --white:      #f1f5f9;
      --mono:       'JetBrains Mono', monospace;
      --sidebar-w:  296px;
      --terminal-w: 300px;
      --radius:     16px;
      --blur:       blur(10px);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; }
    body {
      background: var(--bg);
      color: var(--white);
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 14px;
      background-image: radial-gradient(circle, rgba(59,130,246,0.05) 1px, transparent 1px);
      background-size: 30px 30px;
    }

    /* ── TOPBAR ── */
    .topbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      height: 52px;
      background: rgba(7,13,26,0.97);
      backdrop-filter: var(--blur); -webkit-backdrop-filter: var(--blur);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; padding: 0 22px; gap: 14px;
    }
    .tb-brand { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 15px; font-weight: 800; color: #fff; letter-spacing: -0.3px; }
    .tb-brand em { color: var(--blue-hi); font-style: normal; }
    .tb-sep { width: 1px; height: 18px; background: var(--border); }
    .tb-persona { display: flex; align-items: center; gap: 9px; }
    .tb-avatar {
      width: 28px; height: 28px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 10px; font-weight: 800; color: #fff;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .tb-avatar.royal-blue { background: linear-gradient(135deg,#1e40af,#3b82f6); }
    .tb-avatar.emerald    { background: linear-gradient(135deg,#065f46,#10b981); }
    .tb-avatar.gold       { background: linear-gradient(135deg,#78350f,#f59e0b); }
    .tb-name  { font-size: 13px; font-weight: 700; }
    .tb-role  { font-size: 10px; color: var(--soft); }
    .tb-right { margin-left: auto; display: flex; align-items: center; gap: 12px; }
    .tb-live  { display:flex; align-items:center; gap:6px; font-size:10px; font-weight:700; color:var(--green); font-family: var(--mono); }
    .tb-live-dot { width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green);animation:lp 1.8s ease-in-out infinite; }
    @keyframes lp { 0%,100%{opacity:1;} 50%{opacity:0.3;} }
    .tb-timer { font-size: 13px; font-weight: 600; color: var(--soft); font-family: var(--mono); }
    .tb-meta  { font-size: 11px; color: var(--soft); }
    .tb-end   { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.28); color: #fca5a5; font-size: 11px; font-weight: 700; padding: 6px 14px; border-radius: 7px; cursor: pointer; transition: background 0.15s; }
    .tb-end:hover { background: rgba(239,68,68,0.22); }

    /* ══════════════════════════════════════════════════════════════
       3-COLUMN GRID — 300px | 1fr | 300px, exactly as specified.
       Swap any single column's inner markup freely; the grid itself
       never needs to change.
    ══════════════════════════════════════════════════════════════ */
    .os-grid {
      display: grid;
      grid-template-columns: var(--sidebar-w) 1fr var(--terminal-w);
      height: 100vh;
      padding-top: 52px;
    }

    /* ────────────────────────────────────────────────
       LEFT COLUMN — session context + progress only.
       No activity log, no raw scores, no debug data.
       (Debug data lives in #debugConsole — see bottom of
       file — hidden unless explicitly opened by staff.)
    ──────────────────────────────────────────────── */
    .sidebar {
      background: rgba(13,24,41,0.9);
      border-right: 1px solid var(--border);
      display: flex; flex-direction: column;
      padding: 22px 20px;
      overflow-y: auto;
    }
    .sb-block { margin-bottom: 26px; }
    .sb-block-label { font-size: 10px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--blue-hi); margin-bottom: 12px; }
    .sb-field { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 14px; }
    .sb-field:last-child { margin-bottom: 0; }
    .sb-field-icon { font-size: 13px; color: var(--blue-hi); margin-top: 1px; flex-shrink: 0; }
    .sb-field-key { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 2px; }
    .sb-field-val { font-size: 14px; font-weight: 600; color: var(--white); }

    .sb-progress-num { font-size: 34px; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif; line-height: 1; }
    .sb-progress-num span { font-size: 15px; font-weight: 500; color: var(--soft); }
    .sb-progress-lbl { font-size: 11px; color: var(--soft); margin: 4px 0 10px; }
    .sb-progress-track { height: 5px; background: rgba(255,255,255,0.06); border-radius: 3px; overflow: hidden; margin-bottom: 8px; }
    .sb-progress-fill { height: 100%; background: linear-gradient(90deg,var(--blue),var(--blue-hi)); border-radius: 3px; transition: width 0.6s cubic-bezier(0.25,1,0.5,1); }
    .sb-progress-remaining { font-size: 11px; color: var(--muted); }

    .sb-time-val { font-size: 22px; font-weight: 700; font-family: var(--mono); }
    .sb-time-lbl { font-size: 10px; color: var(--muted); margin-top: 2px; }

    .sb-spacer { flex: 1; }

    .sb-tip { background: rgba(59,130,246,0.06); border: 1px solid var(--border); border-radius: 12px; padding: 14px; display: flex; gap: 10px; }
    .sb-tip-icon { font-size: 15px; flex-shrink: 0; }
    .sb-tip-text { font-size: 11.5px; color: var(--soft); line-height: 1.5; }
    .sb-tip-text strong { color: var(--white); display:block; margin-bottom: 3px; font-size: 12px; }

    /* ────────────────────────────────────────────────
       CENTER COLUMN — the Focus Zone.
       Webcam on top, floating blurred question card below.
    ──────────────────────────────────────────────── */
    .centre-col { display: flex; flex-direction: column; overflow: hidden; padding: 18px 22px 22px; gap: 16px; }

    .webcam-card {
      position: relative; flex-shrink: 0; height: 40vh; min-height: 240px; max-height: 360px;
      background: #0a1526; border-radius: var(--radius); overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: 0 12px 40px rgba(0,0,0,0.35);
    }
    .webcam-card video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); display: none; }
    .webcam-placeholder { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
      background: radial-gradient(circle at 50% 55%, rgba(29,78,216,0.1) 0%, transparent 70%); }
    .wc-icon { font-size: 34px; color: var(--muted); }
    .wc-hint { font-size: 10px; color: var(--muted); font-family: var(--mono); }
    .webcam-badge { position: absolute; top: 12px; left: 14px; display: flex; align-items: center; gap: 6px;
      background: rgba(0,0,0,0.55); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 4px 11px;
      font-size: 9px; font-family: var(--mono); color: #fff; backdrop-filter: var(--blur); }
    .webcam-badge .wbdot { width: 5px; height: 5px; border-radius: 50%; background: var(--green); box-shadow: 0 0 5px var(--green); }
    .webcam-badge.off .wbdot { background: var(--muted); box-shadow: none; }
    .webcam-toggle { position: absolute; top: 12px; right: 14px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.12);
      border-radius: 7px; padding: 5px 12px; font-size: 10px; color: var(--soft); cursor: pointer; transition: all 0.15s; backdrop-filter: var(--blur); }
    .webcam-toggle:hover { background: rgba(59,130,246,0.18); color: #fff; }

    /* Floating blurred question card — the single primary task on screen */
    .question-card {
      flex: 1; display: flex; flex-direction: column; min-height: 0;
      background: rgba(17,30,51,0.66);
      backdrop-filter: var(--blur); -webkit-backdrop-filter: var(--blur);
      border: 1px solid var(--border); border-radius: var(--radius);
      padding: 22px 26px; box-shadow: 0 16px 48px rgba(0,0,0,0.3);
      overflow-y: auto;
    }
    .qc-top-row { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .qc-eyebrow { font-size: 11px; font-weight: 700; color: var(--blue-hi); text-transform: uppercase; letter-spacing: 0.6px; }
    .qc-report-issue { margin-left: auto; font-size: 11px; color: var(--muted); cursor: pointer; text-decoration: none; }
    .qc-report-issue:hover { color: var(--soft); }
    .qc-text { font-size: 19px; font-weight: 700; font-family: 'Plus Jakarta Sans', sans-serif; line-height: 1.5; color: #fff; margin-bottom: 14px; }
    .qc-why-btn { align-self: flex-start; background: rgba(59,130,246,0.12); border: 1px solid var(--border-hi); color: var(--blue-hi);
      font-size: 11px; font-weight: 600; padding: 6px 14px; border-radius: 20px; cursor: pointer; transition: all 0.15s; }
    .qc-why-btn:hover { background: rgba(59,130,246,0.2); }
    .qc-why-text { font-size: 12.5px; color: var(--soft); line-height: 1.6; margin-top: 12px; display: none; }
    .qc-why-text.shown { display: block; }

    /* Answer bar — single pill, mic integrated, no clutter */
    .answer-bar-wrap { flex-shrink: 0; }
    .answer-bar {
      display: flex; align-items: flex-end; gap: 10px;
      background: rgba(17,30,51,0.85); border: 1px solid var(--border); border-radius: 26px;
      padding: 8px 8px 8px 20px; backdrop-filter: var(--blur);
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    }
    .answer-bar textarea {
      flex: 1; background: transparent; border: none; outline: none; resize: none;
      color: #fff; font-size: 14px; font-family: 'Inter', sans-serif; line-height: 1.5;
      max-height: 140px; padding: 8px 0;
    }
    .answer-bar textarea::placeholder { color: var(--muted); }
    .mic-btn {
      width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
      background: var(--blue); border: none; color: #fff; cursor: pointer;
      display: flex; align-items: center; justify-content: center; font-size: 17px;
      transition: all 0.18s;
    }
    .mic-btn:hover { background: var(--blue-hi); box-shadow: 0 0 16px var(--blue-glow); }
    .mic-btn.live { background: rgba(239,68,68,0.85); animation: micPulse 1.4s ease-in-out infinite; }
    @keyframes micPulse { 0%,100%{box-shadow:0 0 0 0 rgba(239,68,68,0.5);} 50%{box-shadow:0 0 0 8px rgba(239,68,68,0);} }
    .send-btn {
      width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
      background: var(--blue); border: none; color: #fff; cursor: pointer;
      display: none; align-items: center; justify-content: center; font-size: 16px;
      transition: all 0.18s;
    }
    .send-btn.show { display: flex; }
    .send-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .answer-bar-meta { display: flex; align-items: center; margin-top: 8px; padding: 0 6px; }
    .char-count { font-size: 10px; color: var(--muted); font-family: var(--mono); }
    .skip-link { margin-left: auto; font-size: 11px; color: var(--muted); background: none; border: none; cursor: pointer; }
    .skip-link:hover { color: var(--soft); }
    .voice-status-line { font-size: 10px; color: var(--muted); font-family: var(--mono); text-align: center; margin-top: 8px; }

    /* Loading state */
    .loading-overlay { display: none; flex-direction: column; align-items: center; justify-content: center; gap: 14px; flex: 1; text-align: center; }
    .loading-overlay.show { display: flex; }
    .ldots { display: flex; gap: 6px; }
    .ldots span { width: 7px; height: 7px; border-radius: 50%; background: var(--blue-hi); animation: lbounce 1s ease-in-out infinite; }
    .ldots span:nth-child(2){animation-delay:.15s;} .ldots span:nth-child(3){animation-delay:.3s;}
    @keyframes lbounce { 0%,60%,100%{transform:translateY(0);} 30%{transform:translateY(-7px);} }
    .ltext { font-size: 11px; color: var(--muted); font-family: var(--mono); }

    /* ────────────────────────────────────────────────
       RIGHT COLUMN — AI Interview Status (always calm,
       always visible) + Live Terminal (collapsed by
       default, mirrors the landing-page component).
    ──────────────────────────────────────────────── */
    .terminal-panel { background: rgba(13,22,40,0.92); border-left: 1px solid var(--border); display: flex; flex-direction: column; overflow-y: auto; padding: 18px 18px 24px; }
    .tp-header { display: flex; align-items: center; gap: 8px; margin-bottom: 18px; }
    .tp-title { font-size: 11px; font-weight: 700; color: var(--soft); letter-spacing: 0.6px; text-transform: uppercase; }
    .tp-toggle-row { margin-left: auto; display: flex; align-items: center; gap: 7px; }
    .tp-toggle-lbl { font-size: 10px; color: var(--muted); }
    .tp-switch { position: relative; width: 32px; height: 17px; flex-shrink: 0; }
    .tp-switch input { opacity: 0; width: 0; height: 0; }
    .tp-switch-track { position: absolute; inset: 0; background: rgba(255,255,255,0.08); border: 1px solid var(--border); border-radius: 20px; cursor: pointer; transition: all .2s; }
    .tp-switch-track::before { content:''; position:absolute; width:13px; height:13px; left:2px; top:1px; background:var(--soft); border-radius:50%; transition: all .2s; }
    .tp-switch input:checked + .tp-switch-track { background: rgba(59,130,246,0.28); border-color: var(--border-hi); }
    .tp-switch input:checked + .tp-switch-track::before { transform: translateX(15px); background: var(--blue-hi); }

    /* Always-visible calm status */
    .ai-status-block { text-align: center; padding: 8px 4px 22px; border-bottom: 1px solid var(--border); margin-bottom: 18px; }
    .ai-status-ring-wrap { width: 78px; height: 78px; margin: 0 auto 12px; position: relative; }
    .ai-status-ring-wrap svg { transform: rotate(-90deg); width: 100%; height: 100%; }
    .ai-status-ring-bg { fill: none; stroke: rgba(255,255,255,0.06); stroke-width: 4; }
    .ai-status-ring-fill { fill: none; stroke: var(--blue-hi); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 220; stroke-dashoffset: 220; transition: stroke-dashoffset 0.6s ease; }
    .ai-status-ring-fill.pulsing { animation: statusPulse 1.6s ease-in-out infinite; }
    @keyframes statusPulse { 0%,100%{opacity:1;} 50%{opacity:0.4;} }
    .ai-status-title { font-size: 15px; font-weight: 700; font-family: 'Plus Jakarta Sans', sans-serif; }
    .ai-status-sub { font-size: 11px; color: var(--muted); margin-top: 3px; }

    .status-checklist { display: flex; flex-direction: column; gap: 11px; padding: 0 6px; }
    .status-item { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--muted); transition: color .2s; }
    .status-item .si-dot { width: 17px; height: 17px; border-radius: 50%; flex-shrink: 0; border: 1.5px solid var(--muted); display: flex; align-items: center; justify-content: center; font-size: 10px; transition: all .2s; }
    .status-item.done { color: var(--white); }
    .status-item.done .si-dot { background: var(--blue); border-color: var(--blue); color: #fff; }
    .status-item.active { color: var(--blue-hi); font-weight: 600; }
    .status-item.active .si-dot { border-color: var(--blue-hi); box-shadow: 0 0 8px var(--blue-glow); animation: lp 1s ease-in-out infinite; }

    /* Live Terminal card — collapsed by default */
    .live-terminal-card {
      display: none; background: var(--card); border: 1px solid var(--border); border-radius: 14px;
      padding: 16px; margin-top: 18px; box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    }
    .live-terminal-card.expanded { display: block; }
    .lt-hdr { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
    .lt-hdr-title { font-size: 10px; font-weight: 700; color: var(--soft); text-transform: uppercase; letter-spacing: 0.6px; }
    .lt-hdr-live { margin-left: auto; display: flex; align-items: center; gap: 5px; font-size: 9px; color: var(--green); font-family: var(--mono); font-weight: 700; }
    .lt-hdr-live .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--green); box-shadow: 0 0 5px var(--green); animation: lp 1.8s ease-in-out infinite; }

    .lt-score-block { text-align: center; margin-bottom: 18px; }
    .lt-score-lbl { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 8px; }
    .score-ring-wrap { position: relative; width: 78px; height: 78px; margin: 0 auto; }
    .score-ring-wrap svg { transform: rotate(-90deg); }
    .ring-bg { fill: none; stroke: rgba(255,255,255,0.06); stroke-width: 5; }
    .ring-fill { fill: none; stroke: var(--blue-hi); stroke-width: 5; stroke-linecap: round; stroke-dasharray: 213; stroke-dashoffset: 213; transition: stroke-dashoffset 0.8s cubic-bezier(0.25,1,0.5,1); }
    .ring-label { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif; }
    .ring-out-of { font-size: 10px; color: var(--muted); text-align: center; margin-top: 4px; }

    .lt-vec-lbl { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 12px; }
    .metric-row { display: flex; align-items: center; gap: 9px; margin-bottom: 12px; }
    .metric-icon { font-size: 12px; flex-shrink: 0; }
    .metric-body { flex: 1; }
    .metric-lbl { font-size: 10px; color: var(--soft); margin-bottom: 4px; }
    .metric-track { height: 4px; background: rgba(255,255,255,0.06); border-radius: 2px; overflow: hidden; }
    .metric-fill { height: 100%; border-radius: 2px; width: 0%; transition: width 0.8s cubic-bezier(0.25,1,0.5,1); }
    .metric-val { font-size: 12px; font-weight: 700; font-family: var(--mono); flex-shrink: 0; min-width: 24px; text-align: right; }

    .lt-footer { font-size: 10px; color: var(--blue-hi); font-family: var(--mono); text-align: center; margin-top: 4px; }
    .lt-footer.pulsing { animation: calfade 1.2s ease-in-out infinite alternate; }
    @keyframes calfade { from{opacity:0.5;} to{opacity:1;} }

    /* ══════════════════════════════════════════════════════════════
       HIDDEN DEBUG CONSOLE — Activity Log, Competency Coverage, and
       raw audio metadata live here. NEVER shown to a candidate. Only
       opens via Ctrl+Shift+D, for founder/staff troubleshooting a
       live session. This is where "system data" belongs — not on the
       candidate's screen.
    ══════════════════════════════════════════════════════════════ */
    .debug-console {
      display: none; position: fixed; bottom: 16px; left: 16px; z-index: 500;
      width: 320px; max-height: 70vh; overflow-y: auto;
      background: rgba(5,10,20,0.97); border: 1px solid var(--border-hi); border-radius: 12px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.6);
    }
    .debug-console.open { display: block; }
    .dbg-hdr { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid var(--border); background: rgba(239,68,68,0.08); }
    .dbg-hdr-title { font-size: 10px; font-weight: 700; color: #fca5a5; font-family: var(--mono); }
    .dbg-close { margin-left: auto; background: none; border: none; color: var(--muted); cursor: pointer; font-size: 14px; }
    .dbg-section { padding: 12px 14px; border-bottom: 1px solid var(--border); }
    .dbg-section-lbl { font-size: 9px; color: var(--muted); font-family: var(--mono); text-transform: uppercase; margin-bottom: 8px; }
    .dbg-comp-row { display: flex; align-items: center; gap: 8px; margin-bottom: 7px; font-size: 10px; }
    .dbg-comp-name { flex: 1; color: var(--soft); }
    .dbg-comp-track { width: 60px; height: 3px; background: rgba(255,255,255,0.06); border-radius: 2px; }
    .dbg-comp-fill { height: 100%; border-radius: 2px; }
    .dbg-comp-count { width: 20px; text-align: right; color: var(--muted); font-family: var(--mono); }
    .dbg-meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .dbg-meta-cell .k { font-size: 8px; color: var(--muted); text-transform: uppercase; }
    .dbg-meta-cell .v { font-size: 12px; font-weight: 700; font-family: var(--mono); }
    .dbg-log-body { padding: 10px 14px; max-height: 200px; overflow-y: auto; }
    .dbg-entry { font-family: var(--mono); font-size: 9px; color: var(--muted); line-height: 1.9; }
    .dbg-entry.ok { color: rgba(34,197,94,0.65); }
    .dbg-entry.err { color: rgba(239,68,68,0.65); }
    .dbg-entry.info { color: rgba(59,130,246,0.65); }
    .dbg-hint { font-size: 9px; color: var(--muted); padding: 8px 14px; font-family: var(--mono); }

    /* Score toast */
    .score-toast { position: fixed; top: 62px; right: calc(var(--terminal-w) + 14px); z-index: 200;
      background: var(--card); border: 1px solid var(--border-hi); border-radius: 12px; padding: 13px 17px;
      display: flex; align-items: center; gap: 12px; transform: translateY(-20px) scale(0.95); opacity: 0;
      transition: transform 0.42s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease; box-shadow: 0 14px 44px rgba(0,0,0,0.5); pointer-events: none; }
    .score-toast.show { transform: translateY(0) scale(1); opacity: 1; }
    .toast-score { font-size: 24px; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif; }
    .toast-score.high{color:var(--green);} .toast-score.mid{color:var(--amber);} .toast-score.low{color:var(--red);}
    .toast-lbl { font-size: 10px; color: var(--muted); }
  </style>
</head>
<body>

<!-- ═══ TOPBAR ═══ -->
<div class="topbar">
  <span class="tb-brand">Medha<em>IQ</em></span>
  <div class="tb-sep"></div>
  <div class="tb-persona">
    <div class="tb-avatar <%= personaStyleColor %>" id="tbAvatar"></div>
    <div>
      <div class="tb-name" id="tbName"></div>
      <div class="tb-role" id="tbRole"></div>
    </div>
  </div>
  <div class="tb-right">
    <div class="tb-live"><div class="tb-live-dot"></div>LIVE</div>
    <div class="tb-timer" id="timer">00:00</div>
    <div class="tb-meta" id="qCounter">Q1 / 5</div>
    <button class="tb-end" id="endBtn">End Session</button>
  </div>
</div>

<!-- ═══ 3-COLUMN GRID ═══ -->
<div class="os-grid">

  <!-- ══ LEFT — session context + progress only ══ -->
  <div class="sidebar">
    <div class="sb-block">
      <div class="sb-block-label">Session Context</div>
      <div class="sb-field">
        <span class="sb-field-icon">◎</span>
        <div><div class="sb-field-key">Role</div><div class="sb-field-val" id="sbRole">—</div></div>
      </div>
      <div class="sb-field">
        <span class="sb-field-icon">⚡</span>
        <div><div class="sb-field-key">Level</div><div class="sb-field-val" id="sbLevel">—</div></div>
      </div>
      <div class="sb-field">
        <span class="sb-field-icon">◈</span>
        <div><div class="sb-field-key">Persona</div><div class="sb-field-val" id="sbPersona">—</div></div>
      </div>
    </div>

    <div class="sb-block">
      <div class="sb-block-label">Progress</div>
      <div class="sb-progress-num"><span id="sbProgNum">1</span><span>/ <%= 5 %></span></div>
      <div class="sb-progress-lbl">Questions</div>
      <div class="sb-progress-track"><div class="sb-progress-fill" id="sbProgFill" style="width:0%;"></div></div>
      <div class="sb-progress-remaining" id="sbProgRemaining">4 questions remaining</div>
    </div>

    <div class="sb-block">
      <div class="sb-block-label">Time</div>
      <div class="sb-time-val" id="sbTimeRemaining">15:00</div>
      <div class="sb-time-lbl">Est. remaining</div>
    </div>

    <div class="sb-spacer"></div>

    <div class="sb-tip">
      <span class="sb-tip-icon">📍</span>
      <div class="sb-tip-text"><strong>Use the STAR framework</strong>Situation, Task, Action, Result</div>
    </div>
  </div><!-- /sidebar -->

  <!-- ══ CENTER — Focus Zone ══ -->
  <div class="centre-col">

    <div class="webcam-card" id="webcamHero">
      <video id="camVideo" autoplay playsinline muted></video>
      <div class="webcam-placeholder" id="camPlaceholder">
        <div class="wc-icon">📷</div>
        <div class="wc-hint">Click "Enable Camera" to start</div>
      </div>
      <div class="webcam-badge off" id="camBadge"><div class="wbdot"></div><span id="camBadgeText">CAM OFF</span></div>
      <button class="webcam-toggle" id="camToggle">Enable Camera</button>
    </div>

    <div class="question-card" id="questionCard">
      <div class="qc-top-row">
        <span class="qc-eyebrow" id="qEyebrow">QUESTION 1 OF 5 · OPENING</span>
        <a class="qc-report-issue" id="reportIssueLink">Report Issue</a>
      </div>
      <div class="qc-text" id="questionText">Loading your first question...</div>
      <button class="qc-why-btn" id="whyBtn">Why this question?</button>
      <div class="qc-why-text" id="qWhyText"></div>
    </div>

    <div class="answer-bar-wrap">
      <div class="answer-bar">
        <textarea id="answerInput" rows="1" placeholder="Start speaking or type your answer…" maxlength="4000"></textarea>
        <button class="send-btn" id="submitBtn" disabled title="Submit answer">➤</button>
        <button class="mic-btn" id="vapiBtn" title="Hold to speak">🎙</button>
      </div>
      <div class="answer-bar-meta">
        <span class="char-count" id="charCount">0 / 4000</span>
        <button class="skip-link" id="skipBtn">Skip question →</button>
      </div>
      <div class="voice-status-line" id="vapiSub">Speak directly with your AI interviewer</div>
    </div>

    <div class="loading-overlay" id="loadingOverlay">
      <div class="ldots"><span></span><span></span><span></span></div>
      <div class="ltext" id="loadingText">Analysing your response...</div>
    </div>

  </div><!-- /centre-col -->

  <!-- ══ RIGHT — AI Interview Status (always visible, calm)
       + Live Terminal (collapsed by default) ══ -->
  <div class="terminal-panel">

    <div class="tp-header">
      <span class="tp-title">AI Interview Status</span>
      <div class="tp-toggle-row">
        <span class="tp-toggle-lbl" id="tpToggleLbl">Show terminal</span>
        <label class="tp-switch">
          <input type="checkbox" id="terminalToggle">
          <span class="tp-switch-track"></span>
        </label>
      </div>
    </div>

    <div class="ai-status-block">
      <div class="ai-status-ring-wrap">
        <svg viewBox="0 0 78 78">
          <circle class="ai-status-ring-bg" cx="39" cy="39" r="35"/>
          <circle class="ai-status-ring-fill" id="aiStatusRing" cx="39" cy="39" r="35"/>
        </svg>
      </div>
      <div class="ai-status-title" id="aiStatusTitle">Calibrating…</div>
      <div class="ai-status-sub" id="aiStatusSub">Setting up your session</div>
    </div>

    <div class="status-checklist" id="statusChecklist">
      <div class="status-item" data-step="captured"><span class="si-dot"></span>Answer captured</div>
      <div class="status-item" data-step="analyzing"><span class="si-dot"></span>Analyzing response</div>
      <div class="status-item" data-step="preparing"><span class="si-dot"></span>Preparing next question</div>
    </div>

    <!-- Live Terminal — collapsed by default, mirrors the landing page -->
    <div class="live-terminal-card" id="liveTerminalCard">
      <div class="lt-hdr">
        <span class="lt-hdr-title">Live Terminal</span>
        <span class="lt-hdr-live"><span class="dot"></span>LIVE</span>
      </div>

      <div class="lt-score-block">
        <div class="lt-score-lbl">Overall Intelligence Score</div>
        <div class="score-ring-wrap">
          <svg width="78" height="78" viewBox="0 0 78 78">
            <circle class="ring-bg" cx="39" cy="39" r="34"/>
            <circle class="ring-fill" id="ringFill" cx="39" cy="39" r="34"/>
          </svg>
          <div class="ring-label" id="ringLabel">—</div>
        </div>
        <div class="ring-out-of" id="ringOutOf">/ 100</div>
      </div>

      <div class="lt-vec-lbl">5-Vector Intelligence</div>
      <div class="metric-row">
        <span class="metric-icon">⚡</span>
        <div class="metric-body"><div class="metric-lbl">Structure (STAR)</div>
          <div class="metric-track"><div class="metric-fill" id="mStar" style="background:#3b82f6;"></div></div></div>
        <span class="metric-val" id="mStarV" style="color:#3b82f6;">—</span>
      </div>
      <div class="metric-row">
        <span class="metric-icon">🧠</span>
        <div class="metric-body"><div class="metric-lbl">Technical Depth</div>
          <div class="metric-track"><div class="metric-fill" id="mTech" style="background:#a78bfa;"></div></div></div>
        <span class="metric-val" id="mTechV" style="color:#a78bfa;">—</span>
      </div>
      <div class="metric-row">
        <span class="metric-icon">👔</span>
        <div class="metric-body"><div class="metric-lbl">Executive Presence</div>
          <div class="metric-track"><div class="metric-fill" id="mExec" style="background:#22c55e;"></div></div></div>
        <span class="metric-val" id="mExecV" style="color:#22c55e;">—</span>
      </div>
      <div class="metric-row">
        <span class="metric-icon">🌐</span>
        <div class="metric-body"><div class="metric-lbl">GCC Readiness</div>
          <div class="metric-track"><div class="metric-fill" id="mGcc" style="background:#f59e0b;"></div></div></div>
        <span class="metric-val" id="mGccV" style="color:#f59e0b;">—</span>
      </div>
      <div class="metric-row">
        <span class="metric-icon">💬</span>
        <div class="metric-body"><div class="metric-lbl">Communication Clarity</div>
          <div class="metric-track"><div class="metric-fill" id="mFric" style="background:#fb923c;"></div></div></div>
        <span class="metric-val" id="mFricV" style="color:#fb923c;">—</span>
      </div>

      <div class="lt-footer pulsing" id="ltFooter">⚡ Analyzing in real-time</div>
    </div>

  </div><!-- /terminal-panel -->
</div><!-- /os-grid -->

<!-- Score toast -->
<div class="score-toast" id="scoreToast">
  <div>
    <div class="toast-score" id="toastScore">—</div>
    <div class="toast-lbl">Answer Score</div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════════
     HIDDEN DEBUG CONSOLE
     Opens with Ctrl+Shift+D. Never surfaced to a candidate. Holds
     everything that's useful for troubleshooting a live session but
     adds cognitive noise for the person being interviewed: activity
     log, competency coverage, and raw audio metadata.
══════════════════════════════════════════════════════════════ -->
<div class="debug-console" id="debugConsole">
  <div class="dbg-hdr">
    <span class="dbg-hdr-title">⚠ DEBUG CONSOLE — STAFF ONLY</span>
    <button class="dbg-close" id="dbgClose">✕</button>
  </div>
  <div class="dbg-section">
    <div class="dbg-section-lbl">Session</div>
    <div class="dbg-meta-grid">
      <div class="dbg-meta-cell"><div class="k">Session ID</div><div class="v">#<%= sessionId %></div></div>
      <div class="dbg-meta-cell"><div class="k">Question ID</div><div class="v" id="dbgQid">—</div></div>
    </div>
  </div>
  <div class="dbg-section">
    <div class="dbg-section-lbl">Competency Coverage</div>
    <div id="dbgCompMap">
      <div class="dbg-comp-row"><span class="dbg-comp-name">System Design</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-system_design" style="width:0%;background:#3b82f6;"></div></div><span class="dbg-comp-count" id="compC-system_design">0</span></div>
      <div class="dbg-comp-row"><span class="dbg-comp-name">Leadership</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-leadership" style="width:0%;background:#22c55e;"></div></div><span class="dbg-comp-count" id="compC-leadership">0</span></div>
      <div class="dbg-comp-row"><span class="dbg-comp-name">Strategy</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-strategy" style="width:0%;background:#a78bfa;"></div></div><span class="dbg-comp-count" id="compC-strategy">0</span></div>
      <div class="dbg-comp-row"><span class="dbg-comp-name">Communication</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-communication" style="width:0%;background:#f59e0b;"></div></div><span class="dbg-comp-count" id="compC-communication">0</span></div>
      <div class="dbg-comp-row"><span class="dbg-comp-name">Technical</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-technical" style="width:0%;background:#fb923c;"></div></div><span class="dbg-comp-count" id="compC-technical">0</span></div>
    </div>
  </div>
  <div class="dbg-section">
    <div class="dbg-section-lbl">Audio Metadata</div>
    <div class="dbg-meta-grid">
      <div class="dbg-meta-cell"><div class="k">Filler Words</div><div class="v" id="advFiller">0</div></div>
      <div class="dbg-meta-cell"><div class="k">Pace</div><div class="v" id="advPace">—</div></div>
      <div class="dbg-meta-cell"><div class="k">Executive Tone</div><div class="v" id="advTone">—</div></div>
      <div class="dbg-meta-cell"><div class="k">Coherence</div><div class="v" id="advCoherence">—</div></div>
    </div>
  </div>
  <div class="dbg-section-lbl" style="padding:10px 14px 0;">Activity Log</div>
  <div class="dbg-log-body" id="slogBody"></div>
  <div class="dbg-hint">Ctrl+Shift+D to close</div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     INTERVIEW OS ENGINE
═══════════════════════════════════════════════════════════════ -->
<script>
(function() {
  /* ══ Sync engine — fixes the UI/audio desync bug ══
     The fetched question is held here and only painted to the DOM the
     instant Vapi reports the AI has actually started speaking. In
     text-only mode there's no audio to wait for, so it paints
     immediately. window.MedhaIQVoiceLive is flipped by the Vapi state
     machine further down this file. */
  var pendingQuestion = null;
  var MedhaIQSync = {
    hold: function(question, type, competency) {
      pendingQuestion = { question: question, type: type, competency: competency };
      if (!window.MedhaIQVoiceLive) MedhaIQSync.reveal();
    },
    reveal: function() {
      if (!pendingQuestion) return;
      showQuestion(pendingQuestion.question, pendingQuestion.type, pendingQuestion.competency);
      pendingQuestion = null;
    }
  };
  window.MedhaIQSync = MedhaIQSync;
  window.MedhaIQVoiceLive = false;

  /* ── EJS-injected session variables ── */
  var SID    = '<%= sessionId %>';
  var QID    = '<%= questionId %>';
  var QN     = <%= answeredCount %> + 1;
  var MAXQ   = 5;
  var SEC_PER_Q = 180; /* 3 min budget per question, drives the "Est. remaining" clock */
  var PNAME  = '<%= personaName %>';
  var PTITLE = '<%= personaTitle %>';
  var PINIT  = '<%= personaInitials %>';
  var PCOL   = '<%= personaStyleColor %>';
  var QTYPE  = '<%= questionType %>';
  var ROLE   = '<%= roleTitle %>';
  var LEVEL  = '<%= experienceLevel %>';
  var INITQ  = `<%- questionText.replace(/`/g, '\\`') %>`;

  document.getElementById('tbAvatar').textContent = PINIT;
  document.getElementById('tbAvatar').className   = 'tb-avatar ' + PCOL;
  document.getElementById('tbName').textContent   = PNAME;
  document.getElementById('tbRole').textContent   = PTITLE;
  document.getElementById('sbRole').textContent   = ROLE  || '—';
  document.getElementById('sbLevel').textContent  = LEVEL || '—';
  document.getElementById('sbPersona').textContent= PNAME || '—';

  /* ── Elapsed timer (topbar) ── */
  var t0 = Date.now(), timerInt;
  function tick() {
    var e = Math.floor((Date.now()-t0)/1000);
    document.getElementById('timer').textContent =
      String(Math.floor(e/60)).padStart(2,'0')+':'+String(e%60).padStart(2,'0');
  }
  timerInt = setInterval(tick, 1000);

  function updateCounter() {
    document.getElementById('qCounter').textContent = 'Q'+QN+' / '+MAXQ;
    document.getElementById('sbProgNum').textContent = QN;
    var pct = Math.round(((QN-1)/MAXQ)*100);
    document.getElementById('sbProgFill').style.width = pct+'%';
    var remaining = Math.max(0, MAXQ-(QN-1));
    document.getElementById('sbProgRemaining').textContent = remaining + (remaining===1?' question remaining':' questions remaining');
    var secsLeft = remaining * SEC_PER_Q;
    document.getElementById('sbTimeRemaining').textContent =
      String(Math.floor(secsLeft/60)).padStart(2,'0')+':'+String(secsLeft%60).padStart(2,'0');
  }

  /* ── Debug console (staff-only, Ctrl+Shift+D) ── */
  var dbg = document.getElementById('debugConsole');
  document.addEventListener('keydown', function(e){
    if (e.ctrlKey && e.shiftKey && (e.key==='D'||e.key==='d')) dbg.classList.toggle('open');
  });
  document.getElementById('dbgClose').addEventListener('click', function(){ dbg.classList.remove('open'); });

  function slog(msg, type) {
    var el = document.getElementById('slogBody');
    var ts = new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    var cls= 'dbg-entry' + (type==='ok'?' ok':type==='err'?' err':type==='info'?' info':'');
    el.insertAdjacentHTML('afterbegin','<div class="'+cls+'">['+ts+'] '+msg+'</div>');
  }

  var compScores = { system_design:0, leadership:0, strategy:0, communication:0, technical:0 };
  function updateCompetency(key, increment) {
    if (!(key in compScores)) return;
    compScores[key] = Math.min(100, compScores[key] + (increment || 20));
    var bar = document.getElementById('comp-'+key);
    var cnt = document.getElementById('compC-'+key);
    if (bar) bar.style.width = compScores[key]+'%';
    if (cnt) cnt.textContent = parseInt(cnt.textContent||0)+1;
  }

  /* ══ 5-Vector metrics — consumes the standardized IntelligenceMetrics
     schema: { overallScore, vectors:{...}, status, metadata:{...} } ══ */
  var runningScores = [];
  function updateMetrics(m) {
    if (!m || !m.vectors) return;
    runningScores.push(m);
    var v = m.vectors;
    [['mStar','mStarV', v.structure||0], ['mTech','mTechV', v.technicalDepth||0],
     ['mExec','mExecV', v.executivePresence||0], ['mGcc','mGccV', v.gccReadiness||0],
     ['mFric','mFricV', v.communicationClarity||0]].forEach(function(r) {
      var val = Math.round(r[2]);
      var bar = document.getElementById(r[0]); var lbl = document.getElementById(r[1]);
      if (bar) setTimeout(function(){ bar.style.width=val+'%'; }, 80);
      if (lbl) lbl.textContent = val;
    });
    if (m.metadata) {
      document.getElementById('advFiller').textContent    = m.metadata.fillerWords ?? '0';
      document.getElementById('advPace').textContent      = m.metadata.pace || '—';
      document.getElementById('advTone').textContent      = m.metadata.executiveTone || m.metadata.coherence || '—';
      document.getElementById('advCoherence').textContent = m.metadata.coherence || '—';
    }
    document.getElementById('dbgQid').textContent = QID;
    updateScoreRing(m.overallScore);
  }

  function updateScoreRing(latestOverall) {
    if (typeof latestOverall !== 'number') return;
    var total = runningScores.reduce(function(a,s){ return a+(s.overallScore||0); }, 0);
    var avg   = Math.round(total / runningScores.length);
    var CIRC  = 213; /* 2 * π * 34 */
    document.getElementById('ringFill').style.strokeDashoffset = CIRC - (CIRC*avg/100);
    var lbl = document.getElementById('ringLabel');
    lbl.textContent = avg;
    lbl.style.color = avg>=75?'#22c55e':avg>=55?'#f59e0b':'#ef4444';
  }

  /* ══ AI Interview Status — always-visible calm state machine ══ */
  var STATE_META = {
    PREPARING:        { title:'Preparing…',        sub:'Setting up your next question',     pulse:true,  ring:0.15, steps:[] },
    CALIBRATING:       { title:'Calibrating…',       sub:'Analysing your target role',        pulse:true,  ring:0.25, steps:[] },
    LISTENING:         { title:'Listening…',         sub:'Capturing your answer',             pulse:false, ring:0.4,  steps:['captured'] },
    ANALYZING:         { title:'Analyzing…',         sub:'Scoring your response',             pulse:true,  ring:0.75, steps:['captured','analyzing'] },
    GENERATING:        { title:'Generating…',        sub:'Preparing next question',           pulse:true,  ring:0.9,  steps:['captured','analyzing','preparing'] },
    READY:             { title:'Ready',              sub:'Your next question is up',          pulse:false, ring:1,    steps:['captured','analyzing','preparing'] },
    SESSION_COMPLETE:  { title:'Session Complete',   sub:'All questions answered',            pulse:false, ring:1,    steps:['captured','analyzing','preparing'] },
    GENERATING_REPORT: { title:'Generating Report…', sub:'Compiling your Intelligence Report',pulse:true,  ring:0.95, steps:['captured','analyzing','preparing'] },
    FINISHED:          { title:'Finished',           sub:'Redirecting to your report',        pulse:false, ring:1,    steps:['captured','analyzing','preparing'] },
  };
  var RING_CIRC = 220; /* 2 * π * 35 */
  var WORKING_STATES = { LISTENING:1, ANALYZING:1, GENERATING:1 };
  function setAIState(key) {
    var meta = STATE_META[key] || STATE_META.PREPARING;
    document.getElementById('aiStatusTitle').textContent = meta.title;
    document.getElementById('aiStatusSub').textContent   = meta.sub;
    var ring = document.getElementById('aiStatusRing');
    ring.style.strokeDashoffset = RING_CIRC - (RING_CIRC * meta.ring);
    ring.classList.toggle('pulsing', !!meta.pulse);
    var lastStep = meta.steps[meta.steps.length-1];
    document.querySelectorAll('#statusChecklist .status-item').forEach(function(el){
      var step = el.getAttribute('data-step');
      var included = meta.steps.indexOf(step) > -1;
      var isCurrent = included && step===lastStep && WORKING_STATES[key];
      el.classList.toggle('active', !!isCurrent);
      el.classList.toggle('done', included && !isCurrent);
    });
  }

  function showToast(overallScore) {
    var s = Math.round(overallScore||0);
    var el = document.getElementById('toastScore');
    el.textContent = s;
    el.className = 'toast-score '+(s>=75?'high':s>=55?'mid':'low');
    var t = document.getElementById('scoreToast');
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 4000);
  }

  /* ── Loading / question rendering ── */
  function showLoading(text) {
    document.getElementById('answerBarWrap') || null;
    document.querySelector('.answer-bar-wrap').style.display='none';
    document.getElementById('questionCard').style.display='none';
    document.getElementById('loadingOverlay').classList.add('show');
    document.getElementById('loadingText').textContent = text || 'Analysing...';
  }

  var QUESTION_WHY = {
    opening: 'This opening question establishes context and helps the AI calibrate follow-up depth.',
    behavioral: 'This evaluates your structure, ownership, and executive delivery under a real scenario.',
    drill_down: 'A deep-dive follow-up — the AI probes a gap or vague point from your last answer.',
  };

  function showQuestion(q, type, competency) {
    document.getElementById('loadingOverlay').classList.remove('show');
    document.getElementById('questionCard').style.display='flex';
    document.querySelector('.answer-bar-wrap').style.display='block';

    document.getElementById('questionText').textContent = q.text;
    var label = competency ? competency.replace(/_/g,' ').toUpperCase() : (type==='drill_down' ? 'DEEP DIVE' : 'BEHAVIORAL');
    document.getElementById('qEyebrow').textContent = 'QUESTION '+QN+' OF '+MAXQ+' · '+label;
    var why = document.getElementById('qWhyText');
    why.textContent = QUESTION_WHY[type] || QUESTION_WHY.behavioral;
    why.classList.remove('shown');

    document.getElementById('answerInput').value = '';
    document.getElementById('charCount').textContent = '0 / 4000';
    document.getElementById('submitBtn').disabled = true;
    document.getElementById('submitBtn').classList.remove('show');
    document.getElementById('answerInput').focus();
    setAIState('LISTENING');
  }

  document.getElementById('whyBtn').addEventListener('click', function(){
    document.getElementById('qWhyText').classList.toggle('shown');
  });

  /* ── Answer input ── */
  var answerInput = document.getElementById('answerInput');
  answerInput.addEventListener('input', function() {
    document.getElementById('charCount').textContent = this.value.length+' / 4000';
    var hasText = !!this.value.trim();
    document.getElementById('submitBtn').disabled = !hasText;
    document.getElementById('submitBtn').classList.toggle('show', hasText);
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 140)+'px';
  });

  document.getElementById('submitBtn').addEventListener('click', function(){ submitAnswer(false); });
  document.getElementById('skipBtn').addEventListener('click', function(){ submitAnswer(true); });

  async function submitAnswer(skip) {
    var ans = skip ? '' : answerInput.value.trim();
    if (!skip && !ans) return;
    document.getElementById('submitBtn').disabled = true;
    setAIState('ANALYZING');
    showLoading(PNAME+' is analysing your response...');
    slog('Q'+QN+' submitted — AI scoring...','info');
    try {
      var resp = await fetch('/api/interview/sessions/'+SID+'/answer', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ questionId: QID, answerText: ans, skip: skip }),
      });
      var data = await resp.json();
      if (!resp.ok) throw new Error(data.error || 'Server error '+resp.status);

      if (data.scores && !skip) {
        updateMetrics(data.scores);
        showToast(data.scores.overallScore);
        slog('Scored: '+Math.round(data.scores.overallScore)+'/100','ok');
      }
      if (data.competency_tag) updateCompetency(data.competency_tag, 20);

      setAIState('PREPARING');

      if (data.sessionEnded) {
        clearInterval(timerInt);
        setAIState('GENERATING_REPORT');
        slog('Session complete — generating report...','ok');
        showLoading('Generating your Career Intelligence Report...');
        setTimeout(function(){ window.location.href='/interview/report/'+data.reportId; }, 2200);
        return;
      }
      QID = data.question.id;
      QN++;
      updateCounter();
      MedhaIQSync.hold(data.question, data.question.type, data.competency_tag || data.question.competency);
      slog('Q'+QN+' ready','info');
    } catch (err) {
      console.error('[MedhaIQ]', err);
      slog('ERROR: '+err.message, 'err');
      document.getElementById('loadingOverlay').classList.remove('show');
      document.getElementById('questionCard').style.display='flex';
      document.querySelector('.answer-bar-wrap').style.display='block';
      document.getElementById('submitBtn').disabled = false;
      alert('Error: '+err.message);
    }
  }

  /* ── End session ── */
  document.getElementById('endBtn').addEventListener('click', async function(){
    if (!confirm('End this session? Your progress cannot be resumed.')) return;
    clearInterval(timerInt);
    try { await fetch('/api/interview/sessions/'+SID, { method:'DELETE' }); } catch(e){}
    window.location.href = '/dashboard/history';
  });

  /* ── Live Terminal toggle — collapsed by default ── */
  var liveTerminalCard = document.getElementById('liveTerminalCard');
  var terminalToggle   = document.getElementById('terminalToggle');
  var tpToggleLbl       = document.getElementById('tpToggleLbl');
  terminalToggle.addEventListener('change', function(){
    var expanded = this.checked;
    liveTerminalCard.classList.toggle('expanded', expanded);
    tpToggleLbl.textContent = expanded ? 'Hide terminal' : 'Show terminal';
    slog(expanded ? 'Live Terminal opened by candidate' : 'Live Terminal collapsed', 'info');
  });

  /* ── Initialise ── */
  updateCounter();
  setAIState('CALIBRATING');
  if (INITQ) showQuestion({text:INITQ}, QTYPE, null);
  slog('Session #'+SID+' initialised — '+PNAME, 'ok');
  slog('Role: '+ROLE+' | Level: '+LEVEL);
  window.MedhaIQ_log = slog; /* exposed for the Vapi block below */
  window.MedhaIQ_setAIState = setAIState;
})();
</script>

<!-- ═══════════════════════════════════════════════════════════════
     WEBCAM — unchanged behaviour, restyled container only.
═══════════════════════════════════════════════════════════════ -->
<script>
(function(){
  var video    = document.getElementById('camVideo');
  var ph       = document.getElementById('camPlaceholder');
  var badge    = document.getElementById('camBadge');
  var badgeTxt = document.getElementById('camBadgeText');
  var toggle   = document.getElementById('camToggle');
  var stream   = null, on = false;

  async function startCam(){
    try{
      stream=await navigator.mediaDevices.getUserMedia({video:true,audio:false});
      video.srcObject=stream; video.style.display='block';
      ph.style.display='none';
      badge.classList.remove('off'); badgeTxt.textContent='● LIVE';
      toggle.textContent='Disable Camera';
      on=true;
    }catch(e){
      badgeTxt.textContent='BLOCKED';
      console.warn('[cam]',e.message);
    }
  }
  function stopCam(){
    if(stream){stream.getTracks().forEach(function(t){t.stop();}); stream=null;}
    video.style.display='none'; ph.style.display='flex';
    badge.classList.add('off'); badgeTxt.textContent='CAM OFF';
    toggle.textContent='Enable Camera';
    on=false;
  }
  toggle.addEventListener('click',function(){ if(!on)startCam(); else stopCam(); });
  setTimeout(startCam, 1400);
})();
</script>

<!-- ═══════════════════════════════════════════════════════════════
     VAPI VOICE STATE MACHINE — now driving a single inline mic
     button instead of a standalone panel button. Fixes the desync
     via MedhaIQSync (defined in the main engine script above).
═══════════════════════════════════════════════════════════════ -->
<script>
(function(){
  var VKEY = '<%= vapiPublicKey %>';
  var VAST = '<%= vapiAssistantId %>';

  var btn = document.getElementById('vapiBtn');
  var sub = document.getElementById('vapiSub');
  var slog = window.MedhaIQ_log || function(){};

  if(!VKEY||!VAST){ btn.disabled = true; btn.style.opacity='0.4'; sub.textContent='Voice not configured — add VAPI keys in Render'; return; }

  var STATES={ IDLE:'IDLE',REQUESTING:'REQUESTING',CONNECTING:'CONNECTING',LIVE:'LIVE',STOPPING:'STOPPING' };
  var state=STATES.IDLE, vapi=null;

  function setState(s,msg,isErr){
    state=s;
    btn.classList.toggle('live', s===STATES.LIVE);
    btn.disabled = (s===STATES.REQUESTING||s===STATES.CONNECTING||s===STATES.STOPPING);
    if(msg){ sub.textContent=msg; sub.style.color=isErr?'#ef4444':''; }
  }
  function setErr(msg){
    setState(STATES.IDLE,msg,true);
    setTimeout(function(){ if(state===STATES.IDLE){ sub.textContent='Speak directly with your AI interviewer'; sub.style.color=''; } },7000);
  }

  function initVapi(){
    if(vapi||!window.vapiSDK)return;
    vapi=window.vapiSDK.run({apiKey:VKEY,assistant:VAST,config:{position:'hidden'}});

    vapi.on('call-start', function() {
      setState(STATES.LIVE, 'Voice active — speak your answer');
      window.MedhaIQVoiceLive = true;
    });

    /* Sync fix: speech-start reveals the already-fetched question via
       MedhaIQSync rather than painting raw ASR/TTS partial text. */
    vapi.on('speech-start', function() {
      if (window.MedhaIQSync) window.MedhaIQSync.reveal();
      sub.textContent = '● AI is speaking…';
    });

    vapi.on('speech-end', function() {
      sub.textContent = 'Your turn — speak clearly';
    });

    vapi.on('call-end', function() {
      window.MedhaIQVoiceLive = false;
      setState(STATES.IDLE, 'Speak directly with your AI interviewer');
    });

    vapi.on('error',function(e){
      console.error('[Vapi]',e);
      var msg='Connection error — retry';
      if(e&&e.message){
        if(/permission|not allowed/i.test(e.message)) msg='Microphone blocked — check browser settings';
        else if(/network|fetch/i.test(e.message))     msg='Network error — check your connection';
        else if(/assistant/i.test(e.message))         msg='Config error — check VAPI_ASSISTANT_ID';
      }
      setErr(msg);
    });
  }

  btn.addEventListener('click', async function(){
    if(state===STATES.LIVE||state===STATES.STOPPING){
      setState(STATES.STOPPING,'Ending voice session…');
      if(vapi){try{vapi.stop();}catch(e){}}
      return;
    }
    if(state!==STATES.IDLE)return;

    setState(STATES.REQUESTING,'Requesting microphone access…');
    try{
      var ms=await navigator.mediaDevices.getUserMedia({audio:true});
      ms.getTracks().forEach(function(t){t.stop();});
    }catch(e){
      if(e.name==='NotAllowedError') setErr('Microphone access required — click the lock icon in your browser bar');
      else if(e.name==='NotFoundError') setErr('No microphone detected');
      else setErr('Mic error: '+e.message);
      return;
    }

    if(!window.vapiSDK){
      setState(STATES.CONNECTING,'Loading voice engine…');
      var waited=0;
      try{
        await new Promise(function(res,rej){
          var t=setInterval(function(){
            waited+=150;
            if(window.vapiSDK){clearInterval(t);res();}
            if(waited>9000){clearInterval(t);rej(new Error('Voice SDK load timeout'));}
          },150);
        });
      }catch(e){ setErr(e.message); return; }
    }
    if(state!==STATES.CONNECTING&&state!==STATES.REQUESTING)return;

    setState(STATES.CONNECTING,'Connecting to AI interviewer…');
    try{ initVapi(); vapi.start(VAST); }
    catch(e){ setErr('Failed to connect: '+e.message); return; }

    setTimeout(function(){
      if(state===STATES.CONNECTING) setErr('Connection timed out — check your internet and retry');
    },13000);
  });

  setInterval(function(){ if(state===STATES.IDLE&&btn.disabled) btn.disabled=false; },3000);
})();
</script>

</body>
</html>
