<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Interview — MedhaIQ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <!--
    Vapi SDK note: vapiSDK html-script-tag CDN.
    This loads asynchronously and exposes window.vapiSDK when ready.
    The state machine below waits for it before attempting any call.
  -->
  <script>
  (function(d,t){
    var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
    g.src='https://cdn.jsdelivr.net/gh/VapiAI/html-script-tag@latest/dist/assets/index.js';
    g.defer=true; g.async=true;
    s.parentNode.insertBefore(g,s);
  })(document,'script');
  </script>
  <style>
    :root {
      --bg:        #070d1a;
      --panel:     #0e1628;
      --card:      #111e33;
      --border:    rgba(59,130,246,0.1);
      --border-hi: rgba(59,130,246,0.45);
      --blue:      #1d4ed8;
      --blue-hi:   #3b82f6;
      --blue-glow: rgba(59,130,246,0.18);
      --green:     #22c55e;
      --purple:    #a78bfa;
      --amber:     #f59e0b;
      --red:       #ef4444;
      --muted:     #475569;
      --soft:      #94a3b8;
      --white:     #f1f5f9;
      --mono:      'JetBrains Mono', monospace;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; }
    body {
      background: var(--bg);
      color: var(--white);
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 14px;
      background-image: radial-gradient(circle, rgba(59,130,246,0.055) 1px, transparent 1px);
      background-size: 28px 28px;
    }

    /* ── TOPBAR ── */
    .topbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 60;
      height: 50px;
      background: rgba(7,13,26,0.96);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center;
      padding: 0 20px; gap: 14px;
    }
    .tb-brand { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 800; color: #fff; }
    .tb-brand em { color: var(--blue-hi); font-style: normal; }
    .tb-sep { width: 1px; height: 18px; background: var(--border); }
    .tb-persona { display: flex; align-items: center; gap: 9px; }
    .tb-avatar { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif; color: #fff; }
    .tb-avatar.royal-blue { background: linear-gradient(135deg,#1e40af,#3b82f6); }
    .tb-avatar.emerald    { background: linear-gradient(135deg,#065f46,#10b981); }
    .tb-avatar.gold       { background: linear-gradient(135deg,#78350f,#f59e0b); }
    .tb-name { font-size: 13px; font-weight: 600; }
    .tb-role { font-size: 10px; color: var(--soft); }
    .tb-right { margin-left: auto; display: flex; align-items: center; gap: 10px; }
    .tb-q { font-size: 10px; font-weight: 700; color: var(--blue-hi); font-family: var(--mono); background: rgba(59,130,246,0.1); border: 1px solid var(--border); padding: 3px 10px; border-radius: 5px; }
    .tb-timer { font-size: 13px; font-weight: 600; color: var(--soft); font-family: var(--mono); }
    .tb-end { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.28); color: #fca5a5; font-size: 12px; font-weight: 600; padding: 5px 13px; border-radius: 6px; cursor: pointer; transition: background 0.15s; }
    .tb-end:hover { background: rgba(239,68,68,0.22); }

    /* ── 2-COLUMN LAYOUT ── */
    .layout {
      display: grid;
      grid-template-columns: 1fr 300px;
      height: 100vh;
      padding-top: 50px;
    }

    /* ── LEFT: INTERVIEW AREA ── */
    .interview-area {
      display: flex; flex-direction: column;
      padding: 18px 20px;
      gap: 13px;
      overflow-y: auto;
    }

    /* Live status bar */
    .live-bar {
      display: flex; align-items: center; gap: 10px;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 9px;
      padding: 8px 14px;
      flex-shrink: 0;
      backdrop-filter: blur(10px);
      box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    }
    .live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 8px var(--green); animation: lpulse 1.8s ease-in-out infinite; }
    @keyframes lpulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }
    .live-lbl { font-size: 10px; font-weight: 700; color: var(--green); text-transform: uppercase; letter-spacing: 1px; font-family: var(--mono); }
    .live-role-lbl { font-size: 11px; color: var(--muted); font-family: var(--mono); margin-left: 2px; }
    .live-gap { flex: 1; }
    .voice-ind { font-size: 10px; color: var(--muted); font-family: var(--mono); transition: color 0.3s; }
    .voice-ind.active { color: var(--purple); }
    .voice-ind.error  { color: var(--red); }

    /* Calibrating overlay — shows for first 5s */
    .calibrating-bar {
      display: flex; align-items: center; gap: 10px;
      background: rgba(59,130,246,0.06);
      border: 1px solid rgba(59,130,246,0.2);
      border-radius: 9px; padding: 9px 14px;
      font-size: 11px; font-family: var(--mono); color: var(--blue-hi);
      flex-shrink: 0;
      animation: calfade 1.2s ease-in-out infinite alternate;
    }
    @keyframes calfade { from{opacity:0.5;} to{opacity:1;} }
    .cal-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue-hi); animation: lpulse 0.8s ease-in-out infinite; }

    /* Question terminal */
    .q-terminal {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      flex-shrink: 0;
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }
    .q-term-hdr {
      display: flex; align-items: center; gap: 7px;
      padding: 9px 14px;
      border-bottom: 1px solid var(--border);
      background: rgba(0,0,0,0.22);
    }
    .tdot { width: 10px; height: 10px; border-radius: 50%; }
    .td-r{background:#ef4444;} .td-y{background:#f59e0b;} .td-g{background:#22c55e;}
    .q-path { font-size: 10px; color: var(--muted); font-family: var(--mono); margin-left: 4px; }
    .q-term-body { padding: 20px 22px; }
    .q-prompt { font-size: 10px; color: var(--blue-hi); font-family: var(--mono); margin-bottom: 8px; }
    .q-text { font-size: 16px; font-weight: 600; font-family: 'Plus Jakarta Sans', sans-serif; color: #fff; line-height: 1.58; }
    .q-tip { font-size: 10px; color: var(--muted); font-style: italic; margin-top: 9px; font-family: var(--mono); }

    /* Voice visualiser */
    .viz-wrap {
      background: var(--panel); border: 1px solid var(--border);
      border-radius: 9px; padding: 11px 16px;
      display: flex; align-items: center; gap: 12px;
      flex-shrink: 0;
      box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    }
    .viz-lbl { font-size: 9px; color: var(--muted); font-family: var(--mono); text-transform: uppercase; letter-spacing: 1px; white-space: nowrap; }
    .viz-bars { display: flex; align-items: flex-end; gap: 3px; height: 28px; flex: 1; }
    .vbar { width: 4px; border-radius: 2px; background: var(--blue-hi); opacity: 0.2; transition: height 0.07s ease; }
    .vbar.lit { opacity: 1; }
    .cam-toggle { width: 32px; height: 32px; border-radius: 50%; border: 1.5px solid var(--border-hi); background: rgba(59,130,246,0.07); display: flex; align-items: center; justify-content: center; font-size: 14px; cursor: pointer; transition: all 0.15s; flex-shrink: 0; }
    .cam-toggle:hover { background: rgba(59,130,246,0.18); }
    .cam-toggle.recording { border-color: var(--red); background: rgba(239,68,68,0.12); animation: recring 1.2s infinite; }
    @keyframes recring { 0%,100%{box-shadow:0 0 0 0 rgba(239,68,68,0.3);} 50%{box-shadow:0 0 0 8px rgba(239,68,68,0);} }

    /* Answer area */
    .answer-area { display: flex; flex-direction: column; gap: 10px; flex: 1; min-height: 140px; }
    .answer-textarea {
      width: 100%; min-height: 130px; flex: 1;
      background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
      padding: 14px 16px; color: #fff; font-size: 14px; font-family: 'Inter', sans-serif; line-height: 1.6; resize: none;
      box-shadow: 0 4px 16px rgba(0,0,0,0.18);
    }
    .answer-textarea:focus { outline: none; border-color: var(--blue-hi); box-shadow: 0 0 0 3px rgba(59,130,246,0.08); }
    .answer-textarea::placeholder { color: var(--muted); }
    .answer-actions { display: flex; align-items: center; gap: 10px; }
    .char-count { font-size: 10px; color: var(--muted); font-family: var(--mono); margin-right: auto; }
    .btn-skip { background: transparent; border: 1px solid var(--border); color: var(--muted); font-size: 12px; font-weight: 500; padding: 7px 14px; border-radius: 6px; cursor: pointer; }
    .btn-skip:hover { border-color: var(--border-hi); color: #fff; }
    .btn-submit { background: var(--blue); border: none; border-radius: 7px; color: #fff; font-size: 13px; font-weight: 700; font-family: 'Plus Jakarta Sans', sans-serif; padding: 9px 28px; cursor: pointer; transition: all 0.16s; }
    .btn-submit:not(:disabled):hover { background: var(--blue-hi); box-shadow: 0 0 14px var(--blue-glow); }
    .btn-submit:disabled { opacity: 0.35; cursor: not-allowed; }

    /* Loading state */
    .loading-overlay { display: none; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 44px; text-align: center; flex: 1; }
    .loading-overlay.show { display: flex; }
    .ldots { display: flex; gap: 6px; }
    .ldots span { width: 7px; height: 7px; border-radius: 50%; background: var(--blue-hi); animation: lbounce 1s ease-in-out infinite; }
    .ldots span:nth-child(2){animation-delay:.15s;} .ldots span:nth-child(3){animation-delay:.3s;}
    @keyframes lbounce { 0%,60%,100%{transform:translateY(0);} 30%{transform:translateY(-8px);} }
    .ltext { font-size: 12px; color: var(--muted); font-family: var(--mono); }

    /* ── RIGHT: TERMINAL PANEL ── */
    .terminal-panel {
      background: rgba(14,22,40,0.97);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-left: 1px solid var(--border);
      display: flex; flex-direction: column;
      overflow: hidden;
      box-shadow: -8px 0 32px rgba(0,0,0,0.3);
    }
    .tp-header {
      padding: 11px 14px; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 8px;
    }
    .tp-title { font-size: 10px; font-weight: 700; color: var(--blue-hi); letter-spacing: 1.6px; text-transform: uppercase; font-family: var(--mono); }
    .tp-ver { font-size: 9px; font-weight: 700; padding: 2px 7px; border-radius: 20px; background: rgba(59,130,246,0.1); color: var(--blue-hi); border: 1px solid var(--border); margin-left: auto; }

    /* Webcam block */
    .cam-block { padding: 10px 14px; border-bottom: 1px solid var(--border); }
    .blabel { font-size: 9px; color: var(--muted); font-family: var(--mono); text-transform: uppercase; letter-spacing: 1.1px; margin-bottom: 8px; }
    .cam-wrap {
      position: relative; width: 100%; padding-top: 62%;
      background: #050b17; border-radius: 8px; overflow: hidden;
      border: 1px solid var(--border);
      box-shadow: 0 4px 20px rgba(0,0,0,0.4);
    }
    .cam-wrap video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
    .cam-placeholder { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 28px; color: var(--muted); }
    .cam-status-badge { position: absolute; bottom: 7px; left: 8px; font-size: 9px; font-weight: 700; color: #fff; background: rgba(0,0,0,0.7); padding: 2px 7px; border-radius: 4px; font-family: var(--mono); }

    /* Vapi state machine block */
    .vapi-block { padding: 10px 14px; border-bottom: 1px solid var(--border); }
    .vapi-btn {
      width: 100%; padding: 9px;
      background: rgba(59,130,246,0.08); border: 1px solid var(--border-hi);
      border-radius: 7px; color: var(--blue-hi);
      font-size: 12px; font-weight: 700; font-family: 'Plus Jakarta Sans', sans-serif;
      cursor: pointer; transition: all 0.18s;
      display: flex; align-items: center; justify-content: center; gap: 7px;
    }
    .vapi-btn:hover:not(:disabled) { background: rgba(59,130,246,0.18); }
    .vapi-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .vapi-btn.state-live { background: rgba(239,68,68,0.12); border-color: rgba(239,68,68,0.4); color: #fca5a5; }
    .vapi-btn.state-connecting { background: rgba(245,158,11,0.1); border-color: rgba(245,158,11,0.4); color: #fcd34d; }
    .vapi-btn.state-error { background: rgba(239,68,68,0.08); border-color: rgba(239,68,68,0.25); color: #fca5a5; }
    .vapi-sub { font-size: 9px; color: var(--muted); text-align: center; margin-top: 5px; font-family: var(--mono); transition: color 0.2s; }
    .vapi-perm-warn { display: none; font-size: 9px; color: var(--amber); text-align: center; margin-top: 5px; font-family: var(--mono); }

    /* Metrics */
    .metrics-block { flex: 1; overflow-y: auto; padding: 11px 14px; }
    .metric-row { display: flex; align-items: center; gap: 9px; margin-bottom: 13px; }
    .metric-icon { font-size: 13px; flex-shrink: 0; }
    .metric-body { flex: 1; }
    .metric-lbl { font-size: 9px; color: var(--muted); font-family: var(--mono); margin-bottom: 3px; text-transform: uppercase; letter-spacing: 0.6px; }
    .metric-track { height: 3px; background: rgba(255,255,255,0.05); border-radius: 2px; overflow: hidden; }
    .metric-fill { height: 100%; border-radius: 2px; width: 0%; transition: width 0.75s cubic-bezier(0.25,1,0.5,1); }
    .metric-val { font-size: 11px; font-weight: 700; font-family: var(--mono); flex-shrink: 0; min-width: 24px; text-align: right; }
    /* Metric slide-up animation when value first arrives */
    @keyframes metric-reveal { from{opacity:0;transform:translateY(4px);} to{opacity:1;transform:translateY(0);} }
    .metric-val.revealed { animation: metric-reveal 0.35s ease forwards; }

    /* Session log */
    .slog { padding: 8px 14px 10px; border-top: 1px solid var(--border); max-height: 110px; overflow-y: auto; }
    .slog-entry { font-family: var(--mono); font-size: 9px; color: var(--muted); line-height: 1.9; }
    .slog-entry.ok  { color: #22c55e88; }
    .slog-entry.err { color: #ef444488; }

    /* Score toast */
    .score-toast {
      position: fixed; top: 62px; right: 16px; z-index: 200;
      background: var(--card); border: 1px solid var(--border-hi); border-radius: 12px;
      padding: 12px 18px; display: flex; align-items: center; gap: 14px;
      transform: translateX(120%);
      transition: transform 0.42s cubic-bezier(0.34,1.56,0.64,1);
      box-shadow: 0 10px 32px rgba(0,0,0,0.45), 0 0 0 1px var(--border-hi);
    }
    .score-toast.show { transform: translateX(0); }
    .toast-score { font-size: 24px; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif; }
    .toast-score.high { color: var(--green); } .toast-score.mid { color: var(--amber); } .toast-score.low { color: var(--red); }
    .toast-lbl { font-size: 10px; color: var(--muted); }
    .toast-vec { font-size: 9px; color: var(--muted); font-family: var(--mono); margin-top: 2px; }
  </style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
  <span class="tb-brand">Medha<em>IQ</em></span>
  <div class="tb-sep"></div>
  <div class="tb-persona">
    <div class="tb-avatar <%= personaStyleColor %>" id="tbAvatar"></div>
    <div>
      <div class="tb-name" id="tbName"></div>
      <div class="tb-role" id="tbRole"></div>
    </div>
  </div>
  <div class="tb-right">
    <div class="tb-q" id="qCounter">Q1 / 5</div>
    <div class="tb-timer" id="timer">00:00</div>
    <button class="tb-end" id="endBtn">End Session</button>
  </div>
</div>

<!-- LAYOUT -->
<div class="layout">

  <!-- LEFT: INTERVIEW AREA -->
  <div class="interview-area" id="interviewArea">

    <!-- Calibrating bar — hides after 5s -->
    <div class="calibrating-bar" id="calibBar">
      <div class="cal-dot"></div>
      <span>Calibrating interview environment... AI engine loading</span>
    </div>

    <!-- Live status bar -->
    <div class="live-bar">
      <div class="live-dot"></div>
      <span class="live-lbl">Live Interview</span>
      <span class="live-role-lbl" id="liveRole"></span>
      <div class="live-gap"></div>
      <span class="voice-ind" id="voiceInd">Voice: standby</span>
    </div>

    <!-- Question terminal -->
    <div class="q-terminal">
      <div class="q-term-hdr">
        <div class="tdot td-r"></div>
        <div class="tdot td-y"></div>
        <div class="tdot td-g"></div>
        <span class="q-path">medhaiq://session/<%= sessionId %>/question</span>
      </div>
      <div class="q-term-body">
        <div class="q-prompt" id="qPrompt">&gt; question_01.opening</div>
        <div class="q-text" id="questionText">Loading your first question...</div>
        <div class="q-tip" id="qTip">// Tip: Use the STAR framework — Situation, Task, Action, Result.</div>
      </div>
    </div>

    <!-- Voice signal visualiser -->
    <div class="viz-wrap">
      <span class="viz-lbl">Signal</span>
      <div class="viz-bars" id="vizBars"></div>
      <div class="cam-toggle" id="camToggle" title="Toggle webcam">&#127909;</div>
    </div>

    <!-- Answer area -->
    <div class="answer-area" id="answerArea">
      <textarea class="answer-textarea" id="answerInput"
        placeholder="Type your answer here, or use Voice Mode in the right panel..."
        maxlength="4000"></textarea>
      <div class="answer-actions">
        <span class="char-count" id="charCount">0 / 4000</span>
        <button class="btn-skip" id="skipBtn">Skip &rarr;</button>
        <button class="btn-submit" id="submitBtn" disabled>Submit Answer</button>
      </div>
    </div>

    <!-- Loading overlay -->
    <div class="loading-overlay" id="loadingOverlay">
      <div class="ldots"><span></span><span></span><span></span></div>
      <div class="ltext" id="loadingText">Reviewing your answer...</div>
    </div>

  </div><!-- /interview-area -->

  <!-- RIGHT: TERMINAL PANEL -->
  <div class="terminal-panel">

    <div class="tp-header">
      <span class="tp-title">Live Terminal</span>
      <span class="tp-ver">v0.5</span>
    </div>

    <!-- Webcam feed -->
    <div class="cam-block">
      <div class="blabel">// Candidate Feed</div>
      <div class="cam-wrap">
        <video id="camVideo" autoplay playsinline muted style="display:none;"></video>
        <div class="cam-placeholder" id="camPlaceholder">&#128247;</div>
        <div class="cam-status-badge" id="camStatus">CAM OFF</div>
      </div>
    </div>

    <!-- VAPI VOICE — State Machine UI -->
    <div class="vapi-block">
      <button class="vapi-btn" id="vapiBtn">&#127897; Enable Voice Mode</button>
      <div class="vapi-sub" id="vapiSub">Click to speak with your interviewer</div>
      <div class="vapi-perm-warn" id="vapiPermWarn">&#9888; Mic permission required — check browser bar</div>
    </div>

    <!-- Live metrics -->
    <div class="metrics-block">
      <div class="blabel" style="margin-bottom:12px;">// Performance Metrics</div>

      <div class="metric-row">
        <span class="metric-icon">&#9889;</span>
        <div class="metric-body">
          <div class="metric-lbl">Structure (STAR)</div>
          <div class="metric-track"><div class="metric-fill" id="mStar" style="background:#3b82f6;"></div></div>
        </div>
        <span class="metric-val" id="mStarV" style="color:#3b82f6;">&#8212;</span>
      </div>

      <div class="metric-row">
        <span class="metric-icon">&#129504;</span>
        <div class="metric-body">
          <div class="metric-lbl">Technical Depth</div>
          <div class="metric-track"><div class="metric-fill" id="mTech" style="background:#a78bfa;"></div></div>
        </div>
        <span class="metric-val" id="mTechV" style="color:#a78bfa;">&#8212;</span>
      </div>

      <div class="metric-row">
        <span class="metric-icon">&#128084;</span>
        <div class="metric-body">
          <div class="metric-lbl">Executive Presence</div>
          <div class="metric-track"><div class="metric-fill" id="mExec" style="background:#22c55e;"></div></div>
        </div>
        <span class="metric-val" id="mExecV" style="color:#22c55e;">&#8212;</span>
      </div>

      <div class="metric-row">
        <span class="metric-icon">&#127758;</span>
        <div class="metric-body">
          <div class="metric-lbl">GCC Readiness</div>
          <div class="metric-track"><div class="metric-fill" id="mGcc" style="background:#f59e0b;"></div></div>
        </div>
        <span class="metric-val" id="mGccV" style="color:#f59e0b;">&#8212;</span>
      </div>

      <div class="metric-row">
        <span class="metric-icon">&#128172;</span>
        <div class="metric-body">
          <div class="metric-lbl">Communication Clarity</div>
          <div class="metric-track"><div class="metric-fill" id="mFric" style="background:#fb923c;"></div></div>
        </div>
        <span class="metric-val" id="mFricV" style="color:#fb923c;">&#8212;</span>
      </div>
    </div>

    <!-- Session log -->
    <div class="slog">
      <div class="blabel" style="margin-bottom:6px;">// Session Log</div>
      <div id="slogBody"></div>
    </div>

  </div><!-- /terminal-panel -->
</div><!-- /layout -->

<!-- Score toast -->
<div class="score-toast" id="scoreToast">
  <div>
    <div class="toast-score" id="toastScore">&#8212;</div>
    <div class="toast-lbl">Answer Score</div>
    <div class="toast-vec" id="toastVec"></div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     INTERVIEW ENGINE — Main logic
═══════════════════════════════════════════════════════════════ -->
<script>
(function() {
  /* EJS-injected session variables */
  var SID    = '<%= sessionId %>';
  var QID    = '<%= questionId %>';
  var QN     = <%= answeredCount %> + 1;
  var MAXQ   = 5;
  var PNAME  = '<%= personaName %>';
  var PTITLE = '<%= personaTitle %>';
  var PINIT  = '<%= personaInitials %>';
  var PCOL   = '<%= personaStyleColor %>';
  var QTYPE  = '<%= questionType %>';
  var ROLE   = '<%= roleTitle %>';
  var INITQ  = `<%- questionText.replace(/`/g, '\\`') %>`;

  /* ── Topbar init ── */
  document.getElementById('tbAvatar').textContent = PINIT;
  document.getElementById('tbAvatar').className   = 'tb-avatar ' + PCOL;
  document.getElementById('tbName').textContent   = PNAME;
  document.getElementById('tbRole').textContent   = PTITLE;
  document.getElementById('liveRole').textContent = ROLE ? '· ' + ROLE : '';

  /* ── Calibrating bar — hide after 5s ── */
  setTimeout(function() {
    var cb = document.getElementById('calibBar');
    if (cb) { cb.style.transition = 'opacity 0.6s'; cb.style.opacity = '0'; setTimeout(function(){cb.style.display='none';}, 650); }
  }, 5000);

  /* ── Timer ── */
  var t0 = Date.now(), timerInt;
  function tick() {
    var e = Math.floor((Date.now()-t0)/1000);
    document.getElementById('timer').textContent =
      String(Math.floor(e/60)).padStart(2,'0') + ':' + String(e%60).padStart(2,'0');
  }
  timerInt = setInterval(tick, 1000);
  function updateCounter() { document.getElementById('qCounter').textContent = 'Q' + QN + ' / ' + MAXQ; }

  /* ── Session log ── */
  function slog(msg, type) {
    var el = document.getElementById('slogBody');
    var ts = new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    var cls = 'slog-entry' + (type === 'ok' ? ' ok' : type === 'err' ? ' err' : '');
    el.insertAdjacentHTML('afterbegin', '<div class="'+cls+'">['+ts+'] '+msg+'</div>');
  }

  /* ── Metrics update with slide-up animation ── */
  function updateMetrics(s) {
    if (!s) return;
    var map = [
      ['mStar','mStarV',s.star||s.structure||0],
      ['mTech','mTechV',s.technical||s.depth||0],
      ['mExec','mExecV',s.executive||0],
      ['mGcc', 'mGccV', s.gcc||s.coherence||0],
      ['mFric','mFricV',s.friction||s.clarity||0],
    ];
    map.forEach(function(r) {
      var v = Math.round(r[2]);
      var bar = document.getElementById(r[0]);
      var val = document.getElementById(r[1]);
      if (bar) { setTimeout(function(){ bar.style.width = v+'%'; }, 80); }
      if (val) {
        val.textContent = v;
        val.classList.remove('revealed');
        void val.offsetWidth; /* reflow to retrigger animation */
        val.classList.add('revealed');
      }
    });
  }

  /* ── Score toast ── */
  function showToast(w, scores) {
    var s = Math.round(w||0);
    var el = document.getElementById('toastScore');
    el.textContent = s;
    el.className = 'toast-score ' + (s>=75?'high':s>=55?'mid':'low');
    var vec = document.getElementById('toastVec');
    if (scores && vec) {
      vec.textContent = 'STAR:'+Math.round(scores.star||0)+' EXE:'+Math.round(scores.executive||0)+' CLR:'+Math.round(scores.friction||0);
    }
    var t = document.getElementById('scoreToast');
    t.classList.add('show');
    setTimeout(function(){t.classList.remove('show');}, 4000);
  }

  /* ── Voice visualiser ── */
  var vizEl = document.getElementById('vizBars');
  for (var i=0;i<26;i++) {
    var b = document.createElement('div'); b.className='vbar';
    b.style.height = (Math.random()*18+4)+'px'; vizEl.appendChild(b);
  }
  var vizOn = false;
  function startViz() { vizOn=true; vizEl.querySelectorAll('.vbar').forEach(function(b){b.classList.add('lit');}); animViz(); }
  function stopViz()  { vizOn=false; vizEl.querySelectorAll('.vbar').forEach(function(b){b.classList.remove('lit');b.style.height=(Math.random()*18+4)+'px';}); }
  function animViz()  { if(!vizOn)return; vizEl.querySelectorAll('.vbar').forEach(function(b){b.style.height=(Math.random()*26+4)+'px';}); setTimeout(animViz,85); }

  /* ── Show/hide states ── */
  function showLoading(text) {
    document.getElementById('answerArea').style.display = 'none';
    document.getElementById('loadingOverlay').classList.add('show');
    document.getElementById('loadingText').textContent = text || 'Reviewing...';
    startViz();
  }
  function showQuestion(q, type) {
    document.getElementById('loadingOverlay').classList.remove('show');
    document.getElementById('answerArea').style.display = 'flex';
    document.getElementById('questionText').textContent = q.text;
    var p = document.getElementById('qPrompt');
    p.textContent = '> question_0'+QN+'.'+(type||'behavioral');
    var tip = document.getElementById('qTip');
    tip.style.display = (type==='drill_down') ? 'none' : 'block';
    document.getElementById('answerInput').value = '';
    document.getElementById('charCount').textContent = '0 / 4000';
    document.getElementById('submitBtn').disabled = true;
    document.getElementById('answerInput').focus();
    stopViz();
  }

  /* ── Textarea char count ── */
  document.getElementById('answerInput').addEventListener('input', function() {
    document.getElementById('charCount').textContent = this.value.length + ' / 4000';
    document.getElementById('submitBtn').disabled = !this.value.trim();
  });

  /* ── Submit / Skip ── */
  document.getElementById('submitBtn').addEventListener('click', function(){ submitAnswer(false); });
  document.getElementById('skipBtn').addEventListener('click', function(){ submitAnswer(true); });

  async function submitAnswer(skip) {
    var ans = skip ? '' : document.getElementById('answerInput').value.trim();
    if (!skip && !ans) return;
    document.getElementById('submitBtn').disabled = true;
    showLoading(PNAME + ' is analysing your answer...');
    slog('Q'+QN+' submitted — AI scoring in progress...');
    try {
      var resp = await fetch('/api/interview/sessions/'+SID+'/answer', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({questionId: QID, answerText: ans, skip: skip}),
      });
      var data = await resp.json();
      if (!resp.ok) throw new Error(data.error || 'Server error '+resp.status);

      if (data.scores && !skip) {
        updateMetrics(data.scores);
        showToast(data.scores.weighted, data.scores);
        slog('Scored: '+Math.round(data.scores.weighted)+'/100 · STAR:'+Math.round(data.scores.star||0), 'ok');
      }

      if (data.sessionEnded) {
        clearInterval(timerInt);
        slog('Session complete — generating Career Intelligence Report...', 'ok');
        showLoading('Generating your Career Intelligence Report...');
        setTimeout(function(){ window.location.href = '/interview/report/'+data.reportId; }, 2000);
        return;
      }

      QID = data.question.id;
      QN++;
      updateCounter();
      showQuestion(data.question, data.question.type);
      slog('Q'+QN+' loaded ('+data.question.type+')');
    } catch(err) {
      console.error('[MedhaIQ]', err);
      slog('ERROR: '+err.message, 'err');
      document.getElementById('loadingOverlay').classList.remove('show');
      document.getElementById('answerArea').style.display = 'flex';
      document.getElementById('submitBtn').disabled = false;
      stopViz();
      alert('Error: '+err.message+'\n\nCheck browser console for details.');
    }
  }

  /* ── End session ── */
  document.getElementById('endBtn').addEventListener('click', async function() {
    if (!confirm('End this session? Your progress cannot be resumed.')) return;
    clearInterval(timerInt);
    try { await fetch('/api/interview/sessions/'+SID, {method:'DELETE'}); } catch(e){}
    window.location.href = '/dashboard/history';
  });

  /* ── Initialise ── */
  updateCounter();
  if (INITQ) showQuestion({text: INITQ}, QTYPE);
  slog('Session '+SID+' initialised — '+PNAME);
  slog('Role: '+ROLE+' | Level: '+'<%= experienceLevel %>');
  slog('Agentic AI engine ready');
})();
</script>

<!-- ═══════════════════════════════════════════════════════════════
     WEBCAM — Auto-start with graceful fallback
═══════════════════════════════════════════════════════════════ -->
<script>
(function() {
  var video       = document.getElementById('camVideo');
  var placeholder = document.getElementById('camPlaceholder');
  var statusBadge = document.getElementById('camStatus');
  var camToggleBtn= document.getElementById('camToggle');
  var camStream   = null;
  var camOn       = false;

  async function startCam() {
    try {
      camStream = await navigator.mediaDevices.getUserMedia({video: true, audio: false});
      video.srcObject = camStream;
      video.style.display = 'block';
      placeholder.style.display = 'none';
      statusBadge.textContent = '● LIVE';
      statusBadge.style.color = '#22c55e';
      camOn = true;
    } catch(e) {
      statusBadge.textContent = 'BLOCKED';
      console.warn('[cam]', e.message);
    }
  }

  function stopCam() {
    if (camStream) { camStream.getTracks().forEach(function(t){ t.stop(); }); camStream = null; }
    video.style.display = 'none';
    placeholder.style.display = 'flex';
    statusBadge.textContent = 'CAM OFF';
    statusBadge.style.color = '#fff';
    camOn = false;
  }

  camToggleBtn.addEventListener('click', function() {
    if (!camOn) startCam(); else stopCam();
  });

  /* Auto-start after short delay */
  setTimeout(startCam, 1400);
})();
</script>

<!-- ═══════════════════════════════════════════════════════════════
     VAPI VOICE STATE MACHINE
     States: IDLE → REQUESTING_PERMISSIONS → CONNECTING → LIVE → STOPPING
     Each state update changes button text, colour, and disabled state.
     Errors are caught per-state with specific user messages.
═══════════════════════════════════════════════════════════════ -->
<script>
(function() {
  var VKEY = '<%= vapiPublicKey %>';
  var VAST = '<%= vapiAssistantId %>';

  var btn      = document.getElementById('vapiBtn');
  var sub      = document.getElementById('vapiSub');
  var permWarn = document.getElementById('vapiPermWarn');
  var voiceInd = document.getElementById('voiceInd');
  var camToggle= document.getElementById('camToggle');
  var vizEl    = document.getElementById('vizBars');

  /* Hide button if no credentials configured */
  if (!VKEY || !VAST) {
    btn.style.display = 'none';
    sub.textContent = 'Voice mode: credentials not configured';
    return;
  }

  /* ── State machine ── */
  var STATES = { IDLE: 'IDLE', REQUESTING: 'REQUESTING', CONNECTING: 'CONNECTING', LIVE: 'LIVE', STOPPING: 'STOPPING' };
  var state = STATES.IDLE;
  var vapiInstance = null;

  function setState(newState, msg, isErr) {
    state = newState;
    var labels = {
      IDLE:       { text: '🎙 Enable Voice Mode', cls: '',               dis: false },
      REQUESTING: { text: '⏳ Checking mic...',    cls: 'state-connecting', dis: true  },
      CONNECTING: { text: '⏳ Connecting...',       cls: 'state-connecting', dis: true  },
      LIVE:       { text: '🔴 End Voice Session',   cls: 'state-live',      dis: false },
      STOPPING:   { text: '⏹ Stopping...',          cls: '',               dis: true  },
    };
    var L = labels[newState] || labels.IDLE;
    btn.textContent = L.text;
    btn.className   = 'vapi-btn ' + L.cls;
    btn.disabled    = L.dis;
    if (msg) {
      sub.textContent = msg;
      sub.style.color = isErr ? '#ef4444' : '';
    }
    /* Voice indicator in topbar */
    if (newState === STATES.LIVE) {
      voiceInd.textContent = 'Voice: ● active'; voiceInd.className = 'voice-ind active';
      camToggle.classList.add('recording');
    } else if (newState === STATES.IDLE || newState === STATES.STOPPING) {
      voiceInd.textContent = 'Voice: standby'; voiceInd.className = 'voice-ind';
      camToggle.classList.remove('recording');
    }
    if (isErr) { voiceInd.textContent = 'Voice: error'; voiceInd.className = 'voice-ind error'; }
  }

  function setErrState(userMsg) {
    setState(STATES.IDLE, userMsg, true);
    /* Reset to IDLE after 6s so user can retry */
    setTimeout(function() {
      if (state === STATES.IDLE) { sub.textContent = 'Click to speak with your interviewer'; sub.style.color = ''; }
    }, 6000);
  }

  /* ── Initialise Vapi instance ── */
  function initVapi() {
    if (vapiInstance) return;
    if (!window.vapiSDK) { setErrState('SDK not loaded — refresh and try again'); return; }

    vapiInstance = window.vapiSDK.run({
      apiKey:    VKEY,
      assistant: VAST,
      config:    { position: 'hidden' },
    });

    vapiInstance.on('call-start', function() {
      setState(STATES.LIVE, 'Voice active — speak your answer');
      startVizFromVapi();
    });

    vapiInstance.on('call-end', function() {
      setState(STATES.IDLE, 'Voice session ended');
      stopVizFromVapi();
    });

    vapiInstance.on('speech-start', function() {
      sub.textContent = '● AI interviewer is speaking...';
      voiceInd.textContent = 'Voice: ● AI speaking';
    });

    vapiInstance.on('speech-end', function() {
      sub.textContent = 'Your turn — answer clearly';
      voiceInd.textContent = 'Voice: ● listening';
    });

    vapiInstance.on('error', function(e) {
      console.error('[Vapi error]', e);
      var msg = 'Connection error — retry';
      /* Translate common Vapi error codes to plain English */
      if (e && e.message) {
        if (/permission|not allowed/i.test(e.message)) msg = 'Mic blocked — allow in browser settings';
        else if (/network|fetch/i.test(e.message))     msg = 'Network issue — check connection';
        else if (/assistant/i.test(e.message))         msg = 'Assistant config error — check VAPI_ASSISTANT_ID';
      }
      setErrState(msg);
      stopVizFromVapi();
    });
  }

  /* Visualiser control from Vapi events */
  function startVizFromVapi() { vizEl.querySelectorAll('.vbar').forEach(function(b){b.classList.add('lit');}); animVizVapi(); }
  function stopVizFromVapi()  { vizEl.querySelectorAll('.vbar').forEach(function(b){b.classList.remove('lit');b.style.height=(Math.random()*18+4)+'px';}); }
  var vapiVizOn = false;
  function animVizVapi() {
    if (state !== STATES.LIVE) return;
    vizEl.querySelectorAll('.vbar').forEach(function(b){b.style.height=(Math.random()*26+4)+'px';});
    setTimeout(animVizVapi, 90);
  }

  /* ── Button click: full state machine flow ── */
  btn.addEventListener('click', async function() {
    if (state === STATES.LIVE || state === STATES.STOPPING) {
      /* STOP */
      setState(STATES.STOPPING, 'Ending voice session...');
      if (vapiInstance) { try { vapiInstance.stop(); } catch(e){} }
      return;
    }

    if (state !== STATES.IDLE) return; /* block rapid clicking */

    /* Step 1: REQUEST PERMISSIONS */
    setState(STATES.REQUESTING, 'Requesting microphone access...');
    permWarn.style.display = 'none';

    var micStream = null;
    try {
      micStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      /* Permission granted — stop the test stream immediately */
      micStream.getTracks().forEach(function(t){ t.stop(); });
    } catch(e) {
      permWarn.style.display = 'block';
      if (e.name === 'NotAllowedError') {
        setErrState('Mic blocked — click the lock icon in your browser bar');
      } else if (e.name === 'NotFoundError') {
        setErrState('No microphone found — plug one in and retry');
      } else {
        setErrState('Mic error: ' + e.message);
      }
      return;
    }

    /* Step 2: LOAD SDK if not ready yet */
    if (!window.vapiSDK) {
      setState(STATES.CONNECTING, 'Loading Vapi SDK...');
      var waited = 0;
      await new Promise(function(resolve, reject) {
        var t = setInterval(function() {
          waited += 150;
          if (window.vapiSDK) { clearInterval(t); resolve(); }
          if (waited > 8000)  { clearInterval(t); reject(new Error('SDK load timeout')); }
        }, 150);
      }).catch(function(e) { setErrState(e.message); return Promise.reject(e); });
      if (state !== STATES.CONNECTING) return; /* aborted */
    }

    /* Step 3: CONNECT */
    setState(STATES.CONNECTING, 'Connecting to AI interviewer...');
    try {
      initVapi();
      vapiInstance.start();
    } catch(e) {
      setErrState('Failed to start: '+e.message);
    }

    /* Safety re-enable after 12s if stuck in CONNECTING */
    setTimeout(function() {
      if (state === STATES.CONNECTING) {
        setErrState('Connection timed out — check your internet and retry');
      }
    }, 12000);
  });

  /* Re-enable if vapiBtn gets stuck disabled for any reason */
  setInterval(function() {
    if (state === STATES.IDLE && btn.disabled) { btn.disabled = false; }
  }, 3000);
})();
</script>

</body>
</html>
