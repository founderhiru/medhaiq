<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Interview OS — MedhaIQ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <script>
  (function(d,t){
    var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
    g.src='https://cdn.jsdelivr.net/gh/VapiAI/html-script-tag@latest/dist/assets/index.js';
    g.defer=true; g.async=true; s.parentNode.insertBefore(g,s);
  })(document,'script');
  </script>
  <style>
    /* ═══════════════════════════════════════════════════════════════
       DESIGN TOKENS — one place to change the entire visual system
    ═══════════════════════════════════════════════════════════════ */
    :root {
      --bg:         #070d1a;
      --panel:      #0d1829;
      --card:       #111e33;
      --border:     rgba(59,130,246,0.1);
      --border-hi:  rgba(59,130,246,0.42);
      --blue:       #1d4ed8;
      --blue-hi:    #3b82f6;
      --blue-glow:  rgba(59,130,246,0.2);
      --green:      #22c55e;
      --purple:     #a78bfa;
      --amber:      #f59e0b;
      --red:        #ef4444;
      --muted:      #3d5068;
      --soft:       #94a3b8;
      --white:      #f1f5f9;
      --mono:       'JetBrains Mono', monospace;
      --sidebar-w:  272px;
      --terminal-w: 284px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; }
    body {
      background: var(--bg);
      color: var(--white);
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 14px;
      /* Premium dot-grid background */
      background-image: radial-gradient(circle, rgba(59,130,246,0.055) 1px, transparent 1px);
      background-size: 28px 28px;
    }

    /* ── TOPBAR ── */
    .topbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      height: 48px;
      background: rgba(7,13,26,0.97);
      backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; padding: 0 20px; gap: 12px;
      box-shadow: 0 1px 0 rgba(59,130,246,0.06);
    }
    .tb-brand { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; font-weight: 800; color: #fff; letter-spacing: -0.3px; }
    .tb-brand em { color: var(--blue-hi); font-style: normal; }
    .tb-sep { width: 1px; height: 16px; background: var(--border); }
    .tb-persona { display: flex; align-items: center; gap: 8px; }
    .tb-avatar {
      width: 26px; height: 26px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 9px; font-weight: 800; color: #fff;
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .tb-avatar.royal-blue { background: linear-gradient(135deg,#1e40af,#3b82f6); }
    .tb-avatar.emerald    { background: linear-gradient(135deg,#065f46,#10b981); }
    .tb-avatar.gold       { background: linear-gradient(135deg,#78350f,#f59e0b); }
    .tb-name  { font-size: 12px; font-weight: 600; }
    .tb-role  { font-size: 10px; color: var(--soft); }
    .tb-right { margin-left: auto; display: flex; align-items: center; gap: 10px; }
    .tb-q     { font-size: 10px; font-weight: 700; color: var(--blue-hi); font-family: var(--mono); background: rgba(59,130,246,0.1); border: 1px solid var(--border); padding: 3px 9px; border-radius: 5px; }
    .tb-timer { font-size: 13px; font-weight: 600; color: var(--soft); font-family: var(--mono); }
    .tb-end   { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.28); color: #fca5a5; font-size: 11px; font-weight: 700; padding: 4px 12px; border-radius: 5px; cursor: pointer; transition: background 0.15s; }
    .tb-end:hover { background: rgba(239,68,68,0.22); }

    /* ══════════════════════════════════════════════════════════════
       3-COLUMN OS LAYOUT
       Left: 272px session sidebar
       Centre: 1fr — webcam + question + answer
       Right: 284px — live terminal / intelligence panel
    ══════════════════════════════════════════════════════════════ */
    .os-grid {
      display: grid;
      grid-template-columns: var(--sidebar-w) 1fr var(--terminal-w);
      height: 100vh;
      padding-top: 48px;
    }

    /* ────────────────────────────────────────────────
       LEFT SIDEBAR — Session context & competency map
    ──────────────────────────────────────────────── */
    .sidebar {
      background: rgba(13,24,41,0.98);
      backdrop-filter: blur(20px);
      border-right: 1px solid var(--border);
      display: flex; flex-direction: column;
      overflow: hidden;
    }
    .sb-section { padding: 14px 16px; border-bottom: 1px solid var(--border); }
    .sb-label { font-size: 9px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; color: var(--blue-hi); margin-bottom: 10px; font-family: var(--mono); }

    /* Session meta */
    .sb-meta-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
    .sb-meta-icon { font-size: 14px; flex-shrink: 0; }
    .sb-meta-key { font-size: 9px; color: var(--muted); font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.6px; }
    .sb-meta-val { font-size: 12px; font-weight: 500; color: var(--white); }

    /* Live status */
    .live-pill {
      display: flex; align-items: center; gap: 7px;
      background: rgba(34,197,94,0.06); border: 1px solid rgba(34,197,94,0.2);
      border-radius: 7px; padding: 7px 12px;
      font-size: 11px; font-weight: 600; color: var(--green); font-family: var(--mono);
    }
    .live-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 7px var(--green); animation: lp 1.8s ease-in-out infinite; }
    @keyframes lp { 0%,100%{opacity:1;} 50%{opacity:0.3;} }
    .voice-pill { font-size: 10px; color: var(--muted); font-family: var(--mono); margin-top: 6px; padding: 5px 12px; border: 1px solid var(--border); border-radius: 6px; transition: all 0.2s; }
    .voice-pill.active { color: var(--purple); border-color: rgba(167,139,250,0.3); background: rgba(167,139,250,0.05); }
    .voice-pill.error  { color: var(--red);    border-color: rgba(239,68,68,0.3); }

    /* Competency map — shows which skills have been tested */
    .comp-map { display: flex; flex-direction: column; gap: 8px; }
    .comp-row { display: flex; align-items: center; gap: 9px; }
    .comp-icon { font-size: 12px; flex-shrink: 0; }
    .comp-body { flex: 1; }
    .comp-name { font-size: 10px; color: var(--soft); font-family: var(--mono); margin-bottom: 3px; text-transform: uppercase; letter-spacing: 0.5px; }
    .comp-track { height: 2px; background: rgba(255,255,255,0.05); border-radius: 1px; }
    .comp-fill  { height: 100%; border-radius: 1px; transition: width 1s cubic-bezier(0.25,1,0.5,1); }
    .comp-count { font-size: 9px; font-family: var(--mono); color: var(--muted); flex-shrink: 0; min-width: 28px; text-align: right; }

    /* Session log in sidebar */
    .sb-log { flex: 1; overflow-y: auto; padding: 10px 16px; }
    .slog-entry { font-family: var(--mono); font-size: 9px; color: var(--muted); line-height: 2; }
    .slog-entry.ok  { color: rgba(34,197,94,0.65); }
    .slog-entry.err { color: rgba(239,68,68,0.65); }
    .slog-entry.info{ color: rgba(59,130,246,0.65); }

    /* ────────────────────────────────────────────────
       CENTRE COLUMN — Webcam + Question + Answer
    ──────────────────────────────────────────────── */
    .centre-col {
      display: flex; flex-direction: column;
      background: transparent;
      overflow: hidden;
    }

    /* Webcam — hero section at top of centre column */
    .webcam-hero {
      position: relative;
      flex-shrink: 0;
      height: 220px;
      background: #050b17;
      border-bottom: 1px solid var(--border);
      overflow: hidden;
    }
    .webcam-hero video {
      width: 100%; height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
      display: none;
    }
    .webcam-placeholder {
      position: absolute; inset: 0;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 8px;
      background: radial-gradient(circle at 50% 60%, rgba(29,78,216,0.08) 0%, transparent 70%);
    }
    .wc-icon { font-size: 36px; color: var(--muted); }
    .wc-hint { font-size: 10px; color: var(--muted); font-family: var(--mono); }
    /* Webcam overlays */
    .webcam-badge {
      position: absolute; top: 10px; left: 12px;
      display: flex; align-items: center; gap: 6px;
      background: rgba(0,0,0,0.72); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 20px; padding: 3px 10px;
      font-size: 9px; font-family: var(--mono); color: #fff;
      backdrop-filter: blur(8px);
    }
    .webcam-badge .wbdot { width: 5px; height: 5px; border-radius: 50%; background: var(--green); box-shadow: 0 0 5px var(--green); }
    .webcam-badge.off .wbdot { background: var(--muted); box-shadow: none; }
    .webcam-toggle {
      position: absolute; top: 10px; right: 12px;
      background: rgba(0,0,0,0.65); border: 1px solid rgba(255,255,255,0.12);
      border-radius: 6px; padding: 4px 10px;
      font-size: 10px; color: var(--soft); cursor: pointer;
      font-family: var(--mono); transition: all 0.15s;
      backdrop-filter: blur(8px);
    }
    .webcam-toggle:hover { background: rgba(59,130,246,0.15); color: #fff; }

    /* Interview content area */
    .interview-content {
      flex: 1; overflow-y: auto;
      display: flex; flex-direction: column;
      padding: 16px 20px; gap: 13px;
    }

    /* Calibrating bar */
    .calibrating-bar {
      display: flex; align-items: center; gap: 9px;
      background: rgba(59,130,246,0.05); border: 1px solid rgba(59,130,246,0.18);
      border-radius: 8px; padding: 8px 13px;
      font-size: 10px; font-family: var(--mono); color: var(--blue-hi);
      flex-shrink: 0;
      animation: calfade 1.2s ease-in-out infinite alternate;
    }
    @keyframes calfade { from{opacity:0.5;} to{opacity:1;} }
    .cal-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--blue-hi); animation: lp 0.9s ease-in-out infinite; }

    /* Question terminal */
    .q-terminal {
      background: var(--panel); border: 1px solid var(--border); border-radius: 11px;
      overflow: hidden; flex-shrink: 0;
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }
    .q-term-hdr {
      display: flex; align-items: center; gap: 7px;
      padding: 8px 13px; border-bottom: 1px solid var(--border);
      background: rgba(0,0,0,0.2);
    }
    .tdot { width: 9px; height: 9px; border-radius: 50%; }
    .td-r{background:#ef4444;} .td-y{background:#f59e0b;} .td-g{background:#22c55e;}
    .q-path { font-size: 9px; color: var(--muted); font-family: var(--mono); margin-left: 4px; }
    .q-term-body { padding: 18px 20px; }
    .q-prompt { font-size: 10px; color: var(--blue-hi); font-family: var(--mono); margin-bottom: 7px; }
    .q-competency-tag {
      display: inline-block; font-size: 9px; font-weight: 700;
      padding: 2px 8px; border-radius: 20px; margin-bottom: 9px;
      background: rgba(59,130,246,0.12); color: var(--blue-hi); border: 1px solid var(--border);
      font-family: var(--mono); letter-spacing: 0.4px; text-transform: uppercase;
    }
    .q-text { font-size: 15px; font-weight: 600; font-family: 'Plus Jakarta Sans', sans-serif; color: #fff; line-height: 1.6; }
    .q-tip  { font-size: 10px; color: var(--muted); font-style: italic; margin-top: 8px; font-family: var(--mono); }

    /* Voice signal visualiser */
    .viz-wrap {
      background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
      padding: 10px 14px; display: flex; align-items: center; gap: 11px; flex-shrink: 0;
    }
    .viz-lbl { font-size: 9px; color: var(--muted); font-family: var(--mono); text-transform: uppercase; letter-spacing: 1px; white-space: nowrap; }
    .viz-bars { display: flex; align-items: flex-end; gap: 3px; height: 26px; flex: 1; }
    .vbar { width: 4px; border-radius: 2px; background: var(--blue-hi); opacity: 0.18; transition: height 0.07s ease; }
    .vbar.lit { opacity: 1; }

    /* Answer area */
    .answer-area { display: flex; flex-direction: column; gap: 9px; flex: 1; min-height: 130px; }
    .answer-textarea {
      width: 100%; min-height: 120px; flex: 1;
      background: var(--panel); border: 1px solid var(--border); border-radius: 9px;
      padding: 13px 15px; color: #fff; font-size: 13px; font-family: 'Inter', sans-serif; line-height: 1.65; resize: none;
      box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    }
    .answer-textarea:focus { outline: none; border-color: var(--blue-hi); box-shadow: 0 0 0 3px rgba(59,130,246,0.08); }
    .answer-textarea::placeholder { color: var(--muted); }
    .answer-actions { display: flex; align-items: center; gap: 9px; }
    .char-count { font-size: 10px; color: var(--muted); font-family: var(--mono); margin-right: auto; }
    .btn-skip   { background: transparent; border: 1px solid var(--border); color: var(--muted); font-size: 12px; font-weight: 500; padding: 6px 13px; border-radius: 6px; cursor: pointer; }
    .btn-skip:hover { border-color: var(--border-hi); color: #fff; }
    .btn-submit { background: var(--blue); border: none; border-radius: 7px; color: #fff; font-size: 13px; font-weight: 700; font-family: 'Plus Jakarta Sans', sans-serif; padding: 8px 24px; cursor: pointer; transition: all 0.16s; }
    .btn-submit:not(:disabled):hover { background: var(--blue-hi); box-shadow: 0 0 14px var(--blue-glow); }
    .btn-submit:disabled { opacity: 0.32; cursor: not-allowed; }

    /* Loading state */
    .loading-overlay { display: none; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 40px; text-align: center; flex: 1; }
    .loading-overlay.show { display: flex; }
    .ldots { display: flex; gap: 6px; }
    .ldots span { width: 7px; height: 7px; border-radius: 50%; background: var(--blue-hi); animation: lbounce 1s ease-in-out infinite; }
    .ldots span:nth-child(2){animation-delay:.15s;} .ldots span:nth-child(3){animation-delay:.3s;}
    @keyframes lbounce { 0%,60%,100%{transform:translateY(0);} 30%{transform:translateY(-7px);} }
    .ltext { font-size: 11px; color: var(--muted); font-family: var(--mono); }

    /* ────────────────────────────────────────────────
       RIGHT TERMINAL PANEL — Live Intelligence
    ──────────────────────────────────────────────── */
    .terminal-panel {
      background: rgba(13,22,40,0.98);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      border-left: 1px solid var(--border);
      display: flex; flex-direction: column;
      overflow: hidden;
      box-shadow: -8px 0 32px rgba(0,0,0,0.28);
    }
    .tp-header {
      padding: 11px 14px; border-bottom: 1px solid var(--border);
      display: flex; align-items: center; gap: 8px;
    }
    .tp-title { font-size: 9px; font-weight: 700; color: var(--blue-hi); letter-spacing: 1.8px; text-transform: uppercase; font-family: var(--mono); }
    .tp-ver   { font-size: 8px; font-weight: 700; padding: 2px 7px; border-radius: 20px; background: rgba(59,130,246,0.1); color: var(--blue-hi); border: 1px solid var(--border); margin-left: auto; font-family: var(--mono); }

    /* Vapi voice section */
    .vapi-block { padding: 10px 14px; border-bottom: 1px solid var(--border); }
    .vapi-btn {
      width: 100%; padding: 9px;
      background: rgba(59,130,246,0.08); border: 1px solid var(--border-hi);
      border-radius: 7px; color: var(--blue-hi);
      font-size: 11px; font-weight: 700; font-family: 'Plus Jakarta Sans', sans-serif;
      cursor: pointer; transition: all 0.18s;
      display: flex; align-items: center; justify-content: center; gap: 7px;
    }
    .vapi-btn:hover:not(:disabled) { background: rgba(59,130,246,0.18); }
    .vapi-btn:disabled { opacity: 0.45; cursor: not-allowed; }
    .vapi-btn.state-live       { background: rgba(239,68,68,0.12); border-color: rgba(239,68,68,0.4); color: #fca5a5; }
    .vapi-btn.state-connecting { background: rgba(245,158,11,0.1);  border-color: rgba(245,158,11,0.4); color: #fcd34d; }
    .vapi-sub  { font-size: 9px; color: var(--muted); text-align: center; margin-top: 5px; font-family: var(--mono); transition: color 0.2s; }
    .vapi-warn { display: none; font-size: 9px; color: var(--amber); text-align: center; margin-top: 5px; font-family: var(--mono); }

    /* 5-Vector metrics */
    .metrics-block { flex: 1; overflow-y: auto; padding: 11px 14px; }
    .blabel { font-size: 9px; color: var(--muted); font-family: var(--mono); text-transform: uppercase; letter-spacing: 1.1px; margin-bottom: 10px; }
    .metric-row { display: flex; align-items: center; gap: 9px; margin-bottom: 12px; }
    .metric-icon { font-size: 12px; flex-shrink: 0; }
    .metric-body { flex: 1; }
    .metric-lbl  { font-size: 9px; color: var(--muted); font-family: var(--mono); margin-bottom: 3px; text-transform: uppercase; letter-spacing: 0.5px; }
    .metric-track{ height: 3px; background: rgba(255,255,255,0.05); border-radius: 2px; overflow: hidden; }
    .metric-fill { height: 100%; border-radius: 2px; width: 0%; transition: width 0.8s cubic-bezier(0.25,1,0.5,1); }
    .metric-val  { font-size: 11px; font-weight: 700; font-family: var(--mono); flex-shrink: 0; min-width: 24px; text-align: right; }
    @keyframes metric-reveal { from{opacity:0;transform:translateY(5px);} to{opacity:1;transform:translateY(0);} }
    .metric-val.revealed { animation: metric-reveal 0.38s ease forwards; }

    /* Weighted score ring */
    .score-ring-block {
      padding: 12px 14px; border-top: 1px solid var(--border);
      display: flex; align-items: center; gap: 12px;
    }
    .score-ring-wrap { position: relative; width: 52px; height: 52px; flex-shrink: 0; }
    .score-ring-wrap svg { transform: rotate(-90deg); }
    .ring-bg   { fill: none; stroke: rgba(255,255,255,0.06); stroke-width: 4; }
    .ring-fill { fill: none; stroke: var(--blue-hi); stroke-width: 4; stroke-linecap: round; stroke-dasharray: 138; stroke-dashoffset: 138; transition: stroke-dashoffset 1s cubic-bezier(0.25,1,0.5,1); }
    .ring-label { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif; }
    .ring-meta { flex: 1; }
    .ring-meta-title { font-size: 10px; font-weight: 700; color: var(--soft); font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.6px; }
    .ring-meta-rec   { font-size: 11px; font-weight: 600; color: var(--white); margin-top: 3px; }
    .ring-meta-rec.hire  { color: var(--green); }
    .ring-meta-rec.nohire{ color: var(--red); }
    .ring-meta-rec.lean  { color: var(--amber); }

    /* Score toast */
    .score-toast {
      position: fixed; top: 58px; right: calc(var(--terminal-w) + 12px); z-index: 200;
      background: var(--card); border: 1px solid var(--border-hi); border-radius: 11px;
      padding: 12px 16px; display: flex; align-items: center; gap: 12px;
      transform: translateY(-20px) scale(0.95); opacity: 0;
      transition: transform 0.42s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
      box-shadow: 0 12px 40px rgba(0,0,0,0.5);
      pointer-events: none;
    }
    .score-toast.show { transform: translateY(0) scale(1); opacity: 1; }
    .toast-score { font-size: 24px; font-weight: 800; font-family: 'Plus Jakarta Sans', sans-serif; }
    .toast-score.high{color:var(--green);} .toast-score.mid{color:var(--amber);} .toast-score.low{color:var(--red);}
    .toast-lbl { font-size: 10px; color: var(--muted); }
    .toast-vec { font-size: 9px; color: var(--muted); font-family: var(--mono); margin-top: 2px; }
  </style>
</head>
<body>

<!-- ═══ TOPBAR ═══ -->
<div class="topbar">
  <span class="tb-brand">Medha<em>IQ</em></span>
  <div class="tb-sep"></div>
  <div class="tb-persona">
    <div class="tb-avatar <%= personaStyleColor %>" id="tbAvatar"></div>
    <div>
      <div class="tb-name" id="tbName"></div>
      <div class="tb-role" id="tbRole"></div>
    </div>
  </div>
  <div class="tb-right">
    <div class="tb-q" id="qCounter">Q1 / 5</div>
    <div class="tb-timer" id="timer">00:00</div>
    <button class="tb-end" id="endBtn">End Session</button>
  </div>
</div>

<!-- ═══ 3-COLUMN OS GRID ═══ -->
<div class="os-grid">

  <!-- ══ LEFT SIDEBAR ══ -->
  <div class="sidebar">

    <!-- Session meta -->
    <div class="sb-section">
      <div class="sb-label">// Session Context</div>
      <div class="sb-meta-row">
        <span class="sb-meta-icon">🎯</span>
        <div><div class="sb-meta-key">Role</div><div class="sb-meta-val" id="sbRole">—</div></div>
      </div>
      <div class="sb-meta-row">
        <span class="sb-meta-icon">⚡</span>
        <div><div class="sb-meta-key">Level</div><div class="sb-meta-val" id="sbLevel">—</div></div>
      </div>
      <div class="sb-meta-row">
        <span class="sb-meta-icon">🆔</span>
        <div><div class="sb-meta-key">Session ID</div><div class="sb-meta-val" style="font-family:var(--mono);font-size:10px;">#<%= sessionId %></div></div>
      </div>
    </div>

