<!-- ═══════════════════════════════════════════════════════════════
     INTERVIEW OS ENGINE
     Handles: question display, answer submission, metric updates,
     competency tracking, running score ring, and session log.
═══════════════════════════════════════════════════════════════ -->
<script>
(function() {
  /* ── EJS-injected session variables ── */
  var SID    = '<%= sessionId %>';
  var QID    = '<%= questionId %>';
  var QN     = <%= answeredCount %> + 1;
  var MAXQ   = 5;
  var PNAME  = '<%= personaName %>';
  var PTITLE = '<%= personaTitle %>';
  var PINIT  = '<%= personaInitials %>';
  var PCOL   = '<%= personaStyleColor %>';
  var QTYPE  = '<%= questionType %>';
  var ROLE   = '<%= roleTitle %>';
  var LEVEL  = '<%= experienceLevel %>';
  var INITQ  = `<%- questionText.replace(/`/g, '\\`') %>`;

  /* ── Topbar & sidebar init ── */
  document.getElementById('tbAvatar').textContent = PINIT;
  document.getElementById('tbAvatar').className   = 'tb-avatar ' + PCOL;
  document.getElementById('tbName').textContent   = PNAME;
  document.getElementById('tbRole').textContent   = PTITLE;
  document.getElementById('sbRole').textContent   = ROLE  || '—';
  document.getElementById('sbLevel').textContent  = LEVEL || '—';

  /* ── Calibrating bar fades after 5s ── */
  setTimeout(function() {
    var cb = document.getElementById('calibBar');
    if (cb) { cb.style.transition='opacity 0.7s'; cb.style.opacity='0'; setTimeout(function(){cb.style.display='none';},750); }
  }, 5000);

  /* ── Timer ── */
  var t0 = Date.now(), timerInt;
  function tick() {
    var e = Math.floor((Date.now()-t0)/1000);
    document.getElementById('timer').textContent =
      String(Math.floor(e/60)).padStart(2,'0')+':'+String(e%60).padStart(2,'0');
  }
  timerInt = setInterval(tick, 1000);
  function updateCounter() { document.getElementById('qCounter').textContent='Q'+QN+' / '+MAXQ; }

  /* ── Activity log ── */
  function slog(msg, type) {
    var el = document.getElementById('slogBody');
    var ts = new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    var cls= 'slog-entry' + (type==='ok'?' ok':type==='err'?' err':type==='info'?' info':'');
    el.insertAdjacentHTML('afterbegin','<div class="'+cls+'">['+ts+'] '+msg+'</div>');
  }

  /* ── Competency map (updated when backend returns competency in response) ── */
  var compScores = { system_design:0, leadership:0, strategy:0, communication:0, technical:0 };
  function updateCompetency(key, increment) {
    if (!(key in compScores)) return;
    compScores[key] = Math.min(100, compScores[key] + (increment || 20));
    var bar = document.getElementById('comp-'+key);
    var cnt = document.getElementById('compC-'+key);
    if (bar) bar.style.width = compScores[key]+'%';
    if (cnt) {
      var n = parseInt(cnt.textContent||0)+1;
      cnt.textContent = n;
    }
  }

  /* ── 5-Vector metrics ── */
  var runningScores = [];
  function updateMetrics(s) {
    if (!s) return;
    runningScores.push(s);
    var map = [
      ['mStar','mStarV', s.star      || s.structure || 0],
      ['mTech','mTechV', s.technical || s.depth     || 0],
      ['mExec','mExecV', s.executive || 0],
      ['mGcc', 'mGccV',  s.gcc       || s.coherence || 0],
      ['mFric','mFricV', s.friction  || s.clarity   || 0],
    ];
    map.forEach(function(r) {
      var v = Math.round(r[2]);
      var bar = document.getElementById(r[0]);
      var val = document.getElementById(r[1]);
      if (bar) setTimeout(function(){ bar.style.width=v+'%'; }, 80);
      if (val) {
        val.textContent = v;
        val.classList.remove('revealed');
        void val.offsetWidth;
        val.classList.add('revealed');
      }
    });
    updateScoreRing();
  }

  /* ── Running score ring ── */
  function updateScoreRing() {
    if (!runningScores.length) return;
    var total = runningScores.reduce(function(a,s){ return a+(s.weighted||0); }, 0);
    var avg   = Math.round(total / runningScores.length);
    var ring  = document.getElementById('ringFill');
    var lbl   = document.getElementById('ringLabel');
    var rec   = document.getElementById('ringRec');
    var CIRC  = 138; /* 2 * π * 22 ≈ 138 */
    ring.style.strokeDashoffset = CIRC - (CIRC * avg / 100);
    lbl.textContent = avg;
    lbl.style.color = avg>=75?'#22c55e':avg>=55?'#f59e0b':'#ef4444';
    if (avg >= 75)      { rec.textContent='Strong Hire'; rec.className='ring-meta-rec hire'; }
    else if (avg >= 60) { rec.textContent='Lean Hire';   rec.className='ring-meta-rec lean'; }
    else if (avg >= 45) { rec.textContent='Lean No Hire';rec.className='ring-meta-rec lean'; }
    else                { rec.textContent='No Hire';     rec.className='ring-meta-rec nohire'; }
  }

  /* ── Score toast ── */
  function showToast(w, scores) {
    var s = Math.round(w||0);
    var el = document.getElementById('toastScore');
    el.textContent = s;
    el.className = 'toast-score '+(s>=75?'high':s>=55?'mid':'low');
    var vec = document.getElementById('toastVec');
    if (scores && vec) {
      vec.textContent = 'STAR:'+Math.round(scores.star||0)+' EXE:'+Math.round(scores.executive||0)+' CLR:'+Math.round(scores.friction||0);
    }
    var t = document.getElementById('scoreToast');
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 4000);
  }

  /* ── Voice visualiser ── */
  var vizEl = document.getElementById('vizBars');
  for (var i=0;i<28;i++) {
    var b=document.createElement('div'); b.className='vbar';
    b.style.height=(Math.random()*16+4)+'px'; vizEl.appendChild(b);
  }
  var vizOn=false;
  function startViz(){ vizOn=true; vizEl.querySelectorAll('.vbar').forEach(function(b){b.classList.add('lit');}); animViz(); }
  function stopViz() { vizOn=false; vizEl.querySelectorAll('.vbar').forEach(function(b){b.classList.remove('lit');b.style.height=(Math.random()*16+4)+'px';}); }
  function animViz() { if(!vizOn)return; vizEl.querySelectorAll('.vbar').forEach(function(b){b.style.height=(Math.random()*26+4)+'px';}); setTimeout(animViz,85); }

  /* ── Show/hide states ── */
  function showLoading(text) {
    document.getElementById('answerArea').style.display='none';
    document.getElementById('loadingOverlay').classList.add('show');
    document.getElementById('loadingText').textContent=text||'Analysing...';
    startViz();
  }
  function showQuestion(q, type, competency) {
    document.getElementById('loadingOverlay').classList.remove('show');
    document.getElementById('answerArea').style.display='flex';
    document.getElementById('questionText').textContent=q.text;
    var p=document.getElementById('qPrompt');
    p.textContent='> question_0'+QN+'.'+(type||'behavioral');
    /* Competency tag — shows which skill is being tested */
    var ct=document.getElementById('qCompTag');
    var compLabel = competency ? competency.replace(/_/g,' ').toUpperCase() : (type==='drill_down'?'DEEP DIVE':'BEHAVIORAL');
    ct.textContent=compLabel;
    var tip=document.getElementById('qTip');
    tip.style.display=(type==='drill_down')?'none':'block';
    document.getElementById('answerInput').value='';
    document.getElementById('charCount').textContent='0 / 4000';
    document.getElementById('submitBtn').disabled=true;
    document.getElementById('answerInput').focus();
    stopViz();
  }

  /* ── Textarea ── */
  document.getElementById('answerInput').addEventListener('input', function() {
    document.getElementById('charCount').textContent=this.value.length+' / 4000';
    document.getElementById('submitBtn').disabled=!this.value.trim();
  });

  /* ── Submit / Skip ── */
  document.getElementById('submitBtn').addEventListener('click',function(){ submitAnswer(false); });
  document.getElementById('skipBtn').addEventListener('click',function(){ submitAnswer(true); });

  async function submitAnswer(skip) {
    var ans=skip?'':document.getElementById('answerInput').value.trim();
    if(!skip&&!ans)return;
    document.getElementById('submitBtn').disabled=true;
    showLoading(PNAME+' is analysing your response...');
    slog('Q'+QN+' submitted — AI scoring...','info');
    try {
      var resp=await fetch('/api/interview/sessions/'+SID+'/answer',{
        method:'POST', headers:{'Content-Type':'application/json'},
        body:JSON.stringify({questionId:QID,answerText:ans,skip:skip}),
      });
      var data=await resp.json();
      if(!resp.ok) throw new Error(data.error||'Server error '+resp.status);

      if(data.scores&&!skip) {
        updateMetrics(data.scores);
        showToast(data.scores.weighted,data.scores);
        slog('Scored: '+Math.round(data.scores.weighted)+'/100 · STAR:'+Math.round(data.scores.star||0),'ok');
      }

      /* Update competency map if backend returns which area was tested */
      if(data.competency) updateCompetency(data.competency, 20);

      if(data.sessionEnded) {
        clearInterval(timerInt);
        slog('Session complete — generating Career Intelligence Report...','ok');
        showLoading('Generating your Career Intelligence Report...');
        setTimeout(function(){ window.location.href='/interview/report/'+data.reportId; },2200);
        return;
      }
      QID=data.question.id;
      QN++;
      updateCounter();
      showQuestion(data.question, data.question.type, data.question.competency);
      slog('Q'+QN+' loaded · competency: '+(data.question.competency||'behavioral'));
    } catch(err) {
      console.error('[MedhaIQ]',err);
      slog('ERROR: '+err.message,'err');
      document.getElementById('loadingOverlay').classList.remove('show');
      document.getElementById('answerArea').style.display='flex';
      document.getElementById('submitBtn').disabled=false;
      stopViz();
      alert('Error: '+err.message+'\n\nCheck browser console for details.');
    }
  }

  /* ── End session ── */
  document.getElementById('endBtn').addEventListener('click',async function(){
    if(!confirm('End this session? Your progress cannot be resumed.'))return;
    clearInterval(timerInt);
    try{ await fetch('/api/interview/sessions/'+SID,{method:'DELETE'}); }catch(e){}
    window.location.href='/dashboard/history';
  });

  /* ── Initialise ── */
  updateCounter();
  if(INITQ) showQuestion({text:INITQ},QTYPE,null);
  slog('Session #'+SID+' initialised — '+PNAME,'ok');
  slog('Role: '+ROLE+' | Level: '+LEVEL);
  slog('Agentic CompetencyRouter active','info');
})();
</script>

<!-- ═══════════════════════════════════════════════════════════════
     WEBCAM — Clean hero-style feed, user-toggled
═══════════════════════════════════════════════════════════════ -->
<script>
(function(){
  var video    = document.getElementById('camVideo');
  var ph       = document.getElementById('camPlaceholder');
  var badge    = document.getElementById('camBadge');
  var badgeTxt = document.getElementById('camBadgeText');
  var toggle   = document.getElementById('camToggle');
  var stream   = null, on = false;

  async function startCam(){
    try{
      stream=await navigator.mediaDevices.getUserMedia({video:true,audio:false});
      video.srcObject=stream; video.style.display='block';
      ph.style.display='none';
      badge.classList.remove('off'); badgeTxt.textContent='● LIVE';
      toggle.textContent='Disable Camera';
      on=true;
    }catch(e){
      badgeTxt.textContent='BLOCKED';
      console.warn('[cam]',e.message);
    }
  }
  function stopCam(){
    if(stream){stream.getTracks().forEach(function(t){t.stop();}); stream=null;}
    video.style.display='none'; ph.style.display='flex';
    badge.classList.add('off'); badgeTxt.textContent='CAM OFF';
    toggle.textContent='Enable Camera';
    on=false;
  }
  toggle.addEventListener('click',function(){ if(!on)startCam(); else stopCam(); });
  /* Auto-start with 1.4s delay so page renders first */
  setTimeout(startCam, 1400);
})();
</script>

<!-- ═══════════════════════════════════════════════════════════════
     VAPI VOICE STATE MACHINE
     IDLE → REQUESTING_PERMISSIONS → CONNECTING → LIVE → STOPPING
     Each transition has explicit UI state + specific error messages.
     Root cause of "Voice: error": mic permission was never checked
     before Vapi was called. This is now step 1 before any SDK init.
═══════════════════════════════════════════════════════════════ -->
<script>
(function(){
  var VKEY = '<%= vapiPublicKey %>';
  var VAST = '<%= vapiAssistantId %>';

  var btn      = document.getElementById('vapiBtn');
  var sub      = document.getElementById('vapiSub');
  var permWarn = document.getElementById('vapiPermWarn');
  var voiceInd = document.getElementById('voiceInd');
  var vizEl    = document.getElementById('vizBars');

  if(!VKEY||!VAST){ btn.style.display='none'; sub.textContent='Voice: not configured (add VAPI keys in Render)'; return; }

  var STATES={ IDLE:'IDLE',REQUESTING:'REQUESTING',CONNECTING:'CONNECTING',LIVE:'LIVE',STOPPING:'STOPPING' };
  var state=STATES.IDLE, vapi=null;

  function setState(s,msg,isErr){
    state=s;
    var L={
      IDLE:      {text:'🎙 Enable Voice Mode',   cls:'',                dis:false},
      REQUESTING:{text:'⏳ Checking mic…',        cls:'state-connecting',dis:true },
      CONNECTING:{text:'⏳ Connecting…',           cls:'state-connecting',dis:true },
      LIVE:      {text:'🔴 End Voice Session',    cls:'state-live',      dis:false},
      STOPPING:  {text:'⏹ Stopping…',             cls:'',                dis:true },
    }[s]||{text:'🎙 Enable Voice Mode',cls:'',dis:false};
    btn.textContent=L.text; btn.className='vapi-btn '+L.cls; btn.disabled=L.dis;
    if(msg){ sub.textContent=msg; sub.style.color=isErr?'#ef4444':''; }
    if(s===STATES.LIVE)    { voiceInd.textContent='Voice: ● active';  voiceInd.className='voice-pill active'; }
    else if(s===STATES.IDLE){ voiceInd.textContent='Voice: standby';  voiceInd.className='voice-pill'; }
    if(isErr)               { voiceInd.textContent='Voice: error';    voiceInd.className='voice-pill error'; }
  }

  function setErr(msg){
    setState(STATES.IDLE,msg,true);
    setTimeout(function(){ if(state===STATES.IDLE){ sub.textContent='Speak directly with your AI interviewer'; sub.style.color=''; } },7000);
  }

  function initVapi(){
    if(vapi||!window.vapiSDK)return;
    vapi=window.vapiSDK.run({apiKey:VKEY,assistant:VAST,config:{position:'hidden'}});

    /* ── UPDATED: VAPI EVENT SYNC (Lines ~485-520) ── */
vapi.on('call-start', function() {
    setState(STATES.LIVE, 'Voice active — speak your answer');
    vizEl.querySelectorAll('.vbar').forEach(function(b){ b.classList.add('lit'); });
    animVizLive();
});

vapi.on('speech-start', function(speech) {
    // SYNC: Force the screen text to match the AI speech start
    if (speech && speech.text) {
        document.getElementById('questionText').textContent = speech.text;
    }
    sub.textContent = '● AI is speaking…';
    voiceInd.textContent = 'Voice: ● AI speaking';
});

vapi.on('speech-end', function() {
    sub.textContent = 'Your turn — speak clearly';
    voiceInd.textContent = 'Voice: ● listening';
});
    vapi.on('error',function(e){
      console.error('[Vapi]',e);
      var msg='Connection error — retry';
      if(e&&e.message){
        if(/permission|not allowed/i.test(e.message)) msg='Microphone blocked — open browser settings';
        else if(/network|fetch/i.test(e.message))     msg='Network error — check your connection';
        else if(/assistant/i.test(e.message))         msg='Config error — check VAPI_ASSISTANT_ID in Render';
      }
      setErr(msg);
    });
  }

  function animVizLive(){
    if(state!==STATES.LIVE)return;
    vizEl.querySelectorAll('.vbar').forEach(function(b){b.style.height=(Math.random()*26+4)+'px';});
    setTimeout(animVizLive,90);
  }

  btn.addEventListener('click',async function(){
    if(state===STATES.LIVE||state===STATES.STOPPING){
      setState(STATES.STOPPING,'Ending voice session…');
      if(vapi){try{vapi.stop();}catch(e){}}
      return;
    }
    if(state!==STATES.IDLE)return;

    /* ── Step 1: REQUEST MICROPHONE PERMISSION ── */
    setState(STATES.REQUESTING,'Requesting microphone access…');
    permWarn.style.display='none';
    try{
      var ms=await navigator.mediaDevices.getUserMedia({audio:true});
      ms.getTracks().forEach(function(t){t.stop();}); /* test only — release immediately */
    }catch(e){
      permWarn.style.display='block';
      if(e.name==='NotAllowedError') setErr('Microphone Access Required — click the lock icon in your browser bar');
      else if(e.name==='NotFoundError') setErr('No microphone detected — plug one in and retry');
      else setErr('Mic error: '+e.message);
      return;
    }

    /* ── Step 2: WAIT FOR SDK ── */
    if(!window.vapiSDK){
      setState(STATES.CONNECTING,'Loading voice engine…');
      var waited=0;
      try{
        await new Promise(function(res,rej){
          var t=setInterval(function(){
            waited+=150;
            if(window.vapiSDK){clearInterval(t);res();}
            if(waited>9000){clearInterval(t);rej(new Error('Voice SDK load timeout — check network'));}
          },150);
        });
      }catch(e){ setErr(e.message); return; }
    }
    if(state!==STATES.CONNECTING&&state!==STATES.REQUESTING)return;

    /* ── Step 3: CONNECT ── */
    setState(STATES.CONNECTING,'Connecting to AI interviewer…');
    try{ initVapi(); vapi.start(VAST); }
    catch(e){ setErr('Failed to connect: '+e.message); return; }

    /* Safety fallback — re-enable if stuck CONNECTING after 13s */
    setTimeout(function(){
      if(state===STATES.CONNECTING) setErr('Connection timed out — check your internet and retry');
    },13000);
  });

  /* Watchdog: un-stuck the button if it gets disabled in IDLE */
  setInterval(function(){ if(state===STATES.IDLE&&btn.disabled) btn.disabled=false; },3000);
})();
</script>

</body>
</html>
