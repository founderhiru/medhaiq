<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Explore MedhaIQ | MedhaIQ.ai</title>
  <meta name="description" content="Your gateway to MedhaIQ's Company Library, Role Library, sample reports, and interview guides.">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
  <link rel="stylesheet" href="/css/explore.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- HERO — simplified per direction: just a title, one short line, and
       search. No marketing headline, no repeated copy from the homepage
       or the guide pages' closing CTA. -->
  <section class="mh-why-hero reveal">
    <div class="mh-why-hero-inner mh-section-center">
      <h1 class="mh-section-title">Explore MedhaIQ</h1>
      <p class="mh-section-sub">Discover companies, roles, sample reports, and interview guides — all in one place.</p>

      <div class="mh-explore-search-wrap">
        <svg class="mh-explore-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input id="mh-explore-search" class="mh-form-input" type="search" placeholder="Search companies, roles and guides..." aria-label="Search companies, roles and guides">
      </div>
      <div id="mh-explore-search-meta" class="mh-explore-search-meta" aria-live="polite"></div>
    </div>
  </section>

  <!-- ============ LIGHT EDITORIAL SURFACE BEGINS ============ -->

  <!-- 4 Primary Navigation Cards — the entire content of this page's main
       section. No previews inside these cards; each library owns its own
       content now. Company/Role Library link to their real, built pages.
       Sample Reports / Interview Guides don't have dedicated pages yet
       (out of this round's scope — flagged in chat), so they open the
       same "coming soon" pattern already established elsewhere, rather
       than a dead link or a fake destination. -->
  <section class="mh-explore-light reveal" aria-labelledby="mh-explore-begin-title">
    <div class="mh-explore-section-inner" style="padding: 88px 40px 96px;">
      <h2 id="mh-explore-begin-title" class="mh-colib-visually-hidden">Where would you like to begin?</h2>
      <div class="mh-explore-begin-grid">
        <a href="/explore/company-library" class="mh-explore-begin-card" style="text-decoration:none;">
          <div class="mh-explore-begin-icon mh-explore-begin-icon-blue" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M6 21V7l6-4 6 4v14M10 21v-6h4v6"/></svg>
          </div>
          <div class="mh-explore-begin-title">Company Library</div>
          <div class="mh-explore-begin-desc">Learn how leading companies interview and what they look for in candidates.</div>
          <span class="mh-explore-begin-link">Explore <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg></span>
        </a>
        <a href="/explore/role-library" class="mh-explore-begin-card" style="text-decoration:none;">
          <div class="mh-explore-begin-icon mh-explore-begin-icon-purple" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
          </div>
          <div class="mh-explore-begin-title">Role Library</div>
          <div class="mh-explore-begin-desc">Master interviews for every role and every stage of your career.</div>
          <span class="mh-explore-begin-link">Explore <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg></span>
        </a>
        <button type="button" class="mh-explore-begin-card mh-explore-comingsoon-trigger" style="text-decoration:none; text-align:left; cursor:pointer; width:100%; font-family:inherit;">
          <div class="mh-explore-begin-icon mh-explore-begin-icon-green" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg>
          </div>
          <div class="mh-explore-begin-title">Sample Reports</div>
          <div class="mh-explore-begin-desc">See real report and scorecard examples to understand your interview outcomes.</div>
          <span class="mh-explore-begin-link">Explore <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg></span>
        </button>
        <button type="button" class="mh-explore-begin-card mh-explore-comingsoon-trigger" style="text-decoration:none; text-align:left; cursor:pointer; width:100%; font-family:inherit;">
          <div class="mh-explore-begin-icon mh-explore-begin-icon-orange" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          </div>
          <div class="mh-explore-begin-title">Interview Guides</div>
          <div class="mh-explore-begin-desc">Practical frameworks, tips, and strategies to ace your interviews.</div>
          <span class="mh-explore-begin-link">Explore <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 6l6 6-6 6"/></svg></span>
        </button>
      </div>
    </div>
  </section>

  <!-- Recently Added — lightweight pills only, no previews. Real internal
       links where a real page exists; "coming soon" trigger where it
       doesn't (STAR Method, Sample AI Report — no dedicated pages yet). -->
  <section class="mh-explore-light mh-explore-light-alt reveal">
    <div class="mh-explore-section-inner" style="padding: 56px 40px;">
      <div class="mh-explore-recent-header">
        <div class="mh-explore-recent-title">Recently Added</div>
      </div>
      <div class="mh-explore-recent-row">
        <a href="/explore/company-library/amazon" class="mh-explore-recent-pill"><span class="mh-explore-recent-dot" style="background:#2563EB;"></span>Amazon Interview Guide</a>
        <a href="/explore/company-library/microsoft" class="mh-explore-recent-pill"><span class="mh-explore-recent-dot" style="background:#2563EB;"></span>Microsoft Interview Guide</a>
        <a href="/explore/role-library/product-manager" class="mh-explore-recent-pill"><span class="mh-explore-recent-dot" style="background:#9333EA;"></span>Product Manager Role Guide</a>
        <button type="button" class="mh-explore-recent-pill mh-explore-comingsoon-trigger" style="border:1px solid var(--el-border,rgba(15,23,42,0.08)); cursor:pointer; font-family:inherit;"><span class="mh-explore-recent-dot" style="background:#D97706;"></span>STAR Method Guide</button>
        <button type="button" class="mh-explore-recent-pill mh-explore-comingsoon-trigger" style="border:1px solid var(--el-border,rgba(15,23,42,0.08)); cursor:pointer; font-family:inherit;"><span class="mh-explore-recent-dot" style="background:#059669;"></span>Sample AI Report</button>
      </div>
    </div>
  </section>

  <!-- Why Explore MedhaIQ — reduced to a thin separator strip, not a
       section with its own visual weight. No icons, no sub-heading, just
       four short labels in one row. -->
  <section class="mh-explore-light reveal">
    <div class="mh-explore-section-inner mh-explore-why-thin">
      <span class="mh-explore-why-thin-item">Company-calibrated insights</span>
      <span class="mh-explore-why-thin-sep" aria-hidden="true">•</span>
      <span class="mh-explore-why-thin-item">Role-specific preparation</span>
      <span class="mh-explore-why-thin-sep" aria-hidden="true">•</span>
      <span class="mh-explore-why-thin-item">AI-powered feedback</span>
      <span class="mh-explore-why-thin-sep" aria-hidden="true">•</span>
      <span class="mh-explore-why-thin-item">Continuous career intelligence</span>
    </div>
  </section>

  <%- include('partials/footer') %>

  <!-- Coming-soon modal — now covers Sample Reports, Interview Guides (as
       destinations), and the two Recently Added items without their own
       page yet. Generic copy since it's no longer company-specific. -->
  <div class="mh-modal-overlay" id="mh-explore-comingsoon-modal" style="display:none">
    <div class="mh-modal" role="dialog" aria-modal="true" aria-labelledby="mh-explore-comingsoon-title">
      <button class="mh-modal-close" id="mh-explore-comingsoon-close" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="mh-modal-title" id="mh-explore-comingsoon-title">This one's being prepared</div>
      <div class="mh-modal-sub">This page is currently being built as its own dedicated destination. Check back soon.</div>
    </div>
  </div>

  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (reveals.length) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) { if (entry.isIntersecting) entry.target.classList.add('visible'); });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(function(el) { observer.observe(el); });
    }
  })();

  (function() {
    // Search now has nothing on-page left to filter (no more card grids —
    // see chat for why). It's kept visually per "keep: search bar," but
    // real cross-library search is a separate feature, not built here.
    var searchInput = document.getElementById('mh-explore-search');
    var searchMeta = document.getElementById('mh-explore-search-meta');
    if (!searchInput) return;
    searchInput.addEventListener('input', function(e) {
      var q = e.target.value.trim();
      searchMeta.textContent = q ? 'Search is coming soon — try the Company Library or Role Library directly for now.' : '';
    });
  })();

  (function() {
    var modal = document.getElementById('mh-explore-comingsoon-modal');
    var closeBtn = document.getElementById('mh-explore-comingsoon-close');
    if (!modal) return;
    document.querySelectorAll('.mh-explore-comingsoon-trigger').forEach(function(trigger) {
      trigger.addEventListener('click', function(e) { e.preventDefault(); modal.style.display = 'flex'; });
    });
    if (closeBtn) closeBtn.addEventListener('click', function() { modal.style.display = 'none'; });
    modal.addEventListener('click', function(e) { if (e.target === modal) modal.style.display = 'none'; });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') modal.style.display = 'none'; });
  })();
  </script>
</body>
</html>
