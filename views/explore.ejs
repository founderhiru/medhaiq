<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Explore MedhaIQ | MedhaIQ.ai</title>
  <meta name="description" content="Discover how professionals prepare, practice and grow with Continuous Career Intelligence — company guides, role libraries, sample reports and scorecards.">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
  <link rel="stylesheet" href="/css/explore.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- SECTION 1: Hero + Global Search — reuses the same hero shell as
       Why MedhaIQ / Architecture (mh-why-hero / mh-section-center /
       mh-eyebrow / mh-section-title / mh-section-sub). No new typography
       introduced; only the search field below is new. -->
  <section class="mh-why-hero reveal">
    <div class="mh-why-hero-inner mh-section-center">
      <div class="mh-eyebrow">Explore MedhaIQ</div>
      <h1 class="mh-section-title">Explore MedhaIQ</h1>
      <p class="mh-section-sub">Discover how professionals prepare, practice and grow with Continuous Career Intelligence.</p>

      <div class="mh-explore-search-wrap">
        <svg class="mh-explore-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input id="mh-explore-search" class="mh-form-input" type="search" placeholder="Search companies, roles and guides..." aria-label="Search companies, roles and guides">
      </div>
      <div id="mh-explore-search-meta" class="mh-explore-search-meta" aria-live="polite"></div>
    </div>
  </section>

  <!-- SECTION 2: Company Library -->
  <section class="mh-explore-section reveal" aria-labelledby="mh-explore-companies-title">
    <div class="mh-explore-section-inner">
      <div class="mh-section-center">
        <div class="mh-eyebrow">Company Library</div>
        <h2 id="mh-explore-companies-title" class="mh-section-title">Practice for the room you're walking into</h2>
        <p class="mh-section-sub">Company-calibrated interview loops, built from real hiring patterns.</p>
      </div>
      <div id="mh-explore-companies-grid" class="mh-explore-grid" role="list">
        <% companies.forEach(function(company) { %>
          <%- include('partials/explore-company-card', { company: company }) %>
        <% }); %>
      </div>
      <div id="mh-explore-companies-empty" class="mh-explore-empty">No companies match your search yet — try a different term.</div>
    </div>
  </section>

  <!-- SECTION 3: Role Library -->
  <section class="mh-explore-section mh-explore-section-alt reveal" aria-labelledby="mh-explore-roles-title">
    <div class="mh-explore-section-inner">
      <div class="mh-section-center">
        <div class="mh-eyebrow">Role Library</div>
        <h2 id="mh-explore-roles-title" class="mh-section-title">Every role, its own bar</h2>
        <p class="mh-section-sub">Interview loops calibrated to the competencies each role is actually judged on.</p>
      </div>
      <div id="mh-explore-roles-grid" class="mh-explore-grid" role="list">
        <% roles.forEach(function(role) { %>
          <%- include('partials/explore-role-card', { role: role }) %>
        <% }); %>
      </div>
      <div id="mh-explore-roles-empty" class="mh-explore-empty">No roles match your search yet — try a different term.</div>
    </div>
  </section>

  <!-- SECTION 4 + 5: Sample AI Report + Sample Scorecard -->
  <section class="mh-explore-section reveal" aria-labelledby="mh-explore-samples-title">
    <div class="mh-explore-section-inner">
      <div class="mh-section-center">
        <div class="mh-eyebrow">See The Output</div>
        <h2 id="mh-explore-samples-title" class="mh-section-title">A preview of what you walk away with</h2>
        <p class="mh-section-sub">Every mock interview ends with a report and a scorecard like these.</p>
      </div>
      <div class="mh-explore-preview-grid">
        <%- include('partials/explore-report-card') %>
        <%- include('partials/explore-scorecard-card') %>
      </div>
    </div>
  </section>

  <!-- SECTION 6: Career Guides -->
  <section class="mh-explore-section mh-explore-section-alt reveal" aria-labelledby="mh-explore-guides-title">
    <div class="mh-explore-section-inner">
      <div class="mh-section-center">
        <div class="mh-eyebrow">Career Guides</div>
        <h2 id="mh-explore-guides-title" class="mh-section-title">Short reads, real edge</h2>
        <p class="mh-section-sub">Practical frameworks you can use in your next interview.</p>
      </div>
      <div id="mh-explore-guides-grid" class="mh-explore-grid" role="list">
        <% articles.forEach(function(article) { %>
          <%- include('partials/explore-article-card', { article: article }) %>
        <% }); %>
      </div>
      <div id="mh-explore-guides-empty" class="mh-explore-empty">No guides match your search yet — try a different term.</div>
    </div>
  </section>

  <!-- SECTION 7: Bottom CTA -->
  <%- include('partials/explore-cta') %>

  <%- include('partials/footer') %>

  <!-- Coming-soon modal — reuses the exact .mh-modal-overlay/.mh-modal markup
       and open/close JS pattern already live in partials/pricing-section.ejs,
       instead of introducing a new modal system. -->
  <div class="mh-modal-overlay" id="mh-explore-comingsoon-modal" style="display:none">
    <div class="mh-modal" role="dialog" aria-modal="true" aria-labelledby="mh-explore-comingsoon-title">
      <button class="mh-modal-close" id="mh-explore-comingsoon-close" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="mh-modal-title" id="mh-explore-comingsoon-title">This one's being prepared</div>
      <div class="mh-modal-sub" id="mh-explore-comingsoon-sub">This company guide is currently being prepared. More company intelligence is being added every week.</div>
    </div>
  </div>

  <script>
  (function() {
    // Scroll reveal — identical IntersectionObserver pattern used on every
    // other marketing page (architecture.ejs, why.ejs, layout.ejs).
    var reveals = document.querySelectorAll('.reveal');
    if (reveals.length) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            var items = entry.target.querySelectorAll('.reveal-item');
            items.forEach(function(item, i) {
              setTimeout(function() { item.classList.add('visible'); }, i * 100);
            });
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(function(el) { observer.observe(el); });
    }
  })();

  (function() {
    // Live search — simple substring filter across companies/roles/guides.
    // No fuzzy matching, no backend call, per this sprint's scope.
    var searchInput = document.getElementById('mh-explore-search');
    var searchMeta = document.getElementById('mh-explore-search-meta');
    if (!searchInput) return;

    var sections = [
      { grid: document.getElementById('mh-explore-companies-grid'), empty: document.getElementById('mh-explore-companies-empty') },
      { grid: document.getElementById('mh-explore-roles-grid'), empty: document.getElementById('mh-explore-roles-empty') },
      { grid: document.getElementById('mh-explore-guides-grid'), empty: document.getElementById('mh-explore-guides-empty') }
    ];

    searchInput.addEventListener('input', function(e) {
      var q = e.target.value.trim().toLowerCase();
      var totalVisible = 0;

      sections.forEach(function(section) {
        if (!section.grid) return;
        var cards = section.grid.querySelectorAll('[role="listitem"]');
        var visibleCount = 0;
        cards.forEach(function(card) {
          var matches = !q || card.textContent.toLowerCase().indexOf(q) !== -1;
          card.style.display = matches ? '' : 'none';
          if (matches) visibleCount++;
        });
        totalVisible += visibleCount;
        if (section.empty) section.empty.classList.toggle('is-visible', q.length > 0 && visibleCount === 0);
      });

      searchMeta.textContent = q ? (totalVisible + ' result' + (totalVisible === 1 ? '' : 's') + ' for "' + e.target.value.trim() + '"') : '';
    });
  })();

  (function() {
    // Coming-soon modal — same open/close pattern as partials/pricing-section.ejs's
    // existing email-capture modal (inline style.display, click-outside-to-close).
    var modal = document.getElementById('mh-explore-comingsoon-modal');
    var closeBtn = document.getElementById('mh-explore-comingsoon-close');
    if (!modal) return;

    document.querySelectorAll('.mh-explore-comingsoon-trigger').forEach(function(trigger) {
      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        modal.style.display = 'flex';
      });
    });
    if (closeBtn) closeBtn.addEventListener('click', function() { modal.style.display = 'none'; });
    modal.addEventListener('click', function(e) { if (e.target === modal) modal.style.display = 'none'; });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') modal.style.display = 'none'; });
  })();

  (function() {
    // Animate scorecard bars once on load.
    requestAnimationFrame(function() {
      document.querySelectorAll('.mh-explore-score-bar-fill').forEach(function(el) {
        el.style.width = el.getAttribute('data-target') + '%';
      });
    });
  })();
  </script>
</body>
</html>
