<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= company.seo.title %></title>
  <meta name="description" content="<%= company.seo.description %>">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#0A0F1E">
  <link rel="canonical" href="https://www.medhaiq.ai/explore/company-library/<%= company.slug %>">
  <meta property="og:title" content="<%= company.seo.title %>">
  <meta property="og:description" content="<%= company.seo.description %>">
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://www.medhaiq.ai/explore/company-library/<%= company.slug %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/medhaiq.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
  <link rel="stylesheet" href="/css/explore.css">
  <link rel="stylesheet" href="/css/company-library.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- ============================================================
       EXECUTIVE BRIEFING HERO — informs, doesn't market. Eyebrow +
       name + a single horizontal row of interview-intelligence stats
       + one two-line summary sentence. No CTA and no "view sample
       report" link here — the page has exactly one CTA, at the very
       bottom, per this round's redesign.
       ============================================================ -->
  <section class="mh-why-hero reveal">
    <div class="mh-why-hero-inner mh-section-center">
      <div class="mh-eyebrow"><%= company.category %></div>
      <h1 class="mh-section-title mh-colib-hero-title mh-colib-hero-title-compact"><%= company.name %> Interview Guide</h1>

      <div class="mh-colib-brief-row" role="list">
        <div class="mh-colib-brief-stat" role="listitem">
          <div class="mh-colib-brief-stat-label">Interview Rounds</div>
          <div class="mh-colib-brief-stat-value"><%= company.briefing.rounds %></div>
        </div>
        <div class="mh-colib-brief-stat" role="listitem">
          <div class="mh-colib-brief-stat-label">Primary Focus</div>
          <div class="mh-colib-brief-stat-value"><%= company.briefing.primaryFocus %></div>
        </div>
        <div class="mh-colib-brief-stat" role="listitem">
          <div class="mh-colib-brief-stat-label">Behavioral Weight</div>
          <div class="mh-colib-brief-stat-value"><%= company.briefing.behavioralWeight %></div>
        </div>
        <div class="mh-colib-brief-stat" role="listitem">
          <div class="mh-colib-brief-stat-label">Technical Depth</div>
          <div class="mh-colib-brief-stat-value"><%= company.briefing.technicalDepth %></div>
        </div>
        <%
          const _wordSource = [
            company.briefing.summary,
            company.journeyCompressed.map(function(s) { return s.stage + ' ' + s.desc; }).join(' '),
            company.competencies.map(function(c) { return c.name + ' ' + c.desc; }).join(' '),
            company.questions.join(' '),
            company.checklist.join(' '),
          ].join(' ');
          const _wordCount = _wordSource.split(/\s+/).filter(Boolean).length;
          const _readingMinutes = Math.max(1, Math.round(_wordCount / 200));
        %>
        <div class="mh-colib-brief-stat" role="listitem">
          <div class="mh-colib-brief-stat-label">Reading Time</div>
          <div class="mh-colib-brief-stat-value"><%= _readingMinutes %> min</div>
        </div>
      </div>

      <p class="mh-section-sub mh-colib-hero-summary"><%= company.briefing.summary %></p>
    </div>
  </section>

  <!-- ============================================================
       TWO-COLUMN BRIEFING LAYOUT — main content (reading column) +
       a sticky reference sidebar. Collapses to one column on
       tablet/mobile (sidebar drops below the hero, per spec).
       ============================================================ -->
  <div class="mh-editorial-surface">
    <div class="mh-editorial-inner">

      <nav class="mh-colib-breadcrumb-row" aria-label="Breadcrumb" style="padding: 0 0 24px; color: var(--ed-muted, #5B6472);">
        <div style="color: inherit;">
          <a href="/explore" style="color: var(--ed-muted, #5B6472);">Explore MedhaIQ</a>
          <span aria-hidden="true">/</span>
          <a href="/explore/company-library" style="color: var(--ed-muted, #5B6472);">Company Interview Library</a>
          <span aria-hidden="true">/</span>
          <span style="color: var(--ed-text, #1A1F2B); font-weight: 600;"><%= company.name %></span>
        </div>
      </nav>

      <div class="mh-colib-brief-grid">
        <!-- MAIN CONTENT (reading column) -->
        <div class="mh-colib-brief-main">

          <!-- Interview Philosophy — max 5 principles, one sentence each.
               Reuses the existing `competencies` data (already ≤5 items,
               one sentence per item) rather than introducing a new field. -->
          <div class="mh-editorial-card mh-colib-brief-card">
            <div class="mh-eyebrow">Interview Philosophy</div>
            <h2 class="mh-editorial-card-title">What <%= company.name %> looks for</h2>
            <ul class="mh-colib-philosophy-list">
              <% company.competencies.slice(0, 5).forEach(function(comp) { %>
                <li>
                  <div class="mh-colib-philosophy-name"><%= comp.name %></div>
                  <div class="mh-colib-philosophy-desc"><%= comp.desc %></div>
                </li>
              <% }); %>
            </ul>
          </div>

          <!-- Interview Journey — compressed to 5 generic stages, one
               short sentence each, minimal vertical whitespace. -->
          <div class="mh-editorial-card mh-colib-brief-card">
            <div class="mh-eyebrow">Interview Journey</div>
            <h2 class="mh-editorial-card-title">How the process runs</h2>
            <ol class="mh-colib-journey-compact">
              <% company.journeyCompressed.forEach(function(stage, i) { %>
                <li>
                  <span class="mh-colib-journey-num"><%= i + 1 %></span>
                  <span class="mh-colib-journey-stage"><%= stage.stage %></span>
                  <span class="mh-colib-journey-desc"><%= stage.desc %></span>
                </li>
              <% }); %>
            </ol>
          </div>

          <!-- Sample Questions — moved higher (immediate value), accordion,
               collapsed by default via native <details>/<summary>. -->
          <div class="mh-editorial-card mh-colib-brief-card">
            <div class="mh-eyebrow">Sample Questions</div>
            <h2 class="mh-editorial-card-title">Questions in <%= company.name %>'s style</h2>
            <p class="mh-editorial-muted" style="margin-bottom: 16px;">Illustrative of the company's known interview style — not official or leaked questions.</p>
            <div class="mh-colib-accordion">
              <% company.questions.slice(0, 8).forEach(function(q, i) { %>
                <details class="mh-colib-accordion-item">
                  <summary class="mh-colib-accordion-trigger">
                    <span class="mh-colib-accordion-num"><%= i + 1 %></span>
                    <span class="mh-colib-accordion-q"><%= q %></span>
                    <svg class="mh-colib-accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                  </summary>
                  <div class="mh-colib-accordion-body">Think in STAR structure — Situation, Task, Action, Result — and be ready for a specific, first-person follow-up.</div>
                </details>
              <% }); %>
            </div>
          </div>

          <!-- Preparation Checklist — concise checklist, no cards. -->
          <div class="mh-editorial-card mh-colib-brief-card">
            <div class="mh-eyebrow">Before Your Interview</div>
            <h2 class="mh-editorial-card-title">Preparation Checklist</h2>
            <ul class="mh-colib-checklist">
              <% company.checklist.forEach(function(item) { %>
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                  <span><%= item %></span>
                </li>
              <% }); %>
            </ul>
          </div>

          <!-- Official Resources — minimal, max 3-4, quiet disclaimer. -->
          <% if (company.officialResources && company.officialResources.length) { %>
          <div class="mh-colib-official-block">
            <div class="mh-eyebrow" style="justify-content:center; display:flex; margin-bottom: 12px;">Official Resources</div>
            <ul class="mh-colib-official-list">
              <% company.officialResources.slice(0, 4).forEach(function(res) { %>
                <li><a href="<%= res.url %>" target="_blank" rel="noopener noreferrer"><%= res.title %> <span aria-hidden="true">↗</span></a></li>
              <% }); %>
            </ul>
            <p class="mh-colib-trademark-disclaimer" style="margin-top: 20px;">Company names and logos are the property of their respective owners and are used solely for identification purposes. No affiliation or endorsement is implied.</p>
          </div>
          <% } %>

        </div>

        <!-- STICKY SIDEBAR — persistent reference while reading. Stats
             only, no CTA (see design-resolution note: rule #9 elsewhere
             in this spec is explicit that there's exactly one CTA, at
             the bottom of the page). -->
        <aside class="mh-colib-brief-sidebar">
          <div class="mh-colib-sidebar-card">
            <div class="mh-colib-sidebar-name"><%= company.name.toUpperCase() %></div>
            <div class="mh-colib-sidebar-focus"><%= company.briefing.primaryFocus %></div>
            <div class="mh-colib-sidebar-divider"></div>
            <div class="mh-colib-sidebar-row">
              <span>Difficulty</span>
              <span class="mh-colib-sidebar-stars" aria-label="<%= company.briefing.difficulty %> out of 5"><%= '★'.repeat(company.briefing.difficulty) %><%= '☆'.repeat(5 - company.briefing.difficulty) %></span>
            </div>
            <div class="mh-colib-sidebar-row">
              <span>Interview Rounds</span>
              <span><%= company.briefing.rounds %></span>
            </div>
            <div class="mh-colib-sidebar-row">
              <span>Behavioral Weight</span>
              <span><%= company.briefing.behavioralWeight %></span>
            </div>
            <div class="mh-colib-sidebar-row mh-colib-sidebar-row-stacked">
              <span><%= company.briefing.fingerprintLabel %></span>
              <span><%= company.briefing.fingerprint %></span>
            </div>
            <div class="mh-colib-sidebar-row">
              <span>Reading Time</span>
              <span><%= _readingMinutes %> min</span>
            </div>
          </div>
        </aside>
      </div>

    </div>
  </div>

  <!-- FINAL CTA — the only CTA on the page. -->
  <section class="mh-colib-dark-cta reveal">
    <div class="mh-explore-cta-inner">
      <h2 class="mh-section-title">Your preparation starts here.</h2>
      <p class="mh-explore-cta-sub">You've seen how <%= company.name %> evaluates candidates and what to prepare for. Now experience a personalized interview tailored to your resume and target role.</p>
      <div class="mh-explore-cta-actions">
        <a href="/login" class="mh-btn-primary">Practice <%= company.name %> Interview</a>
      </div>
      <p style="margin-top: 16px;"><a href="/explore/company-library" class="mh-explore-card-link" style="justify-content: center; color: var(--text-muted);">Back to Library</a></p>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
  (function() {
    var reveals = document.querySelectorAll('.reveal');
    if (reveals.length) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) entry.target.classList.add('visible');
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(function(el) { observer.observe(el); });
    }
  })();
  </script>
</body>
</html>
