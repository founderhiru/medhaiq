<%- include('partials/workspace-shell-top', { pageTitle: 'Career Workspace — MedhaIQ', activeNav: 'dashboard', bodyClass: 'career-workspace', shellUser: shellUser, extraStylesheets: ['/css/career-workspace.css'], previewMode: typeof previewMode !== 'undefined' ? previewMode : false }) %>

<%
/* Dynamic greeting — server renders a fallback using its own clock so
   there's a sensible first-paint value, then the inline script below
   overwrites it immediately using the *client's* local time, which is
   the actual source of truth per spec. Same 4 bands computed both
   places; keep them in sync if the ranges ever change. */
const _firstName = (shellUser && shellUser.name) ? shellUser.name.trim().split(/\s+/)[0] : 'there';
const _srvHour = new Date().getHours();
const _initialGreeting = (_srvHour >= 5 && _srvHour < 12) ? `Good morning, ${_firstName} 👋`
  : (_srvHour >= 12 && _srvHour < 17) ? `Good afternoon, ${_firstName} ☀️`
  : (_srvHour >= 17 && _srvHour < 22) ? `Good evening, ${_firstName} 🌙`
  : `Welcome back, ${_firstName} 👋`;
%>
<div class="page-header-row">
  <div>
    <h1 id="dashGreeting"><%= _initialGreeting %></h1>
    <p class="subtitle">Track your progress, improve every day, and land your next opportunity.</p>
    <% if (typeof previewMode !== 'undefined' && previewMode) { %>
      <span style="display:inline-flex;align-items:center;gap:6px;margin-top:8px;padding:4px 12px;border-radius:20px;background:rgba(59,130,246,0.15);color:#3b82f6;font-size:12px;font-weight:600;letter-spacing:0.02em;">● Sample Account — Demo Data</span>
    <% } %>
  </div>
  <div class="page-header-actions">
    <% if (typeof previewMode !== 'undefined' && previewMode) { %>
      <span class="new-interview-btn" aria-disabled="true" title="Create a free account to start your own interview" style="opacity:0.5;cursor:not-allowed;pointer-events:none;">＋ New Interview</span>
    <% } else { %>
      <a href="/interview" class="new-interview-btn">＋ New Interview</a>
    <% } %>
    <!-- Notifications -- icon only, no backend notification system exists
         yet, so no unread dot is shown (would be fabricated status). -->
    <button type="button" class="db-bell-btn" aria-label="Notifications" title="Notifications">
      <%- include('partials/icon', { name: 'bell', svgSize: 19 }) %>
    </button>
    <%
    /* Same package resolution as partials/workspace-shell-top.ejs, used
       here only for the dropdown's plan badge. Duplicated (not shared)
       because EJS include() locals don't cross back out of that partial's
       own scope -- see workspace-shell-top.ejs's own comment on this same
       resolution for the source of truth. Keep both in sync if the
       package tiers ever change. */
    const _dbPkgMeta = {
      explorer:   { label: 'Explorer',   dot: '⚪', cls: 'pill-explorer' },
      growth:     { label: 'Growth',     dot: '🟢', cls: 'pill-growth' },
      leadership: { label: 'Leadership', dot: '🟣', cls: 'pill-leadership' },
    };
    const _dbPkgId = (typeof capabilities !== 'undefined' && capabilities && capabilities.package && capabilities.package.id) || 'explorer';
    const _dbIsFounder = typeof capabilities !== 'undefined' && capabilities && capabilities.isFounderAccount;
    const _dbPkg = _dbIsFounder ? { label: 'Founder', dot: '👑', cls: 'pill-founder' } : (_dbPkgMeta[_dbPkgId] || _dbPkgMeta.explorer);
    %>
    <div class="db-profile-wrap" id="db-profile-wrap">
      <button type="button" id="db-profile-trigger" aria-haspopup="true" aria-expanded="false" aria-label="Account menu for <%= (shellUser && shellUser.name) || 'your account' %>" class="db-profile-trigger">
        <span class="db-profile-avatar"><%- include('partials/user-avatar', { user: shellUser, glyphSize: 17 }) %></span>
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.6;flex-shrink:0;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div id="db-profile-menu" role="menu" class="db-profile-menu">
        <div class="db-profile-menu-header">
          <div class="db-profile-menu-name"><%= (shellUser && shellUser.name) || 'Your account' %></div>
          <div class="shell-package-pill <%= _dbPkg.cls %>"><%= _dbPkg.dot %> <%= _dbPkg.label %></div>
        </div>
        <%- include('partials/account-menu', {
          menuItems: [{ label: 'My Profile', href: '/settings' }],
          logoutLabel: 'Sign Out',
          showLogoutIcon: true,
          showDivider: false,
          linkColor: '#0B1020',
        }) %>
      </div>
    </div>
  </div>
</div>

<script>
  // Dynamic greeting, client-local-time authoritative — overwrites the
  // server-rendered fallback in #dashGreeting immediately.
  (function() {
    var el = document.getElementById('dashGreeting');
    if (!el) return;
    var name = <%- JSON.stringify(_firstName) %>;
    var h = new Date().getHours();
    var greeting, emoji;
    if (h >= 5 && h < 12) { greeting = 'Good morning'; emoji = '👋'; }
    else if (h >= 12 && h < 17) { greeting = 'Good afternoon'; emoji = '☀️'; }
    else if (h >= 17 && h < 22) { greeting = 'Good evening'; emoji = '🌙'; }
    else { greeting = 'Welcome back'; emoji = '👋'; }
    el.textContent = greeting + ', ' + name + ' ' + emoji;
  })();
</script>

<% if (!history || history.length === 0) { %>
  <!-- First-time user / no history yet: action-oriented empty state,
       per the flow spec — no fabricated numbers, no gauge, no insights. -->
  <div class="report-section" style="text-align:center; padding:48px 32px;">
    <h3 style="margin-bottom:10px;">Let's get your first read on where you stand</h3>
    <p style="color:var(--muted); font-size:14px; max-width:440px; margin:0 auto 24px;">
      Run one interview and this page fills in with your readiness score, your strengths, and where to focus next.
    </p>
    <a href="/interview" class="cta-btn primary" style="display:inline-block;">＋ Configure your first interview</a>
  </div>
<% } else { %>

  <!-- Activity Overview Strip -->
  <div class="overview-strip">
    <div class="overview-stat">
      <div class="icon-sq square <%= resumeIntelActive ? 'green' : 'blue' %>"><%- include('partials/icon', { name: 'sparkle', svgSize: 20 }) %></div>
      <div>
        <div class="num resume-intel-status">
          <span class="resume-intel-dot <%= resumeIntelActive ? 'is-active' : 'is-inactive' %>"></span>
          <%= resumeIntelActive ? 'Active' : 'Inactive' %>
        </div>
        <div class="label">Resume Intelligence</div>
        <% if (resumeIntelActive) { %>
          <div class="sublabel"><%= resumeIntelSubLabel %></div>
        <% } else if (typeof previewMode !== 'undefined' && previewMode) { %>
          <span class="sublabel resume-intel-cta" aria-disabled="true" title="Create a free account to upload your resume" style="opacity:0.5;cursor:not-allowed;">Upload Resume →</span>
        <% } else { %>
          <a href="/resume" class="sublabel resume-intel-cta">Upload Resume →</a>
        <% } %>
      </div>
    </div>
    <div class="overview-stat">
      <div class="icon-sq square violet"><%- include('partials/icon', { name: 'calendar', svgSize: 20 }) %></div>
      <div>
        <div class="num"><%= interviewsCompletedCount %></div>
        <div class="label">Interviews completed</div>
        <div class="sublabel"><%= lastInterviewLabel %></div>
      </div>
    </div>
    <div class="overview-stat">
      <div class="icon-sq square green"><%- include('partials/icon', { name: 'clock', svgSize: 20 }) %></div>
      <div>
        <div class="num"><%= practiceTimeLabel %></div>
        <div class="label">Total practice time</div>
        <div class="sublabel"><%= lastSessionLabel %></div>
      </div>
    </div>
    <div class="overview-stat">
      <div class="icon-sq square blue"><%- include('partials/icon', { name: 'document', svgSize: 20 }) %></div>
      <div>
        <div class="num"><%= reportsGeneratedCount %></div>
        <div class="label">Reports generated</div>
        <div class="sublabel"><%= lastReportLabel %></div>
      </div>
    </div>
  </div>

  <!-- AI Interview Minutes + Interview Readiness, paired -->
  <%
    // Same interviewEntitlement object already powering Settings' "X of Y
    // minutes remaining" line and the exhaustion modal (lib/capability-engine.js)
    // — no new query, no fabricated numbers. package.expiresAt is the real
    // credits renewal date from the active acquisition row.
    const _ent = (typeof capabilities !== 'undefined' && capabilities) ? capabilities.interviewEntitlement : null;
    const _pkgExpiry = (typeof capabilities !== 'undefined' && capabilities && capabilities.package) ? capabilities.package.expiresAt : null;
    // Qualitative tier label for the Readiness score — thresholds are a
    // simple, documented display convention, not a new scoring model
    // (the underlying number is still the real trend average untouched).
    const _readinessTier = (readinessScore === null) ? null
      : readinessScore >= 80 ? { label: 'Excellent Progress', cls: 'good' }
      : readinessScore >= 60 ? { label: 'Good Progress', cls: 'good' }
      : readinessScore >= 40 ? { label: 'Building Progress', cls: 'mid' }
      : { label: 'Needs Focus', cls: 'low' };
  %>
  <div class="pair-row">
    <div class="panel minutes-panel">
      <h3><%- include('partials/icon', { name: 'bolt', svgSize: 15 }) %> AI Interview Minutes</h3>
      <% if (_ent && !_ent.unlimited) {
        const minCircR = 46, minCircCircumference = 2 * Math.PI * minCircR;
        const minPct = _ent.minutesIncluded > 0 ? Math.max(0, Math.min(1, _ent.minutesRemaining / _ent.minutesIncluded)) : 0;
        const minCircOffset = minCircCircumference - minPct * minCircCircumference;
        const minUsedPct = _ent.minutesIncluded > 0 ? Math.max(0, Math.min(100, (_ent.minutesUsed / _ent.minutesIncluded) * 100)) : 0;
      %>
        <div class="minutes-row">
          <div class="minutes-ring-wrap">
            <svg viewBox="0 0 110 110" width="110" height="110">
              <defs>
                <linearGradient id="minutesRingGrad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#FDE68A"/>
                  <stop offset="100%" stop-color="#F59E0B"/>
                </linearGradient>
              </defs>
              <circle class="minutes-ring-track" cx="55" cy="55" r="<%= minCircR %>"/>
              <circle class="minutes-ring-fill" cx="55" cy="55" r="<%= minCircR %>"
                stroke-dasharray="<%= minCircCircumference %>" stroke-dashoffset="<%= minCircOffset %>"/>
            </svg>
            <div class="minutes-ring-center">
              <div class="num"><%= Math.round(_ent.minutesRemaining) %></div>
              <div class="of100">mins</div>
            </div>
          </div>
          <div class="minutes-stats-col">
            <div class="minutes-remaining-label">AI Interview Minutes Remaining</div>
            <div class="minutes-progress-track"><div class="minutes-progress-fill" style="width:<%= minUsedPct %>%"></div></div>
            <div class="minutes-progress-labels">
              <span>Used <%= Math.round(_ent.minutesUsed) %> mins</span>
              <span>Total <%= _ent.minutesIncluded %> mins</span>
            </div>
          </div>
        </div>
        <div class="minutes-footer-row">
          <% if (_pkgExpiry) { %>
          <div class="minutes-renew-info">
            <span class="minutes-renew-icon"><%- include('partials/icon', { name: 'calendar', svgSize: 15 }) %></span>
            <div>
              <div class="minutes-renew-label">Plan renews on</div>
              <div class="minutes-renew-date"><%= new Date(_pkgExpiry).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) %></div>
            </div>
          </div>
          <% } %>
          <button type="button" class="minutes-cta" id="openTopupModalBtn" data-package-id="<%= (capabilities && capabilities.package && capabilities.package.id) || 'explorer' %>" style="cursor:pointer; font-family:inherit;">Buy More Minutes</button>
        </div>
      <% } else { %>
        <p style="color:var(--dim); font-size:12.5px;">Unlimited AI Interview Minutes on your plan.</p>
      <% } %>
    </div>

    <div class="panel readiness-panel">
      <div class="panel-header-row">
        <h3>Interview Readiness</h3>
        <% if (trend && trend.length > 1 && readinessDeltaVsPrevious !== null) { %>
          <span class="readiness-delta-inline"><%= readinessDeltaVsPrevious >= 0 ? '↑' : '↓' %> <%= Math.abs(readinessDeltaVsPrevious) %> pts since your last interview</span>
        <% } %>
      </div>
      <% if (trend && trend.length > 1) { %>
        <div class="readiness-row">
          <div class="readiness-summary-col">
            <div class="readiness-score"><span class="num"><%= readinessScore %></span><span class="of100">/100</span></div>
            <% if (_readinessTier) { %><div class="readiness-progress-label <%= _readinessTier.cls %>"><%= _readinessTier.label %></div><% } %>
            <p class="readiness-caption">Calculated from your last <%= trend.length %> completed interviews.</p>
          </div>
          <div class="readiness-chart-row">
            <div class="trend-y-labels"><span>100</span><span>75</span><span>50</span><span>25</span><span>0</span></div>
            <div class="readiness-chart-col">
              <svg class="score-trend-svg" viewBox="0 0 <%= trendWidth %> 80" preserveAspectRatio="none" id="trendSvg">
                <defs>
                  <linearGradient id="trendGrad" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="rgba(52,211,153,0.32)"/>
                    <stop offset="100%" stop-color="rgba(52,211,153,0)"/>
                  </linearGradient>
                </defs>
                <% [0, 20, 40, 60, 80].forEach(function(gy) { %>
                  <line class="trend-grid-line" x1="0" y1="<%= gy %>" x2="<%= trendWidth %>" y2="<%= gy %>"/>
                <% }); %>
                <line class="trend-axis-line" x1="0" y1="0" x2="0" y2="80"/>
                <polygon class="trend-fill" points="<%= trendPointsFill %>"/>
                <polyline class="trend-line" points="<%= trendPoints %>"/>
                <% trend.forEach(function(score, i) {
                  const isLatest = i === trend.length - 1;
                  const x = trendX(i); const y = trendY(score);
                %>
                  <circle class="trend-dot<%= isLatest ? ' trend-dot-latest' : '' %>" cx="<%= x %>" cy="<%= y %>" r="<%= isLatest ? 6 : 3.5 %>"/>
                <% }); %>
              </svg>
              <div class="trend-x-labels">
                <% trend.forEach(function(score, i) { %><span><%= i === 0 ? 'Interview 1' : (i + 1) %></span><% }); %>
              </div>
            </div>
          </div>
        </div>
      <% } else { %>
        <p style="color:var(--dim); font-size:12.5px;">Complete another interview to track progress.</p>
      <% } %>
      <% if (bestCompetencyLabel || focusNextLabel) { %>
        <div class="readiness-competency-row">
          <div class="competency-stat">
            <div class="competency-stat-label">Best Competency</div>
            <div class="competency-stat-value good"><%= bestCompetencyLabel || '—' %></div>
          </div>
          <div class="competency-stat">
            <div class="competency-stat-label">Focus Next</div>
            <div class="competency-stat-value focus"><%= focusNextLabel || '—' %></div>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Recent Activity + Quick Actions, paired (9:3 — Activity is the
       primary continuation point) -->
  <div class="pair-row pair-row--activity">
    <div class="panel">
      <div class="panel-header-row"><h3>Recent Activity</h3><a href="/dashboard/reports" class="view-all-link">View all →</a></div>
      <div class="activity-feed">
        <% history.slice(0, 3).forEach(function(s) { %>
          <% const isInterrupted = s.status === 'in_progress'; %>
          <div class="activity-row <%= isInterrupted ? 'interrupted' : '' %>">
            <div class="icon-sq sm <%= isInterrupted ? 'blue' : (s.overallScore !== null && s.overallScore >= 80 ? 'violet' : 'orange') %>">
              <%- include('partials/icon', { name: isInterrupted ? 'play' : 'check', svgSize: 15 }) %>
            </div>
            <div class="activity-main">
              <div class="title"><%= s.roleTitle || 'Mock Interview' %></div>
              <div class="meta">
                <% if (s.orgPreset) { %><%= s.orgPreset %> · <% } %><%= new Date(s.startedAt).toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric'}) %>
              </div>
            </div>
            <% if (s.status === 'completed' && s.overallScore !== null) { %>
              <span class="activity-score <%= s.overallScore >= 80 ? 'high' : s.overallScore >= 60 ? 'mid' : 'low' %>"><%= s.overallScore %><span class="of100">/100</span></span>
            <% } else { %>
              <span class="activity-status-text <%= s.status %>"><%= s.status.replace('_',' ') %></span>
            <% } %>
            <% if (isInterrupted) { %>
              <a href="/interview/session/<%= s.id %>" class="activity-cta resume">Resume Session ▷</a>
            <% } else if (s.status === 'completed' && s.overallScore !== null) { %>
              <a href="/interview/report/<%= s.id %>" class="activity-cta view">View report</a>
            <% } else { %>
              <span style="color:var(--dim);font-size:12.5px;">—</span>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>

    <div class="panel qa-panel">
      <h3>Quick Actions</h3>
      <div class="quick-actions">
        <% const _previewDisabled = typeof previewMode !== 'undefined' && previewMode; %>
        <% if (interruptedSession) { %>
          <% if (_previewDisabled) { %>
          <span class="qa-card violet" aria-disabled="true" title="Create a free account to continue" style="opacity:0.5;cursor:not-allowed;">
          <% } else { %>
          <a href="/interview/session/<%= interruptedSession.id %>" class="qa-card violet">
          <% } %>
            <div class="qa-icon"><%- include('partials/icon', { name: 'play', svgSize: 20 }) %></div>
            <div class="qa-title">Continue Interview</div>
            <div class="qa-desc">Pick back up where you left off</div>
            <div class="qa-arrow">→</div>
          <%- _previewDisabled ? '</span>' : '</a>' %>
        <% } else { %>
          <% if (_previewDisabled) { %>
          <span class="qa-card violet" aria-disabled="true" title="Create a free account to start your own interview" style="opacity:0.5;cursor:not-allowed;">
          <% } else { %>
          <a href="/interview" class="qa-card violet">
          <% } %>
            <div class="qa-icon"><%- include('partials/icon', { name: 'mic', svgSize: 20 }) %></div>
            <div class="qa-title">Start Interview</div>
            <div class="qa-desc">Practice with AI interviewer and get instant feedback</div>
            <div class="qa-arrow">→</div>
          <%- _previewDisabled ? '</span>' : '</a>' %>
        <% } %>
        <% if (resumeIntelActive) { %>
          <% if (_previewDisabled) { %>
          <span class="qa-card green" aria-disabled="true" title="Create a free account to update your resume" style="opacity:0.5;cursor:not-allowed;">
          <% } else { %>
          <a href="/resume" class="qa-card green">
          <% } %>
            <div class="qa-icon"><%- include('partials/icon', { name: 'upload', svgSize: 20 }) %></div>
            <div class="qa-title">Update Resume</div>
            <div class="qa-desc">Refresh Resume Intelligence with your latest resume</div>
            <div class="qa-arrow">→</div>
          <%- _previewDisabled ? '</span>' : '</a>' %>
        <% } else { %>
          <% if (_previewDisabled) { %>
          <span class="qa-card green" aria-disabled="true" title="Create a free account to upload your resume" style="opacity:0.5;cursor:not-allowed;">
          <% } else { %>
          <a href="/resume" class="qa-card green">
          <% } %>
            <div class="qa-icon"><%- include('partials/icon', { name: 'upload', svgSize: 20 }) %></div>
            <div class="qa-title">Upload Resume</div>
            <div class="qa-desc">Complete your AI profile before starting your interview</div>
            <div class="qa-arrow">→</div>
          <%- _previewDisabled ? '</span>' : '</a>' %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Buy More Minutes modal (Workspace top-up) — same visual language
       (colors, radius, overlay pattern) as the existing entitlement-
       exhausted modal in views/interview-setup.ejs, kept page-local
       rather than extracted into a shared component per "smallest safe
       change." This is a credit top-up selector only — it never offers
       package switching/downgrade. The two option buttons route through
       the DEDICATED, currency-aware top-up checkout routes
       (/checkout/growth-topup, /checkout/leadership-topup —
       routes/stripe.js), commercially distinct prices from the full
       Growth/Leadership package purchase; the "Upgrade to Leadership"
       button in the locked state below routes through the EXISTING
       full-price /checkout/leadership route instead — see its own
       comment further down for why. Placed HERE, inside this else-block,
       because it reads _ent (current balance) which is scoped to this
       block — see the const _ent declaration near the top of this
       branch. -->
  <%
  // Local, currency-appropriate top-up prices — resolved server-side
  // (server.js's /dashboard/history route, using the SAME
  // lib/pricing-market.js resolveMarket() the checkout routes use) and
  // passed in as `market`. Shown as a single currency, never both —
  // this is a display convenience only; the ACTUAL charged price is
  // always re-resolved server-side at checkout-creation time
  // (routes/stripe.js), never trusted from here.
  const _isIndia = (typeof market !== 'undefined' && market === 'india');
  const _growthTopupPrice = _isIndia ? '\u20b9699' : '$12';
  const _leadershipTopupPrice = _isIndia ? '\u20b91,999' : '$29';
  %>
  <div id="topupModalOverlay" style="display:none; position:fixed; inset:0; background:rgba(2,6,16,0.75); z-index:9999; align-items:center; justify-content:center; padding:16px;">
    <div style="background:var(--card); border:1px solid rgba(255,255,255,0.12); border-radius:var(--radius); padding:28px; max-width:380px; width:100%;">
      <div style="font-size:17px; font-weight:700; color:var(--white); margin-bottom:4px;">Add AI Minutes</div>
      <div style="font-size:13px; color:var(--muted); margin-bottom:20px;">
        Current balance: <strong style="color:var(--white);"><%= _ent ? Math.round(_ent.minutesRemaining) : 0 %> AI Minutes</strong>
      </div>

      <div style="font-size:11.5px; font-weight:700; color:var(--dim); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:8px;">Choose additional minutes</div>

      <button type="button" class="topup-option-btn" data-package="growth-topup" style="width:100%; display:flex; align-items:center; justify-content:space-between; padding:14px 16px; margin-bottom:10px; background:var(--slate); border:1px solid rgba(255,255,255,0.10); border-radius:10px; cursor:pointer; text-align:left; font-family:inherit;">
        <span>
          <span style="display:block; font-size:14px; font-weight:700; color:var(--white);">+120 AI Minutes</span>
          <span style="display:block; font-size:12px; color:var(--muted);"><%= _growthTopupPrice %></span>
        </span>
        <span class="topup-option-cta" style="font-size:12.5px; font-weight:600; color:var(--bright);">Add 120 Minutes</span>
      </button>

      <%
      // Top-up eligibility rule: the discounted +300 (Leadership-tier)
      // top-up price is available ONLY to users who already have active
      // Leadership access — enforced server-side too (routes/stripe.js's
      // /checkout/leadership-topup route rejects anyone else, never
      // creating a Stripe session). This UI lock is the friendly,
      // fast-fail front end for that same rule, not the actual
      // enforcement.
      const _isLeadership = capabilities && capabilities.package && capabilities.package.id === 'leadership';
      %>
      <% if (_isLeadership) { %>
      <button type="button" class="topup-option-btn" data-package="leadership-topup" style="width:100%; display:flex; align-items:center; justify-content:space-between; padding:14px 16px; margin-bottom:6px; background:var(--slate); border:1px solid rgba(255,255,255,0.10); border-radius:10px; cursor:pointer; text-align:left; font-family:inherit;">
        <span>
          <span style="display:block; font-size:14px; font-weight:700; color:var(--white);">+300 AI Minutes</span>
          <span style="display:block; font-size:12px; color:var(--muted);"><%= _leadershipTopupPrice %></span>
        </span>
        <span class="topup-option-cta" style="font-size:12.5px; font-weight:600; color:var(--bright);">Add 300 Minutes</span>
      </button>
      <% } else { %>
      <div style="width:100%; padding:14px 16px; margin-bottom:6px; background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.08); border-radius:10px; text-align:left;">
        <div style="font-size:13px; font-weight:700; color:var(--muted); margin-bottom:4px;">🔒 Available with Leadership</div>
        <div style="font-size:12px; color:var(--dim); margin-bottom:10px;">Upgrade to Leadership to unlock 300-minute top-ups.</div>
        <button type="button" id="upgradeToLeadershipBtn" style="width:100%; padding:9px; border-radius:8px; border:1px solid rgba(59,130,246,0.4); background:rgba(59,130,246,0.12); color:var(--bright); font-weight:600; font-size:12.5px; cursor:pointer; font-family:inherit;">Upgrade to Leadership</button>
      </div>
      <% } %>

      <p style="font-size:11.5px; color:var(--dim); margin:12px 0 18px;">Your current access level remains unchanged.</p>

      <button type="button" id="topupModalCancel" style="width:100%; padding:9px; border-radius:10px; border:none; background:transparent; color:var(--muted); font-weight:600; font-size:12.5px; cursor:pointer; font-family:inherit;">Cancel</button>
    </div>
  </div>

  <script>
    // Buy More Minutes modal — opens on click, closes on Cancel/backdrop/
    // Escape (same conventions as the account dropdown script further
    // below and the entitlement-exhausted modal on the interview setup
    // page). Each option button POSTs to the EXISTING checkout route for
    // that package (routes/stripe.js) — this creates no new payment
    // logic, just a different entry point into the same flow the
    // Pricing page already used.
    (function() {
      var openBtn = document.getElementById('openTopupModalBtn');
      var overlay = document.getElementById('topupModalOverlay');
      var cancelBtn = document.getElementById('topupModalCancel');
      if (!openBtn || !overlay) return;

      function openModal() { overlay.style.display = 'flex'; }
      function closeModal() { overlay.style.display = 'none'; }

      // Explorer has no top-up UI at all (nothing to "top up" yet) —
      // clicking Buy More Minutes sends them straight to the normal
      // package purchase options instead of opening this modal. Growth
      // and Leadership both open the modal; which options are unlocked
      // inside it is decided server-side at render time (see the EJS
      // conditional above this script), not here.
      openBtn.addEventListener('click', function() {
        var pkgId = openBtn.getAttribute('data-package-id');
        if (pkgId === 'explorer') {
          window.location.href = '/#pricing';
          return;
        }
        openModal();
      });

      if (cancelBtn) cancelBtn.addEventListener('click', closeModal);
      overlay.addEventListener('click', function(e) { if (e.target === overlay) closeModal(); });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && overlay.style.display === 'flex') closeModal();
      });

      // Shared checkout-start helper — used by both the top-up option
      // buttons (growth / leadership-topup) AND the locked +300 card's
      // "Upgrade to Leadership" button (full-price 'leadership' route).
      // All three are just different packageId values into the SAME
      // existing checkout endpoint family; no separate payment logic.
      async function startCheckout(packageId, triggerBtn, labelEl, otherButtonsToDisable) {
        var originalText = labelEl ? labelEl.textContent : '';
        otherButtonsToDisable.forEach(function(b) { b.disabled = true; });
        if (labelEl) labelEl.textContent = 'Redirecting…';
        try {
          var res = await fetch('/api/stripe/checkout/' + packageId, { method: 'POST' });
          if (res.status === 401) {
            window.location.href = '/login';
            return;
          }
          var json = await res.json();
          if (res.ok && json.url) {
            window.location.href = json.url;
          } else {
            alert(json.error || 'Could not start checkout. Please try again.');
            otherButtonsToDisable.forEach(function(b) { b.disabled = false; });
            if (labelEl) labelEl.textContent = originalText;
          }
        } catch (err) {
          alert('Network error. Please try again.');
          otherButtonsToDisable.forEach(function(b) { b.disabled = false; });
          if (labelEl) labelEl.textContent = originalText;
        }
      }

      var optionButtons = overlay.querySelectorAll('.topup-option-btn');
      optionButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var packageId = btn.getAttribute('data-package');
          var ctaEl = btn.querySelector('.topup-option-cta');
          startCheckout(packageId, btn, ctaEl, Array.prototype.slice.call(optionButtons));
        });
      });

      // Locked +300 card's upgrade path — full Leadership price, the
      // SAME /checkout/leadership route the standing Pricing page CTA
      // already uses. Deliberately NOT /checkout/leadership-topup: that
      // discounted price is only ever reachable by someone who is
      // already Leadership, which by definition this button's viewer is
      // not (otherwise they'd see the unlocked +300 option instead).
      var upgradeBtn = document.getElementById('upgradeToLeadershipBtn');
      if (upgradeBtn) {
        upgradeBtn.addEventListener('click', function() {
          startCheckout('leadership', upgradeBtn, upgradeBtn, [upgradeBtn]);
        });
      }
    })();
  </script>

<% } %>

<script>
  // Account dropdown — same click/Escape/outside-click pattern already
  // used by the homepage header's profile menu (partials/header.ejs).
  (function() {
    var wrap = document.getElementById('db-profile-wrap');
    if (!wrap) return;
    var trigger = document.getElementById('db-profile-trigger');
    var menu = document.getElementById('db-profile-menu');

    function openMenu() { menu.style.display = 'block'; trigger.setAttribute('aria-expanded', 'true'); }
    function closeMenu() { menu.style.display = 'none'; trigger.setAttribute('aria-expanded', 'false'); }

    trigger.addEventListener('click', function(e) {
      e.stopPropagation();
      if (menu.style.display === 'block') { closeMenu(); } else { openMenu(); }
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && menu.style.display === 'block') { closeMenu(); trigger.focus(); }
    });
    document.addEventListener('click', function(e) {
      if (menu.style.display === 'block' && !wrap.contains(e.target)) { closeMenu(); }
    });
  })();
</script>

