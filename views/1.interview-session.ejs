          _speak(request);
        } else {
          pendingRequest = request;
          speechState = SPEECH_STATE.SPEAKING_PENDING;
          slog('[VoiceController] speech request QUEUED (assistant still speaking) questionId=' + question.questionId + ' version=' + CurrentQuestion.version, 'info');
        }
        return true;
      },

      // Speech Correlation gate: an event not matching activeSpokenVersion
      // is logged and ignored -- it does not belong to what we currently
      // believe is playing, so it must not be allowed to move the state
      // machine (Invariant 6).
      onSpeechStart: function () {
        // Speech Correlation: only meaningful if we're actually expecting
        // this event (state SPEAKING). A speech-start arriving while
        // already FREE (e.g. a duplicate/echoed event, or one that
        // arrived after an intentional cancel already released the gate)
        // does not belong to the controller's current activity and must
        // not be trusted.
        if (speechState !== SPEECH_STATE.SPEAKING) {
          slog('[VoiceController] IGNORED speech-start -- does not correlate to an active request (state=' + speechState + ')', 'info');
          return;
        }
        slog('[VoiceController] speech-start observed for active version ' + activeSpokenVersion, 'info');
      },
      onSpeechEnd: function () {
        // Speech Correlation gate (Invariant 6): a speech-end that arrives
        // while the controller is already FREE does not correlate to the
        // active request -- it is a duplicate/delayed echo and must not be
        // allowed to re-trigger pending-request logic a second time.
        if (speechState !== SPEECH_STATE.SPEAKING && speechState !== SPEECH_STATE.SPEAKING_PENDING) {
          slog('[VoiceController] IGNORED speech-end -- does not correlate to an active request (state=' + speechState + ')', 'info');
          return;
        }
        _releaseAndMaybeSpeakPending('speech-end');
      },
      onCallEnd: function () {
        pendingRequest = null;
