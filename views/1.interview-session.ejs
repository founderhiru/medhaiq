<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interview Session — MedhaIQ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <script>
  (function(d,t){
    var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
    g.src='https://cdn.jsdelivr.net/gh/VapiAI/html-script-tag@latest/dist/assets/index.js';
    g.defer=true; g.async=true; s.parentNode.insertBefore(g,s);
  })(document,'script');
  </script>
  <script>
  /* ── setSinkId AbortError noise suppression (bug fix, 2026-07-24) ──
     Vapi's own bundled SDK polls to keep each <audio>/<video> element's
     output device in sync with the browser's preferred sink
     (startPollingToSyncPreferredAudioOutputToDOM, confirmed in the deployed
     bundle) -- calling element.setSinkId(...) repeatedly for the life of
     the call. On many browsers/devices this legitimately rejects with
     AbortError (unsupported output-selection change mid-stream, or a
     transient device-switch race) with ZERO effect on whether the user
     actually hears audio -- playback itself goes through a completely
     separate path (BrowserAudioPlayer). Confirmed via a real staging log:
     55 of these in a single session, once every couple of seconds,
     drowning out everything else in the console.
     This wraps the native setSinkId once, globally, before Vapi's SDK (or
     anything else) ever calls it: the FIRST AbortError still logs once, so
     the condition remains visible; every repeat after that is silently
     swallowed. Any error that ISN'T an AbortError still throws/rejects
     normally -- this only quiets the one specific, confirmed-harmless,
     confirmed-noisy case. */
  (function suppressRepeatedSetSinkIdAbortNoise() {
    if (typeof HTMLMediaElement === 'undefined' || typeof HTMLMediaElement.prototype.setSinkId !== 'function') return;
    var nativeSetSinkId = HTMLMediaElement.prototype.setSinkId;
    var hasLoggedOnce = false;
    HTMLMediaElement.prototype.setSinkId = function () {
      var result = nativeSetSinkId.apply(this, arguments);
      if (result && typeof result.catch === 'function') {
        return result.catch(function (err) {
          if (err && err.name === 'AbortError') {
            if (!hasLoggedOnce) {
              hasLoggedOnce = true;
              console.warn('[MedhaIQ] setSinkId AbortError (audio-output-device sync) -- confirmed harmless to playback, further repeats this session are suppressed to reduce log noise.');
            }
            return; // swallow -- do not propagate a rejection for this specific, expected case
          }
          throw err; // any other error is real and must still surface
        });
      }
      return result;
    };
  })();
  </script>
  <link rel="stylesheet" href="/css/brand-logo.css">
  <link rel="stylesheet" href="/css/interview-session.css">
  <style>
    /* Hide Vapi's own default floating call widget (html-script-tag's
       built-in "vapi-support-btn" — the green phone-icon button seen in
       the upper-left corner). Confirmed via the actual deployed bundle:
       this app never uses that widget to start/manage calls — our own
       connectVoice()/mic button calls vapi.start() directly and
       independently — so this button is purely redundant here. Hiding it
       via display:none also means it can no longer be clicked at all,
       which removes a real (if unlikely) risk: that widget almost
       certainly has its own bound click handler that could otherwise
       start a second, completely uncontrolled call attempt outside this
       app's state machine. CSS-only change — zero effect on
       vapiSDK.run(), any vapi.on(...) handler, or our own call flow. */
    #vapi-support-btn { display: none !important; }
    /* ── STAR skip/miss indicators (additive — safe to remove anytime) ──
       box-shadow instead of border/outline so node sizes never shift. */
    [id^="starNode-"].skipped { box-shadow: 0 0 0 2px #f59e0b, 0 0 10px rgba(245,158,11,.45); animation: starSkipPulse 1.2s ease-in-out infinite; }
    [id^="starNode-"].missed  { box-shadow: 0 0 0 2px #ef4444; opacity: 1; }
    @keyframes starSkipPulse { 0%,100% { box-shadow: 0 0 0 2px #f59e0b, 0 0 4px rgba(245,158,11,.25);} 50% { box-shadow: 0 0 0 2px #f59e0b, 0 0 14px rgba(245,158,11,.65);} }
    .star-skip-note { font-size: 11px; line-height: 1.4; margin-top: 6px; min-height: 15px; letter-spacing: .02em; color: transparent; transition: color .2s; }
    .star-skip-note.warn { color: #f59e0b; }
    .star-skip-note.miss { color: #ef4444; }
    .star-skip-note.ok   { color: #22c55e; }
  </style>
</head>
