<!-- ═══════════════════════════════════════════════════════════════
     INTERVIEW OS ENGINE
═══════════════════════════════════════════════════════════════ -->
<script src="/js/interviewOrchestrator.js"></script>
<!-- PR3: voice/ modules, loaded but only USED when VOICE_PLAYBACK_PROVIDER=tts_pipeline
     (see PR3 Integration Plan §4). Safe to load unconditionally -- these files are
     inert until explicitly constructed. -->
<script src="/js/voice/stt/stt-adapter.js"></script>
<script src="/js/voice/tts/tts-adapter.js"></script>
<script src="/js/voice/tts/elevenlabs-tts-adapter.js"></script>
<script src="/js/voice/player/browser-audio-player.js"></script>
<script src="/js/voice/services/question-speech-service.js"></script>
<script src="/js/voice/voice-client-config.js"></script>
<script>
  window.VOICE_PLAYBACK_PROVIDER = '<%= voicePlaybackProvider %>';
  // Resolved ONCE, here, as a genuine global. This page has multiple
  // independent top-level <script> blocks (each wrapped in its own
  // immediately-invoked function) -- a `var` declared inside one IIFE
  // is invisible to a sibling IIFE. Attaching this to `window`
  // explicitly is what makes it reachable from every block, including
  // submitAnswer() (Sync-engine IIFE, below) and _speak() (Vapi Voice
  // State Machine IIFE, further down).
  window.VOICE_PIPELINE_MODE = (window.VOICE_PLAYBACK_PROVIDER === 'tts_pipeline') ? 'tts_pipeline' : 'legacy_vapi';
  window.questionSpeechService = null; // constructed later, in the Vapi Voice State Machine block, if VOICE_PIPELINE_MODE is tts_pipeline

  // Diagnostic-only timeline tracker (no behavior change). Correlates
  // every checkpoint of a single turn by questionId, so the console
  // shows exactly where a given turn's journey stopped, rather than
  // leaving that to be inferred from scattered, uncorrelated logs.
  window._timelineSteps = window._timelineSteps || {}; // { questionId: { stepName: true/false, ... } }
  window.timelineLog = function (step, questionId, ok, extra) {
    var qid = (questionId === undefined || questionId === null) ? '(none)' : questionId;
    if (!window._timelineSteps[qid]) window._timelineSteps[qid] = {};
    window._timelineSteps[qid][step] = ok;
    console.log('[TIMELINE] questionId=' + qid + ' step="' + step + '" ' + (ok ? '\u2705' : '\u274c') + (extra ? ' ' + extra : ''));
  };

  // ══════════════════════════════════════════════════════════════════
  // CandidateTurnComplete -- provider-independent turn-detection layer.
  //
  // Explicit architectural requirement: the Interview Engine must never
  // depend on one specific Vapi callback again. Evidence gathered this
  // session showed vapi.on('speech-start') is NOT reliably available --
  // some sessions fire it repeatedly, others (confirmed via raw event
  // instrumentation) never fire it at all. A design built on it alone
  // has no fallback when it's absent.
  //
  // REMOVED: an attempted "Option C" (gating the silence-debounce with
  // Daily's local-audio-level API) was tried and reverted. Confirmed via
  // real staging logs: the observer callback fired consistently (~100ms
  // cadence, proving the mechanism itself was alive), but audioLevel was
  // permanently exactly 0.000 across hundreds of readings while the
  // candidate was clearly speaking. Daily's own TypeScript definitions
  // confirm `audioLevel` was the correct field name, ruling out a simple
  // naming bug. Most likely explanation: Vapi constructs the underlying
  // Daily call object internally, not this code, and may not enable
  // whatever internal configuration this feature depends on -- meaning
  // this API path is not usable through Vapi's wrapper. Per explicit
  // instruction: if the API cannot provide usable data, remove the
  // approach rather than keep tuning around a signal that isn't there.
  //
  // This module is the single source of truth for "has the candidate
  // finished their turn," combining what's ACTUALLY available:
  //   1. FAST PATH (optional): if speech-start ever fires, that's Vapi's
  //      own endpointing telling us the turn just ended -- take it
  //      immediately, don't wait.
  //   2. GUARANTEED FALLBACK: every real transcript event (partial or
  //      final) resets a short debounce. If no further transcript
  //      activity arrives within TURN_SILENCE_MS, the turn is declared
  //      complete on that basis alone -- this works even in a session
  //      where speech-start never fires at all.
  //
  // KNOWN OPEN ISSUE (not fixed by this revert): logs still show
  // transcript continuing to arrive for the same answer after
  // AUTO-SUBMIT already fired -- the original cutoff bug remains
  // present. Per explicit instruction, TURN_SILENCE_MS and debounce
  // logic are left untouched pending further investigation, rather than
  // tuned again without proven cause.
  //
  // The Interview Engine (auto-submit logic, below) listens ONLY to
  // onTurnComplete() -- it has no knowledge of speech-start, Vapi, or
  // any other provider-specific event.
  var CandidateTurnComplete = (function () {
    var TURN_SILENCE_MS = 3500; // Explicit spec: "wait approximately 3-4 seconds of continuous silence before treating the answer as complete." 3500ms is the midpoint of that range. Also matches real staging evidence (P1.log) showing candidates cut off mid-sentence, including one case where the candidate literally said "I'm not done yet," at the previous 1200ms threshold.
    var debounceHandle = null;
    var callbacks = [];
    var turnActive = false; // true once real transcript activity has been seen for the current turn

    function fire(source) {
      if (!turnActive) return; // nothing to complete -- avoids a stray fast-path signal firing on an empty/not-yet-started turn
      turnActive = false;
      if (debounceHandle) { clearTimeout(debounceHandle); debounceHandle = null; }
      console.log('[CandidateTurnComplete] fired via ' + source + ' at ' + Date.now());
      callbacks.forEach(function (cb) {
        try { cb({ source: source }); } catch (e) { /* isolate listener errors */ }
      });
    }

    return {
      // Call on EVERY real transcript event (partial or final) for the
      // candidate. Marks the turn as genuinely in-progress and
      // (re)schedules the guaranteed fallback.
      notifyTranscriptActivity: function () {
        turnActive = true;
        if (debounceHandle) clearTimeout(debounceHandle);
        debounceHandle = setTimeout(function () { fire('silence-debounce'); }, TURN_SILENCE_MS);
      },
      // Call when any optional, provider-specific fast-path signal
      // fires (today: Vapi's speech-start). Fires immediately if a
      // turn is genuinely in progress; otherwise a harmless no-op.
      notifyFastPathSignal: function (label) {
        fire(label || 'fast-path');
      },
      // Reset when a new question begins being asked -- clears any
      // stale debounce/turn-state left over from the previous turn.
      reset: function () {
        turnActive = false;
        if (debounceHandle) { clearTimeout(debounceHandle); debounceHandle = null; }
      },
      onTurnComplete: function (cb) {
        if (typeof cb === 'function') callbacks.push(cb);
      }
    };
  })();
  window.CandidateTurnComplete = CandidateTurnComplete;

  // Impossible-to-misinterpret startup banner -- fires immediately, before
  // either IIFE runs, regardless of Vapi/ElevenLabs connection state. If
  // this doesn't show tts_pipeline after flipping the Render env var, the
  // deploy hasn't picked up the change (or the flag itself is wrong) --
  // that's a config problem, not a code problem.
  console.log('==============================');
  console.log('Voice Playback Provider');
  console.log(window.VOICE_PIPELINE_MODE);
  console.log('==============================');
</script>
<script>
(function() {
  /* ══ Sync engine — fixes the UI/audio desync bug ══
     THE ROOT BUG (historical): two independent AI calls were generating
     "the next question" — our own backend text call, AND whatever Vapi's
     own voice assistant decided to actually say — with nothing forcing
     them to match.
     CURRENT DESIGN (Architecture Doc Rev 4): question progression owns
     the on-screen card unconditionally (Invariant 4) — showQuestion() is
     called immediately here in hold(), regardless of voice state. When
     voice is live, the SAME backend text is separately handed to
     InterviewVoiceController.notify() (wired up in the Vapi script
     below), which is the single owner of if/when Vapi actually speaks it
     — see InterviewVoiceController in the Vapi script block for the
     full gating/queueing/version/correlation model. Text and speech are
     deliberately two independent concerns now: text never waits on
     voice, and voice always speaks the exact text already on screen. */
  var pendingQuestion = null;
  var pendingAudioUrl = null;
  var qAudioEl = new Audio();
  var MedhaIQSync = {
    hold: function(question, type, competency, wasSkipped, turnId) {
      // Question lifecycle owns progression (Architecture Doc Rev 4,
      // Invariant 4): text ALWAYS renders immediately and unconditionally,
      // regardless of voice state. Whether or not Vapi is live, ever
      // speaks, or falls behind has zero bearing on whether the candidate
      // sees the current question right now.
      pendingQuestion = { question: question, type: type, competency: competency, turnId: turnId };
      if (turnId) (window.MedhaIQ_log||function(){})('[turn-trace] TURN_ID='+turnId+' UI rendered: QuestionId='+question.id, 'info');
      showQuestion(question, type, competency);
      pendingQuestion = null;

      var vc = window.InterviewVoiceController;
      if (vc && vc.isLive && vc.isLive()) {
        // Single entry point for all voice progression (Invariant 3/5) --
        // Skip and Pass both arrive here identically; only wasSkipped
        // differs, which only affects spoken wording, never the gating.
        vc.notify({ questionId: question.id, text: question.text, turnId: turnId, wasSkipped: !!wasSkipped });
        pendingAudioUrl = null; // Vapi owns speech now -- our own TTS clip (if any) must not fire later
        if (window.MedhaIQOrchestrator) window.MedhaIQOrchestrator.lockInput();
        return;
      }
      // No live voice -- preserve the exact legacy fallback behavior
      // reveal() has always provided: a pre-rendered audio_url clip, if
      // the backend supplied one for a text-only/no-voice session.
      if (pendingAudioUrl) {
        try { qAudioEl.src = pendingAudioUrl; qAudioEl.play().catch(function(){}); } catch(e){}
        pendingAudioUrl = null;
      }
    },
    reveal: function() {
      if (!pendingQuestion) return;
      if (pendingQuestion.turnId) (window.MedhaIQ_log||function(){})('[turn-trace] TURN_ID='+pendingQuestion.turnId+' UI rendered (text-only path): QuestionId='+pendingQuestion.question.id, 'info');
      showQuestion(pendingQuestion.question, pendingQuestion.type, pendingQuestion.competency);
      pendingQuestion = null;
      if (pendingAudioUrl) {
        try { qAudioEl.src = pendingAudioUrl; qAudioEl.play().catch(function(){}); } catch(e){}
        pendingAudioUrl = null;
      }
    }
  };
  window.MedhaIQSync = MedhaIQSync;
  window.MedhaIQVoiceLive = false;

  /* ── EJS-injected session variables ── */
  var SID    = '<%= sessionId %>';
  var QID    = '<%= questionId %>';
  var QN     = <%= answeredCount %> + 1;
  var MAXQ   = 5;
  var SEC_PER_Q = 180; /* 3 min budget per question, drives the "Est. remaining" clock */
  var PNAME  = '<%= personaName %>';
  var PTITLE = '<%= personaTitle %>';
  var PINIT  = '<%= personaInitials %>';
  var PCOL   = '<%= personaStyleColor %>';
  var QTYPE  = '<%= questionType %>';
  var ROLE   = '<%= roleTitle %>';
  var LEVEL  = '<%= experienceLevel %>';
  var INITQ  = `<%- questionText.replace(/`/g, '\\`') %>`;
  /* v2.5 SCOPE BRIDGE — the Vapi script block below is a separate scope and
     cannot see these engine-block variables. Referencing them bare from the
     call-start handler threw "ReferenceError: ROLE is not defined", which
     aborted the handler BEFORE vapi.say() could run — the silent-AI bug.
     Everything the voice layer needs is published on window. */
  window.MedhaIQ_ROLE  = ROLE;
  window.MedhaIQ_LEVEL = LEVEL;
  window.MedhaIQ_PNAME = PNAME;
  // Dynamic Interviewer Greeting bridge -- server.js only ever computes a
  // real value for the render that starts a fresh session (answeredCount
  // === 0); every other render passes null, so this can never resurface
  // mid-interview even on a reload or reconnect.
  window.MedhaIQ_GREETING = <%- JSON.stringify(typeof greetingText !== 'undefined' ? greetingText : null) %>;

  /* Persona (PNAME/PTITLE/PINIT/PCOL) is retained purely as internal
     session data for scoring/report generation — it is never rendered.
     The UI shows only the candidate and the System's own presence. */
  document.getElementById('sbRole').textContent   = ROLE  || '—';
  document.getElementById('sbLevel').textContent  = LEVEL || '—';

  /* ── Elapsed timer (topbar) + Est. remaining (sidebar) — both driven off
     the SAME real clock now. Previously "Est. remaining" was recomputed
     only from the question count (MAXQ-remaining * 180s) and never moved
     within a question, so it could show 9:00 remaining while the actual
     elapsed timer said 2:00 — the two numbers had nothing to do with each
     other. Now there's one 15:00 session budget and remaining = budget
     minus actual elapsed seconds, ticking every second like the timer. ── */
  var TOTAL_BUDGET_SEC = MAXQ * SEC_PER_Q; // 5 * 180s = 15:00 total
  var t0 = Date.now(), timerInt;
  function mmss(totalSeconds) {
    var s = Math.max(0, Math.floor(totalSeconds));
    return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
  }
  function tick() {
    var elapsed = Math.floor((Date.now()-t0)/1000);
    document.getElementById('timer').textContent = mmss(elapsed);
    document.getElementById('sbTimeRemaining').textContent = mmss(TOTAL_BUDGET_SEC - elapsed);
  }
  timerInt = setInterval(tick, 1000);
  tick();

  /* ── Server-owned session lifecycle management (bug fix, 2026-07-24) ──
     Heartbeat: refreshes last_activity_at server-side every 60s while
     this session is genuinely open, so requireInterviewEntitlement's
     auto-recovery (middleware/guards.js) never mistakes an in-progress
     interview for stale. Deliberately fire-and-forget — a missed
     heartbeat due to a transient network blip is fine; the timeout
     (config/plans.js SESSION_INACTIVITY_TIMEOUT_MINUTES, currently 10
     minutes) tolerates far more than one missed 60s ping. */
  var HEARTBEAT_INTERVAL_MS = 60000;
  function sendHeartbeat() {
    fetch('/api/interview/sessions/' + SID + '/heartbeat', { method: 'POST' })
      .catch(function (e) { console.warn('[heartbeat] failed (non-fatal, next tick will retry):', e); });
  }
  // URGENT FOLLOW-UP FIX (2026-07-24, same day): fire one immediately on
  // load, not just on the 60s interval. Without this, a genuinely-reached
  // session's last_activity_at stays at its creation-time default for up
  // to a full minute — indistinguishable from a failed launch attempt
  // that never reached this page at all (see SESSION_UNCONFIRMED_TIMEOUT_
  // MINUTES in config/plans.js). This confirms "really here" within
  // seconds instead.
  sendHeartbeat();
  var heartbeatInt = setInterval(sendHeartbeat, HEARTBEAT_INTERVAL_MS);

  /* Browser-closing signal: sent via sendBeacon (works reliably during
     page unload, unlike a normal fetch which browsers may cancel) so a
     candidate closing the tab mid-interview is recorded with a specific,
     real reason (abandoned_reason='browser_closed') rather than only
     being caught later by the generic heartbeat-timeout path. Best-effort
     by design — if it doesn't arrive, the heartbeat timeout still
     recovers the session correctly, just with a less specific reason. */
  function sendBrowserClosingBeacon() {
    try {
      if (navigator.sendBeacon) {
        navigator.sendBeacon('/api/interview/sessions/' + SID + '/browser-closing');
      }
    } catch (e) { /* best-effort — nothing to do if this throws */ }
  }
  window.addEventListener('pagehide', sendBrowserClosingBeacon);
  window.addEventListener('beforeunload', sendBrowserClosingBeacon);

  /* Follow-up state (feature, 2026-07-23) — whether the CURRENT turn on
     screen is a follow-up. Initialized from the server-rendered QTYPE (a
     reload/reconnect can land directly on a pending follow-up — server.js
     passes questionType: currentQ.question_type, which is exactly QTYPE
     here), then kept live by the response handler below on every
     subsequent turn. */
  window.MedhaIQ_IsFollowupTurn = (QTYPE === 'follow_up');

  function updateCounter() {
    document.getElementById('qCounter').textContent = 'Question '+QN+' / '+MAXQ;
    document.getElementById('qFollowupBadge').style.display = window.MedhaIQ_IsFollowupTurn ? '' : 'none';
    document.getElementById('sbProgNum').textContent = QN;
    var pct = Math.round(((QN-1)/MAXQ)*100);
    document.getElementById('sbProgFill').style.width = pct+'%';
    var remaining = Math.max(0, MAXQ - QN); // questions left AFTER current one
    document.getElementById('sbProgRemaining').textContent = remaining + (remaining===1?' question remaining':' questions remaining');
  }

  /* ── Debug console (staff-only, Ctrl+Shift+D) ── */
  var dbg = document.getElementById('debugConsole');
  document.addEventListener('keydown', function(e){
    if (e.ctrlKey && e.shiftKey && (e.key==='D'||e.key==='d')) dbg.classList.toggle('open');
  });
  document.getElementById('dbgClose').addEventListener('click', function(){ dbg.classList.remove('open'); });

  function slog(msg, type) {
    var el = document.getElementById('slogBody');
    var ts = new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    var cls= 'dbg-entry' + (type==='ok'?' ok':type==='err'?' err':type==='info'?' info':'');
    el.insertAdjacentHTML('afterbegin','<div class="'+cls+'">['+ts+'] '+msg+'</div>');
  }
  // FIX: slog() was declared with a plain `function` statement inside this
  // script's own (function(){...})() wrapper, so it was ONLY callable from
  // code inside this same closure — not from the separate Vapi/orchestrator
  // <script> block later in the page, which lives in its own IIFE. Every
  // slog(...) call added there (guard-block logging, instructNext
  // diagnostics, opening-question diagnostics) was silently a
  // ReferenceError waiting to happen, and it's exactly what crashed
  // instructNext(): the QN reference failed first (while building the log
  // message argument), before the call even reached slog itself — so slog's
  // own scope bug hadn't been hit yet, but it was there too. Exposing it on
  // window makes it safely callable from every script block on this page.
  window.slog = slog;

  var compScores = { system_design:0, leadership:0, strategy:0, communication:0, technical:0 };
  function updateCompetency(key, increment) {
    if (!(key in compScores)) return;
    compScores[key] = Math.min(100, compScores[key] + (increment || 20));
    var bar = document.getElementById('comp-'+key);
    var cnt = document.getElementById('compC-'+key);
    if (bar) bar.style.width = compScores[key]+'%';
    if (cnt) cnt.textContent = parseInt(cnt.textContent||0)+1;
  }

  /* ══ 5-Vector metrics — consumes the standardized IntelligenceMetrics
     schema: { overallScore, vectors:{...}, status, metadata:{...} } ══ */
  var runningScores = [];
  function updateMetrics(m) {
    if (!m || !m.vectors) return;
    runningScores.push(m);
    var v = m.vectors;
    // .hasOwnProperty style checks would be overkill here — these are
    // always-present numeric fields from the server — but the important
    // fix is using `?? 0` (nullish coalescing) instead of `|| 0`: `?? 0`
    // only substitutes when the value is null/undefined, so a genuine 0
    // passes straight through instead of being masked by a fallback that
    // happens to also be 0 (same value, but this makes the intent explicit
    // and safe against a future change to the fallback).
    [['mStar','mStarV', v.structure ?? 0], ['mTech','mTechV', v.technicalDepth ?? 0],
     ['mExec','mExecV', v.executivePresence ?? 0], ['mGcc','mGccV', v.gccReadiness ?? 0],
     ['mFric','mFricV', v.communicationClarity ?? 0]].forEach(function(r) {
      var val = Math.round(r[2]);
      var isZero = val === 0;
      var bar = document.getElementById(r[0]); var lbl = document.getElementById(r[1]);
      if (bar) {
        bar.classList.toggle('is-zero', isZero);
        // Always set width explicitly — 0 renders as empty bar (0% fill, track
        // background visible), never hidden. Immediate DOM update, no delay.
        bar.style.width = val + '%';
      }
      if (lbl) {
        lbl.textContent = val;
        lbl.classList.toggle('is-zero', isZero);
      }
    });
    if (m.metadata) {
      document.getElementById('advFiller').textContent    = m.metadata.fillerWords ?? '0';
      document.getElementById('advPace').textContent      = m.metadata.pace || '—';
      document.getElementById('advTone').textContent      = m.metadata.executiveTone || m.metadata.coherence || '—';
      document.getElementById('advCoherence').textContent = m.metadata.coherence || '—';
    }
    document.getElementById('dbgQid').textContent = QID;
    updateScoreRing(m.overallScore);
  }

  function updateScoreRing(latestOverall) {
    if (typeof latestOverall !== 'number') return;
    var total = runningScores.reduce(function(a,s){ return a+(s.overallScore||0); }, 0);
    var avg   = Math.round(total / runningScores.length);
    var CIRC  = 213; /* 2 * π * 34 */
    document.getElementById('ringFill').style.strokeDashoffset = CIRC - (CIRC*avg/100);
    var lbl = document.getElementById('ringLabel');
    lbl.textContent = avg;
    var tier = avg>=75?'high':avg>=55?'mid':'low';
    lbl.style.color = avg>=75?'#22c55e':avg>=55?'#f59e0b':'#ef4444';
    var STATUS_COPY = {
      high: ['Strong Performance', "You're demonstrating excellent leadership potential."],
      mid:  ['Solid Progress', 'A few more concrete results would sharpen this further.'],
      low:  ['Early Signal', 'Lean harder into STAR structure and quantified results.'],
    };
    var statusEl = document.getElementById('ringStatus');
    var subEl    = document.getElementById('ringStatusSub');
    if (statusEl) { statusEl.className = 'ring-status '+tier; statusEl.textContent = STATUS_COPY[tier][0]; }
    if (subEl)    subEl.textContent = STATUS_COPY[tier][1];
  }

  /* ══ STAR Progress — Tactical view ══
     Two sources feed the same four nodes:
     1) A real-time client-side regex pass, run on every keystroke, paints
        nodes as "active" (pulsing) the instant a STAR signal appears in
        the answer as it's being typed/spoken.
     2) The server's own computeStarProgress() (moved to
        services/star/star-engine.js in Phase 2A, 2026-07-24 — same
        function, same behavior, new file location), returned as
        `star_progress` on submit, is the source of truth and
        repaints the same nodes as solid "done" once the answer lands. */
  var STAR_ORDER = ['situation','task','action','result'];
  /* NOTE: these patterns are intentionally kept IDENTICAL to STAR_PATTERNS in
     services/star/star-engine.js (relocated there in Phase 2A, 2026-07-24 —
     previously services/interview.js) so the live view and the server
     verdict agree. If you edit one, edit both.
     TODO (future phase, NOT Phase 2A/2B): this hand-synced duplication is a
     known, documented architectural finding — a single shared STAR
     detection library consumable by both server and client (e.g. an
     isomorphic module bundled for the browser, or the client calling a
     lightweight endpoint instead of re-implementing the regex set) would
     close this risk structurally instead of by convention. Deliberately
     left as-is for this checkpoint, which is a pure, behavior-preserving
     relocation. */
  var STAR_PATTERNS = {
    situation: /\b(when i|at my (previous|last|current)|in my role|while (working|leading)|the (context|situation|background) was|we (were|had) facing|a few (months|years|weeks) ago|during|last (year|quarter|month|week)|in (19|20)\s?\d{2}|i was working (on|at|with)|we were (building|working|running|struggling)|at (a|an|the|our) (company|startup|client|firm)|(our|the|a) (customer|client)s? (wanted|needed|was (asking|looking)|had a)|we had a (customer|client))\b/i,
    task: /\b(my (task|responsibility|goal|objective|job)([^.]{0,25})? was|i was (responsible|asked|tasked|expected)|(we|i) need(ed)? to|had to (deliver|fix|solve|build|reduce|improve)|the (goal|objective|target|challenge|problem|ask) was|asked me to|i had to|(we|i) (had to|needed to) assess)\b/i,
    action: /\b(i (led|built|designed|redesigned|rebuilt|reimplemented|rearchitected|re-?architected|recreated|implemented|created|drove|decided|initiated|coordinated|proposed|negotiated|restructured|launched|rolled out|owned|developed|managed|organi[sz]ed|automated|migrated|deployed|fixed|resolved|refactored|presented|convinced|persuaded|established|introduced|analy[sz]ed|started|began|took|worked|ended up (redesigning|rebuilding|building|designing|creating))|i (was|am|'m)[\s,]*(uh|um|like)?[\s,]*(leading|building|designing|managing|driving|running|developing|creating|working on|coordinating|organi[sz]ing)|we (implemented|built|created|designed|redesigned|rebuilt|launched|migrated|deployed|developed|automated|redesigned|rolled out|restructured)|my approach was|so i\b|then i\b)/i,
    result: /\b(as a result|resulted in|which (led to|resulted)|(reduced|increased|improved|grew|cut|saved|boosted)[^.]{0,40}(\d+%|\$|percent)|the (outcome|impact) was|(we|i) (achieved|delivered)|ended up|in the end|leading to|\d+%|that'?s how (we|i) decided)\b/i,
  };
  function liveDetectStar(text) {
    var t = (text || '').toLowerCase();
    return {
      situation: STAR_PATTERNS.situation.test(t),
      task: STAR_PATTERNS.task.test(t),
      action: STAR_PATTERNS.action.test(t),
      result: STAR_PATTERNS.result.test(t),
    };
  }
  /* Human-readable labels for the note line */
  var STAR_LABELS = { situation:'Situation', task:'Task', action:'Action', result:'Result' };

  /* One small note line under the STAR nodes. Created once, on first use,
     right after the container that holds the Result node — no HTML/partial
     edits needed. */
  function getStarNote() {
    var el = document.getElementById('starSkipNote');
    if (el) return el;
    var anchor = document.getElementById('starNode-result');
    if (!anchor || !anchor.parentElement) return null;
    el = document.createElement('div');
    el.id = 'starSkipNote';
    el.className = 'star-skip-note';
    var host = anchor.parentElement.parentElement || anchor.parentElement;
    host.appendChild(el);
    return el;
  }

  /* Skip-aware painter.
     LIVE (finalized=false): a letter is flagged "skipped" the INSTANT a later
       letter is detected while it's still missing — e.g. Action lights up but
       Task never did → Task pulses amber immediately, mid-answer, while the
       candidate is still talking/typing. They can still fix it.
     FINAL (finalized=true, server verdict on submit): any letter still missing
       is flagged red "missed" — the answer is over, it's now a definitive gap.
       (If ALL four are missing — e.g. the question was skipped entirely — we
       don't paint four red nodes; the note simply says no structure detected.) */
  function paintStarProgress(progress, finalized) {
    progress = progress || {};
    var lastHitIdx = -1;
    STAR_ORDER.forEach(function(key, i) { if (progress[key]) lastHitIdx = i; });
    var anyHit = lastHitIdx > -1;
    var flagged = [];

    STAR_ORDER.forEach(function(key, i) {
      var node = document.getElementById('starNode-'+key);
      if (!node) return;
      var on = !!progress[key];
      var isSkipped = !on && !finalized && i < lastHitIdx;        // jumped past it, mid-answer
      var isMissed  = !on && !!finalized && anyHit;               // answer done, letter absent
      node.classList.toggle('done',   on && !!finalized);
      node.classList.toggle('active', on && !finalized);
      node.classList.toggle('skipped', isSkipped);
      node.classList.toggle('missed',  isMissed);
      if (isSkipped || isMissed) {
        flagged.push(STAR_LABELS[key]);
        node.title = STAR_LABELS[key] + (finalized ? ' was missing from this answer' : ' looks skipped — you can still add it');
      } else {
        node.removeAttribute('title');
      }
    });

    for (var i = 1; i <= 3; i++) {
      var a = STAR_ORDER[i-1], b = STAR_ORDER[i];
      var conn = document.getElementById('starConn-'+i);
      if (conn) conn.classList.toggle('done', !!(progress[a] && progress[b]));
    }

    var note = getStarNote();
    if (note) {
      if (finalized && progress.status === 'not_addressed') {
        note.textContent = '✕ Not Addressed — answer was too brief to evaluate for STAR structure';
        note.className = 'star-skip-note miss';
      } else if (flagged.length && !finalized) {
        note.textContent = '⚠ Skipped so far: ' + flagged.join(', ') + ' — try to cover it before you finish';
        note.className = 'star-skip-note warn';
      } else if (flagged.length && finalized) {
        note.textContent = '✕ This answer missed: ' + flagged.join(', ');
        note.className = 'star-skip-note miss';
      } else if (finalized && !anyHit) {
        note.textContent = 'No STAR structure detected in this answer';
        note.className = 'star-skip-note miss';
      } else if (finalized && lastHitIdx === 3 && flagged.length === 0 && progress.situation && progress.task && progress.action && progress.result) {
        note.textContent = '✓ Full STAR structure — all four components covered';
        note.className = 'star-skip-note ok';
      } else {
        note.textContent = '';
        note.className = 'star-skip-note';
      }
    }
  }
  function resetStarProgress() { paintStarProgress({}, false); }

  /* ══ AI Interview Status — always-visible calm state machine ══ */
  // Bug 3 fix: same states, same transitions, same pulse/ring/steps wiring
  // as before -- only the displayed title/sub text changed, to read like
  // a natural conversation rather than exposed internal AI states.
  var STATE_META = {
    PREPARING:        { title:'Getting ready…',      sub:'',                                   pulse:true,  ring:0.15, steps:[] },
    CALIBRATING:       { title:'Getting ready…',      sub:'',                                   pulse:true,  ring:0.25, steps:[] },
    LISTENING:         { title:'Your turn',           sub:'',                                   pulse:false, ring:0.4,  steps:['captured'] },
    ANALYZING:         { title:'One moment…',         sub:'',                                   pulse:true,  ring:0.75, steps:['captured','analyzing'] },
    GENERATING:        { title:'One moment…',         sub:'',                                   pulse:true,  ring:0.9,  steps:['captured','analyzing','preparing'] },
    READY:             { title:'Ready',              sub:'',                                   pulse:false, ring:1,    steps:['captured','analyzing','preparing'] },
    SESSION_COMPLETE:  { title:'All done',            sub:'',                                   pulse:false, ring:1,    steps:['captured','analyzing','preparing'] },
    GENERATING_REPORT: { title:'Preparing your results…', sub:'',                               pulse:true,  ring:0.95, steps:['captured','analyzing','preparing'] },
    FINISHED:          { title:'One moment…',         sub:'',                                   pulse:false, ring:1,    steps:['captured','analyzing','preparing'] },
  };
  var RING_CIRC = 220; /* 2 * π * 35 */
  var WORKING_STATES = { LISTENING:1, ANALYZING:1, GENERATING:1 };
  function setAIState(key) {
    var meta = STATE_META[key] || STATE_META.PREPARING;
    document.getElementById('aiStatusTitle').textContent = meta.title;
    document.getElementById('aiStatusSub').textContent   = meta.sub;
    var ring = document.getElementById('aiStatusRing');
    ring.style.strokeDashoffset = RING_CIRC - (RING_CIRC * meta.ring);
    ring.classList.toggle('pulsing', !!meta.pulse);
    var lastStep = meta.steps[meta.steps.length-1];
    document.querySelectorAll('#statusChecklist .status-item').forEach(function(el){
      var step = el.getAttribute('data-step');
      var included = meta.steps.indexOf(step) > -1;
      var isCurrent = included && step===lastStep && WORKING_STATES[key];
      el.classList.toggle('active', !!isCurrent);
      el.classList.toggle('done', included && !isCurrent);
    });
  }

  function showToast(overallScore) {
    var s = Math.round(overallScore||0);
    var el = document.getElementById('toastScore');
    el.textContent = s;
    el.className = 'toast-score '+(s>=75?'high':s>=55?'mid':'low');
    var t = document.getElementById('scoreToast');
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 4000);
  }

  /* ── Loading / question rendering ── */
  function showLoading(text) {
    document.getElementById('answerBarWrap') || null;
    document.querySelector('.answer-bar-wrap').style.display='none';
    document.getElementById('questionCard').style.display='none';
    document.getElementById('loadingOverlay').classList.add('show');
    document.getElementById('loadingText').textContent = text || 'Analysing...';
  }

  var QUESTION_WHY = {
    opening: 'This opening question establishes context and helps the AI calibrate follow-up depth.',
    behavioral: 'This evaluates your structure, ownership, and executive delivery under a real scenario.',
    drill_down: 'A deep-dive follow-up — the AI probes a gap or vague point from your last answer.',
  };

  function showQuestionMeta(q, type, competency) {
    // Defensive consolidation: updateCounter() also runs immediately when
    // a new question is fetched (in submitAnswer, right after QN++), but
    // it's called here too so the progress bar is GUARANTEED correct at
    // the exact moment any question — drill-down or not, voice or text —
    // actually gets painted, regardless of which code path got it there.
    // Calling it twice is harmless; it just re-renders the same numbers.
    updateCounter();

    document.getElementById('loadingOverlay').classList.remove('show');
    document.getElementById('questionCard').style.display='flex';
    document.querySelector('.answer-bar-wrap').style.display='block';

    var label = competency ? competency.replace(/_/g,' ').toUpperCase() : (type==='drill_down' ? 'DEEP DIVE' : 'BEHAVIORAL');
    document.getElementById('qEyebrow').textContent = window.MedhaIQ_IsFollowupTurn
      ? 'FOLLOW-UP · '+label
      : 'QUESTION '+QN+' OF '+MAXQ+' · '+label;
    var why = document.getElementById('qWhyText');
    why.textContent = QUESTION_WHY[type] || QUESTION_WHY.behavioral;
    why.classList.remove('shown');

    document.getElementById('answerInput').value = '';
    document.getElementById('charCount').textContent = '0 / 4000';
    document.getElementById('submitBtn').disabled = true;
    document.getElementById('submitBtn').classList.remove('show');
    document.getElementById('answerInput').focus();
    resetStarProgress();
    setAIState('LISTENING');
  }
  function showQuestionText(text) {
    document.getElementById('questionText').textContent = text;
  }
  function showQuestion(q, type, competency) {
    try { hashTrace('3_before_showQuestion', window.MedhaIQ_LastTurnId, q && q.id, q && q.text); }
    catch (e) { console.warn('[HASH-TRACE] stage 3 failed (non-fatal, instrumentation only):', e); }
    showQuestionMeta(q, type, competency);
    showQuestionText(q.text);
    // v2.4 — live snapshot for the voice handshake. The call-start handler
    // used to read a Q1 snapshot frozen at page load; if the candidate had
    // already advanced by text before voice connected, the AI then spoke a
    // STALE question that mismatched the card. Every question paint now
    // refreshes this, so voice always opens with the question on screen.
    window.MedhaIQ_CurrentQ = q.text;
  }
  window.MedhaIQ_showQuestionMeta = showQuestionMeta;
  window.MedhaIQ_showQuestionText = showQuestionText;

  document.getElementById('whyBtn').addEventListener('click', function(){
    document.getElementById('qWhyText').classList.toggle('shown');
  });

  /* ── Answer input ── */
  var answerInput = document.getElementById('answerInput');
  answerInput.addEventListener('input', function() {
    // DIAGNOSTIC (bug fix investigation, 2026-07-24) — added specifically
    // to root-cause the "live STAR indicators never activate" report.
    // Extensive investigation (isolated simulation of this exact listener
    // + liveDetectStar + paintStarProgress against real DOM structure,
    // full log trace) found the mechanism itself works correctly and
    // star_update_dispatched fires 1:1 with final_transcript_received in
    // the provided log (14/14, zero drops, zero JS errors). This log
    // line is the one thing static analysis couldn't confirm: whether
    // THIS listener is actually the one that fires when the voice
    // dispatch's synthetic 'input' event lands, in the real browser, in
    // the real session. If this log is present in the next session's
    // trace whenever star_update_dispatched also appears, the mechanism
    // is confirmed working end-to-end and the reported symptom has a
    // different cause (most likely worth re-checking after Issue #3's
    // fix, since a live second conversational agent competing for the
    // candidate's attention/timing could easily be perceived as "STAR
    // isn't reacting" even when the DOM is, in fact, updating correctly).
    // Remove once confirmed either way.
    window.timelineLog && window.timelineLog('star_listener_fired', (typeof currentSpokenQuestionId !== 'undefined' ? currentSpokenQuestionId : null), true, 'inputLength=' + this.value.length);
    document.getElementById('charCount').textContent = this.value.length+' / 4000';
    var hasText = !!this.value.trim();
    document.getElementById('submitBtn').disabled = !hasText;
    document.getElementById('submitBtn').classList.toggle('show', hasText);
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 140)+'px';
    paintStarProgress(liveDetectStar(this.value), false);
    logStarDetection(this.value, 'typed');
  });

  // TEMPORARY INSTRUMENTATION (Priority 0.5 validation request) --
  // remove after validation is complete. Logs exactly the requested
  // fields for every significant transcript update. "Confidence" is
  // reported honestly as detected-elements/4 (a simple proxy; no other
  // confidence metric currently exists in this pipeline). "Live Score"
  // is reported as N/A with an explicit note -- confirmed via direct
  // code trace that the Overall Intelligence Score does NOT update
  // during an answer, only after that question is submitted and scored
  // by the server (see updateMetrics()/updateScoreRing(), called only
  // from the answer-submission response handler). This instrumentation
  // does not fabricate a live score that doesn't exist.
  function logStarDetection(text, source) {
    var progress = liveDetectStar(text);
    var detectedCount = ['situation', 'task', 'action', 'result'].filter(function (k) { return progress[k]; }).length;
    console.log('[STAR-DETECTION]\n'
      + 'source=' + source + '\n'
      + 'Transcript Length: ' + (text || '').length + '\n'
      + 'Situation: ' + progress.situation + '\n'
      + 'Task: ' + progress.task + '\n'
      + 'Action: ' + progress.action + '\n'
      + 'Result: ' + progress.result + '\n'
      + 'Confidence: ' + detectedCount + '/4\n'
      + 'Live Score: N/A (does not update until this question is submitted -- confirmed, not a bug being masked here)');
  }

  document.getElementById('submitBtn').addEventListener('click', function(){ submitAnswer(false); });
  document.getElementById('skipBtn').addEventListener('click', function(){ submitAnswer(true); });

  /* Hard re-entrancy guard. Previously only submitBtn was disabled while a
     request was in flight — skipBtn had no lock at all, so an impatient
     candidate clicking "Skip" repeatedly during a slow AI scoring/next-
     question call could fire 2-3 overlapping POSTs. Each one independently
     read "answeredCount" before any of the others had saved, so more than
     MAXQ questions could get created and the session would run to 6/5, 7/5,
     etc. instead of ending at 5. isSubmitting blocks that at the source,
     regardless of which control the candidate mashes. */
  var isSubmitting = false;

  // Item 2 (rotating acknowledgements): a small natural-sounding set,
  // picked randomly but never the same phrase twice in a row -- avoids
  // the "Understood, let's move on" sounding robotic by the third skip.
  var SKIP_ACK_PHRASES = [
    "Alright, let's continue.",
    "That's fine. Let's move to the next question.",
    "We'll come back to that later. Here's the next one.",
    "No problem. Let's keep going.",
    "Let's move ahead.",
    "That's okay. Here's your next question."
  ];
  var _lastSkipAckIndex = -1;
  function pickSkipAcknowledgement() {
    if (SKIP_ACK_PHRASES.length <= 1) return SKIP_ACK_PHRASES[0];
    var idx;
    do { idx = Math.floor(Math.random() * SKIP_ACK_PHRASES.length); } while (idx === _lastSkipAckIndex);
    _lastSkipAckIndex = idx;
    return SKIP_ACK_PHRASES[idx];
  }

  // ROOT CAUSE FIX (Bug 1, "silent transition"): confirmed via direct log
  // trace that acknowledgement was ONLY ever spoken on the skip path --
  // a genuine answer submission went straight from CandidateTurnComplete
  // -> AUTO-SUBMIT -> backend -> next question with nothing in between.
  // Same rotating-phrase mechanism, same one-line-in-the-list rule,
  // exactly the phrases requested: short, never repeated consecutively,
  // no verbal evaluation of the answer.
  var ANSWER_ACK_PHRASES = ['Got it.', 'Thanks.', 'Understood.', 'Makes sense.', 'Thank you.'];
  var _lastAnswerAckIndex = -1;
  function pickAnswerAcknowledgement() {
    if (ANSWER_ACK_PHRASES.length <= 1) return ANSWER_ACK_PHRASES[0];
    var idx;
    do { idx = Math.floor(Math.random() * ANSWER_ACK_PHRASES.length); } while (idx === _lastAnswerAckIndex);
    _lastAnswerAckIndex = idx;
    return ANSWER_ACK_PHRASES[idx];
  }

  async function submitAnswer(skip) {
    // TEMPORARY DEBUG LOGGING ONLY -- no behavior change. Placed before
    // the existing isSubmitting guard so both a call that proceeds AND
    // one that gets blocked by it are equally visible; wasAlreadyInFlight
    // is read BEFORE isSubmitting is set below, so it reflects the true
    // state at the moment THIS call started, not after.
    window._submitAnswerRequestId = (window._submitAnswerRequestId || 0) + 1;
    var _thisRequestId = window._submitAnswerRequestId;
    var _wasAlreadyInFlight = isSubmitting;
    console.log('[SUBMIT-TRACE] requestId=' + _thisRequestId + ' questionId=' + QID + ' timestamp=' + Date.now() + ' wasAlreadyInFlight=' + _wasAlreadyInFlight + (_wasAlreadyInFlight ? ' -- WILL BE BLOCKED by isSubmitting guard below' : ' -- will proceed'));

    if (isSubmitting) return;
    isSubmitting = true;
    // Immediately silence any in-progress assistant speech — applies to
    // both Skip and a normal answer submission, since either action means
    // we're moving on and any speech still playing for the OLD question
    // should stop now, not finish on its own. Fail-safe: no-ops if the
    // bridge function isn't available for any reason.
    if (window.VOICE_PIPELINE_MODE === 'tts_pipeline' && window.questionSpeechService) {
      try {
        window.questionSpeechService.stop();
        // THE FIX: QuestionSpeechService.stop() only manages its own token +
        // tells BrowserAudioPlayer to stop -- it has no way to reach into
        // InterviewVoiceController. BrowserAudioPlayer.stop() deliberately
        // never fires 'ended' (that's what makes stop() a real, synchronous
        // guarantee), so onFinished never fires either. Without this call,
        // speechState stays stuck at SPEAKING after any skip/submit that
        // happens mid-utterance, and every subsequent notify() silently
        // queues instead of speaking. Mirrors exactly what the legacy
        // path's silenceCurrentSpeech() already does.
        window.InterviewVoiceController.onIntentionalCancel();

        // Item 1 fix: speak the skip acknowledgement immediately, as its
        // own standalone utterance, instead of waiting for it to arrive
        // as a text prefix on the NEXT question (the old behavior) --
        // which could only be heard once the entire next question had
        // been generated AND synthesized, sometimes several seconds
        // later. Calling speak() directly here (not through notify())
        // is intentional and safe: QuestionSpeechService's own token
        // guard already ensures whichever request is newest wins, so
        // this acknowledgement is cleanly superseded/cut off the moment
        // the real next question is ready to speak -- no extra
        // plumbing needed for that to work correctly.
        if (skip) {
          try {
            // Item 3: the final question deserves a real wrap-up, not a
            // "let's move on" that implies another question is coming.
            // QN/MAXQ are already tracked client-side (same scope as
            // submitAnswer), so we know this before the backend even
            // responds -- no need to wait for data.sessionEnded to decide
            // what to say.
            var isFinalQuestion = (QN >= MAXQ);
            var ackText = isFinalQuestion
              ? "That's the final question. I'll prepare your report now."
              : pickSkipAcknowledgement();
            // TEMPORARY DEBUG FIELD (ElevenLabs usage investigation):
            // 'reason' is pure diagnostic metadata for the console logs
            // below -- never read or branched on anywhere else, so this
            // does not change any business logic.
            window.questionSpeechService.speak({ text: ackText, questionId: 'skip-ack', turnId: null, reason: isFinalQuestion ? 'closing' : 'skip' });
          } catch (e) { console.warn('[VoicePipeline] skip acknowledgement failed (non-fatal):', e); }
        } else {
          // ROOT CAUSE FIX (Bug 1): a genuine answer also gets a short
          // acknowledgement before the next question -- previously this
          // branch did nothing at all, confirmed via log trace. Same
          // "final question" override as skip, since a genuine last
          // answer also deserves the wrap-up rather than "Got it."
          try {
            var _isFinalAnswer = (QN >= MAXQ);
            var _answerAckText = _isFinalAnswer
              ? "That's the final question. I'll prepare your report now."
              : pickAnswerAcknowledgement();
            window.questionSpeechService.speak({ text: _answerAckText, questionId: 'answer-ack', turnId: null, reason: _isFinalAnswer ? 'closing' : 'acknowledgement' });
          } catch (e) { console.warn('[VoicePipeline] answer acknowledgement failed (non-fatal):', e); }
        }
      } catch (e) { console.warn('[VoicePipeline] stop() on submit failed (non-fatal):', e); }
    } else if (typeof window.MedhaIQ_silenceCurrentSpeech === 'function') {
      try { window.MedhaIQ_silenceCurrentSpeech(); } catch (e) { console.warn('[Vapi] silence-on-submit failed (non-fatal):', e); }
    }
    var ans = skip ? '' : answerInput.value.trim();
    if (!skip && !ans) { isSubmitting = false; return; }
    document.getElementById('submitBtn').disabled = true;
    document.getElementById('skipBtn').disabled = true;
    setAIState('ANALYZING');
    showLoading('Analyzing your response...');
    slog('Q'+QN+' submitted — AI scoring...','info');
    try {
      console.log('[SUBMIT-TRACE] requestId=' + _thisRequestId + ' questionId=' + QID + ' NETWORK CALL STARTING at ' + Date.now());
      var resp = await fetch('/api/interview/sessions/'+SID+'/answer', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ questionId: QID, answerText: ans, skip: skip }),
      });
      var data = await resp.json();
      console.log('[SUBMIT-TRACE] requestId=' + _thisRequestId + ' questionId=' + QID + ' NETWORK CALL RESOLVED at ' + Date.now() + ' status=' + resp.status + ' error=' + (data && data.error) + ' sessionEnded=' + (data && data.sessionEnded));
      if (resp.status === 409 && data.duplicate) {
        // A duplicate/raced submission for a question that's already been
        // answered — expected now and then if a click slipped through
        // before the button disabled. The winning request already advanced
        // the session normally, so there's nothing new to render — but we
        // MUST still unfreeze this losing request's UI, or the candidate is
        // stuck on "Analyzing..." forever with dead Skip/End buttons.
        slog('Duplicate submission ignored (already answered)', 'info');
        document.getElementById('loadingOverlay').classList.remove('show');
        document.getElementById('questionCard').style.display='flex';
        document.querySelector('.answer-bar-wrap').style.display='block';
        document.getElementById('submitBtn').disabled = false;
        document.getElementById('skipBtn').disabled = false;
        return;
      }
      if (!resp.ok) throw new Error(data.error || 'Server error '+resp.status);

      // The server now ALWAYS returns real intelligence_scores/star_progress
      // — including an explicit all-zero set for skip — so the dashboard
      // updates immediately and visibly every time, instead of silently
      // doing nothing on skip (which used to leave the bars wherever they
      // last were, making it look like nothing had been recorded).
      if (data.intelligence_scores) {
        updateMetrics(data.intelligence_scores);
        showToast(data.intelligence_scores.overallScore);
        slog('Scored: '+Math.round(data.intelligence_scores.overallScore)+'/100','ok');
      }
      if (data.star_progress) {
        paintStarProgress(data.star_progress, true);
        slog('STAR detected: '+data.star_progress.stepsComplete+'/4 components','info');
      }
      if (data.competency_tag) updateCompetency(data.competency_tag, 20);

      setAIState('GENERATING');

      if (data.turnId) slog('[turn-trace] TURN_ID='+data.turnId+' Frontend received: QuestionId='+(data.question ? data.question.id : QID), 'info');
      window.timelineLog('backend_generated_question', (data.question ? data.question.id : QID), !!(data.text || data.question), 'sessionEnded=' + !!data.sessionEnded);
      window.MedhaIQ_LastTurnId = data.turnId || null; // diagnostic correlation only — read by stage 3, which has no turnId parameter of its own
      try { hashTrace('2_frontend_json_parsed', data.turnId, data.question ? data.question.id : QID, data.text || (data.question ? data.question.text : '')); }
      catch (e) { console.warn('[HASH-TRACE] stage 2 failed (non-fatal, instrumentation only):', e); }
      try {
      if (DEBUG_HASH_TRACE) {
        var _flagLine = '[HASH-TRACE] stage=2_response_flags turnId=' + (data.turnId || 'null')
          + ' validationFailed=' + (data.validationFailed === undefined ? 'undefined' : data.validationFailed)
          + ' sessionEnded=' + (data.sessionEnded === undefined ? 'undefined' : data.sessionEnded)
          + ' question_type=' + (data.question && data.question.type !== undefined ? data.question.type : 'undefined')
          + (data.skip !== undefined ? ' skip=' + data.skip : '');
        console.log(_flagLine);
        if (typeof slog === 'function') slog(_flagLine, 'info');
      }
      } catch (e) { console.warn('[HASH-TRACE] stage 2 flags failed (non-fatal, instrumentation only):', e); }

      if (data.sessionEnded) {
      clearInterval(timerInt);
      setAIState('GENERATING_REPORT');
      slog('Session complete — generating report...','ok');
      showLoading('Generating your Career Intelligence Report...');

      // Item 3 fix: the old fixed-delay guess ("wait 5.5 seconds so Vapi
      // can say goodbye") was tuned for vapi.say()'s low-latency, in-call
      // speech -- it has no idea tts_pipeline exists, and we've directly
      // measured ElevenLabs synthesis alone taking several seconds, plus
      // playback time on top. A fixed guess navigates away and destroys
      // the whole JS context (audio included) whenever the real timing
      // runs longer than the guess. Wait for the actual QuestionSpeechService
      // completion signal instead, with a generous safety-timeout backstop
      // (same defensive pattern QuestionSpeechService's own speak-timeout
      // already uses) in case something never fires.
      if (window.VOICE_PIPELINE_MODE === 'tts_pipeline' && window.questionSpeechService) {
        var _redirected = false;
        var _redirectNow = function () {
          if (_redirected) return;
          _redirected = true;
          window.location.href = '/interview/report/' + data.reportId;
        };
        if (!window.aiIsSpeaking) {
          // Nothing is actually playing right now -- no reason to wait at all.
          _redirectNow();
        } else {
          window.questionSpeechService.onFinished(_redirectNow);
          window.questionSpeechService.onPlaybackError(_redirectNow); // don't strand the candidate on a black screen if TTS fails right at the end
          setTimeout(_redirectNow, 15000); // safety backstop -- should not normally fire
        }
      } else {
        // Legacy path: unchanged fixed-delay behavior.
        var redirectDelay = window.MedhaIQVoiceLive ? 5500 : 2200;
        setTimeout(function(){ window.location.href='/interview/report/'+data.reportId; }, redirectDelay);
      }
      return; // isSubmitting intentionally stays true — page is navigating away
    }

      // FIX 1 — validationFailed (sparse-answer reprompt): this is the SAME
      // question asked again with a request for more detail. It must NEVER
      // advance QID or QN — previously this fell through to the generic
      // "new question" handling below and incorrectly counted as progress.
      if (data.validationFailed) {
        slog('[turn-trace] TURN_ID='+data.turnId+' UI rendering REPROMPT (no advance): QuestionId='+QID, 'info');
        var repromptQ = { text: data.text, type: 'reprompt', id: QID, order: (data.question ? data.question.order : undefined) };
        pendingAudioUrl = data.audio_url || null;
        MedhaIQSync.hold(repromptQ, 'reprompt', data.competency_tag, skip, data.turnId);
        slog('Q'+QN+' — please expand (not a new question)','info');
        return;
      }

      // FIX 2 — follow-up questions do not count toward the 5-question
      // progress counter. QID still advances (it IS a new question/turn),
      // but QN must not — previously this incremented unconditionally for
      // every response type, including follow_up.
      QID = data.question.id;
      window.MedhaIQ_IsFollowupTurn = (data.question.type === 'follow_up'); // feature, 2026-07-23 — drives the topbar Follow-up badge
      if (data.question.type !== 'follow_up') {
        QN = Math.min(QN + 1, MAXQ); // clamp — never display past MAXQ even if something upstream misbehaves
      }
      updateCounter();
      var nextQ = { text: data.text || data.question.text, type: data.question.type, id: data.question.id, order: data.question.order };
      pendingAudioUrl = data.audio_url || null;
      window.MedhaIQ_SessionAdvanced = true; // voice connecting late must not re-open from Q1
      slog('[turn-trace] TURN_ID='+data.turnId+' UI rendering ('+data.question.type+'): QuestionId='+data.question.id, 'info');
      MedhaIQSync.hold(nextQ, data.question.type, data.competency_tag || data.question.competency, skip, data.turnId);
      slog('Q'+QN+' ready','info');
    } catch (err) {
      console.error('[MedhaIQ]', err);
      slog('ERROR: '+err.message, 'err');
      document.getElementById('loadingOverlay').classList.remove('show');
      document.getElementById('questionCard').style.display='flex';
      document.querySelector('.answer-bar-wrap').style.display='block';
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('skipBtn').disabled = false;
      alert('Error: '+err.message);
    } finally {
      isSubmitting = false;
      document.getElementById('skipBtn').disabled = false;
    }
  }

  /* ── End session ── */
  document.getElementById('endBtn').addEventListener('click', async function(){
    if (!confirm('End this session? Your progress cannot be resumed.')) return;
    clearInterval(timerInt);
    clearInterval(heartbeatInt);
    try { await fetch('/api/interview/sessions/'+SID, { method:'DELETE' }); } catch(e){}
    window.location.href = '/dashboard/history';
  });

  /* ── Live Terminal — always expanded, no toggle needed ── */
  // Terminal content stays permanently visible; toggle removed per UX spec.

  /* ── Initialise ── */
  updateCounter();
  setAIState('CALIBRATING');
  if (INITQ) {
    // v2.0 CALIBRATION GATE (cold-start desync fix): with voice configured,
    // the question card stays hidden behind a "Calibrating Interviewer
    // Persona…" loader until Vapi certifies `call-start` (which also injects
    // the sessionReadyContext — see the Vapi block). A hard 8s fallback
    // reveals the question regardless, so no candidate is ever stuck.
    // Text-only sessions (no Vapi keys) reveal instantly, exactly as before.
    window.MedhaIQ_Q1 = INITQ; // read by the Vapi call-start handshake
    var HASVOICE = Boolean('<%= vapiPublicKey %>' && '<%= vapiAssistantId %>');
    window.MedhaIQ_HasVoice = HASVOICE; // read by the separate Vapi script block below (different IIFE scope)
    // ── FEATURE FLAG — set to false to disable all diagnostic hash-trace
  // logging cleanly, with no other code changes. window.MedhaIQ_hashTrace
  // and window.MedhaIQ_vapiPathTrace both become silent no-ops when off.
  var DEBUG_HASH_TRACE = true;
  window.MedhaIQ_DEBUG_HASH_TRACE = DEBUG_HASH_TRACE;

  // ── HASH-TRACE shared helper — diagnostic only, no behavior change.
  // Computes SHA-256 via the browser's native Web Crypto API and logs a
  // single, greppable line (now including payload length, computed
  // synchronously — no need to wait on the digest for that part).
  // Deliberately fire-and-forget (never awaited by any caller): the
  // functions being instrumented (showQuestion, instructNext, vapi.say)
  // must run at their normal, unmodified speed — the hash is computed and
  // logged slightly after the fact, in the background, correlated by
  // turnId/questionId rather than by blocking anything to log
  // synchronously.
  function hashTrace(stage, turnId, questionId, text, extra) {
    if (!DEBUG_HASH_TRACE) return;
    try {
      var t = String(text || '');
      var enc = new TextEncoder().encode(t);
      crypto.subtle.digest('SHA-256', enc).then(function(buf) {
        var hex = Array.from(new Uint8Array(buf)).map(function(b){ return b.toString(16).padStart(2,'0'); }).join('');
        var line = '[HASH-TRACE] stage=' + stage + ' turnId=' + (turnId || 'null') + ' questionId=' + (questionId === undefined || questionId === null ? 'null' : questionId) + ' len=' + t.length + ' first80=' + JSON.stringify(t.slice(0, 80)) + ' sha256=' + hex + (extra ? ' ' + extra : '');
        console.log(line);
        if (typeof slog === 'function') slog(line, 'info');
      }).catch(function(e){ console.error('[HASH-TRACE] hash failed', e); });
    } catch (e) { console.error('[HASH-TRACE] hashTrace threw', e); }
  }
  window.MedhaIQ_hashTrace = hashTrace;

  // Logs which speech mechanism actually fired — say() (forced, reliable),
  // fallback add-message (LLM-mediated, unreliable), or any other path —
  // at the exact moment it's chosen. No-ops when the flag is off.
  function vapiPathTrace(stage, turnId, questionId, path) {
    if (!DEBUG_HASH_TRACE) return;
    var line = '[HASH-TRACE] stage=' + stage + ' turnId=' + (turnId || 'null') + ' questionId=' + (questionId === undefined || questionId === null ? 'null' : questionId) + ' vapi_path=' + path;
    console.log(line);
    if (typeof slog === 'function') slog(line, path === 'vapi.say' ? 'ok' : 'err');
  }
  window.MedhaIQ_vapiPathTrace = vapiPathTrace;

  var revealQ1 = function(){ showQuestion({text:INITQ}, QTYPE, null); };
    // ── REDESIGN — no sequential waits. Every prior version of this block
    // GATED Q1's reveal behind a calibration overlay, waiting up to 8-15s
    // for voice to certify (or its own fallback timer) before the
    // candidate could see or answer anything. That's precisely backwards
    // from how every OTHER question in this app already works:
    // MedhaIQSync.hold() (used for Q2 onward — see ~line 146) reveals the
    // question text IMMEDIATELY and unconditionally, and only ATTEMPTS
    // voice as an independent addition alongside it — never a
    // precondition. Q1 now follows that exact same pattern instead of a
    // special-cased blocking one. The candidate can read and start
    // answering Q1 the instant the page loads, regardless of whether
    // voice is configured, connecting, slow, or never connects at all.
    // No overlay, no fallback timer, no calibration gate of any kind.
    revealQ1();
  }
  slog('Session #'+SID+' initialised', 'ok');
  slog('Persona (internal): '+PNAME, 'info'); /* debug-console only, never shown in candidate UI */
  slog('Role: '+ROLE+' | Level: '+LEVEL);
  window.MedhaIQ_log = slog; /* exposed for the Vapi block below */
  window.MedhaIQ_setAIState = setAIState;
  /* Exposed so the Vapi block can pulse STAR nodes live WHILE the candidate
     is mid-sentence (using partial speech transcripts that we deliberately do
     NOT write into the answer box — only finalized phrases get written). */
  window.MedhaIQ_liveStar = function(text){
    paintStarProgress(liveDetectStar(text), false);
    logStarDetection(text, 'voice');
  };
  /* Voice intents (Bug fix: frozen counter on spoken "skip"). These call the
     EXACT same submitAnswer used by the on-screen buttons, so the question
     counter, server-side answeredCount, scoring, and session-end logic all
     advance identically whether the candidate clicks or speaks. */
  window.MedhaIQ_requestSkip   = function(){ submitAnswer(true);  };
  window.MedhaIQ_requestSubmit = function(){ submitAnswer(false); };
})();
</script>

<!-- ═══════════════════════════════════════════════════════════════
     WEBCAM — unchanged behaviour, restyled container only.
═══════════════════════════════════════════════════════════════ -->
<script>
(function(){
  var video    = document.getElementById('camVideo');
  var ph       = document.getElementById('camPlaceholder');
  var badge    = document.getElementById('camBadge');
  var badgeTxt = document.getElementById('camBadgeText');
  var toggle   = document.getElementById('camToggle');
  var stream   = null, on = false;

  async function startCam(){
    try{
      stream=await navigator.mediaDevices.getUserMedia({video:true,audio:false});
      video.srcObject=stream; video.style.display='block';
      ph.style.display='none';
      badge.classList.remove('off'); badgeTxt.textContent='● LIVE';
      toggle.textContent='Disable Camera';
      on=true;
    }catch(e){
      badgeTxt.textContent='BLOCKED';
      console.warn('[cam]',e.message);
    }
  }
  function stopCam(){
    if(stream){stream.getTracks().forEach(function(t){t.stop();}); stream=null;}
    video.style.display='none'; ph.style.display='flex';
    badge.classList.add('off'); badgeTxt.textContent='CAM OFF';
    toggle.textContent='Enable Camera';
    on=false;
  }
  toggle.addEventListener('click',function(){ if(!on)startCam(); else stopCam(); });
  setTimeout(startCam, 1400);
})();
</script>

<!-- ═══════════════════════════════════════════════════════════════
     VAPI VOICE STATE MACHINE — now driving a single inline mic
     button instead of a standalone panel button. Fixes the desync
     via MedhaIQSync (defined in the main engine script above).

     IMPORTANT CAVEAT (read before assuming this is 100% closed):
     `vapi.send({ type: 'add-message', ... })` is the documented way to
     hand Vapi's assistant a mid-call instruction, and the transcript
     listener below is the documented shape for its own spoken output.
     Both depend on how the assistant itself is configured on the Vapi
     dashboard (VAPI_ASSISTANT_ID) — if that assistant's own system
     prompt tells it to freelance rather than follow instructions handed
     to it mid-call, it can still say something different from what we
     asked it to. What this code guarantees is narrower but real: the
     text on screen will always match Vapi's own transcript of what it
     actually said — never a separate guess generated by our backend.
═══════════════════════════════════════════════════════════════ -->
<script>
(function(){
  // ── FAIL-SAFE diagnostic wrappers (bug fix) — hashTrace()/vapiPathTrace()
  // live in a DIFFERENT script block than every call site in this one.
  // These wrappers read the window-exposed versions and are guaranteed to
  // never throw, regardless of whether those functions exist, are still
  // loading, or ever fail internally. Instrumentation must never be able
  // to stop production logic — this is the enforcement point for that.
  function safeHashTrace() {
    try {
      if (typeof window.MedhaIQ_hashTrace === 'function') window.MedhaIQ_hashTrace.apply(null, arguments);
    } catch (e) { console.warn('[HASH-TRACE] safeHashTrace failed (non-fatal, instrumentation only):', e); }
  }
  function safeVapiPathTrace() {
    try {
      if (typeof window.MedhaIQ_vapiPathTrace === 'function') window.MedhaIQ_vapiPathTrace.apply(null, arguments);
    } catch (e) { console.warn('[HASH-TRACE] safeVapiPathTrace failed (non-fatal, instrumentation only):', e); }
  }

  var VKEY = '<%= vapiPublicKey %>';
  var VAST = '<%= vapiAssistantId %>';

  // Silences the assistant's current speech IMMEDIATELY by locally
  // unsubscribing from their audio track — does not end the call, does
  // not depend on any say() parameter (confirmed not present in this
  // build). Fully defensive: any missing method/unexpected shape just
  // means this silently no-ops.
  function silenceCurrentSpeech() {
    try {
      if (!vapi || !vapi.call || typeof vapi.call.participants !== 'function'
          || typeof vapi.call.updateParticipant !== 'function') return;
      var parts = vapi.call.participants();
      if (!parts) return;
      Object.keys(parts).forEach(function(key) {
        var p = parts[key];
        if (p && !p.local) {
          try { vapi.call.updateParticipant(p.session_id, { setSubscribedTracks: { audio: false } }); }
          catch (e) { console.warn('[Vapi] silenceCurrentSpeech: updateParticipant failed (non-fatal):', e); }
        }
      });
      // INTENTIONAL CANCEL: release the controller's gate immediately --
      // do not wait for a speech-end that this forced local mute may
      // never cleanly emit. Without this, a queued request from the
      // next question could stay stuck indefinitely.
      InterviewVoiceController.onIntentionalCancel();
      slog('[Vapi] Current speech silenced locally (skip/submit)', 'info');
    } catch (e) { console.warn('[Vapi] silenceCurrentSpeech failed (non-fatal, no behavior change):', e); }
  }
  window.MedhaIQ_silenceCurrentSpeech = silenceCurrentSpeech;

  // Vapi has no supported platform-level "transcription only" assistant
  // mode (Model/Transcriber/Voice are always co-present per Vapi's own
  // docs) -- prompting the assistant into silence cannot guarantee true
  // silence, only ask for it, which is exactly what produced "I'm only
  // a transcriber..." being spoken aloud. This is the actual, hard
  // guarantee: permanently refuse to receive the assistant's remote
  // audio track at all, for the entire tts_pipeline session, regardless
  // of what the Model generates or the Voice would have said. Unlike
  // silenceCurrentSpeech() (per-question, later re-subscribed via
  // resumeAudioSubscription()), this is called ONCE at call-start and
  // never undone -- tts_pipeline never needs to hear Vapi at all.
  function permanentlyMuteVapiAssistantAudio(callerContext) {
    window._muteInvocationCount = (window._muteInvocationCount || 0) + 1;
    var invocationId = window._muteInvocationCount;
    console.log('[MUTE-CALL] invocation #' + invocationId + ' triggered by: ' + (callerContext || '(unspecified)') + ' at ' + Date.now());
    try {
      if (!vapi || !vapi.call || typeof vapi.call.participants !== 'function'
          || typeof vapi.call.updateParticipant !== 'function') {
        console.log('[MUTE-CALL] invocation #' + invocationId + ' aborted -- vapi.call/participants/updateParticipant not available yet');
        return;
      }
      var parts = vapi.call.participants();
      if (!parts) {
        console.log('[MUTE-CALL] invocation #' + invocationId + ' aborted -- participants() returned nothing');
        return;
      }
      var allSessionIds = Object.keys(parts).map(function (k) {
        var p = parts[k];
        return (p ? (p.session_id + (p.local ? ' (local)' : ' (remote)')) : k);
      });
      console.log('[MUTE-CALL] invocation #' + invocationId + ' sees ' + allSessionIds.length + ' participant(s): ' + JSON.stringify(allSessionIds));
      var mutedAny = false;
      Object.keys(parts).forEach(function(key) {
        var p = parts[key];
        if (p && !p.local) {
          try {
            vapi.call.updateParticipant(p.session_id, { setSubscribedTracks: { audio: false } });
            mutedAny = true;
            console.log('[MUTE-CALL] invocation #' + invocationId + ' -- updateParticipant(audio:false) applied to session_id=' + p.session_id);
            console.log('[STT]\nvapi_assistant_audio_permanently_muted\n(tts_pipeline mode -- browser will never receive this track regardless of Model/Voice activity, session_id=' + p.session_id + ')');
          } catch (e) { console.warn('[Vapi] permanentlyMuteVapiAssistantAudio: updateParticipant failed (non-fatal):', e); }
        }
      });
      if (!mutedAny) {
        console.log('[MUTE-CALL] invocation #' + invocationId + ' -- NO remote participant found to mute (this is the exact race condition window if the assistant joins right after this)');
      }
    } catch (e) { console.warn('[Vapi] permanentlyMuteVapiAssistantAudio failed (non-fatal, no behavior change):', e); }
  }

  // Re-subscribes to the assistant's audio so the NEXT question is
  // actually audible. Called right before every subsequent vapi.say().
  function resumeAudioSubscription() {
    try {
      if (!vapi || !vapi.call || typeof vapi.call.participants !== 'function'
          || typeof vapi.call.updateParticipant !== 'function') return;
      var parts = vapi.call.participants();
      if (!parts) return;
      Object.keys(parts).forEach(function(key) {
        var p = parts[key];
        if (p && !p.local) {
          try { vapi.call.updateParticipant(p.session_id, { setSubscribedTracks: { audio: true } }); }
          catch (e) { console.warn('[Vapi] resumeAudioSubscription: updateParticipant failed (non-fatal):', e); }
        }
      });
    } catch (e) { console.warn('[Vapi] resumeAudioSubscription failed (non-fatal, no behavior change):', e); }
  }
  window.MedhaIQ_resumeAudioSubscription = resumeAudioSubscription;

  var btn = document.getElementById('vapiBtn');
  var sub = document.getElementById('vapiSub');
  var slog = window.MedhaIQ_log || function(){};

  if(!VKEY||!VAST){ btn.disabled = true; btn.style.opacity='0.4'; sub.textContent='Voice not configured — add VAPI keys in Render'; return; }

  // ── PR3: voice playback pipeline selection ──
  // window.VOICE_PIPELINE_MODE and window.questionSpeechService are
  // already set (see the small <script> block right after voice-client-
  // config.js loads, above) -- NOT re-declared here. A bare `var` here
  // would be local to THIS IIFE only and invisible to submitAnswer(),
  // which lives in a separate, sibling IIFE. That was the exact bug.
  if (window.VOICE_PIPELINE_MODE === 'tts_pipeline') {
    try {
      var _voiceClientConfig = (window.MedhaIQVoice && window.MedhaIQVoice.VOICE_CLIENT_CONFIG) || {};
      var _ttsAdapter = new window.MedhaIQVoice.ElevenLabsTTSAdapter(
        { voice: _voiceClientConfig.defaultVoice, language: _voiceClientConfig.language, streaming: _voiceClientConfig.streaming },
        { proxyUrl: '/api/voice/synthesize', timeoutMs: 20000 } // matches Render's VOICE_TTS_TIMEOUT_MS -- keep these two in sync
      );
      var _audioPlayer = new window.MedhaIQVoice.BrowserAudioPlayer();
      window.questionSpeechService = new window.MedhaIQVoice.QuestionSpeechService({
        ttsAdapter: _ttsAdapter,
        audioPlayer: _audioPlayer,
        config: _voiceClientConfig
      });
      slog('[VoicePipeline] tts_pipeline active -- QuestionSpeechService constructed', 'info');
    } catch (e) {
      // Fail OPEN to the proven legacy path, never fail closed on a
      // construction error -- a broken new pipeline must not be able
      // to silence the interview entirely (Design Principle 8).
      console.error('[VoicePipeline] Failed to construct tts_pipeline chain -- falling back to legacy_vapi', e);
      window.VOICE_PIPELINE_MODE = 'legacy_vapi';
      window.questionSpeechService = null;
    }
  }

  var STATES={ IDLE:'IDLE',REQUESTING:'REQUESTING',CONNECTING:'CONNECTING',LIVE:'LIVE',STOPPING:'STOPPING' };

  // ROOT CAUSE FIX (P0 "navigating back generates Question 6"): the
  // backend's session.status !== 'active' guard (routes/interview.js)
  // is already correct and rejects any stray request against a
  // completed session -- confirmed directly in that file, not touched
  // here. The actual mechanism is the browser's back-forward cache
  // (bfcache): navigating back can restore this EXACT page's prior,
  // pre-completion JS state (mic still "live", question 5 still
  // showing as current) without a fresh network request at all. Any
  // client-side event firing against that stale state (e.g. a lingering
  // Vapi connection, or the auto-submit-on-speech-start behavior)
  // reaches a session the backend has already ended. This uses the
  // browser's native pageshow/persisted event -- not a timer or poll --
  // to detect exactly that restore and force a genuinely fresh page
  // load instead of resuming stale state.
  window.addEventListener('pageshow', function (event) {
    if (event.persisted) {
      console.log('[BFCACHE] page restored from back-forward cache -- forcing reload to avoid resuming a stale, possibly-completed session state');
      window.location.reload();
    }
  });
