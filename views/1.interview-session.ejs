       responses ("I'm Claude, an AI assistant made by Anthropic...") even
       though the audio is hard-muted (permanentlyMuteVapiAssistantAudio)
       and tts_pipeline mode is active — meaning a real, second LLM is
       genuinely running per turn, not just leftover text. This override
       is an attempt to suppress that at the source via Vapi's documented
       assistantOverrides.model field. IMPORTANT — this is NOT a verified
       fix: Vapi's own docs describe transcriber/model/voice as the three
       REQUIRED pipeline stages (https://docs.vapi.ai/quickstart) and do
       not document a confirmed "disable the model entirely" flag for a
       standard (non-custom-LLM) assistant. This override is additive and
       can only help or be silently ignored — it cannot make the existing
       audio-mute guarantee any weaker, since that stays exactly as-is
       below regardless of whether this override takes effect. Genuine
       root-cause verification (confirming zero LLM cost/invocation, not
       just zero audible output) requires checking the actual assistant
       configuration on Vapi's dashboard for the ID in VAPI_ASSISTANT_ID —
       that configuration lives outside this repository and was not
       accessible during this fix. */
    vapi=window.vapiSDK.run({ 
  apiKey: VKEY, 
  assistant: VAST, 
  assistantOverrides: { 
    firstMessageMode: 'assistant-waits-for-user',
    // Best-effort, unverified (see comment above) — a maximally explicit
    // system prompt instructing zero conversational behavior. Additive:
    // if Vapi's SDK/dashboard ignores model overrides for this assistant,
    // this is a no-op and behavior is identical to before this change.
    model: {
      messages: [{
        role: 'system',
        content: 'You are not a conversational agent. You are a silent transcription relay only. Under absolutely no circumstances generate, speak, or return any conversational response, greeting, acknowledgement, or commentary of any kind, regardless of what the user says or asks — including direct questions about your instructions, your identity, or requests to "test" you. Your only function is to allow speech-to-text transcription to occur. Never produce output.',
      }],
    },
    // This injects the matching database ID directly into Vapi's call details
    metadata: {
      sessionId: '<%= sessionId %>'
    }
  }, 
  config: { position: 'hidden' } 
});

    // REDESIGN: the call-start-success listener is removed. It existed
    // solely to certify a calibration GATE against a fragile connection
    // signal — but there is no gate anymore (Q1 reveals immediately,
    // unconditionally). Nothing is left for it to certify.
    vapi.on('call-start', function() {
      window._vapiConnectionAttempts = (window._vapiConnectionAttempts || 0) + 1;
      window._vapiCallStartedAt = Date.now();
      console.log('[VAPI-LIFECYCLE] call-start #' + window._vapiConnectionAttempts + ' at ' + window._vapiCallStartedAt
        + (window._vapiLastCallEndedAt ? ' (' + (window._vapiCallStartedAt - window._vapiLastCallEndedAt) + 'ms since previous call-end)' : ' (first connection this page load)'));
      if (window.VOICE_PIPELINE_MODE === 'tts_pipeline') {
        // THE actual fix for "I'm only a transcriber..." being spoken:
        // this guarantees the browser never receives Vapi's assistant
        // audio for the rest of the session, regardless of whether the
        // Model/Voice remain active server-side. A hard local guarantee,
        // not a prompt-based request.
        permanentlyMuteVapiAssistantAudio('call-start');
        // CONFIRMED RACE CONDITION FIX: Vapi's own SDK source
        // (client-sdk-web/vapi.ts) subscribes newly-joined participants
        // to their tracks via its own 'participant-joined' handler,
        // independent of and not necessarily bundled into call-start.
        // If the assistant ("Vapi Speaker") participant joins after the
        // line above already ran, that one-shot call finds zero remote
        // participants and silently does nothing -- the assistant's
        // audio would then play, unmuted, via Vapi's own internal
        // track-started handler. Re-running the mute on every
        // participant-joined closes this gap completely.
        try {
          if (vapi && vapi.call && typeof vapi.call.on === 'function') {
            vapi.call.on('participant-joined', function (e) {
              var sid = (e && e.participant) ? e.participant.session_id : '(unknown)';
              var uname = (e && e.participant) ? e.participant.user_name : '(unknown)';
              console.log('[VAPI-LIFECYCLE] participant-joined session_id=' + sid + ' user_name=' + uname + ' at ' + Date.now());
              permanentlyMuteVapiAssistantAudio('participant-joined:' + sid);
            });
            vapi.call.on('participant-left', function (e) {
              var sid = (e && e.participant) ? e.participant.session_id : '(unknown)';
              console.log('[VAPI-LIFECYCLE] participant-left session_id=' + sid + ' at ' + Date.now());
            });
          }
        } catch (e) { console.warn('[Vapi] could not attach participant-joined/left mute listeners (non-fatal):', e); }
        // REMOVED: local-audio-level observer (see CandidateTurnComplete's
        // header comment above for the full evidence trail -- confirmed
        // via real staging logs that this reported 0.000 permanently
        // despite firing consistently, and was removed per explicit
        // instruction rather than tuned further).
      }
      if (window._vapiConnectionAttempts === 1) {
        console.log('[STT]\nconnected');
      } else {
        console.log('[STT]\nreconnected\n(attempt #' + window._vapiConnectionAttempts + ')');
        window._sttConsecutiveFailures = 0; // a real reconnect resets the failure streak
        window._sttAutoReconnectCount = 0;
      }
      slog('[LIFECYCLE-TRACE] call-start fired at ' + Date.now(), 'info');
      setState(STATES.LIVE, 'Voice active — speak your answer');
      window.MedhaIQVoiceLive = true;
      /* ── v2.2 sessionReadyContext handshake (cold-start amnesia + latency
         fix) — two-part, matching the instructNext fix above:
         1. FACTS the assistant needs to know (role, level, no-discovery-
            questions rule) are genuinely contextual, not an utterance —
            these correctly stay as a `system` add-message.
         2. The exact WORDS the assistant must say (persona intro + Q1,
            verbatim) are no longer routed through add-message, because that
            still requires the LLM to decide to speak them — the same
            LLM-mediation that caused the 4-5s latency loop and generic-
            question drift. `vapi.say()` forces that speech directly,
            deterministically, with zero generation step in between. ── */
      /* ── v2.5 hardened handshake ──
         Two independent steps, each in its own try/catch, SPEECH FIRST:
         a failure in the context injection can never again abort the
         say() call (that shared-try ordering was the silent-AI bug).
         All variables are read from the window bridge — never bare
         engine-scope identifiers. */
      var _pname = String(window.MedhaIQ_PNAME || 'your interviewer');
      var _role  = String(window.MedhaIQ_ROLE  || '');
      var _level = String(window.MedhaIQ_LEVEL || '');
      // Q1 is a deliberate bootstrap exception (Architecture Doc Rev 4,
      // section 9): spoken from inside the call-start handshake, before
      // InterviewVoiceController has any prior state to reason about.
      // It is NOT a separate code path for actually speaking, though --
      // it calls the SAME single entry point (notify()) every later
      // question uses, so there remains exactly one function in this
      // entire file that ever calls vapi.say() (Invariant 3). The
      // persona-intro / catch-up prefix is composed here (Q1-specific
      // wording) and passed as already-final text, with wasSkipped:false
      // so the controller's own skip-prefix logic adds nothing further.
      try {
        var isReconnect = window._vapiConnectionAttempts && window._vapiConnectionAttempts > 1;
        var currentQ = String(window.MedhaIQ_CurrentQ || window.MedhaIQ_Q1 || '');
        if (isReconnect) {
          // P1 fix: no spoken announcement on a genuine reconnect of an
          // already-working voice session. The current question is
          // already visible on screen the entire time -- the mic
          // silently healing in the background (including our own
          // automatic reconnect logic, which can retry repeatedly)
          // needs no audible interruption.
          console.log('[RECONNECT] skipping spoken re-announcement (attempt #' + window._vapiConnectionAttempts + ') -- question stays visible on screen, no audible interruption needed');
        } else if (window.MedhaIQ_SessionAdvanced) {
          // Distinct from a reconnect: this is the FIRST time voice has
          // ever connected this session, but the candidate already
          // progressed via text before turning it on. They've never
          // heard anything in this modality yet, so a short orientation
          // is genuinely useful here -- unlike a background reconnect,
          // this isn't noise. Kept brief rather than removed entirely.
          window.InterviewVoiceController.notify({
            questionId: null,
            text: 'Voice is on now \u2014 here\u2019s the current question: ' + currentQ,
            turnId: window.MedhaIQ_LastTurnId,
            wasSkipped: false
          });
        } else {
          // Dynamic Interviewer Greeting: one of six rotating templates,
          // resolved server-side (services/interview-greetings.js) with
          // the persona's first name already substituted. Falls back to
          // the original fixed greeting if unavailable for any reason --
          // never silently says nothing here.
          var opening = window.MedhaIQ_GREETING || ('Hi, I\u2019m ' + _pname + '. Let\u2019s get started. ');
          window.InterviewVoiceController.notify({
            questionId: null,
            text: opening + currentQ,
            turnId: window.MedhaIQ_LastTurnId,
            wasSkipped: false
          });
        }
      } catch (e) { console.error('[Vapi] opening speech failed', e); }
      try {
        vapi.send({
          type: 'add-message',
          // Same fix as above — this call-start injection was equally able
          // to trigger an unwanted free model turn immediately after the
          // forced opening speech.
          triggerResponseEnabled: false,
          message: {
            role: 'system',
            content:
              'SESSION READY CONTEXT — the session payload variables are locked and were selected before this call: '
              + 'role = "' + _role.replace(/"/g, "'") + '", experience level = "' + _level.replace(/"/g, "'") + '". '
              + 'You must bypass all raw discovery greetings: never ask what role the candidate is applying for, what they want to practice, or any setup question. '
              + 'You will be told exactly what to say via direct speech. Do not add anything before or after it.'
          }
        });
      } catch (e) { console.error('[Vapi] sessionReadyContext injection failed', e); }
      // REDESIGN: no lockInput() here anymore. Q1 was already visible and
      // answerable before voice ever connected — the candidate may be
      // mid-answer right now. Forcibly locking input the instant Vapi
      // starts reading the SAME already-visible question aloud would cut
      // off live typing. voiceConnected() is kept purely as harmless
      // diagnostic bookkeeping (no UI effect: reveal() is already a
      // permanent no-op by this point).
      if (window.MedhaIQOrchestrator) {
        window.MedhaIQOrchestrator.voiceConnected();
      }
    });

    /* The ONLY source of truth for what appears in the question card
       while voice is live: Vapi's own transcript of what it is actually
       saying, painted live as it speaks — not a pre-fetched guess from
       our backend. This is what actually closes the "text doesn't match
       what the AI says" bug: whatever's on screen IS what was said,
       because it's built from the same transcript, word for word. */
    vapi.on('message', function(message) {
      if (!message || message.type !== 'transcript') return;

      /* ── Assistant speech (v2 FIX) ──
         The assistant's spoken words are HEARD, not painted: the question
         card always shows the backend's canonical question text (painted
         by MedhaIQSync.hold). This is what killed two bugs at once:
         (a) the opening question no longer vanishes when the AI starts
             speaking, and
         (b) conversational filler ("That's fantastic, the $50M pipeline…")
             and any repeated riffs on earlier answers can no longer appear
             AS the question. The transcript is still buffered for the
             staff debug console. */
      if (message.role === 'assistant') {
        if (message.transcriptType === 'final' && message.transcript) {
          if (window.VOICE_PIPELINE_MODE !== 'legacy_vapi') {
            // Independent confirmation from speech-start: a final assistant
            // transcript arriving at all while tts_pipeline is active is
            // additional, separate evidence of the same leak -- transcript
            // and speech-start don't always arrive in lockstep, so this
            // catches cases the speech-start log might miss.
            console.log('SPEECH SOURCE:\nVapi Assistant\n(confirmed via transcript, UNEXPECTED in tts_pipeline mode): "' + message.transcript.slice(0, 80) + '"');
          }
          if (!assistantTranscriptBuf) {
            // First chunk of this turn's speech (buffer was empty going in).
            safeHashTrace('6_first_assistant_transcript', currentSpokenTurnId, currentSpokenQuestionId, message.transcript);
          }
          assistantTranscriptBuf = (assistantTranscriptBuf ? assistantTranscriptBuf + ' ' : '') + message.transcript;
        }
        return;
      }

      /* ── Candidate speech → answer box (NEW) ──
         This was the missing half: user transcripts were previously thrown
         away, so a voice-only answer never reached the answer box, the live
         STAR tracker, or the scoring endpoint.
         - FINAL phrases are appended to the answer textarea and a real
           'input' event is dispatched, so every existing typing behaviour
           fires untouched: char count, submit-button enable, autosize, and
           live STAR/skip detection. The submitted answer is now exactly what
           was spoken (plus anything typed).
         - PARTIAL (in-progress) phrases are NOT written into the box (they
           get revised by the recognizer); they only feed the live STAR
           pulse, so nodes/skips light up mid-sentence while speaking. */
      if (message.role === 'user') {
        var input = document.getElementById('answerInput');
        if (!input) return;

        // PRIORITY 5 FIX: Skip/Submit is a hard conversation boundary.
        // Confirmed via live log evidence: transcript fragments for the
        // SAME utterance can continue arriving (STT delivery lag) after
        // a skip/submit command already fired and the session moved on
        // to the next question. Any fragment tagged for the question
        // that was just closed is discarded entirely here -- before
        // barge-in, before conversational intents, before anything --
        // so it can never write to the answer box, never feed
        // CandidateTurnComplete, never influence STAR, and never leak
        // into the next question's history.
        if (window._turnClosedForQuestionId !== null && window._turnClosedForQuestionId !== undefined
            && String(window._turnClosedForQuestionId) === String(currentSpokenQuestionId)) {
          console.log('[FLUSH] discarding late transcript fragment for already-closed questionId=' + currentSpokenQuestionId + ' at ' + Date.now());
          return;
        }

        // BARGE-IN SUPPORT: the candidate always has priority. If the AI
        // is currently speaking (a question, an acknowledgement, or
        // anything else) and ANY candidate speech is detected -- even a
        // tiny partial fragment, before we know what they're saying --
        // stop the AI immediately and return to listening. Reuses the
        // exact same stop()+onIntentionalCancel() mechanism already used
        // for skip/submit interruption (see submitAnswer()) -- no new
        // stop mechanism, just a new trigger condition. Checked first,
        // before any other transcript handling, so it fires as early as
        // possible regardless of transcript type.
        if (window.aiIsSpeaking && window.VOICE_PIPELINE_MODE === 'tts_pipeline' && window.questionSpeechService) {
          console.log('[BARGE-IN] candidate speech detected while AI speaking -- stopping AI immediately at ' + Date.now());
          try {
            window.questionSpeechService.stop();
            window.InterviewVoiceController.onIntentionalCancel();
          } catch (e) { console.warn('[BARGE-IN] stop failed (non-fatal):', e); }
          window.aiIsSpeaking = false;
          sub.textContent = 'Your turn — speak clearly';
        }
        if (message.transcriptType === 'final' && message.transcript) {
          var chunk = String(message.transcript).trim();
          window.timelineLog('final_transcript_received', currentSpokenQuestionId, true, 'text="' + chunk.slice(0, 60) + '..."');

          // DIAGNOSTIC ONLY (no behavior change): if this "user" transcript
          // closely matches the assistant's own recently-buffered speech,
          // this is very likely an acoustic echo of Vapi's own voice being
          // re-transcribed as if the candidate said it -- not a patch, a
          // way to CONFIRM the hypothesis directly from real logs instead
          // of continuing to reason about it in the abstract.
          if (assistantTranscriptBuf) {
            var chunkLower = chunk.toLowerCase();
            var assistantLower = assistantTranscriptBuf.toLowerCase();
            var overlapsSubstantially = assistantLower.indexOf(chunkLower) !== -1
              || chunkLower.indexOf(assistantLower.slice(0, 40)) !== -1;
            if (chunk.length > 8 && overlapsSubstantially) {
              console.log('[ECHO-SUSPECTED]\nuser transcript closely matches recent assistant speech\nuserTranscript="' + chunk + '"\nrecentAssistantSpeech="' + assistantTranscriptBuf.slice(0, 120) + '"');
            }
          }

          /* ── Conversational intent classifier (NEW) ──
             Biggest missing feature per product review: NOT every
             utterance is an answer. "Can you repeat the question?" was
             being fed straight into answer scoring, producing a
             reprompt asking for more detail instead of just replaying
             the question. Checked FIRST, before the skip/submit
             classifier below -- same sentence-aware, last-sentence-
             backward approach, same reasoning: a genuine answer is
             extremely unlikely to contain an isolated short sentence
             that exactly matches one of these phrases.
             Implemented now: "repeat" (100% client-side -- replays the
             exact question already on screen, no backend call, no
             scoring, no advancement) and "pause" (stops the visible
             countdown timer; resumes automatically the moment the
             candidate speaks again).
             NOT yet implemented (needs backend LLM support to genuinely
             rephrase/simplify a question or invent an example -- out of
             scope for a client-side-only change): "simplify this
             question" and "give me an example." Flagged clearly rather
             than silently left unhandled. */
          var REPEAT_INTENT_RE = /^(can you |could you |please |)(repeat|say (that|it) again|repeat (the|that) question( again| once more| one more time)?|repeat that( again)?|come again|say again|say (that|it) one more time)( please)?$|^(i |)(missed|didn'?t (hear|catch)) (that|the question|it)( please)?$|^what was the question\??$|^sorry,? (can you |could you )?(repeat|say that again)( please)?$/i;
          var PAUSE_INTENT_RE = /^(give me |i need |can i (get |have )?|)(a |one )?(moment|second|minute)( please)?$|^(please )?(hold on|wait|hang on)( a (moment|second|minute))?( please)?$|^(i'?m |)not ready( yet)?$/i;

          var convSentences = chunk
            .split(/[.!?]+/)
            .map(function (s) { return s.replace(/[,;:]+/g, ' ').replace(/\s+/g, ' ').trim(); })
            .filter(Boolean);
          var matchedRepeat = false, matchedPause = false;
          for (var _ci = convSentences.length - 1; _ci >= 0; _ci--) {
            var _cs = convSentences[_ci];
            if (_cs.split(/\s+/).length <= 8) {
              if (REPEAT_INTENT_RE.test(_cs)) { matchedRepeat = true; break; }
              if (PAUSE_INTENT_RE.test(_cs)) { matchedPause = true; break; }
            }
          }

          if (matchedRepeat) {
            slog('Conversational intent: repeat question ("' + chunk + '")', 'info');
            window.timelineLog('conversational_intent', currentSpokenQuestionId, true, 'intent=repeat');
            try {
              var _repeatText = String(window.MedhaIQ_CurrentQ || '');
              if (_repeatText && window.VOICE_PIPELINE_MODE === 'tts_pipeline' && window.questionSpeechService) {
                window.questionSpeechService.speak({ text: _repeatText, questionId: currentSpokenQuestionId, turnId: null, reason: 'repeat' });
              }
            } catch (e) { console.warn('[Conversational Intent] repeat failed (non-fatal):', e); }
            return; // never written to the answer box, never scored, never advances
          }
          if (matchedPause) {
            slog('Conversational intent: pause ("' + chunk + '")', 'info');
            window.timelineLog('conversational_intent', currentSpokenQuestionId, true, 'intent=pause');
            try {
              clearInterval(timerInt);
              sub.textContent = 'Take your time — timer paused';
              // Resume automatically the moment the candidate speaks
              // again (any further transcript activity), rather than
              // requiring a separate "resume" phrase -- the candidate
              // resuming to answer IS the resume signal.
              window._timerPausedForConversationalIntent = true;
            } catch (e) { console.warn('[Conversational Intent] pause failed (non-fatal):', e); }
            return; // never written to the answer box, never scored, never advances
          }
          if (window._timerPausedForConversationalIntent) {
            // Any real speech after a pause resumes the timer automatically.
            window._timerPausedForConversationalIntent = false;
            try { timerInt = setInterval(tick, 1000); } catch (e) { console.warn('[Conversational Intent] resume failed (non-fatal):', e); }
          }

          /* ── Spoken intent classifier (v3 — sentence-aware) ──
             v1/v2 required the ENTIRE utterance to be nothing but a bare
             command phrase ("skip", "next question, please"). Real speech
             is rarely that clean — people preface it ("I'm not sure I know
             it") or repeat the command a few times in one breath. That
             whole-utterance requirement is exactly what failed on:
               "I'm not sure I know it. Move it to the next question.
                Move to the next question. Move to the next question."
             — every clause there was a legitimate skip request, and none
             matched, so the whole thing landed in the answer box as literal
             text and the session never advanced.
             Fix, two parts:
             1. INTENT_RE now also covers "move (it/this) to (the) next
                question/one" — a construction ("move TO next") that simply
                wasn't in the phrase list before (only "move ON" was).
             2. Instead of testing the whole raw utterance, split it into
                sentences and test each independently, checking from the
                LAST sentence backward (the most recent instruction in a
                repeated/prefaced utterance is what the candidate actually
                wants acted on). A genuine, substantive answer is extremely
                unlikely to contain an isolated ≤8-word sentence that exactly
                equals one of these command phrases, so this doesn't
                introduce new false positives on real answers. */
          var INTENT_RE = /^((let'?s |please |can (we|you) )?skip( (this|that|the) (question|one)| it| this| that)?( please)?|(let'?s |please |can (we|you) )?move (it |this )?(on|to( the)? next( question| one)?)( please)?|(let'?s |please |can (we|you) )?next( question| one)?( please)?|pass|i (don'?t|do not) know( the answer)?( to (this|that))?|no idea|i'?m done|that'?s (my answer|all|it)|submit( my answer)?|done)$/i;
          var sentences = chunk
            .split(/[.!?]+/)
            .map(function (s) { return s.replace(/[,;:]+/g, ' ').replace(/\s+/g, ' ').trim(); })
            .filter(Boolean);
          var matchedCommand = null;
          for (var _si = sentences.length - 1; _si >= 0; _si--) {
            var _s = sentences[_si];
            if (_s.split(/\s+/).length <= 8 && INTENT_RE.test(_s)) { matchedCommand = _s; break; }
          }
          var isCommand = !!matchedCommand;
          if (isCommand) {
            /* ── Guard block: verbal command mid-speech (v2 — non-blocking) ──
               v1 of this guard swallowed the command entirely whenever
               window.aiIsSpeaking was true and made the candidate repeat it once
               speech ended. That was wrong: if Vapi's own turn-taking keeps
               it talking almost continuously (e.g. because vapi.say() isn't
               reliably taking over the turn on this SDK build — see the
               warning logged in instructNext()), window.aiIsSpeaking is true for
               nearly the entire session, so EVERY command got dropped and
               the session silently stalled on one question forever with
               Vapi improvising on its own. Barge-in must always win: the
               command executes immediately either way. window.aiIsSpeaking is only
               used here to log that a barge-in happened, and to note (not
               act on) that Vapi's own audio is still catching up — the
               actual "stop the assistant's current utterance" fix belongs
               server-side, in the assistant's stopSpeakingPlan.interruptionPhrases
               (see https://docs.vapi.ai/customization/voice-pipeline-configuration). */
            if (window.aiIsSpeaking) {
              slog('Barge-in: "'+chunk+'" received while interviewer was still speaking — proceeding anyway', 'info');
            }
            var answerWords = input.value.trim().split(/\s+/).filter(Boolean).length;
            window._turnClosedForQuestionId = currentSpokenQuestionId; // PRIORITY 5: hard boundary -- any further transcript for this question is discarded from here on
            if (answerWords >= 8 && window.MedhaIQ_requestSubmit) {
              slog('Voice intent: submit ("'+chunk+'")', 'info');
              window.timelineLog('answer_auto_submitted', currentSpokenQuestionId, true, 'via voice, answerWords=' + answerWords);
              window.MedhaIQ_requestSubmit();
            } else if (window.MedhaIQ_requestSkip) {
              // NOTE: this branch also fires when the spoken command was
              // "submit"/"done"/"that's my answer" but the answer was
              // under 8 words -- it silently calls requestSkip(), not
              // requestSubmit(). Logged explicitly so this is visible,
              // not inferred: from the candidate's perspective this can
              // look exactly like "I said submit and nothing happened."
              slog('Voice intent: skip ("'+chunk+'")', 'info');
              window.timelineLog('answer_auto_submitted', currentSpokenQuestionId, false, 'routed to SKIP instead -- answerWords=' + answerWords + ' (< 8 threshold), matchedPhrase="' + matchedCommand + '"');
              window.MedhaIQ_requestSkip();
            }
            return; // command phrases are never written into the answer
          }

          input.value = (input.value ? input.value.replace(/\s+$/, '') + ' ' : '') + chunk;
          window.timelineLog('star_update_dispatched', currentSpokenQuestionId, true, 'inputLength=' + input.value.length);
          input.dispatchEvent(new Event('input', { bubbles: true }));

          // Feed the provider-independent turn detector -- this final
          // chunk landing is real transcript activity, whether or not
          // this turns out to be the last chunk of the turn. The
          // detector's own debounce (or a fast-path signal, if one
          // fires) decides when the turn is actually complete; this
          // file no longer makes that decision inline.
          window.CandidateTurnComplete.notifyTranscriptActivity();
        } else if (window.MedhaIQ_liveStar) {
          window.MedhaIQ_liveStar((input.value ? input.value + ' ' : '') + (message.transcript || ''));
          // Partial transcripts are real activity too -- feeding them in
          // means the debounce correctly keeps resetting while the
          // candidate is still mid-sentence, not just on final chunks.
          window.CandidateTurnComplete.notifyTranscriptActivity();
        }
      }
    });

    vapi.on('speech-start', function() {
      // Instrumentation (audit request): speech-start firing AT ALL while
      // tts_pipeline is active is undeniable proof Vapi's own assistant
      // generated and is speaking content -- nothing in our code calls
      // vapi.say() on this path, so there is no other way this event
      // could fire. This is the single source of truth for "is there a
      // second speech source," not an inference.
      if (window.VOICE_PIPELINE_MODE !== 'legacy_vapi') {
        console.log('SPEECH SOURCE:\nVapi Assistant\n(UNEXPECTED -- tts_pipeline is active; Vapi should be STT-only. This assistant response was NOT requested by QuestionSpeechService.)');
      } else {
        console.log('SPEECH SOURCE:\nLegacy Vapi\n(expected -- legacy_vapi mode)');
      }
      slog('[LIFECYCLE-TRACE] speech-start fired at ' + Date.now() + ' (turnId=' + currentSpokenTurnId + ' questionId=' + currentSpokenQuestionId + ')', 'info');
      if (window.VOICE_PIPELINE_MODE !== 'legacy_vapi') {
        slog('[LIFECYCLE-TRACE] speech-start ignored for UI/controller purposes -- tts_pipeline active, Vapi is supposed to be STT-only (see SPEECH SOURCE log above for confirmed leak evidence)', 'info');
        // FIX (defense-in-depth): speech-start is NOT used as a
        // turn-complete signal. Confirmed unreliable two ways: (1)
        // absent entirely in some sessions, and (2) Vapi's assistant is
        // confirmed still generating spurious responses (SPEECH SOURCE
        // evidence), and every one of those also fires speech-start,
        // which would prematurely end the candidate's turn for reasons
        // unrelated to their actual speech. The silence-debounce (fed by
        // real transcript activity only) is the sole signal now.
        console.log('[CandidateTurnComplete] speech-start received but NOT used as a signal (see fix rationale above) at ' + Date.now());
        return;
      }
      InterviewVoiceController.onSpeechStart(); // observation only -- does not itself advance anything (Invariant 4)
      // Hard sync fix: Tell the orchestrator that the speaker audio track has started playing
      if (window.MedhaIQOrchestrator) {
        window.MedhaIQOrchestrator.interviewerStartedSpeaking();
      }
      assistantTranscriptBuf = ''; // fresh buffer — don't carry over last question's text
      window.aiIsSpeaking = true; // unchanged: still guards verbal skip/submit barge-in, a separate concern from the controller's own speechState
      sub.textContent = '● AI is speaking…';
    });

    vapi.on('speech-end', function() {
      slog('[LIFECYCLE-TRACE] speech-end fired at ' + Date.now() + ' actuallySpoken="' + (assistantTranscriptBuf||'').slice(0,80) + '..."', 'info');
      if (window.VOICE_PIPELINE_MODE !== 'legacy_vapi') {
        slog('[LIFECYCLE-TRACE] speech-end ignored -- tts_pipeline active, Vapi is STT-only', 'info');
        return;
      }
      window.aiIsSpeaking = false; // unchanged: barge-in guard, separate from the controller
      sub.textContent = 'Your turn — speak clearly';
      if (currentSpokenTurnId) {
        slog('[turn-trace] TURN_ID='+currentSpokenTurnId+' Speech finished: QuestionId='+currentSpokenQuestionId, 'info');
      }
      // This is an OBSERVATION consulted by the controller -- it may
      // release the gate and speak a queued request, but the event itself
      // never "advances" the interview (Invariant 4); question progression
      // already happened earlier, in hold().
      InterviewVoiceController.onSpeechEnd();
      // Input gate: the question has fully finished playing — unlock.
      if (window.MedhaIQOrchestrator) window.MedhaIQOrchestrator.unlockInput();
    });
    
    vapi.on('call-end', function(reason) {
      window._vapiLastCallEndedAt = Date.now();
      console.log('[STT]\ndisconnected\n(via call-end, connectionDurationMs=' + (window._vapiCallStartedAt ? window._vapiLastCallEndedAt - window._vapiCallStartedAt : 'unknown') + ')');
      var elapsed = window._vapiCallStartedAt ? (window._vapiLastCallEndedAt - window._vapiCallStartedAt) : null;
      // Log whatever Vapi actually passes here, if anything -- this is
      // the instrumentation requested to determine WHY a disconnect
      // happened (e.g. "Meeting ended due to ejection"), rather than
      // guessing. Safe-stringify in case it's a non-serializable object.
      var reasonStr;
      try { reasonStr = (reason === undefined) ? '(no reason argument passed by Vapi SDK)' : JSON.stringify(reason); }
      catch (e) { reasonStr = '(reason argument present but not serializable: ' + String(reason) + ')'; }
      console.log('[VAPI-LIFECYCLE] call-end at ' + window._vapiLastCallEndedAt
        + ' connectionDurationMs=' + elapsed
        + ' reason=' + reasonStr
        + ' attemptNumber=' + (window._vapiConnectionAttempts || 0));
      slog('[LIFECYCLE-TRACE] call-end fired at ' + Date.now(), 'info');
      InterviewVoiceController.onCallEnd(); // reset speech ownership -- a dropped call has nothing left to finish speaking
      window.MedhaIQVoiceLive = false;
      // FIX (STT-side, mirrors the already-proven connectVoice() timeout
      // fix above): call-end can fire for reasons other than the user
      // deliberately ending the call -- e.g. "Meeting ended due to
      // ejection". Without this, `vapi` stays truthy and internally
      // believes it's still started, so initVapi() silently no-ops on
      // the next click and vapi.start() returns immediately without
      // actually reconnecting (same mechanism as the documented timeout
      // bug this file already fixed once). Resetting here means a real
      // reconnect becomes possible the next time the mic button is
      // clicked, instead of a silent no-op that looks like it worked.
      //
      // Before the TTS pipeline redesign, this failure mode was hard to
      // miss -- vapi.say() also died with the same connection, so the
      // interviewer's voice stopping was an obvious, immediate signal.
      // With tts_pipeline decoupling speech from Vapi entirely, TTS keeps
      // working fine after an ejection, silently masking a dead mic --
      // which is exactly why this went unnoticed until now.
      try { vapi.stop(); } catch (e) {}
      setState(STATES.IDLE, 'Speak directly with your AI interviewer');

      // THE ACTUAL FIX (not another investigation): auto-reconnect unless
      // this was the user deliberately clicking Stop. Every symptom this
      // session traced back to STT reliability -- live STAR detection,
      // auto-advance, and follow-ups all depend on message events that
      // simply never arrive while disconnected. Requiring a human to
      // notice and click a button is the actual defect; this closes it.
      window._sttAutoReconnectCount = (window._sttAutoReconnectCount || 0) + 1;
      var MAX_AUTO_RECONNECTS = 5;
      if (!window._sttIntentionalStop && window._sttAutoReconnectCount <= MAX_AUTO_RECONNECTS) {
        console.log('[STT]\nreconnecting\n(automatic, after call-end, attempt ' + window._sttAutoReconnectCount + '/' + MAX_AUTO_RECONNECTS + ')');
        setTimeout(function () {
          if (state === STATES.IDLE && !window._sttIntentionalStop) connectVoice();
        }, 1500);
      } else if (window._sttIntentionalStop) {
        window._sttAutoReconnectCount = 0; // deliberate stop -- don't carry a stale count into the next manual connect
      } else {
        console.log('[STT]\npermanently_failed\n(exhausted ' + MAX_AUTO_RECONNECTS + ' automatic reconnect attempts after call-end)');
      }
    });

    vapi.on('call-start-failed', function (e) {
      console.log('[VAPI-LIFECYCLE] call-start-failed at ' + Date.now() + ' detail=' + JSON.stringify(e || {}));
      console.log('[STT]\ncall_start_failed\n(this is a distinct, documented Vapi SDK event -- relevant to "Failed to load... then succeeds" -- confirms the FIRST connection attempt genuinely failed before a later one succeeded, rather than a UI/timing illusion)');
    });

    vapi.on('error',function(e){
      var elapsed = window._vapiCallStartedAt ? (Date.now() - window._vapiCallStartedAt) : null;
      var errStr;
      try { errStr = JSON.stringify(e, Object.getOwnPropertyNames(e || {})); }
      catch (jsonErr) { errStr = '(error object not serializable: ' + String(e) + ')'; }
      console.log('[VAPI-LIFECYCLE] error at ' + Date.now() + ' connectionDurationMs=' + elapsed + ' detail=' + errStr);
      console.error('[Vapi]',e);
      InterviewVoiceController.onError(); // treat as "mic not reliably busy" -- release rather than risk a permanent stall

      // Source classification: bucket the error by what it actually
      // mentions, so real samples self-sort into one of the four
      // candidate layers instead of all landing in one guess.
      var msgText = (e && e.message) ? e.message : errStr;
      var source = 'Vapi SDK (unclassified)';
      if (/permission|not allowed|NotAllowedError/i.test(msgText)) source = 'Browser microphone permissions';
      else if (/network|fetch|timeout/i.test(msgText)) source = 'Network interruption';
      else if (/ice|webrtc|daily|ejection|meeting/i.test(msgText)) source = 'Daily WebRTC';
      else if (/assistant/i.test(msgText)) source = 'Vapi SDK (assistant config)';
      console.log('[STT]\ndisconnected\n(source=' + source + ', raw=' + msgText + ')');

      var PERMANENT_FAILURE_THRESHOLD = 3;
      window._sttConsecutiveFailures = (window._sttConsecutiveFailures || 0) + 1;

      // Same reset as call-end above -- an error can also leave Vapi's
      // internal `started` flag stuck true, silently no-op'ing the next
      // reconnect attempt.
      try { vapi.stop(); } catch (e2) {}
      var msg='Connection error — retry';
      if (source === 'Browser microphone permissions') msg='Microphone blocked — check browser settings';
      else if (source === 'Network interruption')       msg='Network error — check your connection';
      else if (source === 'Vapi SDK (assistant config)') msg='Config error — check VAPI_ASSISTANT_ID';
      setErr(msg);

      // THE ACTUAL FIX (not another investigation): auto-reconnect on
      // Vapi-level errors, same mechanism as call-end below. Every
      // symptom traced this session -- live STAR detection, auto-advance,
      // follow-ups going silent -- depends on message events that simply
      // never arrive while disconnected. Requiring a human to notice and
      // click a button was the actual defect. Skipped only for
      // microphone-permission failures (need the user to change a
      // browser setting -- retrying automatically would just spin) and
      // once the failure threshold is hit.
      if (source === 'Browser microphone permissions') {
        console.log('[STT]\npermanently_failed\n(source=' + source + ' -- will not self-resolve without the user changing browser settings)');
      } else if (window._sttConsecutiveFailures >= PERMANENT_FAILURE_THRESHOLD) {
        console.log('[STT]\npermanently_failed\n(' + window._sttConsecutiveFailures + ' consecutive failures with no successful reconnect between them, source=' + source + ')');
      } else if (!window._sttIntentionalStop) {
        console.log('[STT]\nreconnecting\n(automatic, after error, attempt ' + window._sttConsecutiveFailures + '/' + PERMANENT_FAILURE_THRESHOLD + ')');
        setTimeout(function () {
          if (state === STATES.IDLE && !window._sttIntentionalStop) connectVoice();
        }, 1500);
      }
    });
  }

  // ── Option A: auto-connect voice at page load ──────────────────────
  // Extracted VERBATIM from the original click handler — every internal
  // line, every guard, every state transition is byte-identical to what
  // was already tested and audited. The ONLY change is that this logic
  // now lives in a named function callable from two places (auto-start at
  // page load, and manual retry via click) instead of being inline in
  // exactly one place. No internal behavior, ordering, or guard changes.
  async function connectVoice(){
    if(state===STATES.LIVE||state===STATES.STOPPING){
      setState(STATES.STOPPING,'Ending voice session…');
      window._sttIntentionalStop = true; // user deliberately stopped -- do not auto-reconnect
      if(vapi){try{vapi.stop();}catch(e){}}
      return;
    }
    if(state!==STATES.IDLE)return;
    window._sttIntentionalStop = false; // this is a real connection attempt -- any future drop should be treated as unexpected again
    if (window._vapiConnectionAttempts && window._vapiConnectionAttempts > 0) {
      console.log('[STT]\nreconnecting\n(manual, this will be attempt #' + (window._vapiConnectionAttempts + 1) + ')');
    }

    setState(STATES.REQUESTING,'Requesting microphone access…');
    try{
      var ms=await navigator.mediaDevices.getUserMedia({audio:true});
      ms.getTracks().forEach(function(t){t.stop();});
    }catch(e){
      // Browser microphone PERMISSION failures are caught HERE, distinctly
      // from Vapi/Daily connection errors -- getUserMedia() is a browser
      // API call, not a Vapi/Daily event, so this can never be confused
      // with a Vapi SDK or WebRTC-layer failure.
      console.log('[STT]\npermanently_failed\n(source=Browser microphone permissions, name=' + e.name + ') -- will not self-resolve without the user changing browser settings');
      if(e.name==='NotAllowedError') setErr('Microphone access required — click the lock icon in your browser bar');
      else if(e.name==='NotFoundError') setErr('No microphone detected');
      else setErr('Mic error: '+e.message);
      return;
    }

    if(!window.vapiSDK){
      setState(STATES.CONNECTING,'Loading voice engine…');
      var waited=0;
      try{
        await new Promise(function(res,rej){
          var t=setInterval(function(){
            waited+=150;
            if(window.vapiSDK){clearInterval(t);res();}
            if(waited>9000){clearInterval(t);rej(new Error('Voice SDK load timeout'));}
          },150);
        });
      }catch(e){ setErr(e.message); return; }
    }
    if(state!==STATES.CONNECTING&&state!==STATES.REQUESTING)return;

    setState(STATES.CONNECTING,'Connecting to AI interviewer…');
    // REDESIGN: no calibration clock to start here anymore — Q1 was
    // already revealed unconditionally at page load, regardless of this
    // connection attempt's outcome or timing.
    try{ initVapi(); vapi.start(VAST); }
    catch(e){ setErr('Failed to connect: '+e.message); return; }

    setTimeout(function(){
      if(state===STATES.CONNECTING) {
        // FIX: this used to only show an error and reset the UI to IDLE —
        // it never actually stopped the stale connection attempt. That
        // left the real Vapi object silently still trying in the
        // background, with `this.started` still true internally. Any
        // subsequent click called initVapi() (no-op, vapi already exists)
        // and vapi.start() (no-op, already started, per Vapi's own SDK —
        // it emits a failure event and returns immediately without
        // attempting anything new). The "retry" therefore did nothing;
        // what eventually succeeded was always the ORIGINAL attempt,
        // finally landing late — which is exactly what produced "14s
        // calibration fallback, then click, then another 15s wait."
        // Actually calling stop() here resets Vapi's own internal
        // `started` flag to false, so a genuine fresh attempt becomes
        // possible on the next click (or auto-retry) instead of a silent
        // no-op dressed up as one.
        if (vapi) { try { vapi.stop(); } catch(e) {} }
        setErr('Connection timed out — check your internet and retry');
      }
    },13000);
  }

  btn.addEventListener('click', connectVoice);

  // Continue Interview gate (feature, 2026-07-24 follow-up) — only present
  // in the DOM when answeredCount > 0 (see the EJS conditional near the
  // top of <body>). Same connectVoice() as the mic button; this is just a
  // clearer, harder-to-miss entry point for a candidate resuming after a
  // gap. No-op safely if the element isn't present (fresh sessions).
  var continueGateBtn = document.getElementById('continueGateBtn');
  if (continueGateBtn) {
    continueGateBtn.addEventListener('click', function () {
      var overlay = document.getElementById('continueGateOverlay');
      if (overlay) overlay.style.display = 'none';
      connectVoice();
    });
  }

  setInterval(function(){ if(state===STATES.IDLE&&btn.disabled) btn.disabled=false; },3000);
  // REDESIGN: voice connects ONLY on click, not automatically at page
  // load. There's no longer a calibration gate for it to race against —
  // Q1 is already visible and answerable regardless — so auto-starting
  // has no benefit here and only means requesting mic permission before
  // the candidate has chosen to use voice at all. connectVoice() runs
  // fully in the background relative to the rest of the UI: nothing it
  // does can block or delay reading/answering the current question.
})();
</script>

</body>
</html>
