      // the QuestionSpeechService speak()-timeout safety net) must not
      // leave the controller stuck in SPEAKING/SPEAKING_PENDING. Reuses
      // the exact same release-and-continue mechanism as onCallEnd/
      // onError, since the correct response is identical: give up the
      // gate and let the interview continue.
      onPlaybackError: function (err) {
        slog('[VoiceController] Playback error -- releasing gate: ' + (err && err.message), 'err');
        _releaseAndMaybeSpeakPending('playback-error');
      },

      isLive: function () { return state === STATES.LIVE && !!vapi; },
      getCurrentQuestion: function () { return CurrentQuestion; },
      getActiveSpokenVersion: function () { return activeSpokenVersion; } // exposed for the correlation checks at the vapi.on() call sites
    };
  })();
  window.InterviewVoiceController = InterviewVoiceController;

  // ── PR3: wire QuestionSpeechService events, now that the controller
  // exists. These replace, for the tts_pipeline path only, the UI
  // side-effects that used to live inside vapi.on('speech-start'/
  // 'speech-end') -- see the gated versions of those handlers below. ──
  if (window.VOICE_PIPELINE_MODE === 'tts_pipeline' && window.questionSpeechService) {
    window.questionSpeechService.onStarted(function () {
      slog('[LIFECYCLE-TRACE] QuestionSpeechService onStarted fired at ' + Date.now() + ' (turnId=' + currentSpokenTurnId + ' questionId=' + currentSpokenQuestionId + ')', 'info');
      InterviewVoiceController.onSpeechStart();
      if (window.MedhaIQOrchestrator) window.MedhaIQOrchestrator.interviewerStartedSpeaking();
      assistantTranscriptBuf = '';
      window.aiIsSpeaking = true;
      sub.textContent = '● AI is speaking…';
      window.CandidateTurnComplete.reset(); // a new question just started -- clear any stale turn-state from the previous one
      window._turnClosedForQuestionId = null; // PRIORITY 5: a new question is a fresh conversation boundary
    });
    window.questionSpeechService.onFinished(function () {
      slog('[LIFECYCLE-TRACE] QuestionSpeechService onFinished fired at ' + Date.now(), 'info');
      window.aiIsSpeaking = false;
      sub.textContent = 'Your turn — speak clearly';
      if (currentSpokenTurnId) slog('[turn-trace] TURN_ID='+currentSpokenTurnId+' Speech finished: QuestionId='+currentSpokenQuestionId, 'info');
      InterviewVoiceController.onSpeechEnd();
      if (window.MedhaIQOrchestrator) window.MedhaIQOrchestrator.unlockInput();
    });
    window.questionSpeechService.onPlaybackError(function (err) {
      console.error('[VoicePipeline] Playback error', err);
      window.aiIsSpeaking = false;
      sub.textContent = 'Voice hiccup — continuing by text';
      InterviewVoiceController.onPlaybackError(err);
      if (window.MedhaIQOrchestrator) window.MedhaIQOrchestrator.unlockInput();
    });

    // ── Interview Engine's ONLY connection to turn-detection ──
    // Per explicit architectural requirement: this listens to the
    // provider-independent CandidateTurnComplete event exclusively --
    // it has no knowledge of speech-start, Vapi, or any other
    // provider-specific signal. If the STT provider changes entirely in
    // the future, this line never needs to change.
    window.CandidateTurnComplete.onTurnComplete(function (info) {
      try {
        var _submitBtn = document.getElementById('submitBtn');
        if (_submitBtn && !_submitBtn.disabled && typeof window.MedhaIQ_requestSubmit === 'function') {
          console.log('[AUTO-SUBMIT] triggered via CandidateTurnComplete (source=' + info.source + ') at ' + Date.now());
          window._turnClosedForQuestionId = currentSpokenQuestionId; // PRIORITY 5: same hard boundary as the voice-command path
          window.MedhaIQ_requestSubmit();
        } else {
          console.log('[AUTO-SUBMIT] CandidateTurnComplete fired but answer box has no content yet (source=' + info.source + ') -- nothing to submit');
        }
      } catch (e) { console.warn('[AUTO-SUBMIT] failed (non-fatal, Submit button remains available):', e); }
    });
  }

  function setState(s,msg,isErr){
    state=s;
    btn.classList.toggle('live', s===STATES.LIVE);
    btn.disabled = (s===STATES.REQUESTING||s===STATES.CONNECTING||s===STATES.STOPPING);
    if(msg){ sub.textContent=msg; sub.style.color=isErr?'#ef4444':''; }
  }
  function setErr(msg){
    setState(STATES.IDLE,msg,true);
    setTimeout(function(){ if(state===STATES.IDLE){ sub.textContent='Speak directly with your AI interviewer'; sub.style.color=''; } },7000);
  }

  /* ── Exposed to the main engine's MedhaIQSync so it can (a) check
     whether voice is actually live and (b) hand Vapi the exact question
     our backend chose, instead of letting the two AI systems diverge. ── */


  function initVapi(){
    if(vapi||!window.vapiSDK)return;
    /* v2.3 — assistantOverrides: suppress the dashboard-configured First
