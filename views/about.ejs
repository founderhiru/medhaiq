  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/hero-v2.css">
  <link rel="stylesheet" href="/css/value-footer.css">
  <!-- Page-scoped only — see about.css header comment. Does not touch
       any global rule used by other pages. -->
  <link rel="stylesheet" href="/css/about.css">
</head>
<body>
  <%- include('partials/header') %>

  <!-- Slim masthead: intentionally left on body's default --navy-deep
       background (no override) so the fixed, transparent-until-scroll
       nav stays legible at the very top of the page. Section 01 below
       is where the light editorial system actually begins. -->
  <section class="mh-about-masthead">
    <div class="mh-eyebrow">About</div>
