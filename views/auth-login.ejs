<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In — MedhaIQ</title>
  <meta name="description" content="Sign in to MedhaIQ — your AI-powered career intelligence workspace.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/interview.css">
  <style>
    /* Force every native form control to inherit the page font instead of the
       browser's default system font (Arial/Segoe UI/etc.) — this is the #1
       cause of buttons/inputs rendering in a different typeface than headings.
       Kept as a bare element selector (low specificity) so the more specific
       .authv2-cta / .authv2-google-btn font-family rules below still win. */
    button, input, textarea, select {
      font-family: 'Inter', system-ui, sans-serif;
    }

    /* ── Auth v2 — Split Screen (uses --navy/--card/--royal/--bright/--emerald tokens from interview.css) ── */
    .authv2-page {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      background: var(--navy);
    }

    /* ── Left: brand & value proposition ───────────────────── */
    .authv2-left {
      position: relative;
      overflow: hidden;
      padding: 56px 64px;
      display: flex;
      flex-direction: column;
      background: radial-gradient(120% 120% at 0% 0%, #0F1B33 0%, var(--navy) 55%, #060911 100%);
      border-right: 1px solid rgba(255,255,255,0.05);
    }
    .authv2-left::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(1.5px 1.5px at 20% 30%, rgba(59,130,246,0.55) 50%, transparent 51%),
        radial-gradient(1.5px 1.5px at 70% 15%, rgba(59,130,246,0.4) 50%, transparent 51%),
        radial-gradient(2px 2px at 85% 55%, rgba(59,130,246,0.45) 50%, transparent 51%),
        radial-gradient(1.5px 1.5px at 40% 70%, rgba(59,130,246,0.35) 50%, transparent 51%),
        radial-gradient(1.5px 1.5px at 60% 85%, rgba(59,130,246,0.3) 50%, transparent 51%),
        radial-gradient(1.5px 1.5px at 15% 90%, rgba(59,130,246,0.3) 50%, transparent 51%);
      opacity: 0.9;
      pointer-events: none;
    }
    .authv2-left-content { position: relative; z-index: 1; display: flex; flex-direction: column; height: 100%; }

    .authv2-logo { display: flex; align-items: center; gap: 10px; margin-bottom: 40px; }
    .authv2-logo span {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      font-weight: 800;
      font-size: 22px;
      color: var(--white);
      letter-spacing: -0.3px;
    }

    .authv2-eyebrow {
      display: inline-flex;
      align-self: flex-start;
      align-items: center;
      padding: 6px 14px;
      border-radius: 999px;
      border: 1px solid rgba(59,130,246,0.35);
      background: rgba(59,130,246,0.08);
      color: var(--bright);
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.1px;
      margin-bottom: 24px;
    }

    .authv2-left h1 {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      font-weight: 700;
      font-size: clamp(32px, 4.5vw, 48px);
      line-height: 1.05;
      color: var(--white);
      letter-spacing: -1px;
      margin-bottom: 20px;
    }

    .authv2-left .authv2-sub {
      font-size: 18px;
      line-height: 1.6;
      color: var(--muted);
      max-width: 460px;
      margin-bottom: 44px;
    }
    .authv2-left .authv2-sub strong { color: var(--white); font-weight: 600; }

    .authv2-features { display: flex; flex-direction: column; gap: 22px; margin-bottom: 44px; }
    .authv2-feature { display: flex; align-items: flex-start; gap: 16px; }
    .authv2-feature-icon {
      flex: none;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(59,130,246,0.12);
      border: 1px solid rgba(59,130,246,0.18);
    }
    .authv2-feature-icon.tone-emerald { background: rgba(5,150,105,0.14); border-color: rgba(5,150,105,0.22); }
    .authv2-feature-icon.tone-royal   { background: rgba(30,64,175,0.28); border-color: rgba(59,130,246,0.22); }
    .authv2-feature-title { font-size: 18px; font-weight: 600; color: var(--white); margin-bottom: 2px; font-family: 'Plus Jakarta Sans', system-ui, sans-serif; letter-spacing: -0.1px; }
    .authv2-feature-desc { font-size: 14px; color: var(--muted); line-height: 1.5; }

    .authv2-testimonial {
      margin-top: auto;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: var(--radius);
      padding: 24px 26px;
    }
    .authv2-testimonial .quote-mark { color: var(--bright); font-size: 22px; font-weight: 800; line-height: 1; margin-bottom: 6px; }
    .authv2-testimonial p { font-size: 15px; line-height: 1.55; color: #E2E8F0; margin-bottom: 12px; }
    .authv2-testimonial .who { font-size: 12px; letter-spacing: 1.2px; color: var(--dim); font-weight: 600; text-transform: uppercase; }

    /* ── Right: authentication card ────────────────────────── */
    .authv2-right {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 32px;
    }
    .authv2-card {
      width: 100%;
      max-width: 440px;
      background: rgba(26,35,57,0.55);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 20px;
      padding: 44px 40px;
    }
    .authv2-card h2 {
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      font-weight: 700;
      font-size: 30px;
      color: var(--white);
      text-align: center;
      margin-bottom: 8px;
    }
    .authv2-card .authv2-card-sub {
      text-align: center;
      color: var(--muted);
      font-size: 15px;
      margin-bottom: 28px;
    }

    .authv2-google-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      background: var(--white);
      color: #1F2937;
      border: none;
      border-radius: 12px;
      padding: 14px;
      font-size: 16px;
      font-weight: 600;
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      text-decoration: none;
      cursor: pointer;
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .authv2-google-btn:hover { box-shadow: 0 4px 16px rgba(255,255,255,0.12); transform: translateY(-1px); }

    .authv2-divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 24px 0;
      color: var(--dim);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 1px;
    }
    .authv2-divider::before, .authv2-divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: rgba(255,255,255,0.08);
    }

    .authv2-field { margin-bottom: 18px; }
    .authv2-field label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: var(--muted);
      margin-bottom: 8px;
    }
    .authv2-input-wrap { position: relative; }
    .authv2-input-wrap svg {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--dim);
      pointer-events: none;
    }
    .authv2-input-wrap input {
      width: 100%;
      background: var(--slate);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px;
      padding: 13px 16px 13px 44px;
      color: var(--white);
      font-size: 16px;
      font-family: 'Inter', system-ui, sans-serif;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .authv2-input-wrap input::placeholder { color: rgba(148,163,184,0.4); }
    .authv2-input-wrap input:focus {
      outline: none;
      border-color: var(--bright);
      box-shadow: 0 0 0 3px rgba(59,130,246,0.18);
    }

    .authv2-cta {
      width: 100%;
      background: var(--royal);
      color: var(--white);
      border: none;
      border-radius: 12px;
      padding: 14px;
      font-size: 16px;
      font-weight: 600;
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s ease;
    }
    .authv2-cta:hover { background: var(--bright); transform: translateY(-1px); }
    .authv2-cta:disabled { opacity: 0.7; cursor: default; transform: none; }

    .authv2-more-toggle {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      background: none;
      border: none;
      color: var(--bright);
      font-size: 14px;
      font-weight: 500;
      font-family: 'Inter', system-ui, sans-serif;
      cursor: pointer;
      padding: 20px 0 4px;
    }
    .authv2-more-toggle svg { transition: transform 0.2s ease; }
    .authv2-more-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }

    .authv2-more-panel {
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      transition: max-height 0.3s ease, opacity 0.25s ease, margin-top 0.3s ease;
    }
    .authv2-more-panel.is-open {
      max-height: 800px;
      opacity: 1;
      margin-top: 8px;
    }
    .authv2-more-panel .authv2-divider { margin: 20px 0 18px; }
    .authv2-signup-line {
      text-align: center;
      margin-top: 18px;
      color: var(--muted);
      font-size: 14px;
    }
    .authv2-signup-line a { color: var(--bright); text-decoration: none; font-weight: 500; }
    .authv2-signup-line a:hover { text-decoration: underline; }

    .authv2-forgot { text-align: center; margin-top: 8px; }
    .authv2-forgot a { color: var(--bright); font-size: 13px; text-decoration: none; }
    .authv2-forgot a:hover { text-decoration: underline; }
    .authv2-forgot-msg { color: var(--muted); font-size: 13px; margin-top: 6px; display: none; }

    .authv2-trust {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 28px;
      padding-top: 24px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .authv2-trust-icon {
      flex: none;
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: rgba(5,150,105,0.14);
      border: 1px solid rgba(5,150,105,0.25);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .authv2-trust-text { font-size: 13px; line-height: 1.4; }
    .authv2-trust-text .title { color: #E2E8F0; font-weight: 600; }
    .authv2-trust-text .sub { color: var(--dim); }

    /* ── Page footer ────────────────────────────────────────── */
    .authv2-footer {
      grid-column: 1 / -1;
      text-align: center;
      padding: 24px 24px 40px;
      background: var(--navy);
    }
    .authv2-footer-links { display: flex; justify-content: center; gap: 24px; margin-bottom: 10px; }
    .authv2-footer-links a { color: var(--dim); font-size: 13px; text-decoration: none; }
    .authv2-footer-links a:hover { color: var(--muted); }
    .authv2-footer .copyright { color: var(--dim); font-size: 13px; }

    .auth-msg { margin-top: 14px; font-size: 13px; color: var(--muted); text-align: center; }
    .auth-msg.error { color: var(--danger); }
    .auth-msg.success { color: #6EE7B7; }

    /* ── Responsive ─────────────────────────────────────────── */
    @media (max-width: 980px) {
      .authv2-page { grid-template-columns: 1fr; }
      .authv2-left { display: none; }
      .authv2-footer { grid-column: 1; }
    }
    @media (max-width: 480px) {
      .authv2-card { padding: 32px 24px; }
    }
  </style>
</head>
<body>

<div class="authv2-page">

  <!-- ── Left: Brand & Value Proposition ── -->
  <div class="authv2-left">
    <div class="authv2-left-content">
 <div class="authv2-logo">
        <%- include('partials/brand-logo', { size: 'lg', eager: true }) %>
      </div>

      <div class="authv2-eyebrow">Continuous Career Intelligence</div>

      <h1>Welcome Back</h1>
      <p class="authv2-sub">Continue building your professional advantage with <strong>AI-Powered Career Intelligence</strong>.</p>

      <div class="authv2-features">
        <div class="authv2-feature">
          <div class="authv2-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <div>
            <div class="authv2-feature-title">Practice with AI Interview Coach</div>
            <div class="authv2-feature-desc">Real-time practice with adaptive AI feedback</div>
          </div>
        </div>

        <div class="authv2-feature">
          <div class="authv2-feature-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0 1 16 0v1"/></svg>
          </div>
          <div>
            <div class="authv2-feature-title">Build Executive Presence</div>
            <div class="authv2-feature-desc">Strengthen communication and leadership impact</div>
          </div>
        </div>

        <div class="authv2-feature">
          <div class="authv2-feature-icon tone-emerald">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          </div>
          <div>
            <div class="authv2-feature-title">Measure Leadership Growth</div>
            <div class="authv2-feature-desc">Data-driven insights across 5 core vectors</div>
          </div>
        </div>

        <div class="authv2-feature">
          <div class="authv2-feature-icon tone-royal">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#93C5FD" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
          </div>
          <div>
            <div class="authv2-feature-title">Track Career Intelligence</div>
            <div class="authv2-feature-desc">Monitor progress and accelerate your growth</div>
          </div>
        </div>
      </div>

      <div class="authv2-testimonial">
        <div class="quote-mark">&ldquo;</div>
        <p>MedhaIQ has transformed the way I prepare, communicate and grow. It's my career advantage engine.</p>
        <div class="who">Product Leader</div>
      </div>
    </div>
  </div>

  <!-- ── Right: Authentication Card ── -->
  <div class="authv2-right">
    <div class="authv2-card">
      <h2>Sign In</h2>
      <p class="authv2-card-sub">Access your Career Intelligence workspace.</p>

      <a href="/auth/google" class="authv2-google-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        Continue with Google
      </a>

      <div class="authv2-divider">OR</div>

      <!-- Magic link: primary flow -->
      <div class="authv2-field">
        <label for="emailInput">Email address</label>
        <div class="authv2-input-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22 6 12 13 2 6"/></svg>
          <input type="email" id="emailInput" placeholder="you@company.com" autocomplete="email" />
        </div>
      </div>

      <button class="authv2-cta" id="sendBtn">Continue</button>
      <div class="auth-msg" id="authMsg"></div>

      <button type="button" class="authv2-more-toggle" id="moreOptionsToggle" aria-expanded="false" aria-controls="moreOptionsPanel">
        More sign-in options
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>

      <div class="authv2-more-panel" id="moreOptionsPanel" hidden>
        <div class="authv2-field">
          <label for="nameInput">Your name (optional)</label>
          <div class="authv2-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <input type="text" id="nameInput" placeholder="Firstname Lastname" autocomplete="name" />
          </div>
        </div>

        <div class="authv2-divider">Or sign in with password</div>

        <div class="authv2-field">
          <label for="passwordEmailInput">Email address</label>
          <div class="authv2-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22 6 12 13 2 6"/></svg>
            <input type="email" id="passwordEmailInput" placeholder="you@company.com" autocomplete="email" />
          </div>
        </div>

        <div class="authv2-field">
          <label for="passwordInput">Password</label>
          <div class="authv2-input-wrap">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input type="password" id="passwordInput" placeholder="Minimum 8 characters" />
          </div>
        </div>

        <button class="authv2-cta" id="passwordLoginBtn">Login with Password</button>
        <div class="auth-msg" id="passwordMsg"></div>

        <div class="authv2-forgot">
          <a href="#" id="forgotPasswordLink">Forgot password?</a>
          <div class="authv2-forgot-msg" id="forgotPasswordMsg">Please contact support to reset your password.</div>
        </div>

        <div class="authv2-signup-line">
          Don't have an account? <a href="/auth/signup">Create one</a>
        </div>
      </div>

      <div class="authv2-trust">
        <div class="authv2-trust-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 6v6c0 5 3.4 9.4 8 10 4.6-.6 8-5 8-10V6l-8-4z"/><polyline points="9 12 11 14 15 10"/></svg>
        </div>
        <div class="authv2-trust-text">
          <div class="title">Secure Authentication</div>
          <div class="sub">Powered by Supabase &middot; Enterprise-grade encryption</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ── Page Footer ── -->
<div class="authv2-footer">
  <div class="authv2-footer-links">
    <a href="/privacy">Privacy Policy</a>
    <a href="/terms">Terms of Service</a>
    <a href="/contact">Contact Us</a>
  </div>
  <div class="copyright">&copy; 2026 MedhaIQ. All rights reserved.</div>
</div>

<script>
(function() {
  // Progressive disclosure: More sign-in options
  var toggle = document.getElementById('moreOptionsToggle');
  var panel = document.getElementById('moreOptionsPanel');
  toggle.addEventListener('click', function() {
    var isOpen = panel.classList.contains('is-open');
    if (isOpen) {
      panel.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.firstChild.textContent = 'More sign-in options ';
      setTimeout(function() { panel.hidden = true; }, 300);
    } else {
      panel.hidden = false;
      // force reflow so the transition runs
      void panel.offsetHeight;
      panel.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.firstChild.textContent = 'Fewer sign-in options ';
    }
  });
})();
</script>

<script>
(function() {
  // Magic link flow — UNCHANGED from original auth-login.ejs
  const emailInput = document.getElementById('emailInput');
  const nameInput = document.getElementById('nameInput');
  const sendBtn = document.getElementById('sendBtn');
  const msg = document.getElementById('authMsg');

  sendBtn.addEventListener('click', async function() {
    const email = emailInput.value.trim();
    if (!email || !email.includes('@')) {
      msg.className = 'auth-msg error';
      msg.textContent = 'Please enter a valid email address.';
      return;
    }

    sendBtn.disabled = true;
    sendBtn.textContent = 'Sending...';
    msg.className = 'auth-msg';
    msg.textContent = '';

    try {
      const resp = await fetch('/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, name: nameInput.value.trim() }),
      });
      const data = await resp.json();

      if (data.success) {
        msg.className = 'auth-msg success';
        msg.textContent = 'Magic link sent! Check your email and click the link to sign in.';
        sendBtn.textContent = 'Link Sent';
      } else {
        throw new Error(data.error || 'Failed to send link');
      }
    } catch (err) {
      msg.className = 'auth-msg error';
      msg.textContent = err.message || 'Something went wrong. Please try again.';
      sendBtn.disabled = false;
      sendBtn.textContent = 'Continue';
    }
  });

  // Password login flow — UNCHANGED from original auth-login.ejs
  const passwordEmailInput = document.getElementById('passwordEmailInput');
  const passwordInput = document.getElementById('passwordInput');
  const passwordLoginBtn = document.getElementById('passwordLoginBtn');
  const passwordMsg = document.getElementById('passwordMsg');
  const forgotPasswordLink = document.getElementById('forgotPasswordLink');
  const forgotPasswordMsg = document.getElementById('forgotPasswordMsg');

  forgotPasswordLink.addEventListener('click', function(e) {
    e.preventDefault();
    forgotPasswordMsg.style.display = 'block';
  });

  passwordLoginBtn.addEventListener('click', async function() {
    const email = passwordEmailInput.value.trim();
    const password = passwordInput.value;

    if (!email || !email.includes('@')) {
      passwordMsg.className = 'auth-msg error';
      passwordMsg.textContent = 'Please enter a valid email address.';
      return;
    }
    if (!password || password.length < 8) {
      passwordMsg.className = 'auth-msg error';
      passwordMsg.textContent = 'Invalid email or password.';
      return;
    }

    passwordLoginBtn.disabled = true;
    passwordLoginBtn.textContent = 'Signing in...';
    passwordMsg.className = 'auth-msg';
    passwordMsg.textContent = '';

    try {
      const resp = await fetch('/auth/password-login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });
      const data = await resp.json();

      if (data.success) {
        window.location.href = '/interview';
      } else {
        throw new Error(data.error || 'Invalid email or password');
      }
    } catch (err) {
      passwordMsg.className = 'auth-msg error';
      passwordMsg.textContent = 'Invalid email or password.';
      passwordLoginBtn.disabled = false;
      passwordLoginBtn.textContent = 'Login with Password';
    }
  });
})();
</script>

</body>
</html>
