<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interview Session — MedhaIQ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <script>
  (function(d,t){
    var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
    g.src='https://cdn.jsdelivr.net/gh/VapiAI/html-script-tag@latest/dist/assets/index.js';
    g.defer=true; g.async=true; s.parentNode.insertBefore(g,s);
  })(document,'script');
  </script>
  <link rel="stylesheet" href="/css/brand-logo.css">
  <link rel="stylesheet" href="/css/interview-session.css">
  <style>
    /* Hide Vapi's own default floating call widget (html-script-tag's
       built-in "vapi-support-btn" — the green phone-icon button seen in
       the upper-left corner). Confirmed via the actual deployed bundle:
       this app never uses that widget to start/manage calls — our own
       connectVoice()/mic button calls vapi.start() directly and
       independently — so this button is purely redundant here. Hiding it
       via display:none also means it can no longer be clicked at all,
       which removes a real (if unlikely) risk: that widget almost
       certainly has its own bound click handler that could otherwise
       start a second, completely uncontrolled call attempt outside this
       app's state machine. CSS-only change — zero effect on
       vapiSDK.run(), any vapi.on(...) handler, or our own call flow. */
    #vapi-support-btn { display: none !important; }
    /* ── STAR skip/miss indicators (additive — safe to remove anytime) ──
       box-shadow instead of border/outline so node sizes never shift. */
    [id^="starNode-"].skipped { box-shadow: 0 0 0 2px #f59e0b, 0 0 10px rgba(245,158,11,.45); animation: starSkipPulse 1.2s ease-in-out infinite; }
    [id^="starNode-"].missed  { box-shadow: 0 0 0 2px #ef4444; opacity: 1; }
    @keyframes starSkipPulse { 0%,100% { box-shadow: 0 0 0 2px #f59e0b, 0 0 4px rgba(245,158,11,.25);} 50% { box-shadow: 0 0 0 2px #f59e0b, 0 0 14px rgba(245,158,11,.65);} }
    .star-skip-note { font-size: 11px; line-height: 1.4; margin-top: 6px; min-height: 15px; letter-spacing: .02em; color: transparent; transition: color .2s; }
    .star-skip-note.warn { color: #f59e0b; }
    .star-skip-note.miss { color: #ef4444; }
    .star-skip-note.ok   { color: #22c55e; }
  </style>
</head>
<body>

<!-- ═══ SINGLE TOP BAR — matches Target2.jpg exactly:
     "MedhaIQ.live | Interview Session" (left) · LIVE · timer · Qx/5 (center-right) · End Session (right) ═══ -->

<div class="topbar">
<%- include('partials/brand-logo', { size: 'md' }) %>
  <span class="tb-brand-sep">|</span>
  <div class="tb-session-meta">
    <div class="tb-session-label" id="tbSessionLabel">Interview Session</div>
  </div>
  <div class="tb-right">
    <div class="tb-live"><div class="tb-live-dot"></div>LIVE</div>
    <div class="tb-timer" id="timer">00:00</div>
    <div class="tb-meta" id="qCounter">Q1 / 5</div>
    <button class="tb-end" id="endBtn">End Session</button>
  </div>
</div>

<div class="os-grid">

  <%- include('partials/session-context') %>

  <%- include('partials/active-question') %>

  <%- include('partials/live-terminal') %>

</div><!-- /os-grid -->

<!-- ═══ TRUST BAR — pinned inside the viewport (TS1), never causes page scroll ═══ -->
<footer class="it-trustbar">
  <ul>
    <li><svg class="ic tb-c1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4a3 3 0 0 0-3 3 3 3 0 0 0-2 5 3 3 0 0 0 2 5 3 3 0 0 0 3 3c1.5 0 3-1 3-3V7c0-2-1.5-3-3-3Z"/><path d="M15 4a3 3 0 0 1 3 3 3 3 0 0 1 2 5 3 3 0 0 1-2 5 3 3 0 0 1-3 3c-1.5 0-3-1-3-3V7c0-2 1.5-3 3-3Z"/></svg><div class="trust-txt"><b>AI Personalization</b><span>Built for you</span></div></li>
    <li><svg class="ic tb-c2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c1.2-3.2 4-4 6.5-4s5.3.8 6.5 4"/><circle cx="17.5" cy="9" r="2.5"/><path d="M17 15.5c2 .3 3.8 1.3 4.5 3.5"/></svg><div class="trust-txt"><b>Role-Specific</b><span>Interviews</span></div></li>
    <li><svg class="ic tb-c3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2L12 3Z"/></svg><div class="trust-txt"><b>Real-time Feedback</b><span>&amp; Scoring</span></div></li>
    <li><svg class="ic tb-c4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M8 9h8M8 12.5h8M8 16h5"/></svg><div class="trust-txt"><b>Industry-Aligned</b><span>Questions</span></div></li>
    <li><svg class="ic tb-c5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 5 6v5c0 5 3 8.5 7 10 4-1.5 7-5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4.5"/></svg><div class="trust-txt"><b>Secure &amp; Private</b><span>Enterprise Grade</span></div></li>
  </ul>
</footer>

<!-- Score toast -->
<div class="score-toast" id="scoreToast">
  <div>
    <div class="toast-score" id="toastScore">—</div>
    <div class="toast-lbl">Answer Score</div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════════
     HIDDEN DEBUG CONSOLE
     Opens with Ctrl+Shift+D. Never surfaced to a candidate. Holds
     everything that's useful for troubleshooting a live session but
     adds cognitive noise for the person being interviewed: activity
     log, competency coverage, and raw audio metadata.
══════════════════════════════════════════════════════════════ -->
<div class="debug-console" id="debugConsole">
  <div class="dbg-hdr">
    <span class="dbg-hdr-title">⚠ DEBUG CONSOLE — STAFF ONLY</span>
    <button class="dbg-close" id="dbgClose">✕</button>
  </div>
  <div class="dbg-section">
    <div class="dbg-section-lbl">Session</div>
    <div class="dbg-meta-grid">
      <div class="dbg-meta-cell"><div class="k">Session ID</div><div class="v">#<%= sessionId %></div></div>
      <div class="dbg-meta-cell"><div class="k">Question ID</div><div class="v" id="dbgQid">—</div></div>
    </div>
  </div>
  <div class="dbg-section">
    <div class="dbg-section-lbl">Competency Coverage</div>
    <div id="dbgCompMap">
      <div class="dbg-comp-row"><span class="dbg-comp-name">System Design</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-system_design" style="width:0%;background:#3b82f6;"></div></div><span class="dbg-comp-count" id="compC-system_design">0</span></div>
      <div class="dbg-comp-row"><span class="dbg-comp-name">Leadership</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-leadership" style="width:0%;background:#22c55e;"></div></div><span class="dbg-comp-count" id="compC-leadership">0</span></div>
      <div class="dbg-comp-row"><span class="dbg-comp-name">Strategy</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-strategy" style="width:0%;background:#a78bfa;"></div></div><span class="dbg-comp-count" id="compC-strategy">0</span></div>
      <div class="dbg-comp-row"><span class="dbg-comp-name">Communication</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-communication" style="width:0%;background:#f59e0b;"></div></div><span class="dbg-comp-count" id="compC-communication">0</span></div>
      <div class="dbg-comp-row"><span class="dbg-comp-name">Technical</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-technical" style="width:0%;background:#fb923c;"></div></div><span class="dbg-comp-count" id="compC-technical">0</span></div>
    </div>
  </div>
  <div class="dbg-section">
    <div class="dbg-section-lbl">Audio Metadata</div>
    <div class="dbg-meta-grid">
      <div class="dbg-meta-cell"><div class="k">Filler Words</div><div class="v" id="advFiller">0</div></div>
      <div class="dbg-meta-cell"><div class="k">Pace</div><div class="v" id="advPace">—</div></div>
      <div class="dbg-meta-cell"><div class="k">Executive Tone</div><div class="v" id="advTone">—</div></div>
      <div class="dbg-meta-cell"><div class="k">Coherence</div><div class="v" id="advCoherence">—</div></div>
    </div>
  </div>
  <div class="dbg-section-lbl" style="padding:10px 14px 0;">Activity Log</div>
  <div class="dbg-log-body" id="slogBody"></div>
  <div class="dbg-hint">Ctrl+Shift+D to close</div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     INTERVIEW OS ENGINE
═══════════════════════════════════════════════════════════════ -->
<script src="/js/interviewOrchestrator.js"></script>
<script>
(function() {
  /* ══ Sync engine — fixes the UI/audio desync bug ══
     THE ROOT BUG: two independent AI calls were generating "the next
     question" — our own backend text call, AND whatever Vapi's own voice
     assistant decided to actually say — with nothing forcing them to
     match. The card showed our backend's guess the moment it arrived,
     regardless of what the voice assistant was really saying a beat
     later, so the two drifted apart on almost every question.
     THE FIX: when voice is live, our backend's text is sent to Vapi as an
     instruction for what to ask (via window.MedhaIQVoice.instructNext,
     wired up in the Vapi script below), and the on-screen card is ONLY
     ever painted from Vapi's own live transcript of what it actually
     says (see vapi.on('message') below) — never from our own guess. In
     text-only mode (no voice connected) there's nothing to wait for, so
     it still paints our backend text immediately, same as before. */
  var pendingQuestion = null;
  var pendingAudioUrl = null;
  var qAudioEl = new Audio();
  var MedhaIQSync = {
    hold: function(question, type, competency, wasSkipped, turnId) {
      pendingQuestion = { question: question, type: type, competency: competency, turnId: turnId };
      var voice = window.MedhaIQVoice;
      if (voice && voice.isLive && voice.isLive()) {
        // v2 FIX (repeat/ghost bugs): the backend's question is the single
        // source of truth ON SCREEN — painted in full, immediately. Vapi is
        // instructed to SPEAK this same text (with an explicit no-repeat
        // directive), but its transcript never overwrites the card again.
        var instructed = voice.instructNext(question.text, !!wasSkipped, turnId, question.id);
        if (instructed) {
          pendingAudioUrl = null; // Vapi is speaking now — our own TTS clip (if any) must not fire later
          if (turnId) (window.MedhaIQ_log||function(){})('[turn-trace] TURN_ID='+turnId+' UI rendered: QuestionId='+question.id, 'info');
          showQuestion(question, type, competency);
          pendingQuestion = null;
          // Input gate: uiText is drawn; lock typing until the audio
          // playback of this same text finishes (speech-end unlocks).
          if (window.MedhaIQOrchestrator) window.MedhaIQOrchestrator.lockInput();
          return;
        }
        // instructNext failed (voice flagged live but the call object
        // isn't actually usable) — fall back to the text reveal below so
        // the candidate never gets stuck on the placeholder.
      }
      MedhaIQSync.reveal();
    },
    reveal: function() {
      if (!pendingQuestion) return;
      if (pendingQuestion.turnId) (window.MedhaIQ_log||function(){})('[turn-trace] TURN_ID='+pendingQuestion.turnId+' UI rendered (text-only path): QuestionId='+pendingQuestion.question.id, 'info');
      showQuestion(pendingQuestion.question, pendingQuestion.type, pendingQuestion.competency);
      pendingQuestion = null;
      if (pendingAudioUrl) {
        try { qAudioEl.src = pendingAudioUrl; qAudioEl.play().catch(function(){}); } catch(e){}
        pendingAudioUrl = null;
      }
    }
  };
  window.MedhaIQSync = MedhaIQSync;
  window.MedhaIQVoiceLive = false;

  /* ── EJS-injected session variables ── */
  var SID    = '<%= sessionId %>';
  var QID    = '<%= questionId %>';
  var QN     = <%= answeredCount %> + 1;
  var MAXQ   = 5;
  var SEC_PER_Q = 180; /* 3 min budget per question, drives the "Est. remaining" clock */
  var PNAME  = '<%= personaName %>';
  var PTITLE = '<%= personaTitle %>';
  var PINIT  = '<%= personaInitials %>';
  var PCOL   = '<%= personaStyleColor %>';
  var QTYPE  = '<%= questionType %>';
  var ROLE   = '<%= roleTitle %>';
  var LEVEL  = '<%= experienceLevel %>';
  var INITQ  = `<%- questionText.replace(/`/g, '\\`') %>`;
  /* v2.5 SCOPE BRIDGE — the Vapi script block below is a separate scope and
     cannot see these engine-block variables. Referencing them bare from the
     call-start handler threw "ReferenceError: ROLE is not defined", which
     aborted the handler BEFORE vapi.say() could run — the silent-AI bug.
     Everything the voice layer needs is published on window. */
  window.MedhaIQ_ROLE  = ROLE;
  window.MedhaIQ_LEVEL = LEVEL;
  window.MedhaIQ_PNAME = PNAME;

  /* Persona (PNAME/PTITLE/PINIT/PCOL) is retained purely as internal
     session data for scoring/report generation — it is never rendered.
     The UI shows only the candidate and the System's own presence. */
  document.getElementById('sbRole').textContent   = ROLE  || '—';
  document.getElementById('sbLevel').textContent  = LEVEL || '—';

  /* ── Elapsed timer (topbar) + Est. remaining (sidebar) — both driven off
     the SAME real clock now. Previously "Est. remaining" was recomputed
     only from the question count (MAXQ-remaining * 180s) and never moved
     within a question, so it could show 9:00 remaining while the actual
     elapsed timer said 2:00 — the two numbers had nothing to do with each
     other. Now there's one 15:00 session budget and remaining = budget
     minus actual elapsed seconds, ticking every second like the timer. ── */
  var TOTAL_BUDGET_SEC = MAXQ * SEC_PER_Q; // 5 * 180s = 15:00 total
  var t0 = Date.now(), timerInt;
  function mmss(totalSeconds) {
    var s = Math.max(0, Math.floor(totalSeconds));
    return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
  }
  function tick() {
    var elapsed = Math.floor((Date.now()-t0)/1000);
    document.getElementById('timer').textContent = mmss(elapsed);
    document.getElementById('sbTimeRemaining').textContent = mmss(TOTAL_BUDGET_SEC - elapsed);
  }
  timerInt = setInterval(tick, 1000);
  tick();

  function updateCounter() {
    document.getElementById('qCounter').textContent = 'Q'+QN+' / '+MAXQ;
    document.getElementById('sbProgNum').textContent = QN;
    var pct = Math.round(((QN-1)/MAXQ)*100);
    document.getElementById('sbProgFill').style.width = pct+'%';
    var remaining = Math.max(0, MAXQ - QN); // questions left AFTER current one
    document.getElementById('sbProgRemaining').textContent = remaining + (remaining===1?' question remaining':' questions remaining');
  }

  /* ── Debug console (staff-only, Ctrl+Shift+D) ── */
  var dbg = document.getElementById('debugConsole');
  document.addEventListener('keydown', function(e){
    if (e.ctrlKey && e.shiftKey && (e.key==='D'||e.key==='d')) dbg.classList.toggle('open');
  });
  document.getElementById('dbgClose').addEventListener('click', function(){ dbg.classList.remove('open'); });

  function slog(msg, type) {
    var el = document.getElementById('slogBody');
    var ts = new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    var cls= 'dbg-entry' + (type==='ok'?' ok':type==='err'?' err':type==='info'?' info':'');
    el.insertAdjacentHTML('afterbegin','<div class="'+cls+'">['+ts+'] '+msg+'</div>');
  }
  // FIX: slog() was declared with a plain `function` statement inside this
  // script's own (function(){...})() wrapper, so it was ONLY callable from
  // code inside this same closure — not from the separate Vapi/orchestrator
  // <script> block later in the page, which lives in its own IIFE. Every
  // slog(...) call added there (guard-block logging, instructNext
  // diagnostics, opening-question diagnostics) was silently a
  // ReferenceError waiting to happen, and it's exactly what crashed
  // instructNext(): the QN reference failed first (while building the log
  // message argument), before the call even reached slog itself — so slog's
  // own scope bug hadn't been hit yet, but it was there too. Exposing it on
  // window makes it safely callable from every script block on this page.
  window.slog = slog;

  var compScores = { system_design:0, leadership:0, strategy:0, communication:0, technical:0 };
  function updateCompetency(key, increment) {
    if (!(key in compScores)) return;
    compScores[key] = Math.min(100, compScores[key] + (increment || 20));
    var bar = document.getElementById('comp-'+key);
    var cnt = document.getElementById('compC-'+key);
    if (bar) bar.style.width = compScores[key]+'%';
    if (cnt) cnt.textContent = parseInt(cnt.textContent||0)+1;
  }

  /* ══ 5-Vector metrics — consumes the standardized IntelligenceMetrics
     schema: { overallScore, vectors:{...}, status, metadata:{...} } ══ */
  var runningScores = [];
  function updateMetrics(m) {
    if (!m || !m.vectors) return;
    runningScores.push(m);
    var v = m.vectors;
    // .hasOwnProperty style checks would be overkill here — these are
    // always-present numeric fields from the server — but the important
    // fix is using `?? 0` (nullish coalescing) instead of `|| 0`: `?? 0`
    // only substitutes when the value is null/undefined, so a genuine 0
    // passes straight through instead of being masked by a fallback that
    // happens to also be 0 (same value, but this makes the intent explicit
    // and safe against a future change to the fallback).
    [['mStar','mStarV', v.structure ?? 0], ['mTech','mTechV', v.technicalDepth ?? 0],
     ['mExec','mExecV', v.executivePresence ?? 0], ['mGcc','mGccV', v.gccReadiness ?? 0],
     ['mFric','mFricV', v.communicationClarity ?? 0]].forEach(function(r) {
      var val = Math.round(r[2]);
      var isZero = val === 0;
      var bar = document.getElementById(r[0]); var lbl = document.getElementById(r[1]);
      if (bar) {
        bar.classList.toggle('is-zero', isZero);
        // Always set width explicitly — 0 renders as empty bar (0% fill, track
        // background visible), never hidden. Immediate DOM update, no delay.
        bar.style.width = val + '%';
      }
      if (lbl) {
        lbl.textContent = val;
        lbl.classList.toggle('is-zero', isZero);
      }
    });
    if (m.metadata) {
      document.getElementById('advFiller').textContent    = m.metadata.fillerWords ?? '0';
      document.getElementById('advPace').textContent      = m.metadata.pace || '—';
      document.getElementById('advTone').textContent      = m.metadata.executiveTone || m.metadata.coherence || '—';
      document.getElementById('advCoherence').textContent = m.metadata.coherence || '—';
    }
    document.getElementById('dbgQid').textContent = QID;
    updateScoreRing(m.overallScore);
  }

  function updateScoreRing(latestOverall) {
    if (typeof latestOverall !== 'number') return;
    var total = runningScores.reduce(function(a,s){ return a+(s.overallScore||0); }, 0);
    var avg   = Math.round(total / runningScores.length);
    var CIRC  = 213; /* 2 * π * 34 */
    document.getElementById('ringFill').style.strokeDashoffset = CIRC - (CIRC*avg/100);
    var lbl = document.getElementById('ringLabel');
    lbl.textContent = avg;
    var tier = avg>=75?'high':avg>=55?'mid':'low';
    lbl.style.color = avg>=75?'#22c55e':avg>=55?'#f59e0b':'#ef4444';
    var STATUS_COPY = {
      high: ['Strong Performance', "You're demonstrating excellent leadership potential."],
      mid:  ['Solid Progress', 'A few more concrete results would sharpen this further.'],
      low:  ['Early Signal', 'Lean harder into STAR structure and quantified results.'],
    };
    var statusEl = document.getElementById('ringStatus');
    var subEl    = document.getElementById('ringStatusSub');
    if (statusEl) { statusEl.className = 'ring-status '+tier; statusEl.textContent = STATUS_COPY[tier][0]; }
    if (subEl)    subEl.textContent = STATUS_COPY[tier][1];
  }

  /* ══ STAR Progress — Tactical view ══
     Two sources feed the same four nodes:
     1) A real-time client-side regex pass, run on every keystroke, paints
        nodes as "active" (pulsing) the instant a STAR signal appears in
        the answer as it's being typed/spoken.
     2) The server's own computeStarProgress() (services/interview.js),
        returned as `star_progress` on submit, is the source of truth and
        repaints the same nodes as solid "done" once the answer lands. */
  var STAR_ORDER = ['situation','task','action','result'];
  /* NOTE: these patterns are intentionally kept IDENTICAL to STAR_PATTERNS in
     services/interview.js so the live view and the server verdict agree.
     If you edit one, edit both. */
  var STAR_PATTERNS = {
    situation: /\b(when i|at my (previous|last|current)|in my role|while (working|leading)|the (context|situation|background) was|we (were|had) facing|a few (months|years|weeks) ago|during|last (year|quarter|month|week)|in (19|20)\d{2}|i was working (on|at|with)|we were (building|working|running|struggling)|at (a|an|the|our) (company|startup|client|firm))\b/i,
    task: /\b(my (task|responsibility|goal|objective|job) was|i was (responsible|asked|tasked|expected)|needed to|had to (deliver|fix|solve|build|reduce|improve)|the (goal|objective|target|challenge|problem|ask) was|asked me to|i had to)\b/i,
    action: /\b(i (led|built|designed|implemented|created|drove|decided|initiated|coordinated|proposed|negotiated|restructured|launched|rolled out|owned|developed|managed|organi[sz]ed|automated|migrated|deployed|fixed|resolved|refactored|presented|convinced|persuaded|established|introduced|analy[sz]ed|started|began|took|worked)|we (implemented|built|created|designed|launched|migrated|deployed|developed|automated|redesigned|rolled out|restructured)|my approach was|so i\b|then i\b)/i,
    result: /\b(as a result|resulted in|which (led to|resulted)|(reduced|increased|improved|grew|cut|saved|boosted)[^.]{0,40}(\d+%|\$|percent)|the (outcome|impact) was|(we|i) (achieved|delivered)|ended up|in the end|leading to|\d+%)\b/i,
  };
  function liveDetectStar(text) {
    var t = (text || '').toLowerCase();
    return {
      situation: STAR_PATTERNS.situation.test(t),
      task: STAR_PATTERNS.task.test(t),
      action: STAR_PATTERNS.action.test(t),
      result: STAR_PATTERNS.result.test(t),
    };
  }
  /* Human-readable labels for the note line */
  var STAR_LABELS = { situation:'Situation', task:'Task', action:'Action', result:'Result' };

  /* One small note line under the STAR nodes. Created once, on first use,
     right after the container that holds the Result node — no HTML/partial
     edits needed. */
  function getStarNote() {
    var el = document.getElementById('starSkipNote');
    if (el) return el;
    var anchor = document.getElementById('starNode-result');
    if (!anchor || !anchor.parentElement) return null;
    el = document.createElement('div');
    el.id = 'starSkipNote';
    el.className = 'star-skip-note';
    var host = anchor.parentElement.parentElement || anchor.parentElement;
    host.appendChild(el);
    return el;
  }

  /* Skip-aware painter.
     LIVE (finalized=false): a letter is flagged "skipped" the INSTANT a later
       letter is detected while it's still missing — e.g. Action lights up but
       Task never did → Task pulses amber immediately, mid-answer, while the
       candidate is still talking/typing. They can still fix it.
     FINAL (finalized=true, server verdict on submit): any letter still missing
       is flagged red "missed" — the answer is over, it's now a definitive gap.
       (If ALL four are missing — e.g. the question was skipped entirely — we
       don't paint four red nodes; the note simply says no structure detected.) */
  function paintStarProgress(progress, finalized) {
    progress = progress || {};
    var lastHitIdx = -1;
    STAR_ORDER.forEach(function(key, i) { if (progress[key]) lastHitIdx = i; });
    var anyHit = lastHitIdx > -1;
    var flagged = [];

    STAR_ORDER.forEach(function(key, i) {
      var node = document.getElementById('starNode-'+key);
      if (!node) return;
      var on = !!progress[key];
      var isSkipped = !on && !finalized && i < lastHitIdx;        // jumped past it, mid-answer
      var isMissed  = !on && !!finalized && anyHit;               // answer done, letter absent
      node.classList.toggle('done',   on && !!finalized);
      node.classList.toggle('active', on && !finalized);
      node.classList.toggle('skipped', isSkipped);
      node.classList.toggle('missed',  isMissed);
      if (isSkipped || isMissed) {
        flagged.push(STAR_LABELS[key]);
        node.title = STAR_LABELS[key] + (finalized ? ' was missing from this answer' : ' looks skipped — you can still add it');
      } else {
        node.removeAttribute('title');
      }
    });

    for (var i = 1; i <= 3; i++) {
      var a = STAR_ORDER[i-1], b = STAR_ORDER[i];
      var conn = document.getElementById('starConn-'+i);
      if (conn) conn.classList.toggle('done', !!(progress[a] && progress[b]));
    }

    var note = getStarNote();
    if (note) {
      if (finalized && progress.status === 'not_addressed') {
        note.textContent = '✕ Not Addressed — answer was too brief to evaluate for STAR structure';
        note.className = 'star-skip-note miss';
      } else if (flagged.length && !finalized) {
        note.textContent = '⚠ Skipped so far: ' + flagged.join(', ') + ' — try to cover it before you finish';
        note.className = 'star-skip-note warn';
      } else if (flagged.length && finalized) {
        note.textContent = '✕ This answer missed: ' + flagged.join(', ');
        note.className = 'star-skip-note miss';
      } else if (finalized && !anyHit) {
        note.textContent = 'No STAR structure detected in this answer';
        note.className = 'star-skip-note miss';
      } else if (finalized && lastHitIdx === 3 && flagged.length === 0 && progress.situation && progress.task && progress.action && progress.result) {
        note.textContent = '✓ Full STAR structure — all four components covered';
        note.className = 'star-skip-note ok';
      } else {
        note.textContent = '';
        note.className = 'star-skip-note';
      }
    }
  }
  function resetStarProgress() { paintStarProgress({}, false); }

  /* ══ AI Interview Status — always-visible calm state machine ══ */
  var STATE_META = {
    PREPARING:        { title:'Preparing Session…', sub:'Setting up your next question',     pulse:true,  ring:0.15, steps:[] },
    CALIBRATING:       { title:'Calibrating AI…',     sub:'Analysing your target role',        pulse:true,  ring:0.25, steps:[] },
    LISTENING:         { title:'Listening…',         sub:'Capturing your answer',             pulse:false, ring:0.4,  steps:['captured'] },
    ANALYZING:         { title:'Analyzing…',         sub:'Scoring your response',             pulse:true,  ring:0.75, steps:['captured','analyzing'] },
    GENERATING:        { title:'Generating Follow-up…', sub:'Preparing next question',       pulse:true,  ring:0.9,  steps:['captured','analyzing','preparing'] },
    READY:             { title:'Ready',              sub:'Your next question is up',          pulse:false, ring:1,    steps:['captured','analyzing','preparing'] },
    SESSION_COMPLETE:  { title:'Session Complete',   sub:'All questions answered',            pulse:false, ring:1,    steps:['captured','analyzing','preparing'] },
    GENERATING_REPORT: { title:'Generating Report…', sub:'Compiling your Intelligence Report',pulse:true,  ring:0.95, steps:['captured','analyzing','preparing'] },
    FINISHED:          { title:'Finished',           sub:'Redirecting to your report',        pulse:false, ring:1,    steps:['captured','analyzing','preparing'] },
  };
  var RING_CIRC = 220; /* 2 * π * 35 */
  var WORKING_STATES = { LISTENING:1, ANALYZING:1, GENERATING:1 };
  function setAIState(key) {
    var meta = STATE_META[key] || STATE_META.PREPARING;
    document.getElementById('aiStatusTitle').textContent = meta.title;
    document.getElementById('aiStatusSub').textContent   = meta.sub;
    var ring = document.getElementById('aiStatusRing');
    ring.style.strokeDashoffset = RING_CIRC - (RING_CIRC * meta.ring);
    ring.classList.toggle('pulsing', !!meta.pulse);
    var lastStep = meta.steps[meta.steps.length-1];
    document.querySelectorAll('#statusChecklist .status-item').forEach(function(el){
      var step = el.getAttribute('data-step');
      var included = meta.steps.indexOf(step) > -1;
      var isCurrent = included && step===lastStep && WORKING_STATES[key];
      el.classList.toggle('active', !!isCurrent);
      el.classList.toggle('done', included && !isCurrent);
    });
  }

  function showToast(overallScore) {
    var s = Math.round(overallScore||0);
    var el = document.getElementById('toastScore');
    el.textContent = s;
    el.className = 'toast-score '+(s>=75?'high':s>=55?'mid':'low');
    var t = document.getElementById('scoreToast');
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 4000);
  }

  /* ── Loading / question rendering ── */
  function showLoading(text) {
    document.getElementById('answerBarWrap') || null;
    document.querySelector('.answer-bar-wrap').style.display='none';
    document.getElementById('questionCard').style.display='none';
    document.getElementById('loadingOverlay').classList.add('show');
    document.getElementById('loadingText').textContent = text || 'Analysing...';
  }

  var QUESTION_WHY = {
    opening: 'This opening question establishes context and helps the AI calibrate follow-up depth.',
    behavioral: 'This evaluates your structure, ownership, and executive delivery under a real scenario.',
    drill_down: 'A deep-dive follow-up — the AI probes a gap or vague point from your last answer.',
  };

  function showQuestionMeta(q, type, competency) {
    // Defensive consolidation: updateCounter() also runs immediately when
    // a new question is fetched (in submitAnswer, right after QN++), but
    // it's called here too so the progress bar is GUARANTEED correct at
    // the exact moment any question — drill-down or not, voice or text —
    // actually gets painted, regardless of which code path got it there.
    // Calling it twice is harmless; it just re-renders the same numbers.
    updateCounter();

    document.getElementById('loadingOverlay').classList.remove('show');
    document.getElementById('questionCard').style.display='flex';
    document.querySelector('.answer-bar-wrap').style.display='block';

    var label = competency ? competency.replace(/_/g,' ').toUpperCase() : (type==='drill_down' ? 'DEEP DIVE' : 'BEHAVIORAL');
    document.getElementById('qEyebrow').textContent = 'QUESTION '+QN+' OF '+MAXQ+' · '+label;
    var why = document.getElementById('qWhyText');
    why.textContent = QUESTION_WHY[type] || QUESTION_WHY.behavioral;
    why.classList.remove('shown');

    document.getElementById('answerInput').value = '';
    document.getElementById('charCount').textContent = '0 / 4000';
    document.getElementById('submitBtn').disabled = true;
    document.getElementById('submitBtn').classList.remove('show');
    document.getElementById('answerInput').focus();
    resetStarProgress();
    setAIState('LISTENING');
  }
  function showQuestionText(text) {
    document.getElementById('questionText').textContent = text;
  }
  function showQuestion(q, type, competency) {
    try { hashTrace('3_before_showQuestion', window.MedhaIQ_LastTurnId, q && q.id, q && q.text); }
    catch (e) { console.warn('[HASH-TRACE] stage 3 failed (non-fatal, instrumentation only):', e); }
    showQuestionMeta(q, type, competency);
    showQuestionText(q.text);
    // v2.4 — live snapshot for the voice handshake. The call-start handler
    // used to read a Q1 snapshot frozen at page load; if the candidate had
    // already advanced by text before voice connected, the AI then spoke a
    // STALE question that mismatched the card. Every question paint now
    // refreshes this, so voice always opens with the question on screen.
    window.MedhaIQ_CurrentQ = q.text;
  }
  window.MedhaIQ_showQuestionMeta = showQuestionMeta;
  window.MedhaIQ_showQuestionText = showQuestionText;

  document.getElementById('whyBtn').addEventListener('click', function(){
    document.getElementById('qWhyText').classList.toggle('shown');
  });

  /* ── Answer input ── */
  var answerInput = document.getElementById('answerInput');
  answerInput.addEventListener('input', function() {
    document.getElementById('charCount').textContent = this.value.length+' / 4000';
    var hasText = !!this.value.trim();
    document.getElementById('submitBtn').disabled = !hasText;
    document.getElementById('submitBtn').classList.toggle('show', hasText);
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 140)+'px';
    paintStarProgress(liveDetectStar(this.value), false);
  });

  document.getElementById('submitBtn').addEventListener('click', function(){ submitAnswer(false); });
  document.getElementById('skipBtn').addEventListener('click', function(){ submitAnswer(true); });

  /* Hard re-entrancy guard. Previously only submitBtn was disabled while a
     request was in flight — skipBtn had no lock at all, so an impatient
     candidate clicking "Skip" repeatedly during a slow AI scoring/next-
     question call could fire 2-3 overlapping POSTs. Each one independently
     read "answeredCount" before any of the others had saved, so more than
     MAXQ questions could get created and the session would run to 6/5, 7/5,
     etc. instead of ending at 5. isSubmitting blocks that at the source,
     regardless of which control the candidate mashes. */
  var isSubmitting = false;

  async function submitAnswer(skip) {
    if (isSubmitting) return;
    isSubmitting = true;
    var ans = skip ? '' : answerInput.value.trim();
    if (!skip && !ans) { isSubmitting = false; return; }
    document.getElementById('submitBtn').disabled = true;
    document.getElementById('skipBtn').disabled = true;
    setAIState('ANALYZING');
    showLoading('Analyzing your response...');
    slog('Q'+QN+' submitted — AI scoring...','info');
    try {
      var resp = await fetch('/api/interview/sessions/'+SID+'/answer', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ questionId: QID, answerText: ans, skip: skip }),
      });
      var data = await resp.json();
      if (resp.status === 409 && data.duplicate) {
        // A duplicate/raced submission for a question that's already been
        // answered — expected now and then if a click slipped through
        // before the button disabled. The winning request already advanced
        // the session normally, so there's nothing new to render — but we
        // MUST still unfreeze this losing request's UI, or the candidate is
        // stuck on "Analyzing..." forever with dead Skip/End buttons.
        slog('Duplicate submission ignored (already answered)', 'info');
        document.getElementById('loadingOverlay').classList.remove('show');
        document.getElementById('questionCard').style.display='flex';
        document.querySelector('.answer-bar-wrap').style.display='block';
        document.getElementById('submitBtn').disabled = false;
        document.getElementById('skipBtn').disabled = false;
        return;
      }
      if (!resp.ok) throw new Error(data.error || 'Server error '+resp.status);

      // The server now ALWAYS returns real intelligence_scores/star_progress
      // — including an explicit all-zero set for skip — so the dashboard
      // updates immediately and visibly every time, instead of silently
      // doing nothing on skip (which used to leave the bars wherever they
      // last were, making it look like nothing had been recorded).
      if (data.intelligence_scores) {
        updateMetrics(data.intelligence_scores);
        showToast(data.intelligence_scores.overallScore);
        slog('Scored: '+Math.round(data.intelligence_scores.overallScore)+'/100','ok');
      }
      if (data.star_progress) {
        paintStarProgress(data.star_progress, true);
        slog('STAR detected: '+data.star_progress.stepsComplete+'/4 components','info');
      }
      if (data.competency_tag) updateCompetency(data.competency_tag, 20);

      setAIState('GENERATING');

      if (data.turnId) slog('[turn-trace] TURN_ID='+data.turnId+' Frontend received: QuestionId='+(data.question ? data.question.id : QID), 'info');
      window.MedhaIQ_LastTurnId = data.turnId || null; // diagnostic correlation only — read by stage 3, which has no turnId parameter of its own
      try { hashTrace('2_frontend_json_parsed', data.turnId, data.question ? data.question.id : QID, data.text || (data.question ? data.question.text : '')); }
      catch (e) { console.warn('[HASH-TRACE] stage 2 failed (non-fatal, instrumentation only):', e); }
      try {
      if (DEBUG_HASH_TRACE) {
        var _flagLine = '[HASH-TRACE] stage=2_response_flags turnId=' + (data.turnId || 'null')
          + ' validationFailed=' + (data.validationFailed === undefined ? 'undefined' : data.validationFailed)
          + ' sessionEnded=' + (data.sessionEnded === undefined ? 'undefined' : data.sessionEnded)
          + ' question_type=' + (data.question && data.question.type !== undefined ? data.question.type : 'undefined')
          + (data.skip !== undefined ? ' skip=' + data.skip : '');
        console.log(_flagLine);
        if (typeof slog === 'function') slog(_flagLine, 'info');
      }
      } catch (e) { console.warn('[HASH-TRACE] stage 2 flags failed (non-fatal, instrumentation only):', e); }

      if (data.sessionEnded) {
      clearInterval(timerInt);
      setAIState('GENERATING_REPORT');
      slog('Session complete — generating report...','ok');
      showLoading('Generating your Career Intelligence Report...');
      
      // 🌟 Check if voice mode is live. If it is, wait 5.5 seconds so Vapi can say goodbye.
      // If they are just typing (text mode), redirect in 2.2 seconds like normal.
      var redirectDelay = window.MedhaIQVoiceLive ? 5500 : 2200;
      
      setTimeout(function(){ window.location.href='/interview/report/'+data.reportId; }, redirectDelay);
      return; // isSubmitting intentionally stays true — page is navigating away
    }

      // FIX 1 — validationFailed (sparse-answer reprompt): this is the SAME
      // question asked again with a request for more detail. It must NEVER
      // advance QID or QN — previously this fell through to the generic
      // "new question" handling below and incorrectly counted as progress.
      if (data.validationFailed) {
        slog('[turn-trace] TURN_ID='+data.turnId+' UI rendering REPROMPT (no advance): QuestionId='+QID, 'info');
        var repromptQ = { text: data.text, type: 'reprompt', id: QID, order: (data.question ? data.question.order : undefined) };
        pendingAudioUrl = data.audio_url || null;
        MedhaIQSync.hold(repromptQ, 'reprompt', data.competency_tag, skip, data.turnId);
        slog('Q'+QN+' — please expand (not a new question)','info');
        return;
      }

      // FIX 2 — follow-up questions do not count toward the 5-question
      // progress counter. QID still advances (it IS a new question/turn),
      // but QN must not — previously this incremented unconditionally for
      // every response type, including follow_up.
      QID = data.question.id;
      if (data.question.type !== 'follow_up') {
        QN = Math.min(QN + 1, MAXQ); // clamp — never display past MAXQ even if something upstream misbehaves
      }
      updateCounter();
      var nextQ = { text: data.text || data.question.text, type: data.question.type, id: data.question.id, order: data.question.order };
      pendingAudioUrl = data.audio_url || null;
      window.MedhaIQ_SessionAdvanced = true; // voice connecting late must not re-open from Q1
      slog('[turn-trace] TURN_ID='+data.turnId+' UI rendering ('+data.question.type+'): QuestionId='+data.question.id, 'info');
      MedhaIQSync.hold(nextQ, data.question.type, data.competency_tag || data.question.competency, skip, data.turnId);
      slog('Q'+QN+' ready','info');
    } catch (err) {
      console.error('[MedhaIQ]', err);
      slog('ERROR: '+err.message, 'err');
      document.getElementById('loadingOverlay').classList.remove('show');
      document.getElementById('questionCard').style.display='flex';
      document.querySelector('.answer-bar-wrap').style.display='block';
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('skipBtn').disabled = false;
      alert('Error: '+err.message);
    } finally {
      isSubmitting = false;
      document.getElementById('skipBtn').disabled = false;
    }
  }

  /* ── End session ── */
  document.getElementById('endBtn').addEventListener('click', async function(){
    if (!confirm('End this session? Your progress cannot be resumed.')) return;
    clearInterval(timerInt);
    try { await fetch('/api/interview/sessions/'+SID, { method:'DELETE' }); } catch(e){}
    window.location.href = '/dashboard/history';
  });

  /* ── Live Terminal — always expanded, no toggle needed ── */
  // Terminal content stays permanently visible; toggle removed per UX spec.

  /* ── Initialise ── */
  updateCounter();
  setAIState('CALIBRATING');
  if (INITQ) {
    // v2.0 CALIBRATION GATE (cold-start desync fix): with voice configured,
    // the question card stays hidden behind a "Calibrating Interviewer
    // Persona…" loader until Vapi certifies `call-start` (which also injects
    // the sessionReadyContext — see the Vapi block). A hard 8s fallback
    // reveals the question regardless, so no candidate is ever stuck.
    // Text-only sessions (no Vapi keys) reveal instantly, exactly as before.
    window.MedhaIQ_Q1 = INITQ; // read by the Vapi call-start handshake
    var HASVOICE = Boolean('<%= vapiPublicKey %>' && '<%= vapiAssistantId %>');
    window.MedhaIQ_HasVoice = HASVOICE; // read by the separate Vapi script block below (different IIFE scope)
    // ── FEATURE FLAG — set to false to disable all diagnostic hash-trace
  // logging cleanly, with no other code changes. window.MedhaIQ_hashTrace
  // and window.MedhaIQ_vapiPathTrace both become silent no-ops when off.
  var DEBUG_HASH_TRACE = true;
  window.MedhaIQ_DEBUG_HASH_TRACE = DEBUG_HASH_TRACE;

  // ── HASH-TRACE shared helper — diagnostic only, no behavior change.
  // Computes SHA-256 via the browser's native Web Crypto API and logs a
  // single, greppable line (now including payload length, computed
  // synchronously — no need to wait on the digest for that part).
  // Deliberately fire-and-forget (never awaited by any caller): the
  // functions being instrumented (showQuestion, instructNext, vapi.say)
  // must run at their normal, unmodified speed — the hash is computed and
  // logged slightly after the fact, in the background, correlated by
  // turnId/questionId rather than by blocking anything to log
  // synchronously.
  function hashTrace(stage, turnId, questionId, text, extra) {
    if (!DEBUG_HASH_TRACE) return;
    try {
      var t = String(text || '');
      var enc = new TextEncoder().encode(t);
      crypto.subtle.digest('SHA-256', enc).then(function(buf) {
        var hex = Array.from(new Uint8Array(buf)).map(function(b){ return b.toString(16).padStart(2,'0'); }).join('');
        var line = '[HASH-TRACE] stage=' + stage + ' turnId=' + (turnId || 'null') + ' questionId=' + (questionId === undefined || questionId === null ? 'null' : questionId) + ' len=' + t.length + ' first80=' + JSON.stringify(t.slice(0, 80)) + ' sha256=' + hex + (extra ? ' ' + extra : '');
        console.log(line);
        if (typeof slog === 'function') slog(line, 'info');
      }).catch(function(e){ console.error('[HASH-TRACE] hash failed', e); });
    } catch (e) { console.error('[HASH-TRACE] hashTrace threw', e); }
  }
  window.MedhaIQ_hashTrace = hashTrace;

  // Logs which speech mechanism actually fired — say() (forced, reliable),
  // fallback add-message (LLM-mediated, unreliable), or any other path —
  // at the exact moment it's chosen. No-ops when the flag is off.
  function vapiPathTrace(stage, turnId, questionId, path) {
    if (!DEBUG_HASH_TRACE) return;
    var line = '[HASH-TRACE] stage=' + stage + ' turnId=' + (turnId || 'null') + ' questionId=' + (questionId === undefined || questionId === null ? 'null' : questionId) + ' vapi_path=' + path;
    console.log(line);
    if (typeof slog === 'function') slog(line, path === 'vapi.say' ? 'ok' : 'err');
  }
  window.MedhaIQ_vapiPathTrace = vapiPathTrace;

  var revealQ1 = function(){ showQuestion({text:INITQ}, QTYPE, null); };
    // ── REDESIGN — no sequential waits. Every prior version of this block
    // GATED Q1's reveal behind a calibration overlay, waiting up to 8-15s
    // for voice to certify (or its own fallback timer) before the
    // candidate could see or answer anything. That's precisely backwards
    // from how every OTHER question in this app already works:
    // MedhaIQSync.hold() (used for Q2 onward — see ~line 146) reveals the
    // question text IMMEDIATELY and unconditionally, and only ATTEMPTS
    // voice as an independent addition alongside it — never a
    // precondition. Q1 now follows that exact same pattern instead of a
    // special-cased blocking one. The candidate can read and start
    // answering Q1 the instant the page loads, regardless of whether
    // voice is configured, connecting, slow, or never connects at all.
    // No overlay, no fallback timer, no calibration gate of any kind.
    revealQ1();
  }
  slog('Session #'+SID+' initialised', 'ok');
  slog('Persona (internal): '+PNAME, 'info'); /* debug-console only, never shown in candidate UI */
  slog('Role: '+ROLE+' | Level: '+LEVEL);
  window.MedhaIQ_log = slog; /* exposed for the Vapi block below */
  window.MedhaIQ_setAIState = setAIState;
  /* Exposed so the Vapi block can pulse STAR nodes live WHILE the candidate
     is mid-sentence (using partial speech transcripts that we deliberately do
     NOT write into the answer box — only finalized phrases get written). */
  window.MedhaIQ_liveStar = function(text){ paintStarProgress(liveDetectStar(text), false); };
  /* Voice intents (Bug fix: frozen counter on spoken "skip"). These call the
     EXACT same submitAnswer used by the on-screen buttons, so the question
     counter, server-side answeredCount, scoring, and session-end logic all
     advance identically whether the candidate clicks or speaks. */
  window.MedhaIQ_requestSkip   = function(){ submitAnswer(true);  };
  window.MedhaIQ_requestSubmit = function(){ submitAnswer(false); };
})();
</script>

<!-- ═══════════════════════════════════════════════════════════════
     WEBCAM — unchanged behaviour, restyled container only.
═══════════════════════════════════════════════════════════════ -->
<script>
(function(){
  var video    = document.getElementById('camVideo');
  var ph       = document.getElementById('camPlaceholder');
  var badge    = document.getElementById('camBadge');
  var badgeTxt = document.getElementById('camBadgeText');
  var toggle   = document.getElementById('camToggle');
  var stream   = null, on = false;

  async function startCam(){
    try{
      stream=await navigator.mediaDevices.getUserMedia({video:true,audio:false});
      video.srcObject=stream; video.style.display='block';
      ph.style.display='none';
      badge.classList.remove('off'); badgeTxt.textContent='● LIVE';
      toggle.textContent='Disable Camera';
      on=true;
    }catch(e){
      badgeTxt.textContent='BLOCKED';
      console.warn('[cam]',e.message);
    }
  }
  function stopCam(){
    if(stream){stream.getTracks().forEach(function(t){t.stop();}); stream=null;}
    video.style.display='none'; ph.style.display='flex';
    badge.classList.add('off'); badgeTxt.textContent='CAM OFF';
    toggle.textContent='Enable Camera';
    on=false;
  }
  toggle.addEventListener('click',function(){ if(!on)startCam(); else stopCam(); });
  setTimeout(startCam, 1400);
})();
</script>

<!-- ═══════════════════════════════════════════════════════════════
     VAPI VOICE STATE MACHINE — now driving a single inline mic
     button instead of a standalone panel button. Fixes the desync
     via MedhaIQSync (defined in the main engine script above).

     IMPORTANT CAVEAT (read before assuming this is 100% closed):
     `vapi.send({ type: 'add-message', ... })` is the documented way to
     hand Vapi's assistant a mid-call instruction, and the transcript
     listener below is the documented shape for its own spoken output.
     Both depend on how the assistant itself is configured on the Vapi
     dashboard (VAPI_ASSISTANT_ID) — if that assistant's own system
     prompt tells it to freelance rather than follow instructions handed
     to it mid-call, it can still say something different from what we
     asked it to. What this code guarantees is narrower but real: the
     text on screen will always match Vapi's own transcript of what it
     actually said — never a separate guess generated by our backend.
═══════════════════════════════════════════════════════════════ -->
<script>
(function(){
  // ── FAIL-SAFE diagnostic wrappers (bug fix) — hashTrace()/vapiPathTrace()
  // live in a DIFFERENT script block than every call site in this one.
  // These wrappers read the window-exposed versions and are guaranteed to
  // never throw, regardless of whether those functions exist, are still
  // loading, or ever fail internally. Instrumentation must never be able
  // to stop production logic — this is the enforcement point for that.
  function safeHashTrace() {
    try {
      if (typeof window.MedhaIQ_hashTrace === 'function') window.MedhaIQ_hashTrace.apply(null, arguments);
    } catch (e) { console.warn('[HASH-TRACE] safeHashTrace failed (non-fatal, instrumentation only):', e); }
  }
  function safeVapiPathTrace() {
    try {
      if (typeof window.MedhaIQ_vapiPathTrace === 'function') window.MedhaIQ_vapiPathTrace.apply(null, arguments);
    } catch (e) { console.warn('[HASH-TRACE] safeVapiPathTrace failed (non-fatal, instrumentation only):', e); }
  }

  var VKEY = '<%= vapiPublicKey %>';
  var VAST = '<%= vapiAssistantId %>';

  var btn = document.getElementById('vapiBtn');
  var sub = document.getElementById('vapiSub');
  var slog = window.MedhaIQ_log || function(){};

  if(!VKEY||!VAST){ btn.disabled = true; btn.style.opacity='0.4'; sub.textContent='Voice not configured — add VAPI keys in Render'; return; }

  var STATES={ IDLE:'IDLE',REQUESTING:'REQUESTING',CONNECTING:'CONNECTING',LIVE:'LIVE',STOPPING:'STOPPING' };
  var state=STATES.IDLE, vapi=null;
  var assistantTranscriptBuf = '';
  var aiIsSpeaking = false; // true between vapi 'speech-start' and 'speech-end' — guards verbal skip/submit commands
  var currentSpokenTurnId = null, currentSpokenQuestionId = null; // set by instructNext(), logged at speech-end for the final trace stage

  function setState(s,msg,isErr){
    state=s;
    btn.classList.toggle('live', s===STATES.LIVE);
    btn.disabled = (s===STATES.REQUESTING||s===STATES.CONNECTING||s===STATES.STOPPING);
    if(msg){ sub.textContent=msg; sub.style.color=isErr?'#ef4444':''; }
  }
  function setErr(msg){
    setState(STATES.IDLE,msg,true);
    setTimeout(function(){ if(state===STATES.IDLE){ sub.textContent='Speak directly with your AI interviewer'; sub.style.color=''; } },7000);
  }

  /* ── Exposed to the main engine's MedhaIQSync so it can (a) check
     whether voice is actually live and (b) hand Vapi the exact question
     our backend chose, instead of letting the two AI systems diverge. ── */
  window.MedhaIQVoice = {
    isLive: function(){ return state === STATES.LIVE && !!vapi; },
    /* v2.2 FIX — Vapi split-brain / 4-5s latency bug:
       `vapi.send({type:'add-message', role:'system', ...})` (the previous
       implementation) only INJECTS CONTEXT — it still requires Vapi's own
       LLM turn-taking logic to decide when, and whether, to actually speak
       the instructed text. That LLM-mediation is exactly what produced the
       symptom: several seconds of latency while it "thought", and
       occasional drift into a generic/hardcoded question instead of the
       backend's exact text.
       Vapi's Web SDK exposes a separate, documented method for this exact
       case — `vapi.say(text)` — which invokes speech of the given text
       DIRECTLY, bypassing LLM generation entirely. That is now the primary
       mechanism. The system add-message is kept, but demoted to a short
       anti-drift guard only (no longer carrying the question text itself),
       sent first so it can never delay or precede the forced utterance. */
    instructNext: function(questionText, wasSkipped, turnId, questionId){
      safeHashTrace('4_before_instructNext', turnId, questionId, questionText);
      if (state !== STATES.LIVE || !vapi) return false;
      try {
        var lead = wasSkipped
          ? 'No problem, let\u2019s move on. '
          : '';
        // Track the in-flight turn so the speech-end handler below can log
        // the final stage of the trace against the same TURN_ID/QuestionId.
        currentSpokenTurnId = turnId || null;
        currentSpokenQuestionId = (questionId !== undefined && questionId !== null) ? questionId : null;
        // Anti-drift guard only — no question text here, so there is
        // nothing left for the LLM to mediate, paraphrase, or delay.
        vapi.send({
          type: 'add-message',
          // FIX: without this flag, the Vapi SDK's default behavior lets
          // the assistant's model take a free, unconstrained turn in
          // response to this injected message — on EVERY question, right
          // before the forced vapi.say() below. That free turn is a
          // documented, concrete explanation for "Vapi says something
          // different than the screen": the model generates its own
          // response to this context injection, and it can win the race
          // against the forced speech that follows. Setting this false
          // makes the injection silent — no model turn, just context.
          triggerResponseEnabled: false,
          message: {
            role: 'system',
            content: 'Do not add any commentary, acknowledgment, or remarks of your own beyond exactly what you are about to be told to say next. Do not repeat, summarize, or reference any earlier question or answer.'
          }
        });
        // Force deterministic, immediate speech of the EXACT backend text —
        // this is the single source of truth for both the on-screen card
        // and the spoken audio; no LLM step sits between them.
        if (typeof vapi.say === 'function') {
          var vapiPayload = lead + String(questionText);
          safeHashTrace('5a_vapi_payload_raw_question_text', turnId, questionId, questionText);
          safeHashTrace('5b_vapi_payload_final_with_prefix', turnId, questionId, vapiPayload, 'hasPrefix=' + (lead.length > 0));
          safeVapiPathTrace('5_vapi_speech_path', turnId, questionId, 'vapi.say');
          vapi.say(vapiPayload);
          slog('Forced speech via vapi.say()', 'ok');
          if (turnId) slog('[turn-trace] TURN_ID='+turnId+' vapi.say(): QuestionId='+questionId, 'info');
        } else {
          // Defensive fallback only, in case an older SDK build lacks
          // say() — keeps the session functional rather than silent.
          // IMPORTANT: this fallback is context injection, not forced
          // speech — the model can still choose to ignore it, paraphrase
          // it, or ask something else entirely. If you're seeing Vapi ask
          // a generic/"standard" question that doesn't match the screen,
          // check the Live Terminal / console for THIS warning — it means
          // vapi.say() isn't available on the loaded SDK build
          // (window.vapiSDK from html-script-tag), and every question in
          // this session is running on the unreliable fallback path.
          safeVapiPathTrace('5_vapi_speech_path', turnId, questionId, 'fallback_add_message');
          console.warn('[Vapi] vapi.say() unavailable on this SDK build — falling back to context injection');
          slog('WARNING: vapi.say() unavailable — question sent as a suggestion only, not forced', 'err');
          if (turnId) slog('[turn-trace] TURN_ID='+turnId+' vapi.say() UNAVAILABLE — fallback used for QuestionId='+questionId, 'err');
          vapi.send({
            type: 'add-message',
            message: {
              role: 'system',
              content: 'Now read aloud, verbatim and word for word, exactly this next question: "' + String(questionText).replace(/"/g, "'") + '". Say it once, then stop and listen.'
            }
          });
        }
        return true;
      } catch (e) {
        console.error('[Vapi] instructNext failed', e);
        return false;
      }
    }
  };

  function initVapi(){
    if(vapi||!window.vapiSDK)return;
    /* v2.3 — assistantOverrides: suppress the dashboard-configured First
       Message. Without this, the assistant's own greeting ("Hi! What role
       are you applying for?") fires the instant the call connects — BEFORE
       any of our page's injections or say() calls can run — which is the
       double-greeting / wrong-question-first bug. `firstMessageMode:
       'assistant-waits-for-user'` tells Vapi to stay silent at call start;
       our call-start handler then speaks the persona intro + exact Q1 via
       vapi.say(). If this SDK build ignores assistantOverrides, behavior
       simply falls back to today's — the key is harmless when unsupported,
       and the dashboard fix (see deploy notes) covers that case. */
    vapi=window.vapiSDK.run({ 
  apiKey: VKEY, 
  assistant: VAST, 
  assistantOverrides: { 
    firstMessageMode: 'assistant-waits-for-user',
    // This injects the matching database ID directly into Vapi's call details
    metadata: {
      sessionId: '<%= sessionId %>'
    }
  }, 
  config: { position: 'hidden' } 
});

    // REDESIGN: the call-start-success listener is removed. It existed
    // solely to certify a calibration GATE against a fragile connection
    // signal — but there is no gate anymore (Q1 reveals immediately,
    // unconditionally). Nothing is left for it to certify.
    vapi.on('call-start', function() {
      setState(STATES.LIVE, 'Voice active — speak your answer');
      window.MedhaIQVoiceLive = true;
      /* ── v2.2 sessionReadyContext handshake (cold-start amnesia + latency
         fix) — two-part, matching the instructNext fix above:
         1. FACTS the assistant needs to know (role, level, no-discovery-
            questions rule) are genuinely contextual, not an utterance —
            these correctly stay as a `system` add-message.
         2. The exact WORDS the assistant must say (persona intro + Q1,
            verbatim) are no longer routed through add-message, because that
            still requires the LLM to decide to speak them — the same
            LLM-mediation that caused the 4-5s latency loop and generic-
            question drift. `vapi.say()` forces that speech directly,
            deterministically, with zero generation step in between. ── */
      /* ── v2.5 hardened handshake ──
         Two independent steps, each in its own try/catch, SPEECH FIRST:
         a failure in the context injection can never again abort the
         say() call (that shared-try ordering was the silent-AI bug).
         All variables are read from the window bridge — never bare
         engine-scope identifiers. */
      var _pname = String(window.MedhaIQ_PNAME || 'your interviewer');
      var _role  = String(window.MedhaIQ_ROLE  || '');
      var _level = String(window.MedhaIQ_LEVEL || '');
      try {
        if (typeof vapi.say === 'function') {
          var currentQ = String(window.MedhaIQ_CurrentQ || window.MedhaIQ_Q1 || '');
          var opening = window.MedhaIQ_SessionAdvanced
            ? 'Thanks, voice is on now \u2014 let\u2019s continue. Here\u2019s the current question again: '
            : ('Hi, I\u2019m ' + _pname + '. Let\u2019s get started. ');
          var _openingPayload = opening + currentQ;
          safeHashTrace('5a_vapi_payload_raw_question_text', window.MedhaIQ_LastTurnId, null, currentQ);
          safeHashTrace('5b_vapi_payload_final_with_prefix', window.MedhaIQ_LastTurnId, null, _openingPayload, 'hasPrefix=true (persona intro)');
          safeVapiPathTrace('5_vapi_speech_path', window.MedhaIQ_LastTurnId, null, 'vapi.say');
          vapi.say(_openingPayload);
          slog('Opening question forced via vapi.say()', 'ok');
        } else {
          safeVapiPathTrace('5_vapi_speech_path', window.MedhaIQ_LastTurnId, null, 'fallback_add_message');
          console.warn('[Vapi] vapi.say() unavailable on this SDK build — falling back to context injection');
          slog('WARNING: vapi.say() unavailable — opening question sent as a suggestion only, not forced', 'err');
          vapi.send({
            type: 'add-message',
            message: {
              role: 'system',
              content: 'Open with your assigned interviewer persona introduction in ONE short sentence, then read aloud, verbatim and word for word, exactly this question: "'
                + String(window.MedhaIQ_CurrentQ || window.MedhaIQ_Q1 || '').replace(/"/g, "'") + '". Then stop and listen.'
            }
          });
        }
      } catch (e) { console.error('[Vapi] opening speech failed', e); }
      try {
        vapi.send({
          type: 'add-message',
          // Same fix as above — this call-start injection was equally able
          // to trigger an unwanted free model turn immediately after the
          // forced opening speech.
          triggerResponseEnabled: false,
          message: {
            role: 'system',
            content:
              'SESSION READY CONTEXT — the session payload variables are locked and were selected before this call: '
              + 'role = "' + _role.replace(/"/g, "'") + '", experience level = "' + _level.replace(/"/g, "'") + '". '
              + 'You must bypass all raw discovery greetings: never ask what role the candidate is applying for, what they want to practice, or any setup question. '
              + 'You will be told exactly what to say via direct speech. Do not add anything before or after it.'
          }
        });
      } catch (e) { console.error('[Vapi] sessionReadyContext injection failed', e); }
      // REDESIGN: no lockInput() here anymore. Q1 was already visible and
      // answerable before voice ever connected — the candidate may be
      // mid-answer right now. Forcibly locking input the instant Vapi
      // starts reading the SAME already-visible question aloud would cut
      // off live typing. voiceConnected() is kept purely as harmless
      // diagnostic bookkeeping (no UI effect: reveal() is already a
      // permanent no-op by this point).
      if (window.MedhaIQOrchestrator) {
        window.MedhaIQOrchestrator.voiceConnected();
      }
    });

    /* The ONLY source of truth for what appears in the question card
       while voice is live: Vapi's own transcript of what it is actually
       saying, painted live as it speaks — not a pre-fetched guess from
       our backend. This is what actually closes the "text doesn't match
       what the AI says" bug: whatever's on screen IS what was said,
       because it's built from the same transcript, word for word. */
    vapi.on('message', function(message) {
      if (!message || message.type !== 'transcript') return;

      /* ── Assistant speech (v2 FIX) ──
         The assistant's spoken words are HEARD, not painted: the question
         card always shows the backend's canonical question text (painted
         by MedhaIQSync.hold). This is what killed two bugs at once:
         (a) the opening question no longer vanishes when the AI starts
             speaking, and
         (b) conversational filler ("That's fantastic, the $50M pipeline…")
             and any repeated riffs on earlier answers can no longer appear
             AS the question. The transcript is still buffered for the
             staff debug console. */
      if (message.role === 'assistant') {
        if (message.transcriptType === 'final' && message.transcript) {
          if (!assistantTranscriptBuf) {
            // First chunk of this turn's speech (buffer was empty going in).
            safeHashTrace('6_first_assistant_transcript', currentSpokenTurnId, currentSpokenQuestionId, message.transcript);
          }
          assistantTranscriptBuf = (assistantTranscriptBuf ? assistantTranscriptBuf + ' ' : '') + message.transcript;
        }
        return;
      }

      /* ── Candidate speech → answer box (NEW) ──
         This was the missing half: user transcripts were previously thrown
         away, so a voice-only answer never reached the answer box, the live
         STAR tracker, or the scoring endpoint.
         - FINAL phrases are appended to the answer textarea and a real
           'input' event is dispatched, so every existing typing behaviour
           fires untouched: char count, submit-button enable, autosize, and
           live STAR/skip detection. The submitted answer is now exactly what
           was spoken (plus anything typed).
         - PARTIAL (in-progress) phrases are NOT written into the box (they
           get revised by the recognizer); they only feed the live STAR
           pulse, so nodes/skips light up mid-sentence while speaking. */
      if (message.role === 'user') {
        var input = document.getElementById('answerInput');
        if (!input) return;
        if (message.transcriptType === 'final' && message.transcript) {
          var chunk = String(message.transcript).trim();

          /* ── Spoken intent classifier (v3 — sentence-aware) ──
             v1/v2 required the ENTIRE utterance to be nothing but a bare
             command phrase ("skip", "next question, please"). Real speech
             is rarely that clean — people preface it ("I'm not sure I know
             it") or repeat the command a few times in one breath. That
             whole-utterance requirement is exactly what failed on:
               "I'm not sure I know it. Move it to the next question.
                Move to the next question. Move to the next question."
             — every clause there was a legitimate skip request, and none
             matched, so the whole thing landed in the answer box as literal
             text and the session never advanced.
             Fix, two parts:
             1. INTENT_RE now also covers "move (it/this) to (the) next
                question/one" — a construction ("move TO next") that simply
                wasn't in the phrase list before (only "move ON" was).
             2. Instead of testing the whole raw utterance, split it into
                sentences and test each independently, checking from the
                LAST sentence backward (the most recent instruction in a
                repeated/prefaced utterance is what the candidate actually
                wants acted on). A genuine, substantive answer is extremely
                unlikely to contain an isolated ≤8-word sentence that exactly
                equals one of these command phrases, so this doesn't
                introduce new false positives on real answers. */
          var INTENT_RE = /^((let'?s |please |can (we|you) )?skip( (this|that|the) (question|one)| it| this| that)?( please)?|(let'?s |please |can (we|you) )?move (it |this )?(on|to( the)? next( question| one)?)( please)?|(let'?s |please |can (we|you) )?next( question| one)?( please)?|pass|i (don'?t|do not) know( the answer)?( to (this|that))?|no idea|i'?m done|that'?s (my answer|all|it)|submit( my answer)?|done)$/i;
          var sentences = chunk
            .split(/[.!?]+/)
            .map(function (s) { return s.replace(/[,;:]+/g, ' ').replace(/\s+/g, ' ').trim(); })
            .filter(Boolean);
          var matchedCommand = null;
          for (var _si = sentences.length - 1; _si >= 0; _si--) {
            var _s = sentences[_si];
            if (_s.split(/\s+/).length <= 8 && INTENT_RE.test(_s)) { matchedCommand = _s; break; }
          }
          var isCommand = !!matchedCommand;
          if (isCommand) {
            /* ── Guard block: verbal command mid-speech (v2 — non-blocking) ──
               v1 of this guard swallowed the command entirely whenever
               aiIsSpeaking was true and made the candidate repeat it once
               speech ended. That was wrong: if Vapi's own turn-taking keeps
               it talking almost continuously (e.g. because vapi.say() isn't
               reliably taking over the turn on this SDK build — see the
               warning logged in instructNext()), aiIsSpeaking is true for
               nearly the entire session, so EVERY command got dropped and
               the session silently stalled on one question forever with
               Vapi improvising on its own. Barge-in must always win: the
               command executes immediately either way. aiIsSpeaking is only
               used here to log that a barge-in happened, and to note (not
               act on) that Vapi's own audio is still catching up — the
               actual "stop the assistant's current utterance" fix belongs
               server-side, in the assistant's stopSpeakingPlan.interruptionPhrases
               (see https://docs.vapi.ai/customization/voice-pipeline-configuration). */
            if (aiIsSpeaking) {
              slog('Barge-in: "'+chunk+'" received while interviewer was still speaking — proceeding anyway', 'info');
            }
            var answerWords = input.value.trim().split(/\s+/).filter(Boolean).length;
            if (answerWords >= 8 && window.MedhaIQ_requestSubmit) {
              slog('Voice intent: submit ("'+chunk+'")', 'info');
              window.MedhaIQ_requestSubmit();
            } else if (window.MedhaIQ_requestSkip) {
              slog('Voice intent: skip ("'+chunk+'")', 'info');
              window.MedhaIQ_requestSkip();
            }
            return; // command phrases are never written into the answer
          }

          input.value = (input.value ? input.value.replace(/\s+$/, '') + ' ' : '') + chunk;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        } else if (window.MedhaIQ_liveStar) {
          window.MedhaIQ_liveStar((input.value ? input.value + ' ' : '') + (message.transcript || ''));
        }
      }
    });

    vapi.on('speech-start', function() {
      // Hard sync fix: Tell the orchestrator that the speaker audio track has started playing
      if (window.MedhaIQOrchestrator) {
        window.MedhaIQOrchestrator.interviewerStartedSpeaking();
      }
      assistantTranscriptBuf = ''; // fresh buffer — don't carry over last question's text
      aiIsSpeaking = true;
      sub.textContent = '● AI is speaking…';
    });

    vapi.on('speech-end', function() {
      aiIsSpeaking = false;
      sub.textContent = 'Your turn — speak clearly';
      if (currentSpokenTurnId) {
        slog('[turn-trace] TURN_ID='+currentSpokenTurnId+' Speech finished: QuestionId='+currentSpokenQuestionId, 'info');
      }
      // Input gate: the question has fully finished playing — unlock.
      if (window.MedhaIQOrchestrator) window.MedhaIQOrchestrator.unlockInput();
    });
    
    vapi.on('call-end', function() {
      window.MedhaIQVoiceLive = false;
      setState(STATES.IDLE, 'Speak directly with your AI interviewer');
    });

    vapi.on('error',function(e){
      console.error('[Vapi]',e);
      var msg='Connection error — retry';
      if(e&&e.message){
        if(/permission|not allowed/i.test(e.message)) msg='Microphone blocked — check browser settings';
        else if(/network|fetch/i.test(e.message))     msg='Network error — check your connection';
        else if(/assistant/i.test(e.message))         msg='Config error — check VAPI_ASSISTANT_ID';
      }
      setErr(msg);
    });
  }

  // ── Option A: auto-connect voice at page load ──────────────────────
  // Extracted VERBATIM from the original click handler — every internal
  // line, every guard, every state transition is byte-identical to what
  // was already tested and audited. The ONLY change is that this logic
  // now lives in a named function callable from two places (auto-start at
  // page load, and manual retry via click) instead of being inline in
  // exactly one place. No internal behavior, ordering, or guard changes.
  async function connectVoice(){
    if(state===STATES.LIVE||state===STATES.STOPPING){
      setState(STATES.STOPPING,'Ending voice session…');
      if(vapi){try{vapi.stop();}catch(e){}}
      return;
    }
    if(state!==STATES.IDLE)return;

    setState(STATES.REQUESTING,'Requesting microphone access…');
    try{
      var ms=await navigator.mediaDevices.getUserMedia({audio:true});
      ms.getTracks().forEach(function(t){t.stop();});
    }catch(e){
      if(e.name==='NotAllowedError') setErr('Microphone access required — click the lock icon in your browser bar');
      else if(e.name==='NotFoundError') setErr('No microphone detected');
      else setErr('Mic error: '+e.message);
      return;
    }

    if(!window.vapiSDK){
      setState(STATES.CONNECTING,'Loading voice engine…');
      var waited=0;
      try{
        await new Promise(function(res,rej){
          var t=setInterval(function(){
            waited+=150;
            if(window.vapiSDK){clearInterval(t);res();}
            if(waited>9000){clearInterval(t);rej(new Error('Voice SDK load timeout'));}
          },150);
        });
      }catch(e){ setErr(e.message); return; }
    }
    if(state!==STATES.CONNECTING&&state!==STATES.REQUESTING)return;

    setState(STATES.CONNECTING,'Connecting to AI interviewer…');
    // REDESIGN: no calibration clock to start here anymore — Q1 was
    // already revealed unconditionally at page load, regardless of this
    // connection attempt's outcome or timing.
    try{ initVapi(); vapi.start(VAST); }
    catch(e){ setErr('Failed to connect: '+e.message); return; }

    setTimeout(function(){
      if(state===STATES.CONNECTING) {
        // FIX: this used to only show an error and reset the UI to IDLE —
        // it never actually stopped the stale connection attempt. That
        // left the real Vapi object silently still trying in the
        // background, with `this.started` still true internally. Any
        // subsequent click called initVapi() (no-op, vapi already exists)
        // and vapi.start() (no-op, already started, per Vapi's own SDK —
        // it emits a failure event and returns immediately without
        // attempting anything new). The "retry" therefore did nothing;
        // what eventually succeeded was always the ORIGINAL attempt,
        // finally landing late — which is exactly what produced "14s
        // calibration fallback, then click, then another 15s wait."
        // Actually calling stop() here resets Vapi's own internal
        // `started` flag to false, so a genuine fresh attempt becomes
        // possible on the next click (or auto-retry) instead of a silent
        // no-op dressed up as one.
        if (vapi) { try { vapi.stop(); } catch(e) {} }
        setErr('Connection timed out — check your internet and retry');
      }
    },13000);
  }

  btn.addEventListener('click', connectVoice);

  setInterval(function(){ if(state===STATES.IDLE&&btn.disabled) btn.disabled=false; },3000);
  // REDESIGN: voice connects ONLY on click, not automatically at page
  // load. There's no longer a calibration gate for it to race against —
  // Q1 is already visible and answerable regardless — so auto-starting
  // has no benefit here and only means requesting mic permission before
  // the candidate has chosen to use voice at all. connectVoice() runs
  // fully in the background relative to the rest of the UI: nothing it
  // does can block or delay reading/answering the current question.
})();
</script>

</body>
</html>
