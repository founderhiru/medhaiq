<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Interview OS — MedhaIQ</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <script>
  (function(d,t){
    var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
    g.src='https://cdn.jsdelivr.net/gh/VapiAI/html-script-tag@latest/dist/assets/index.js';
    g.defer=true; g.async=true; s.parentNode.insertBefore(g,s);
  })(document,'script');
  </script>
  <link rel="stylesheet" href="/css/interview-session.css">
</head>
<body>

<!-- ═══ SINGLE TOP BAR — matches Target2.jpg exactly:
     "MedhaIQ.live | Interview Session" (left) · LIVE · timer · Qx/5 (center-right) · End Session (right) ═══ -->
<div class="topbar">
  <span class="tb-brand">Medha<em>IQ</em>.live</span>
  <span class="tb-brand-sep">|</span>
  <div class="tb-session-meta">
    <div class="tb-session-label" id="tbSessionLabel">Interview Session</div>
  </div>
  <div class="tb-right">
    <div class="tb-live"><div class="tb-live-dot"></div>LIVE</div>
    <div class="tb-timer" id="timer">00:00</div>
    <div class="tb-meta" id="qCounter">Q1 / 5</div>
    <button class="tb-end" id="endBtn">End Session</button>
  </div>
</div>

<div class="os-grid">

  <%- include('partials/session-context') %>

  <%- include('partials/active-question') %>

  <%- include('partials/live-terminal') %>

</div><!-- /os-grid -->

<!-- Score toast -->
<div class="score-toast" id="scoreToast">
  <div>
    <div class="toast-score" id="toastScore">—</div>
    <div class="toast-lbl">Answer Score</div>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════════
     HIDDEN DEBUG CONSOLE
     Opens with Ctrl+Shift+D. Never surfaced to a candidate. Holds
     everything that's useful for troubleshooting a live session but
     adds cognitive noise for the person being interviewed: activity
     log, competency coverage, and raw audio metadata.
══════════════════════════════════════════════════════════════ -->
<div class="debug-console" id="debugConsole">
  <div class="dbg-hdr">
    <span class="dbg-hdr-title">⚠ DEBUG CONSOLE — STAFF ONLY</span>
    <button class="dbg-close" id="dbgClose">✕</button>
  </div>
  <div class="dbg-section">
    <div class="dbg-section-lbl">Session</div>
    <div class="dbg-meta-grid">
      <div class="dbg-meta-cell"><div class="k">Session ID</div><div class="v">#<%= sessionId %></div></div>
      <div class="dbg-meta-cell"><div class="k">Question ID</div><div class="v" id="dbgQid">—</div></div>
    </div>
  </div>
  <div class="dbg-section">
    <div class="dbg-section-lbl">Competency Coverage</div>
    <div id="dbgCompMap">
      <div class="dbg-comp-row"><span class="dbg-comp-name">System Design</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-system_design" style="width:0%;background:#3b82f6;"></div></div><span class="dbg-comp-count" id="compC-system_design">0</span></div>
      <div class="dbg-comp-row"><span class="dbg-comp-name">Leadership</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-leadership" style="width:0%;background:#22c55e;"></div></div><span class="dbg-comp-count" id="compC-leadership">0</span></div>
      <div class="dbg-comp-row"><span class="dbg-comp-name">Strategy</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-strategy" style="width:0%;background:#a78bfa;"></div></div><span class="dbg-comp-count" id="compC-strategy">0</span></div>
      <div class="dbg-comp-row"><span class="dbg-comp-name">Communication</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-communication" style="width:0%;background:#f59e0b;"></div></div><span class="dbg-comp-count" id="compC-communication">0</span></div>
      <div class="dbg-comp-row"><span class="dbg-comp-name">Technical</span><div class="dbg-comp-track"><div class="dbg-comp-fill" id="comp-technical" style="width:0%;background:#fb923c;"></div></div><span class="dbg-comp-count" id="compC-technical">0</span></div>
    </div>
  </div>
  <div class="dbg-section">
    <div class="dbg-section-lbl">Audio Metadata</div>
    <div class="dbg-meta-grid">
      <div class="dbg-meta-cell"><div class="k">Filler Words</div><div class="v" id="advFiller">0</div></div>
      <div class="dbg-meta-cell"><div class="k">Pace</div><div class="v" id="advPace">—</div></div>
      <div class="dbg-meta-cell"><div class="k">Executive Tone</div><div class="v" id="advTone">—</div></div>
      <div class="dbg-meta-cell"><div class="k">Coherence</div><div class="v" id="advCoherence">—</div></div>
    </div>
  </div>
  <div class="dbg-section-lbl" style="padding:10px 14px 0;">Activity Log</div>
  <div class="dbg-log-body" id="slogBody"></div>
  <div class="dbg-hint">Ctrl+Shift+D to close</div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     INTERVIEW OS ENGINE
═══════════════════════════════════════════════════════════════ -->
<script>
(function() {
  /* ══ Sync engine — fixes the UI/audio desync bug ══
     THE ROOT BUG: two independent AI calls were generating "the next
     question" — our own backend text call, AND whatever Vapi's own voice
     assistant decided to actually say — with nothing forcing them to
     match. The card showed our backend's guess the moment it arrived,
     regardless of what the voice assistant was really saying a beat
     later, so the two drifted apart on almost every question.
     THE FIX: when voice is live, our backend's text is sent to Vapi as an
     instruction for what to ask (via window.MedhaIQVoice.instructNext,
     wired up in the Vapi script below), and the on-screen card is ONLY
     ever painted from Vapi's own live transcript of what it actually
     says (see vapi.on('message') below) — never from our own guess. In
     text-only mode (no voice connected) there's nothing to wait for, so
     it still paints our backend text immediately, same as before. */
  var pendingQuestion = null;
  var pendingAudioUrl = null;
  var qAudioEl = new Audio();
  var MedhaIQSync = {
    hold: function(question, type, competency) {
      pendingQuestion = { question: question, type: type, competency: competency };
      var voice = window.MedhaIQVoice;
      if (voice && voice.isLive && voice.isLive()) {
        // Paint everything EXCEPT the question body right away (counter,
        // "why this question", input reset) — the body stays a neutral
        // placeholder until Vapi's own transcript fills it in live.
        showQuestionMeta(question, type, competency);
        showQuestionText('Listening for your interviewer…');
        var instructed = voice.instructNext(question.text);
        pendingQuestion = null;
        if (instructed) {
          pendingAudioUrl = null; // Vapi is speaking now — our own TTS clip (if any) must not fire later
          return;
        }
        // instructNext failed (voice flagged live but the call object
        // isn't actually usable) — fall back to the text reveal below so
        // the candidate never gets stuck on the placeholder.
      }
      MedhaIQSync.reveal();
    },
    reveal: function() {
      if (!pendingQuestion) return;
      showQuestion(pendingQuestion.question, pendingQuestion.type, pendingQuestion.competency);
      pendingQuestion = null;
      if (pendingAudioUrl) {
        try { qAudioEl.src = pendingAudioUrl; qAudioEl.play().catch(function(){}); } catch(e){}
        pendingAudioUrl = null;
      }
    }
  };
  window.MedhaIQSync = MedhaIQSync;
  window.MedhaIQVoiceLive = false;

  /* ── EJS-injected session variables ── */
  var SID    = '<%= sessionId %>';
  var QID    = '<%= questionId %>';
  var QN     = <%= answeredCount %> + 1;
  var MAXQ   = 5;
  var SEC_PER_Q = 180; /* 3 min budget per question, drives the "Est. remaining" clock */
  var PNAME  = '<%= personaName %>';
  var PTITLE = '<%= personaTitle %>';
  var PINIT  = '<%= personaInitials %>';
  var PCOL   = '<%= personaStyleColor %>';
  var QTYPE  = '<%= questionType %>';
  var ROLE   = '<%= roleTitle %>';
  var LEVEL  = '<%= experienceLevel %>';
  var INITQ  = `<%- questionText.replace(/`/g, '\\`') %>`;

  /* Persona (PNAME/PTITLE/PINIT/PCOL) is retained purely as internal
     session data for scoring/report generation — it is never rendered.
     The UI shows only the candidate and the System's own presence. */
  document.getElementById('sbRole').textContent   = ROLE  || '—';
  document.getElementById('sbLevel').textContent  = LEVEL || '—';

  /* ── Elapsed timer (topbar) + Est. remaining (sidebar) — both driven off
     the SAME real clock now. Previously "Est. remaining" was recomputed
     only from the question count (MAXQ-remaining * 180s) and never moved
     within a question, so it could show 9:00 remaining while the actual
     elapsed timer said 2:00 — the two numbers had nothing to do with each
     other. Now there's one 15:00 session budget and remaining = budget
     minus actual elapsed seconds, ticking every second like the timer. ── */
  var TOTAL_BUDGET_SEC = MAXQ * SEC_PER_Q; // 5 * 180s = 15:00 total
  var t0 = Date.now(), timerInt;
  function mmss(totalSeconds) {
    var s = Math.max(0, Math.floor(totalSeconds));
    return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
  }
  function tick() {
    var elapsed = Math.floor((Date.now()-t0)/1000);
    document.getElementById('timer').textContent = mmss(elapsed);
    document.getElementById('sbTimeRemaining').textContent = mmss(TOTAL_BUDGET_SEC - elapsed);
  }
  timerInt = setInterval(tick, 1000);
  tick();

  function updateCounter() {
    document.getElementById('qCounter').textContent = 'Q'+QN+' / '+MAXQ;
    document.getElementById('sbProgNum').textContent = QN;
    var pct = Math.round(((QN-1)/MAXQ)*100);
    document.getElementById('sbProgFill').style.width = pct+'%';
    var remaining = Math.max(0, MAXQ-(QN-1));
    document.getElementById('sbProgRemaining').textContent = remaining + (remaining===1?' question remaining':' questions remaining');
  }

  /* ── Debug console (staff-only, Ctrl+Shift+D) ── */
  var dbg = document.getElementById('debugConsole');
  document.addEventListener('keydown', function(e){
    if (e.ctrlKey && e.shiftKey && (e.key==='D'||e.key==='d')) dbg.classList.toggle('open');
  });
  document.getElementById('dbgClose').addEventListener('click', function(){ dbg.classList.remove('open'); });

  function slog(msg, type) {
    var el = document.getElementById('slogBody');
    var ts = new Date().toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
    var cls= 'dbg-entry' + (type==='ok'?' ok':type==='err'?' err':type==='info'?' info':'');
    el.insertAdjacentHTML('afterbegin','<div class="'+cls+'">['+ts+'] '+msg+'</div>');
  }

  var compScores = { system_design:0, leadership:0, strategy:0, communication:0, technical:0 };
  function updateCompetency(key, increment) {
    if (!(key in compScores)) return;
    compScores[key] = Math.min(100, compScores[key] + (increment || 20));
    var bar = document.getElementById('comp-'+key);
    var cnt = document.getElementById('compC-'+key);
    if (bar) bar.style.width = compScores[key]+'%';
    if (cnt) cnt.textContent = parseInt(cnt.textContent||0)+1;
  }

  /* ══ 5-Vector metrics — consumes the standardized IntelligenceMetrics
     schema: { overallScore, vectors:{...}, status, metadata:{...} } ══ */
  var runningScores = [];
  function updateMetrics(m) {
    if (!m || !m.vectors) return;
    runningScores.push(m);
    var v = m.vectors;
    // .hasOwnProperty style checks would be overkill here — these are
    // always-present numeric fields from the server — but the important
    // fix is using `?? 0` (nullish coalescing) instead of `|| 0`: `?? 0`
    // only substitutes when the value is null/undefined, so a genuine 0
    // passes straight through instead of being masked by a fallback that
    // happens to also be 0 (same value, but this makes the intent explicit
    // and safe against a future change to the fallback).
    [['mStar','mStarV', v.structure ?? 0], ['mTech','mTechV', v.technicalDepth ?? 0],
     ['mExec','mExecV', v.executivePresence ?? 0], ['mGcc','mGccV', v.gccReadiness ?? 0],
     ['mFric','mFricV', v.communicationClarity ?? 0]].forEach(function(r) {
      var val = Math.round(r[2]);
      var isZero = val === 0;
      var bar = document.getElementById(r[0]); var lbl = document.getElementById(r[1]);
      if (bar) {
        bar.classList.toggle('is-zero', isZero);
        // Always set width explicitly — 0 renders as empty bar (0% fill, track
        // background visible), never hidden. Immediate DOM update, no delay.
        bar.style.width = val + '%';
      }
      if (lbl) {
        lbl.textContent = val;
        lbl.classList.toggle('is-zero', isZero);
      }
    });
    if (m.metadata) {
      document.getElementById('advFiller').textContent    = m.metadata.fillerWords ?? '0';
      document.getElementById('advPace').textContent      = m.metadata.pace || '—';
      document.getElementById('advTone').textContent      = m.metadata.executiveTone || m.metadata.coherence || '—';
      document.getElementById('advCoherence').textContent = m.metadata.coherence || '—';
    }
    document.getElementById('dbgQid').textContent = QID;
    updateScoreRing(m.overallScore);
  }

  function updateScoreRing(latestOverall) {
    if (typeof latestOverall !== 'number') return;
    var total = runningScores.reduce(function(a,s){ return a+(s.overallScore||0); }, 0);
    var avg   = Math.round(total / runningScores.length);
    var CIRC  = 213; /* 2 * π * 34 */
    document.getElementById('ringFill').style.strokeDashoffset = CIRC - (CIRC*avg/100);
    var lbl = document.getElementById('ringLabel');
    lbl.textContent = avg;
    var tier = avg>=75?'high':avg>=55?'mid':'low';
    lbl.style.color = avg>=75?'#22c55e':avg>=55?'#f59e0b':'#ef4444';
    var STATUS_COPY = {
      high: ['Strong Performance', "You're demonstrating excellent leadership potential."],
      mid:  ['Solid Progress', 'A few more concrete results would sharpen this further.'],
      low:  ['Early Signal', 'Lean harder into STAR structure and quantified results.'],
    };
    var statusEl = document.getElementById('ringStatus');
    var subEl    = document.getElementById('ringStatusSub');
    if (statusEl) { statusEl.className = 'ring-status '+tier; statusEl.textContent = STATUS_COPY[tier][0]; }
    if (subEl)    subEl.textContent = STATUS_COPY[tier][1];
  }

  /* ══ STAR Progress — Tactical view ══
     Two sources feed the same four nodes:
     1) A real-time client-side regex pass, run on every keystroke, paints
        nodes as "active" (pulsing) the instant a STAR signal appears in
        the answer as it's being typed/spoken.
     2) The server's own computeStarProgress() (services/interview.js),
        returned as `star_progress` on submit, is the source of truth and
        repaints the same nodes as solid "done" once the answer lands. */
  var STAR_ORDER = ['situation','task','action','result'];
  var STAR_PATTERNS = {
    situation: /\b(when i|at my (previous|last|current)|in my role|while (working|leading)|the (context|situation|background) was|we (were|had) facing|a few (months|years) ago|during)\b/i,
    task: /\b(my (task|responsibility|goal|objective) was|i was (responsible|asked|tasked)|needed to|had to (deliver|fix|solve|build)|the (goal|objective|target) was)\b/i,
    action: /\b(i (led|built|designed|implemented|created|drove|decided|initiated|coordinated|proposed|negotiated|restructured|launched|rolled out|owned))\b/i,
    result: /\b(as a result|resulted in|which (led to|resulted)|(reduced|increased|improved|grew|cut|saved|boosted)[^.]{0,40}(\d+%|\$|percent)|the outcome was|we (achieved|delivered)|\d+%)\b/i,
  };
  function liveDetectStar(text) {
    var t = (text || '').toLowerCase();
    return {
      situation: STAR_PATTERNS.situation.test(t),
      task: STAR_PATTERNS.task.test(t),
      action: STAR_PATTERNS.action.test(t),
      result: STAR_PATTERNS.result.test(t),
    };
  }
  function paintStarProgress(progress, finalized) {
    STAR_ORDER.forEach(function(key) {
      var node = document.getElementById('starNode-'+key);
      if (!node) return;
      var on = !!(progress && progress[key]);
      node.classList.toggle('done', on && !!finalized);
      node.classList.toggle('active', on && !finalized);
    });
    for (var i = 1; i <= 3; i++) {
      var a = STAR_ORDER[i-1], b = STAR_ORDER[i];
      var conn = document.getElementById('starConn-'+i);
      if (conn) conn.classList.toggle('done', !!(progress && progress[a] && progress[b]));
    }
  }
  function resetStarProgress() { paintStarProgress({}, false); }

  /* ══ AI Interview Status — always-visible calm state machine ══ */
  var STATE_META = {
    PREPARING:        { title:'Preparing Session…', sub:'Setting up your next question',     pulse:true,  ring:0.15, steps:[] },
    CALIBRATING:       { title:'Calibrating AI…',     sub:'Analysing your target role',        pulse:true,  ring:0.25, steps:[] },
    LISTENING:         { title:'Listening…',         sub:'Capturing your answer',             pulse:false, ring:0.4,  steps:['captured'] },
    ANALYZING:         { title:'Analyzing…',         sub:'Scoring your response',             pulse:true,  ring:0.75, steps:['captured','analyzing'] },
    GENERATING:        { title:'Generating Follow-up…', sub:'Preparing next question',       pulse:true,  ring:0.9,  steps:['captured','analyzing','preparing'] },
    READY:             { title:'Ready',              sub:'Your next question is up',          pulse:false, ring:1,    steps:['captured','analyzing','preparing'] },
    SESSION_COMPLETE:  { title:'Session Complete',   sub:'All questions answered',            pulse:false, ring:1,    steps:['captured','analyzing','preparing'] },
    GENERATING_REPORT: { title:'Generating Report…', sub:'Compiling your Intelligence Report',pulse:true,  ring:0.95, steps:['captured','analyzing','preparing'] },
    FINISHED:          { title:'Finished',           sub:'Redirecting to your report',        pulse:false, ring:1,    steps:['captured','analyzing','preparing'] },
  };
  var RING_CIRC = 220; /* 2 * π * 35 */
  var WORKING_STATES = { LISTENING:1, ANALYZING:1, GENERATING:1 };
  function setAIState(key) {
    var meta = STATE_META[key] || STATE_META.PREPARING;
    document.getElementById('aiStatusTitle').textContent = meta.title;
    document.getElementById('aiStatusSub').textContent   = meta.sub;
    var ring = document.getElementById('aiStatusRing');
    ring.style.strokeDashoffset = RING_CIRC - (RING_CIRC * meta.ring);
    ring.classList.toggle('pulsing', !!meta.pulse);
    var lastStep = meta.steps[meta.steps.length-1];
    document.querySelectorAll('#statusChecklist .status-item').forEach(function(el){
      var step = el.getAttribute('data-step');
      var included = meta.steps.indexOf(step) > -1;
      var isCurrent = included && step===lastStep && WORKING_STATES[key];
      el.classList.toggle('active', !!isCurrent);
      el.classList.toggle('done', included && !isCurrent);
    });
  }

  function showToast(overallScore) {
    var s = Math.round(overallScore||0);
    var el = document.getElementById('toastScore');
    el.textContent = s;
    el.className = 'toast-score '+(s>=75?'high':s>=55?'mid':'low');
    var t = document.getElementById('scoreToast');
    t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); }, 4000);
  }

  /* ── Loading / question rendering ── */
  function showLoading(text) {
    document.getElementById('answerBarWrap') || null;
    document.querySelector('.answer-bar-wrap').style.display='none';
    document.getElementById('questionCard').style.display='none';
    document.getElementById('loadingOverlay').classList.add('show');
    document.getElementById('loadingText').textContent = text || 'Analysing...';
  }

  var QUESTION_WHY = {
    opening: 'This opening question establishes context and helps the AI calibrate follow-up depth.',
    behavioral: 'This evaluates your structure, ownership, and executive delivery under a real scenario.',
    drill_down: 'A deep-dive follow-up — the AI probes a gap or vague point from your last answer.',
  };

  function showQuestionMeta(q, type, competency) {
    // Defensive consolidation: updateCounter() also runs immediately when
    // a new question is fetched (in submitAnswer, right after QN++), but
    // it's called here too so the progress bar is GUARANTEED correct at
    // the exact moment any question — drill-down or not, voice or text —
    // actually gets painted, regardless of which code path got it there.
    // Calling it twice is harmless; it just re-renders the same numbers.
    updateCounter();

    document.getElementById('loadingOverlay').classList.remove('show');
    document.getElementById('questionCard').style.display='flex';
    document.querySelector('.answer-bar-wrap').style.display='block';

    var label = competency ? competency.replace(/_/g,' ').toUpperCase() : (type==='drill_down' ? 'DEEP DIVE' : 'BEHAVIORAL');
    document.getElementById('qEyebrow').textContent = 'QUESTION '+QN+' OF '+MAXQ+' · '+label;
    var why = document.getElementById('qWhyText');
    why.textContent = QUESTION_WHY[type] || QUESTION_WHY.behavioral;
    why.classList.remove('shown');

    document.getElementById('answerInput').value = '';
    document.getElementById('charCount').textContent = '0 / 4000';
    document.getElementById('submitBtn').disabled = true;
    document.getElementById('submitBtn').classList.remove('show');
    document.getElementById('answerInput').focus();
    resetStarProgress();
    setAIState('LISTENING');
  }
  function showQuestionText(text) {
    document.getElementById('questionText').textContent = text;
  }
  function showQuestion(q, type, competency) {
    showQuestionMeta(q, type, competency);
    showQuestionText(q.text);
  }
  window.MedhaIQ_showQuestionMeta = showQuestionMeta;
  window.MedhaIQ_showQuestionText = showQuestionText;

  document.getElementById('whyBtn').addEventListener('click', function(){
    document.getElementById('qWhyText').classList.toggle('shown');
  });

  /* ── Answer input ── */
  var answerInput = document.getElementById('answerInput');
  answerInput.addEventListener('input', function() {
    document.getElementById('charCount').textContent = this.value.length+' / 4000';
    var hasText = !!this.value.trim();
    document.getElementById('submitBtn').disabled = !hasText;
    document.getElementById('submitBtn').classList.toggle('show', hasText);
    this.style.height = 'auto';
    this.style.height = Math.min(this.scrollHeight, 140)+'px';
    paintStarProgress(liveDetectStar(this.value), false);
  });

  document.getElementById('submitBtn').addEventListener('click', function(){ submitAnswer(false); });
  document.getElementById('skipBtn').addEventListener('click', function(){ submitAnswer(true); });

  /* Hard re-entrancy guard. Previously only submitBtn was disabled while a
     request was in flight — skipBtn had no lock at all, so an impatient
     candidate clicking "Skip" repeatedly during a slow AI scoring/next-
     question call could fire 2-3 overlapping POSTs. Each one independently
     read "answeredCount" before any of the others had saved, so more than
     MAXQ questions could get created and the session would run to 6/5, 7/5,
     etc. instead of ending at 5. isSubmitting blocks that at the source,
     regardless of which control the candidate mashes. */
  var isSubmitting = false;

  async function submitAnswer(skip) {
    if (isSubmitting) return;
    isSubmitting = true;
    var ans = skip ? '' : answerInput.value.trim();
    if (!skip && !ans) { isSubmitting = false; return; }
    document.getElementById('submitBtn').disabled = true;
    document.getElementById('skipBtn').disabled = true;
    setAIState('ANALYZING');
    showLoading('Analyzing your response...');
    slog('Q'+QN+' submitted — AI scoring...','info');
    try {
      var resp = await fetch('/api/interview/sessions/'+SID+'/answer', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ questionId: QID, answerText: ans, skip: skip }),
      });
      var data = await resp.json();
      if (resp.status === 409 && data.duplicate) {
        // A duplicate/raced submission for a question that's already been
        // answered — expected now and then if a click slipped through
        // before the button disabled. Nothing to show the candidate; the
        // winning request already advanced the session normally.
        slog('Duplicate submission ignored (already answered)', 'info');
        return;
      }
      if (!resp.ok) throw new Error(data.error || 'Server error '+resp.status);

      // The server now ALWAYS returns real intelligence_scores/star_progress
      // — including an explicit all-zero set for skip — so the dashboard
      // updates immediately and visibly every time, instead of silently
      // doing nothing on skip (which used to leave the bars wherever they
      // last were, making it look like nothing had been recorded).
      if (data.intelligence_scores) {
        updateMetrics(data.intelligence_scores);
        showToast(data.intelligence_scores.overallScore);
        slog('Scored: '+Math.round(data.intelligence_scores.overallScore)+'/100','ok');
      }
      if (data.star_progress) {
        paintStarProgress(data.star_progress, true);
        slog('STAR detected: '+data.star_progress.stepsComplete+'/4 components','info');
      }
      if (data.competency_tag) updateCompetency(data.competency_tag, 20);

      setAIState('GENERATING');

      if (data.sessionEnded) {
        clearInterval(timerInt);
        setAIState('GENERATING_REPORT');
        slog('Session complete — generating report...','ok');
        showLoading('Generating your Career Intelligence Report...');
        setTimeout(function(){ window.location.href='/interview/report/'+data.reportId; }, 2200);
        return; // isSubmitting intentionally stays true — page is navigating away
      }
      QID = data.question.id;
      QN = Math.min(QN + 1, MAXQ); // clamp — never display past MAXQ even if something upstream misbehaves
      updateCounter();
      var nextQ = { text: data.text || data.question.text, type: data.question.type, id: data.question.id, order: data.question.order };
      pendingAudioUrl = data.audio_url || null;
      MedhaIQSync.hold(nextQ, data.question.type, data.competency_tag || data.question.competency);
      slog('Q'+QN+' ready','info');
    } catch (err) {
      console.error('[MedhaIQ]', err);
      slog('ERROR: '+err.message, 'err');
      document.getElementById('loadingOverlay').classList.remove('show');
      document.getElementById('questionCard').style.display='flex';
      document.querySelector('.answer-bar-wrap').style.display='block';
      document.getElementById('submitBtn').disabled = false;
      document.getElementById('skipBtn').disabled = false;
      alert('Error: '+err.message);
    } finally {
      isSubmitting = false;
      document.getElementById('skipBtn').disabled = false;
    }
  }

  /* ── End session ── */
  document.getElementById('endBtn').addEventListener('click', async function(){
    if (!confirm('End this session? Your progress cannot be resumed.')) return;
    clearInterval(timerInt);
    try { await fetch('/api/interview/sessions/'+SID, { method:'DELETE' }); } catch(e){}
    window.location.href = '/dashboard/history';
  });

  /* ── Live Terminal — single master toggle, off by default.
     Controls the ENTIRE terminal container (Tactical + Strategic
     together); the underlying data (STAR nodes, gauge, vectors) keeps
     updating in the background either way, so nothing is lost when
     the candidate switches it back on mid-session. ── */
  var terminalContent = document.getElementById('terminalContent');
  var terminalToggle   = document.getElementById('terminalToggle');
  var termToggleLbl     = document.getElementById('termToggleLbl');
  terminalToggle.addEventListener('change', function(){
    var expanded = this.checked;
    terminalContent.classList.toggle('expanded', expanded);
    termToggleLbl.textContent = expanded ? 'Hide terminal' : 'Show terminal';
    slog(expanded ? 'Live Terminal opened by candidate' : 'Live Terminal collapsed', 'info');
  });

  /* ── Initialise ── */
  updateCounter();
  setAIState('CALIBRATING');
  if (INITQ) showQuestion({text:INITQ}, QTYPE, null);
  slog('Session #'+SID+' initialised', 'ok');
  slog('Persona (internal): '+PNAME, 'info'); /* debug-console only, never shown in candidate UI */
  slog('Role: '+ROLE+' | Level: '+LEVEL);
  window.MedhaIQ_log = slog; /* exposed for the Vapi block below */
  window.MedhaIQ_setAIState = setAIState;
})();
</script>

<!-- ═══════════════════════════════════════════════════════════════
     WEBCAM — unchanged behaviour, restyled container only.
═══════════════════════════════════════════════════════════════ -->
<script>
(function(){
  var video    = document.getElementById('camVideo');
  var ph       = document.getElementById('camPlaceholder');
  var badge    = document.getElementById('camBadge');
  var badgeTxt = document.getElementById('camBadgeText');
  var toggle   = document.getElementById('camToggle');
  var stream   = null, on = false;

  async function startCam(){
    try{
      stream=await navigator.mediaDevices.getUserMedia({video:true,audio:false});
      video.srcObject=stream; video.style.display='block';
      ph.style.display='none';
      badge.classList.remove('off'); badgeTxt.textContent='● LIVE';
      toggle.textContent='Disable Camera';
      on=true;
    }catch(e){
      badgeTxt.textContent='BLOCKED';
      console.warn('[cam]',e.message);
    }
  }
  function stopCam(){
    if(stream){stream.getTracks().forEach(function(t){t.stop();}); stream=null;}
    video.style.display='none'; ph.style.display='flex';
    badge.classList.add('off'); badgeTxt.textContent='CAM OFF';
    toggle.textContent='Enable Camera';
    on=false;
  }
  toggle.addEventListener('click',function(){ if(!on)startCam(); else stopCam(); });
  setTimeout(startCam, 1400);
})();
</script>

<!-- ═══════════════════════════════════════════════════════════════
     VAPI VOICE STATE MACHINE — now driving a single inline mic
     button instead of a standalone panel button. Fixes the desync
     via MedhaIQSync (defined in the main engine script above).

     IMPORTANT CAVEAT (read before assuming this is 100% closed):
     `vapi.send({ type: 'add-message', ... })` is the documented way to
     hand Vapi's assistant a mid-call instruction, and the transcript
     listener below is the documented shape for its own spoken output.
     Both depend on how the assistant itself is configured on the Vapi
     dashboard (VAPI_ASSISTANT_ID) — if that assistant's own system
     prompt tells it to freelance rather than follow instructions handed
     to it mid-call, it can still say something different from what we
     asked it to. What this code guarantees is narrower but real: the
     text on screen will always match Vapi's own transcript of what it
     actually said — never a separate guess generated by our backend.
═══════════════════════════════════════════════════════════════ -->
<script>
(function(){
  var VKEY = '<%= vapiPublicKey %>';
  var VAST = '<%= vapiAssistantId %>';

  var btn = document.getElementById('vapiBtn');
  var sub = document.getElementById('vapiSub');
  var slog = window.MedhaIQ_log || function(){};

  if(!VKEY||!VAST){ btn.disabled = true; btn.style.opacity='0.4'; sub.textContent='Voice not configured — add VAPI keys in Render'; return; }

  var STATES={ IDLE:'IDLE',REQUESTING:'REQUESTING',CONNECTING:'CONNECTING',LIVE:'LIVE',STOPPING:'STOPPING' };
  var state=STATES.IDLE, vapi=null;
  var assistantTranscriptBuf = '';

  function setState(s,msg,isErr){
    state=s;
    btn.classList.toggle('live', s===STATES.LIVE);
    btn.disabled = (s===STATES.REQUESTING||s===STATES.CONNECTING||s===STATES.STOPPING);
    if(msg){ sub.textContent=msg; sub.style.color=isErr?'#ef4444':''; }
  }
  function setErr(msg){
    setState(STATES.IDLE,msg,true);
    setTimeout(function(){ if(state===STATES.IDLE){ sub.textContent='Speak directly with your AI interviewer'; sub.style.color=''; } },7000);
  }

  /* ── Exposed to the main engine's MedhaIQSync so it can (a) check
     whether voice is actually live and (b) hand Vapi the exact question
     our backend chose, instead of letting the two AI systems diverge. ── */
  window.MedhaIQVoice = {
    isLive: function(){ return state === STATES.LIVE && !!vapi; },
    instructNext: function(questionText){
      if (state !== STATES.LIVE || !vapi) return false;
      try {
        vapi.send({
          type: 'add-message',
          message: {
            role: 'system',
            content: 'Ask the candidate this exact next question next, in your own natural delivery, without announcing that it was given to you: "' + String(questionText).replace(/"/g, "'") + '"'
          }
        });
        return true;
      } catch (e) {
        console.error('[Vapi] instructNext failed', e);
        return false;
      }
    }
  };

  function initVapi(){
    if(vapi||!window.vapiSDK)return;
    vapi=window.vapiSDK.run({apiKey:VKEY,assistant:VAST,config:{position:'hidden'}});

    vapi.on('call-start', function() {
      setState(STATES.LIVE, 'Voice active — speak your answer');
      window.MedhaIQVoiceLive = true;
    });

    /* The ONLY source of truth for what appears in the question card
       while voice is live: Vapi's own transcript of what it is actually
       saying, painted live as it speaks — not a pre-fetched guess from
       our backend. This is what actually closes the "text doesn't match
       what the AI says" bug: whatever's on screen IS what was said,
       because it's built from the same transcript, word for word. */
    vapi.on('message', function(message) {
      if (!message || message.type !== 'transcript' || message.role !== 'assistant') return;
      if (!window.MedhaIQ_showQuestionText) return;
      if (message.transcriptType === 'final') {
        assistantTranscriptBuf = (assistantTranscriptBuf ? assistantTranscriptBuf + ' ' : '') + message.transcript;
        window.MedhaIQ_showQuestionText(assistantTranscriptBuf.trim());
      } else {
        // partial/live caption — show buffer-so-far + the in-progress chunk
        var preview = (assistantTranscriptBuf ? assistantTranscriptBuf + ' ' : '') + (message.transcript || '');
        window.MedhaIQ_showQuestionText(preview.trim());
      }
    });

    vapi.on('speech-start', function() {
      assistantTranscriptBuf = ''; // fresh sentence — don't append to the last question's leftover text
      sub.textContent = '● AI is speaking…';
    });

    vapi.on('speech-end', function() {
      sub.textContent = 'Your turn — speak clearly';
    });

    vapi.on('call-end', function() {
      window.MedhaIQVoiceLive = false;
      setState(STATES.IDLE, 'Speak directly with your AI interviewer');
    });

    vapi.on('error',function(e){
      console.error('[Vapi]',e);
      var msg='Connection error — retry';
      if(e&&e.message){
        if(/permission|not allowed/i.test(e.message)) msg='Microphone blocked — check browser settings';
        else if(/network|fetch/i.test(e.message))     msg='Network error — check your connection';
        else if(/assistant/i.test(e.message))         msg='Config error — check VAPI_ASSISTANT_ID';
      }
      setErr(msg);
    });
  }

  btn.addEventListener('click', async function(){
    if(state===STATES.LIVE||state===STATES.STOPPING){
      setState(STATES.STOPPING,'Ending voice session…');
      if(vapi){try{vapi.stop();}catch(e){}}
      return;
    }
    if(state!==STATES.IDLE)return;

    setState(STATES.REQUESTING,'Requesting microphone access…');
    try{
      var ms=await navigator.mediaDevices.getUserMedia({audio:true});
      ms.getTracks().forEach(function(t){t.stop();});
    }catch(e){
      if(e.name==='NotAllowedError') setErr('Microphone access required — click the lock icon in your browser bar');
      else if(e.name==='NotFoundError') setErr('No microphone detected');
      else setErr('Mic error: '+e.message);
      return;
    }

    if(!window.vapiSDK){
      setState(STATES.CONNECTING,'Loading voice engine…');
      var waited=0;
      try{
        await new Promise(function(res,rej){
          var t=setInterval(function(){
            waited+=150;
            if(window.vapiSDK){clearInterval(t);res();}
            if(waited>9000){clearInterval(t);rej(new Error('Voice SDK load timeout'));}
          },150);
        });
      }catch(e){ setErr(e.message); return; }
    }
    if(state!==STATES.CONNECTING&&state!==STATES.REQUESTING)return;

    setState(STATES.CONNECTING,'Connecting to AI interviewer…');
    try{ initVapi(); vapi.start(VAST); }
    catch(e){ setErr('Failed to connect: '+e.message); return; }

    setTimeout(function(){
      if(state===STATES.CONNECTING) setErr('Connection timed out — check your internet and retry');
    },13000);
  });

  setInterval(function(){ if(state===STATES.IDLE&&btn.disabled) btn.disabled=false; },3000);
})();
</script>

</body>
</html>
